<http://n2t.net/ark:/99152/p05hrsff94b> a skos:Concept ;
    periodo:spatialCoverageDescription "Abyssinia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "Row labeled \"Africa\"" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q115> ;
    skos:altLabel "Axumite Kingdom"@en ;
    skos:editorialNote "This row is somewhat cryptic; it falls on the same line as the \"Ethiopian\" components that seem to have referred to the Nubian kingdom in previous periods, but its two temporal moments are \"the end of the Solomonic race\" in ca. 960 and \"restored Abyssinians\" in ca. 1300. These two dates strongly suggest that here Priestley is referring to the Axumite kingdom and its uncertain predecessors for the first part of this row (960 is the date at which the Axumite dynasty is supposed to have been overthrown), and to the Solomonic Dynasty of Ethiopia in the second part (the intervening dynasty was overthrown in 1270)." ;
    skos:inScheme <http://n2t.net/ark:/99152/p05hrsf> ;
    skos:prefLabel "Solomonic race" ;
    time:intervalFinishedBy [ skos:prefLabel "960" ;
            time:hasDateTimeDescription [ time:year "0960"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "665 BC" ;
            time:hasDateTimeDescription [ time:year "-0664"^^xsd:gYear ] ] .

