    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "Le Crétacé est une période géologique qui s’étend de ≃ 145,0 à 66,0 Ma. Elle se termine avec la disparition des dinosaures non aviens, des ammonites et de nombreuses autres formes de vie. Cette période est la troisième et dernière de l’ère Mésozoïque ; elle suit le Jurassique et précède le Paléogène. (Wikipédia)" ;
    skos:prefLabel "Crétacé" ;
    time:intervalFinishedBy [ skos:prefLabel "-66000000" ;
            time:hasDateTimeDescription [ time:year "-66000000"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "-145000000" ;
            time:hasDateTimeDescription [ time:year "-145000000"^^xsd:gYear ] ] ;
    foaf:page <https://ark.frantiq.fr/ark:/26678/pcrtogy2tiIftS> .

