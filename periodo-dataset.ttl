    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    skos:altLabel "Cenozoic"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0kh9ds2nxh> ;
    skos:editorialNote "Added to original vocabulary 2026-02-11" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0kh9ds> ;
    skos:note "The youngest era of the Phanerozoic. It follows the Mesozoic, extending from about 65 million years ago to the present. During the Cenozoic, flora and fauna evolved toward their present state and the continents assumed their modern configuration. The Cenozoic comprises two periods: the Tertiary (with its five epochs) and the Quaternary." ;
    skos:prefLabel "Cenozoic" ;
    time:intervalFinishedBy [ skos:prefLabel "2026 CE" ;
            time:hasDateTimeDescription [ time:year "2026"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "65000000 BCE" ;
            time:hasDateTimeDescription [ time:year "-64999999"^^xsd:gYear ] ] ;
    foaf:page <http://purl.org/heritagedata/schemes/eh_period/concepts/GCEN> .

