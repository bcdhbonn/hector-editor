<http://n2t.net/ark:/99152/p08m57hg45z> a skos:Concept ;
    periodo:spatialCoverageDescription "modern Hampshire and West Sussex, parts of Kent, East Sussex, Surrey, Berkshire and Wiltshire, Britain" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114766> ;
    skos:altLabel "Southern British Iron Age"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 80 BC-AD 50. It refers to an area roughly equivalent to modern Hampshire and West Sussex, parts of Kent, East Sussex, Surrey, Berkshire and Wiltshire, in which similar styled coins are found. The various issuing authorities of this area seem to have relied on the same sources of technology and craftsmanship. Notable rulers in this area include Commios, Tincomarus, Eppillus, Verica and Epaticcus. The ethnic or tribal identities of these rulers and the anonymous issuers of earlier coins remain unclear, but they may have belonged to the Atrebates, Regni (or Regini) or Belgae (all attested districts of the later Roman province).  J Creighton, Coins and Power in Iron Age Britain, Cambridge (CUP) 2000." ;
    skos:prefLabel "Southern British Iron Age" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 50" ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "80 BC" ;
            time:hasDateTimeDescription [ time:year "-0079"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114766> .

