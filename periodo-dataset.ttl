<http://n2t.net/ark:/99152/p0dkm29z2m4> a skos:Concept ;
    periodo:spatialCoverageDescription "Sharon Plain" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/643777402> ;
            bibo:locator "page 1345" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q801> ;
    skos:altLabel "Geometric Kebaran"@en ;
    skos:editorialNote "Dates here are site-specific and differ from the Sinai Geometric Kebaran (12,500 BCE - 10,900 BCE). The general chronological table on page 1529 groups the Geometric Kebaran under the Epipaleothic and does not provide distinctive dates. " ;
    skos:inScheme <http://n2t.net/ark:/99152/p0dkm29> ;
    skos:note "\"The earliest of the Epipaleothic cultures is the Kebaran, to which the earliest mortars so far recovered are attributed. This culture, dated to between 20,000 and 15,000 years BP, is characterized by very small flint tools (microliths). Its later stage, characterized by an increasing number of geometrically shaped microliths (rectangles and triangles) is accordingly named the Geometric Kebaran (15,000-12,000 BCE).\" (page 1345)" ;
    skos:prefLabel "Geometric Kebaran" ;
    time:intervalFinishedBy [ skos:prefLabel "12,000 BP" ;
            time:hasDateTimeDescription [ time:year "-10050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "15,000 BP" ;
            time:hasDateTimeDescription [ time:year "-13050"^^xsd:gYear ] ] .

