<http://n2t.net/ark:/99152/p0j9r7263xk> a skos:Concept ;
    periodo:spatialCoverageDescription "Greater Poland and Kujavy" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "19-20" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q36> ;
    skos:altLabel "BKK"@de,
        "Brześć-Kujawski Culture"@en,
        "Late Band Pottery Culture IIB"@en,
        "Late Lengyel IIB"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0j9r7233z7> ;
    skos:editorialNote "For begin of this phase, see Late Band Pottery Culture IIA, as they transition into each other" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0j9r72> ;
    skos:note "\" Late Lengyel IIB to Late Lengyel IIIA occurred in 4310–4240 CAL B .C. (91% probability; IIB/IIIA) (FIG . 9) or 4210–4185 CAL B.C. (4% probability), probably in 4300–4265 CAL B.C. (68% probability).  Again, this date estimate is compatible with the estimate for the equivalent transition at Racot 18, where it occurred in 4285–4200 CAL B.C. (95% probability; Racot IIB/IIIA) (FIG. 10), probably in 4270–4230 CAL B.C.. Both models agree in suggesting that Late Lengyel IIB was a short phase, lasting perhaps only two or three generations. We have five assemblages associated with short-life samples ( plus one residual short-life sample) from Late Lengyel IIB.\"" ;
    skos:prefLabel "Late Lengyel IIB" ;
    time:intervalFinishedBy [ skos:prefLabel "-4210/-4185" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-4210"^^xsd:gYear ;
                    periodo:latestYear "-4185"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "-4335/-4310" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-4335"^^xsd:gYear ;
                    periodo:latestYear "-4310"^^xsd:gYear ] ] .

