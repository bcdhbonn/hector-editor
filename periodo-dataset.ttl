<http://n2t.net/ark:/99152/p08m57hvfzk> a skos:Concept ;
    periodo:spatialCoverageDescription "Samarkand (modern Uzbekistan); Transoxiana; Khurasan; Persia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q265>,
        <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q874>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x23294> ;
    skos:altLabel "Timurid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1370-1507  (AH 7721-AH 913). Dynasty named after Timur Lang (Tamerlain) who came from the Barlas clan of Turkicised Mongols. Timur acquired the title guregen/kureken, Mongolian for 'royal son-in-law' because of his marriage to a Chingizid princess. Timur was interested in settled lands of ancient Islamic or Indian culture and eventually built his capital at Samarkand (modern Uzbekistan). His rise to power began in Transoxiana. The later Timurids were mere local rulers in Khurasan and Transoxiana. The Timurid period was one of the most glorious periods in Medieval Islamic art in Transoxiana and Persia." ;
    skos:prefLabel "Timurid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1507 (AH 913)" ;
            time:hasDateTimeDescription [ time:year "1507"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1370 (AH 7721)" ;
            time:hasDateTimeDescription [ time:year "1370"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x23294> .

