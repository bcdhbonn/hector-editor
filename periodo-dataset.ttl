<http://n2t.net/ark:/99152/p08vvjksgbh> a skos:Concept ;
    periodo:spatialCoverageDescription "Byzantine Empire" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q12544> ;
    skos:altLabel "Latin Occupation"@en ;
    skos:broader <http://n2t.net/ark:/99152/p08vvjk5t32> ;
    skos:inScheme <http://n2t.net/ark:/99152/p08vvjk> ;
    skos:note "\"In 1204, armies of the Fourth Crusade invaded from western Europe, conquering the ancient Byzantine imperial capital and founding the “Latin Empire of Constantinople,” while other imperial territories also fell to Crusader rule. The Crusader state in Constantinople was one of several in the thirteenth-century Levant, all under the spiritual authority of the pope as head of the Latin Church of Western Europe... This Crusader state lasted from 1204 until 1261, when Byzantine rule was reestablished in Constantinople and limited portions of the former Byzantine empire were also retaken. The Latin Occupation of 1204–61 had a profound effect on the empire and the Byzantine peoples, causing major political fragmentation as well as the dislocation of Byzantine populations, especially the empire’s nobility and ruling classes.\"" ;
    skos:prefLabel "Latin Occupation" ;
    time:intervalFinishedBy [ skos:prefLabel "1261" ;
            time:hasDateTimeDescription [ time:year "1261"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1204" ;
            time:hasDateTimeDescription [ time:year "1204"^^xsd:gYear ] ] ;
    foaf:page <https://www.metmuseum.org/toah/hd/byza/hd_byza.htm> .

