<http://n2t.net/ark:/99152/p08m57hq7bs> a skos:Concept ;
    periodo:spatialCoverageDescription "Africa, Middle East and parts of Europe" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q15>,
        <http://www.wikidata.org/entity/Q46>,
        <http://www.wikidata.org/entity/Q7204> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x111950> ;
    skos:altLabel "Epi-palaeolithic"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Term used in Africa, Middle East and parts of Europe for assemblages of the early recent or Holocene period, after the end of the last Ice Age and before the beginning of farming, approximately 12,000-6,000BC.  These assemblages were used by hunter-gatherers and show few changes in content or technology from the preceding Upper Palaeolithic period except in the greater numbers of backed blades, crescents and microliths. This similarity gives rise to the term epi (like)-palaeolithic.  In northern Europe, environmental change was much greater at the end of the Ice Age, human adaptations changed in response and, consequently, the stone artefact assemblages are much different from those of the Upper Palaeolithic and are distinguished as Mesolithic. Despite this distinction the terms Epi-palaeolithic and Mesolithic are occasionally used as if synonymous." ;
    skos:prefLabel "Epi-palaeolithic" ;
    time:intervalFinishedBy [ skos:prefLabel "6000 BC" ;
            time:hasDateTimeDescription [ time:year "-5999"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "12,000 BC" ;
            time:hasDateTimeDescription [ time:year "-11999"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x111950> .

