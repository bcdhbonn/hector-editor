<http://n2t.net/ark:/99152/p0qkjhb529j> a skos:Concept ;
    periodo:spatialCoverageDescription "Central Texas" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "pp. 225-228" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1439> ;
    skos:altLabel "Toyah"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0qkjhb4hmc> ;
    skos:editorialNote "The chart on p. 215 provides single start and end dates (650 BP/200 BP), but the text on pp. 225-228 indicates a geographically-dependent progression with start and end dates that run earlier to later from north to south." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0qkjhb> ;
    skos:note "\"The Toyah phase appears at about 700 B.P. in the northern area, at about 600 B.P. in the middle area, and at about 500 B.P. in the southern area... The ending dates are again analogous: 350 B.P. in the northern area, 250 B.P. in the middle area, and 200 B.P. in the southern area\" (p. 225)." ;
    skos:prefLabel "Toyah" ;
    time:intervalFinishedBy [ skos:prefLabel "350 B.P./200 B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "1600"^^xsd:gYear ;
                    periodo:latestYear "1750"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "700 B.P./500 B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "1250"^^xsd:gYear ;
                    periodo:latestYear "1450"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0bw9m8rf48> .

