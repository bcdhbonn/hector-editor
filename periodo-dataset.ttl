<http://n2t.net/ark:/99152/p08m57h2njg> a skos:Concept ;
    periodo:spatialCoverageDescription "Gaul" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x116468> ;
    skos:altLabel "Burgundian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "In this thesaurus the term refers to Germanic people of the migration period, who established a post-Roman successor kingdom in Gaul during the 5thC to 6thC before absorption by the Merovingians (q.v.) in the AD 530s.  NB. The term 'Burgundian’ is also used to refer to the Late Medieval dukes of Burgundy, who ruled a vast area of Europe. In such cases, the term 'Late Medieval' is entered as a Material Culture and 'Burgundy' (or its Narrow terms) are entered in Findspot or Production Place or . In such cases, for coin records, the State field should also be used to record 'Kingdom of Burgundy'." ;
    skos:prefLabel "Burgundian" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 530s" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0530"^^xsd:gYear ;
                    periodo:latestYear "0539"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "5th century AD" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0401"^^xsd:gYear ;
                    periodo:latestYear "0500"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x116468> .

