<http://n2t.net/ark:/99152/p0bd664gkrp> a skos:Concept ;
    periodo:spatialCoverageDescription "Byzantine Empire" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/53156026> ;
            bibo:locator "page 678" ] ;
    skos:altLabel "Byzantine Empire"@en ;
    skos:editorialNote "This entry, originally associated with p. 612 of the 2004 edition, seems instead to be derived from the timeline at the end of the book, which indicates AD 565 (the death of Justinian) as the moment at which the Eastern Empire \"is... normally referred to as the Byzantine Empire\", and the 640s and the period of Islamic expansion as a time after which \"[a] reduced Byzantine state maintains its independence until the sack of Constantinople by the Ottoman Turks in 1453.\" Gates seems to imply, somewhat idiosyncratically, that only the period after Justinian qualifies as \"Byzantine\" and only the period before the Arab conquest qualifies as \"Empire\". " ;
    skos:inScheme <http://n2t.net/ark:/99152/p0bd664> ;
    skos:prefLabel "Byzantine Empire" ;
    time:intervalFinishedBy [ skos:prefLabel "640s A.D." ;
            time:hasDateTimeDescription [ periodo:earliestYear "0640"^^xsd:gYear ;
                    periodo:latestYear "0649"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "565 A.D." ;
            time:hasDateTimeDescription [ time:year "0565"^^xsd:gYear ] ] .

