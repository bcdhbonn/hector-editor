<http://n2t.net/ark:/99152/p08m57hsmnr> a skos:Concept ;
    periodo:spatialCoverageDescription "India to Egypt" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1151567>,
        <http://www.wikidata.org/entity/Q43>,
        <http://www.wikidata.org/entity/Q79>,
        <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q801>,
        <http://www.wikidata.org/entity/Q810>,
        <http://www.wikidata.org/entity/Q822>,
        <http://www.wikidata.org/entity/Q858>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x108702> ;
    skos:altLabel "Achaemenid Dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Iranian dynasty owing its origins to Teispes, son of Achaemenes. Originally kings of a territory called Anshan, subject to Median control, Persian independence was attained around 550 BC by Cyrus II (“The Great”). Cyrus conquered Babylon in 539 BC. The empire grew to control a vast territory extending from India to Egypt. The Achaemenids were brought to an end in 331 BC, following the victory of Alexander of Macedon over Darius III’s troops at the Battle of Gaugamela." ;
    skos:prefLabel "Achaemenid Dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "331 BC" ;
            time:hasDateTimeDescription [ time:year "-0330"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "550 BC" ;
            time:hasDateTimeDescription [ time:year "-0549"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x108702> .

