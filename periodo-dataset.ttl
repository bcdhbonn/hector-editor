<http://n2t.net/ark:/99152/p02chr42dw6> a skos:Concept ;
    periodo:spatialCoverageDescription "France" ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    skos:altLabel "العصر الكلاسيكي"@ar,
        "Klassische Zeit"@de,
        "Classical Greece"@en,
        "Grecia clásica"@es,
        "ép classique"@fr,
        "ép classique grecque"@fr,
        "époque classique"@fr,
        "époque classique grecque"@fr,
        "Grecia classica"@it,
        "Klassieke periode"@nl ;
    skos:editorialNote "Abbreviation ép (for époque) not present in PACTOLS thesaurus, but present in list of dated terms received from INRAP. Included as it is a commonly used alternative in French language" ;
    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "L’Époque classique est une période de l'histoire de la Grèce antique, située entre l'époque archaïque et l'époque hellénistique. Elle correspond à la majeure partie des ve et ive siècles av. J.-C., c'est-à-dire depuis la victoire athénienne de Salamine contre les Perses en -480 jusqu'à la mort d'Alexandre le Grand en -323. (WP le 07/11/18)" ;
    skos:prefLabel "époque classique grecque" ;
    time:intervalFinishedBy [ skos:prefLabel "-323" ;
            time:hasDateTimeDescription [ time:year "-0323"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "-480" ;
