<http://n2t.net/ark:/99152/p0jk4xkwft3> a skos:Concept ;
    periodo:spatialCoverageDescription "World, especially Europe and Asia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "An Age of Extremes c.1310s to c.1810s"@en,
        "LIA"@en,
        "Little Ice Age"@en ;
    skos:editorialNote "Locator: pp. 348-349" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0jk4xk> ;
    skos:note "Source's \"Definition 2\" for \"Little Ice Age\": \"The LIA was an era of recurring fluctuations that began with the devastating “Great Famine” of Europe in the 1310s and ended with the “last great subsistance crisis of the Western world” in the 1810s. Such fluctuations, driven by variations in solar output and especially volcanic eruptions, were not confined to these centuries, but they were evidently more frequent and severe during this era. These events took place against a backdrop of global cooling, which likely aggravated the severity of the fluctuations but was often too gradual to be directly noticed in temperate regions. Although the cooling trend did not become global until c.1400, it was already evident in the most populated parts of the world by the 1300s—hence the wider periodization\" (pp. 348-349)." ;
    skos:prefLabel "Little Ice Age" ;
    time:intervalFinishedBy [ skos:prefLabel "c. 1810s" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1810"^^xsd:gYear ;
                    periodo:latestYear "1819"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 1310s" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1310"^^xsd:gYear ;
                    periodo:latestYear "1319"^^xsd:gYear ] ] .

