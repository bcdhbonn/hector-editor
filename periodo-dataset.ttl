<http://n2t.net/ark:/99152/p08m57h2kf3> a skos:Concept ;
    periodo:spatialCoverageDescription "Eastern Persia to India" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q843>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52022> ;
    skos:altLabel "Saffarid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "861-1003 (AH 247-AH 393). Dynasty in Eastern Persia. Ya'qub and his brother 'Amr derived their name from their founders trade of coppersmith (Saffar). The province of Sistan became the centre of a vast empire which covered almost all of Persia, except for the north-west and the Caspian region. The empire stretched to the frontiers of India. The Saffarids openly proclaimed their contempt for the 'Abbasids and effectively demolished the 'caliphal fiction'." ;
    skos:prefLabel "Saffarid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1003 (AH 393)" ;
            time:hasDateTimeDescription [ time:year "1003"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "861 (AH 247)" ;
            time:hasDateTimeDescription [ time:year "0861"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x52022> .

