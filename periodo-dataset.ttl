            time:hasDateTimeDescription [ periodo:earliestYear "1600"^^xsd:gYear ;
                    periodo:latestYear "1700"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0m448v3d2x> a skos:Concept ;
    periodo:spatialCoverageDescription "Lower Pecos River Region" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "p. 11; pp. 32-33" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1439> ;
    skos:altLabel "Flanders Period"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0m448vtqnz> ;
    skos:editorialNote "The period date range provided in the text is simply \"2300?\", but the Flanders period is clearly defined in the chart on p. 11 as \"2400-1750 B.P.\", and in the description in the text, which seems to identify the period with the Shumla point type, a vague range as early as 2800 B.P. and as late as 1850 B.P. is discussed. Here the earlier date in the chart and \"2300?\" are taken as the start date range, and the 1750 B.P. in the chart and the 1850 B.P. mentioned in the text are taken as the end date range." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0m448v> ;
    skos:note "\"Story's Period V, Collins' Periods F and G, Dibble's Flanders Period, Shafer's Devils Interval\" (p. 32)." ;
    skos:prefLabel "Flanders Period" ;
    time:intervalFinishedBy [ skos:prefLabel "1850 or 1750 B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "0100"^^xsd:gYear ;
                    periodo:latestYear "0200"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "2400 or 2300? B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0450"^^xsd:gYear ;
                    periodo:latestYear "-0350"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0m448v3k4t> a skos:Concept ;
