<http://n2t.net/ark:/99152/p08m57h6ncv> a skos:Concept ;
    periodo:spatialCoverageDescription "Damascus and southern Syria" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q858> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52009> ;
    skos:altLabel "Burid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1104-1154 (AH 497-549). Damascus and southern Syria.  Dynasty derived from Tughtigin, Atabeg of the Seljuq Amie of Damascus (Buri is the son of Tughtigin). They maintained their power through skilful diplomacy with the Fatamids and the Frankish Crusaders but these balancing policies were not popular with the 'Abbasid Caliphs." ;
    skos:prefLabel "Burid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1154 (AH 549)" ;
            time:hasDateTimeDescription [ time:year "1154"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1104 (AH 497)" ;
