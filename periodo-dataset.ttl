<http://n2t.net/ark:/99152/p08m57hz3gh> a skos:Concept ;
    periodo:spatialCoverageDescription "region encompassing the tributaries of the Indus and Ganges rivers, India" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113572> ;
    skos:altLabel "Kuninda dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "An ancient political unit of India which issued coins between the first century BC and second century AD. The Kuninda are sometimes described as a tribal group, or Janapada, and are referred to as a people in Indian and Western texts. They lived in the region encompassing the tributaries of the Indus and Ganges rivers though little is known about their political or cultural history." ;
    skos:prefLabel "Kuninda dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "second century AD" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0101"^^xsd:gYear ;
                    periodo:latestYear "0200"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "first century BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0099"^^xsd:gYear ;
                    periodo:latestYear "0000"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113572> .

<http://n2t.net/ark:/99152/p08m57hz3nz> a skos:Concept ;
