<http://n2t.net/ark:/99152/p02chr4dp3n> a skos:Concept ;
    periodo:spatialCoverageDescription "France" ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    skos:altLabel "أوليغوسن"@ar,
        "Oligozän"@de,
        "Oligocene"@en,
        "Oligoceno"@es,
        "Oligocène"@fr,
        "Oligocene"@it,
        "Oligoceen"@nl ;
    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "L’Oligocène est une époque géologique qui s’étend de 33,9 ± 0,1 à 23,03 ± 0,05 Ma. Elle suit l’Éocène, et notamment la Grande Coupure, et précède le Miocène. C’est la troisième époque de l’ère Cénozoïque et aussi la troisième du Paléogène. Son nom se réfère à la rareté d’apparition de nouveaux mammifères modernes en comparaison de leur rapide apparition durant l’Éocène.(Wikipédia)" ;
    skos:prefLabel "Oligocène" ;
    time:intervalFinishedBy [ skos:prefLabel "-23030000" ;
            time:hasDateTimeDescription [ time:year "-23030000"^^xsd:gYear ] ] ;
