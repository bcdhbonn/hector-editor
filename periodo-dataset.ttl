<http://n2t.net/ark:/99152/p0b3hfgg93g> a skos:Concept ;
    periodo:spatialCoverageDescription "Babylonia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/1042084018> ;
            bibo:locator "pp. 28-29" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q796> ;
    skos:altLabel "Year-Date Formulae at Babylon Stage 2"@en ;
    skos:editorialNote "Derived from the discussion on p. 28: \"Stage 2: From late 316 to 311 BCE, the preiod of Antigonus Monophthalmus's undisputed dominance in Babylonia and Seleucus's exile in Ptolemy's Egypt, records were no longer dated by the reigning monarch, Alexander IV, who was absent in Macedonia. Instead, scribes introduced a year count of Antigonus in his official capacity as lúrab uqu, the Akkadian term for the Greek title stratêgos (general) of Asia....The beginning of this count, in an important precedent for the Seleucid Era, was retrojected to 317/316 BCE;\" as well as from Table 2 on p. 29, which presents the same information schematically." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0b3hfg> ;
    skos:prefLabel "Year-Date Formulae at Babylon Stage 2" ;
    time:intervalFinishedBy [ skos:prefLabel "311 BCE" ;
            time:hasDateTimeDescription [ time:year "-0310"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "late 316 BCE" ;
            time:hasDateTimeDescription [ time:year "-0315"^^xsd:gYear ] ] .

