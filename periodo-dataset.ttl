<http://n2t.net/ark:/99152/p0xkgmr3brp> a skos:Concept ;
    periodo:spatialCoverageDescription "British Isles" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/894969754> ;
            bibo:locator "Volume 2, page 3" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q145>,
        <http://www.wikidata.org/entity/Q27> ;
    skos:altLabel "The Romantic Period"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0xkgmr> ;
    skos:note "The Romantic period … is, tellingly, demarcated differently than any of the other eras that literary historians and anthologists include in their timelines. By convention, the boundaries delimiting those other epochs are either set by the regions of monarchs … or conceptualized as coinciding with the openings and closings of centuries … The date usually serving as the terminus of the Romantic age, 1832, represents a contrast to this pattern, strongly associated as it is with a signal political event, the first major reform of the British Parliament. A diverse range of dates have been identified as marking off the beginning of the Romantic period, but, almost always, each of these, too is associated with an event of tremendous political and social impact. (Volume 2, pages 3–4)" ;
    skos:prefLabel "The Romantic Period" ;
    time:intervalFinishedBy [ skos:prefLabel "1832" ;
            time:hasDateTimeDescription [ time:year "1832"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1785" ;
            time:hasDateTimeDescription [ time:year "1785"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0zpgf95vjc> .

