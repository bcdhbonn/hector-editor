<http://n2t.net/ark:/99152/p0s5mgk69kh> a skos:Concept ;
    periodo:spatialCoverageDescription "Mediterranean littoral, Europe, much of Eurasia, Africa" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://dx.doi.org/10.4000/afriques.2125> ;
            bibo:locator "page 2" ] ;
    skos:altLabel "Black Death"@en,
        "Second Plague Pandemic"@en ;
    skos:editorialNote "Spatial coverage description foregone due to the global reach of the Second Plague Pandemic, specified in the text as an \"epidemiological event starting in the 13th century and continuing to the present day—encompassing not simply the Mediterranean littoral and Europe, but much of Eurasia and, as we will see, Africa.\"" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0s5mgk> ;
    skos:prefLabel "Second Plague Pandemic" ;
    time:intervalFinishedBy [ skos:prefLabel "Present Day" ;
            time:hasDateTimeDescription [ time:year "2018"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "13th century CE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1200"^^xsd:gYear ;
                    periodo:latestYear "1299"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0s5mgkd8hz> a skos:Concept ;
    periodo:spatialCoverageDescription "Europe, Africa, Middle East, Central Asia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Justinianic Plague"@en ;
    skos:editorialNote "Locators: section I.1, section III.A.32" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0s5mgk> ;
    skos:note "Source defines spatial coverage thus: \"The historical (documentary) record for the Justinianic Plague (c. 541 to ca. 750) paints it as a phenomenon centered on the Mediterranean, stretching from Persia to Spain... The genetic (biological) record suggests, in contrast, a far more expansive geography, connecting the Mediterranean with the Tian Shan mountains in Kyrgyzstan, and a deeper chronology for this epidemiological event.\"" ;
    skos:prefLabel "Justinianic Plague" ;
    time:intervalFinishedBy [ skos:prefLabel "ca. 750" ;
            time:hasDateTimeDescription [ time:year "0750"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 541" ;
            time:hasDateTimeDescription [ time:year "0541"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0s5mgkhjkb> a skos:Concept ;
    periodo:spatialCoverageDescription "Southeast China, World" ;
