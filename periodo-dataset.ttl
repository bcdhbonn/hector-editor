<http://n2t.net/ark:/99152/p0zpgf95vjc> a skos:Concept ;
    periodo:spatialCoverageDescription "British Isles" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/895860433> ;
            bibo:locator "Volume 2, page 1" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q145>,
        <http://www.wikidata.org/entity/Q27> ;
    skos:altLabel "The Romantic Period"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0zpgf9> ;
    skos:note "Following the common usage of historians of English literature, we will denote by the “Romantic period” the span between the year 1798, in which Wordsworth and Coleridge published their Lyrical Ballads, and 1832, when Sir Walter Scott died, when other major writers of the earlier century were either dead or no longer productive, and when the passage of the first Reform Bill, after more than three decades of political stagnation and repression, inaugurated the Victorian era of cautious readjustment of political power to conform to the economic and social realities of a new industrial age (Volume 2, page 1)." ;
    skos:prefLabel "The Romantic Period" ;
    time:intervalFinishedBy [ skos:prefLabel "1832" ;
            time:hasDateTimeDescription [ time:year "1832"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1798" ;
            time:hasDateTimeDescription [ time:year "1798"^^xsd:gYear ] ] .

