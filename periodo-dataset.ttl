<http://n2t.net/ark:/99152/p0dkm292wdr> a skos:Concept ;
    periodo:spatialCoverageDescription "Holy Land" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q219060>,
        <http://www.wikidata.org/entity/Q801>,
        <http://www.wikidata.org/entity/Q810>,
        <http://www.wikidata.org/entity/Q822>,
        <http://www.wikidata.org/entity/Q858> ;
    skos:altLabel "Nabatean kingdom"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0dkm29> ;
    skos:note "\"Aretas I, the first known Nabatean ruler, is mentioned in 2 Maccabees 5:8. He is the Arabian prince from whom the deposed High Priest Jason requested asylum in 168 BCE. He may be the Aretas, king of the Arabs, mentioned in a Nabatean inscription from Elusa. The Nabatean royal dynasty at Petra may have been founded by Erotimus (Justin, Historiarum Philippicarum, XXXIX, 5, 5-6), probably the Greek name of Aretas II, who reigned at about the end of the second century BCE. Most of the Nabatean kings who reigned in Petra from that date until the abolishment of the Nabatean kingdom in 106 CE are known.\" (page 1181)" ;
    skos:prefLabel "Nabatean kingdom" ;
    time:intervalFinishedBy [ skos:prefLabel "106 CE" ;
            time:hasDateTimeDescription [ time:year "0106"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "168 BCE" ;
            time:hasDateTimeDescription [ time:year "-0167"^^xsd:gYear ] ] .

