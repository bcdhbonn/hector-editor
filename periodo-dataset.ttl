<http://n2t.net/ark:/99152/p0pf7xr7sbd> a skos:Concept ;
    periodo:spatialCoverageDescription "Ancient Egypt" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/671596128> ;
            bibo:locator "page 17" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q79> ;
    skos:altLabel "Third Period"@en,
        "period of the new empire"@en ;
    skos:editorialNote "Noted in listing on page 17, with details on page 19. Spatial information from earlier in the chapter, page 13." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pf7xr> ;
    skos:note """"Third Period (or period of the new empire), from 1527 to 525." page 17.
"The revival of Egyptian independence by the expulsion of the 'Shepherds' introduces us to the Third Period, or that of the New Empire. This continues for about one thousand years (1527-525 b.c.)..." page 19.
"Ancient Egypt comprised three divisions, — Lower Egypt, or the Delta ; Middle Egypt, or the Heptanomis ; Upper Egypt, or the Thebais." page 13.""" ;
    skos:prefLabel "Third Period" ;
    time:intervalFinishedBy [ skos:prefLabel "525 b.c." ;
            time:hasDateTimeDescription [ time:year "-0524"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1527 b.c." ;
            time:hasDateTimeDescription [ time:year "-1526"^^xsd:gYear ] ] .

