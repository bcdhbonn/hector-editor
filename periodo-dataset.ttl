<http://n2t.net/ark:/99152/p08m57hdng4> a skos:Concept ;
    periodo:spatialCoverageDescription "British Isles" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x41022> ;
    skos:altLabel "Early Medieval"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "For the British Isles, the term refers to the period from about AD 400 to about AD 1050. The term 'Celtic' is used to refer generally to Early Medieval objects from Ireland, Scotland, Wales and Cornwall, ie. the non-Anglo-Saxon areas.   For Continental Europe, for the western territories of the former Roman Empire (Italy, France, Spain, etc.) the Early Medieval period is generally accepted to begin in around AD 400. For the eastern Roman Empire, the term Byzantine is used.   N.B.   For all European coins, the term 'Medieval' (rather than the Narrow Terms 'Early Medieval' and 'Late Medieval') is used as a general term for the period c. 400 to c. 1500. Other term can also be entered, such as 'Burgundian'." ;
    skos:prefLabel "Early Medieval" ;
    time:intervalFinishedBy [ skos:prefLabel "about AD 1050" ;
            time:hasDateTimeDescription [ time:year "1050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "about AD 400" ;
            time:hasDateTimeDescription [ time:year "0400"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x41022> .

