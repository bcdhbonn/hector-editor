    skos:altLabel "Kadamba dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "345-525. Ancient royal family of Karnataka that ruled from Banavasi in present day Uttara Kannada district. The dynasty later continued to rule as a feudatory of larger Kannada empires, the Chalukya and the Rashtrakuta empires for over five hundred years during which time they branched into Goa and Hanagal. At the peak of their power under King Kakushtavarma, they ruled large parts of Karnataka." ;
    skos:prefLabel "Kadamba dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "525" ;
            time:hasDateTimeDescription [ time:year "0525"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "345" ;
            time:hasDateTimeDescription [ time:year "0345"^^xsd:gYear ] ] ;
