<http://n2t.net/ark:/99152/p08m57hwcz9> a skos:Concept ;
    periodo:spatialCoverageDescription "Eastern Wiltshire" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114771> ;
    skos:altLabel "British Iron Age East Wiltshire"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 50 BC-10 BC. It refers to an area of Eastern Wiltshire in which a uniquely local style of Iron Age coinage flourished during the third quarter of the first century BC. These coins are all uninscribed and are closely related to contemporary \"Western\" coinage produced further to the north and west. The ethnic or tribal identities of its issuers are completely unknown." ;
    skos:prefLabel "British Iron Age East Wiltshire" ;
    time:intervalFinishedBy [ skos:prefLabel "10 BC" ;
            time:hasDateTimeDescription [ time:year "-0009"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "50 BC" ;
            time:hasDateTimeDescription [ time:year "-0049"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114771> .

