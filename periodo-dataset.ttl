<http://n2t.net/ark:/99152/p08m57h8gsk> a skos:Concept ;
    periodo:spatialCoverageDescription "Diyar Bakr, Khartpert, Mardin and Mayyafariqin" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q43>,
        <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q858> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52007> ;
    skos:altLabel "Artuqid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "c.1101-1409 (c.AH 494-AH 812). Turkic dynasty ruling in Diyar Bakr, Khartpert, Mardin and Mayyafariqin, an area strongly settled by Turkmens. The rise of the Zangids halted their expansion and in the thirteenth century they became for a while vassals of the Seljuks of Rum. They submitted to the Mongol Hulegu and the dynasty came to an end with the Timurid invasion." ;
    skos:prefLabel "Artuqid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1409 (AH 812)" ;
            time:hasDateTimeDescription [ time:year "1409"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c.1101 (c.AH 494)" ;
            time:hasDateTimeDescription [ time:year "1101"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x52007> .

