<http://n2t.net/ark:/99152/p08m57hwkmv> a skos:Concept ;
    periodo:spatialCoverageDescription "Cyprus" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q229> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x105787> ;
    skos:altLabel "Early Cypriot"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "ca. 2400/2300 BC-2000/1900 BC.  The first division of the Cypriot Bronze Age, characterised by the use of Red Polished pottery, simple bronze tools and burials in chamber tombs usually placed outside the settlement areas. The beginning of the period overlaps with the Late Chalcolithic in some part of Cyprus, especially the west of the island, and with the Philia culture which has links with contemporary Anatolia (not represented in the BM collection)." ;
    skos:prefLabel "Early Cypriot" ;
    time:intervalFinishedBy [ skos:prefLabel "2000/1900 BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-1999"^^xsd:gYear ;
                    periodo:latestYear "-1899"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "ca. 2400/2300 BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-2399"^^xsd:gYear ;
                    periodo:latestYear "-2299"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x105787> .

