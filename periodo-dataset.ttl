<http://n2t.net/ark:/99152/p08m57hxrdm> a skos:Concept ;
    periodo:spatialCoverageDescription "western Turkey" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q43> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x107891> ;
    skos:altLabel "Lydian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "An Iron Age culture of western Turkey named after the kingdom of Lydia (c1300-546 BC). At its greatest extent the kingdom covered all of western Turkey and its capital was the city of Sardis. Coins were invented in Lydia around  660 BC. In 546 BC king Cyrus II captured Sardis and Lydia became part of the Achaemenid empire. The region never regained independence and was subsequently ruled by Alexander the Great and then the Seleucid dynasty." ;
    skos:prefLabel "Lydian" ;
    time:intervalFinishedBy [ skos:prefLabel "546 BC" ;
            time:hasDateTimeDescription [ time:year "-0545"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 1300 BC" ;
            time:hasDateTimeDescription [ time:year "-1299"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x107891> .

