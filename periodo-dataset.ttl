<http://n2t.net/ark:/99152/p08m57hj4jp> a skos:Concept ;
    periodo:spatialCoverageDescription "Transoxiana, Mogholistan and eastern Turkistan" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q265>,
        <http://www.wikidata.org/entity/Q863>,
        <http://www.wikidata.org/entity/Q874>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52010> ;
    skos:altLabel "Chagatayid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1227-1363 (?) (AH 624-764). Transoxiana, Mogholistan and eastern Turkistan. Named after Chagatay, son of Chengiz. The founder of the Chagatayid khanate (dynasty) was Chagatay's grandson Alughu who seized Khwarazm, western Turkestan and Afghanstan. These territories became the nucleus of the khanate. The unity of the Chagatayids began to disintegrate with the rise of Timurlang in Transoxiana." ;
    skos:prefLabel "Chagatayid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1363? (AH 764)" ;
            time:hasDateTimeDescription [ time:year "1363"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1227 (AH 624)" ;
            time:hasDateTimeDescription [ time:year "1227"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x52010> .

