<http://n2t.net/ark:/99152/p0kh9dsbz2g> a skos:Concept ;
    periodo:spatialCoverageDescription "England" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    owl:sameAs <http://purl.org/heritagedata/schemes/eh_period/concepts/NE> ;
    skos:altLabel "Neolithic"@en,
        "New Stone Age"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0kh9ds785r> ;
    skos:editorialNote "September 2024 - revisions to reflect latest data as published May 2024" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0kh9ds> ;
    skos:note "The New Stone Age, this period follows on from the Palaeolithic and the Mesolithic and is itself succeeded by the Bronze Age. This period is characterized by the practice of a farming economy and extensive monumental constructions. Circa -4000 BCE to -2200 BCE." ;
    skos:prefLabel "Neolithic" ;
    time:intervalFinishedBy [ skos:prefLabel "2200 BCE" ;
            time:hasDateTimeDescription [ time:year "-2199"^^xsd:gYear ] ] ;
