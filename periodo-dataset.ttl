<http://n2t.net/ark:/99152/p08m57hph3k> a skos:Concept ;
    periodo:spatialCoverageDescription "Carthage and its settlements established in Sardinia, Spain and Western Sicily, and also to those settlements of North Africa around Carthage" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1460>,
        <http://www.wikidata.org/entity/Q1462>,
        <http://www.wikidata.org/entity/Q29>,
        <http://www.wikidata.org/entity/Q948> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114244> ;
    skos:altLabel "Punic"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term refers to the Punic, western Mediterranean culture contemporary with the Iron Age and Roman Republican period. The culture exhibits elements of Greco-Roman culture but is essentially autonomous. It refers to Carthage and its settlements established in Sardinia, Spain and Western Sicily, and also to those settlements of North Africa around Carthage.  It is related to the Classical World but also to Levantine cultures as its origins are from the Phoenician settlements. This culture may thus be taken back as far as the foundation of Carthage in the 9th century (Roman sources date it to 814 BC) until its destruction by the Romans in 146 BC, but also may extend as far into the Early Modern period when it was refounded by the Romans until it was again destroyed circa AD 698." ;
    skos:prefLabel "Punic" ;
    time:intervalFinishedBy [ skos:prefLabel "146 BC" ;
            time:hasDateTimeDescription [ time:year "-0145"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "9th century BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0899"^^xsd:gYear ;
                    periodo:latestYear "-0800"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114244> .

