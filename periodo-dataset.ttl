<http://n2t.net/ark:/99152/p02chr4f76d> a skos:Concept ;
    periodo:spatialCoverageDescription "France" ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    skos:altLabel "الحقب الجيولوجي الثاني"@ar,
        "Secondary"@en,
        "Mésozoïque"@fr,
        "Secondaire"@fr,
        "Ère des reptiles"@fr,
        "Ère secondaire"@fr,
        "ère secondaire"@fr ;
    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "Ère géologique ayant duré de 245 à 64 Ma et groupant le Trias, le Jurassique et le Crétacé. Ce terme n'est plus usité dans les pays anglo-saxon. (A. Foucault et J.-F. Raoult, Dictionnaire de géologie, 6e édition 2005)" ;
    skos:prefLabel "Secondaire" ;
    time:intervalFinishedBy [ skos:prefLabel "-66000001" ;
