<http://n2t.net/ark:/99152/p0qkjhbnbq9> a skos:Concept ;
    periodo:spatialCoverageDescription "Central Texas" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "pp. 225-228" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1439> ;
    skos:altLabel "Austin"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0qkjhb4hmc> ;
    skos:editorialNote "The chart on p. 215 provides single start and end dates (1250 BP/650 BP), but the text on pp. 225-228 indicates a geographically-dependent progression with start and end dates that run earlier to later from north to south." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0qkjhb> ;
    skos:note "\"... the Austin phase appeared somewhere around 1350 B.P. in the northern area that extends from about Cleburne to Waco. In the middle area that extends from just south of Waco to about Round Rock, the beginning dates are around 1250 B.P. The Austin phase begins in the southern area (extending from about Austin to San Antonio) at about 1100 B.P.... The ending dates show an analogous pattern. The Austin phase ends at about 800 B.P. in the northern area, 700 B.P in the middle area, and 550 B.P. in the southern area\" (p. 225)." ;
    skos:prefLabel "Austin" ;
    time:intervalFinishedBy [ skos:prefLabel "800 B.P./550 B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "1150"^^xsd:gYear ;
                    periodo:latestYear "1400"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1350 B.P./1100 B.P." ;
            time:hasDateTimeDescription [ periodo:earliestYear "0600"^^xsd:gYear ;
                    periodo:latestYear "0850"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0bw9m8trxt> .

