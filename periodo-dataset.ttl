<http://n2t.net/ark:/99152/p06c6g3> a skos:ConceptScheme ;
    dcterms:source [ dcterms:contributor [ foaf:name "" ] ;
            dcterms:creator [ foaf:name "Library of Congress" ] ;
            dcterms:issued "2015" ;
            dcterms:title "Library of Congress Subject Headings" ;
            foaf:page <http://id.loc.gov/authorities/subjects.html> ] ;
    skos:editorialNote "The terms in this collection reflect the current status of the LCSH, but initial records were also gathered from earlier print publications of Library of Congress Subject Headings (LC period subdivisions under names of places, 1975; LC period subdivisions under names of places: compiled from the online subject authority file of the Library of Congress by the Subject Cataloging Division, 1987)." .

