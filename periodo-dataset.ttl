<http://n2t.net/ark:/99152/p08m57h8sp2> a skos:Concept ;
    periodo:spatialCoverageDescription "Cyclades" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q41> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x14106> ;
    skos:altLabel "Keros-Syros Culture"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The second of the three cultural groups into which the Early Cycladic (q.v.) period is divided, based on consistently recurring types of pottery, bronze and marble objects. The name refers to the islands used by Colin Renfrew to define the culture, although the term applies to material from the Cyclades as a whole. There are not always clear boundaries between cultural groups, but an approximate date range is 2800BC – 2300BC." ;
    skos:prefLabel "Keros-Syros Culture" ;
    time:intervalFinishedBy [ skos:prefLabel "2300 BC" ;
            time:hasDateTimeDescription [ time:year "-2299"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "approximately 2800 BC" ;
            time:hasDateTimeDescription [ time:year "-2799"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x14106> .

