<http://n2t.net/ark:/99152/p08m57hfw73> a skos:Concept ;
    periodo:spatialCoverageDescription "regions of Persia, Iraq, Transcaucasia and Anatolia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
