<http://n2t.net/ark:/99152/p08m57h7t8h> a skos:Concept ;
    periodo:spatialCoverageDescription "Ratanpur, Raipur" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113554> ;
    skos:altLabel "Kalachuri dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Kalachuris who ruled from Ratanpur from the early 11th century were distantly related to, and feudatories of, the Tripuri Kalachuris. They gained prominence under Jajalladeva I in the early 12th century. Early historical documents of their rule continue to Pratapamalla (reigned c. 1188-1217) and are then interrupted until the 15th century, by which time the family had split into two branches based at Ratanpur and Raipur. No authentic historical document relating to their history after the 15th century is known." ;
    skos:prefLabel "Kalachuri dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1217" ;
            time:hasDateTimeDescription [ time:year "1217"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "early 11th century" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1001"^^xsd:gYear ;
                    periodo:latestYear "1034"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113554> .

