    skos:altLabel "Phylakopi I Culture"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The latest of the three cultural groups into which the Early Cycladic (q.v.) period is divided, based on consistently recurring types of pottery, bronze and marble objects. The name refers to the type site used by Colin Renfrew to define the culture, although the term applies to material from the Cyclades as a whole. There are not always clear boundaries between cultural groups, but an approximate date range is 2300BC – 2000BC." ;
    skos:prefLabel "Phylakopi I Culture" ;
    time:intervalFinishedBy [ skos:prefLabel "2000 BC" ;
            time:hasDateTimeDescription [ time:year "-1999"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "approximately 2300 BC" ;
            time:hasDateTimeDescription [ time:year "-2299"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x14411> .

