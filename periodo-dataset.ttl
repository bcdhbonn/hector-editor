    foaf:page <http://purl.org/heritagedata/schemes/eh_period/concepts/NE> .

<http://n2t.net/ark:/99152/p0kh9dsj33x> a skos:Concept ;
    periodo:spatialCoverageDescription "England" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    owl:sameAs <http://purl.org/heritagedata/schemes/eh_period/concepts/IA> ;
    skos:altLabel "Iron Age"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0kh9ds785r> ;
    skos:editorialNote "September 2024 - revisions to reflect latest data as published May 2024" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0kh9ds> ;
    skos:note "This period follows on from the Bronze Age and is characterized by the use of iron for making tools and monuments such as hillforts and oppida. The Iron Age is taken to end with the Roman invasion. Circa -800 BCE to 43 CE." ;
    skos:prefLabel "Iron Age" ;
    time:intervalFinishedBy [ skos:prefLabel "43 CE" ;
