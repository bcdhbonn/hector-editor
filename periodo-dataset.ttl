<http://n2t.net/ark:/99152/p05hrsf2xdw> a skos:Concept ;
    periodo:spatialCoverageDescription "Lower Egypt" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "Row labeled \"Africa\"" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q79> ;
    skos:altLabel "Shepherd Kings"@en ;
    skos:editorialNote "It is unclear who Priestley is referring to by this designation; the dates are too late to refer to the Second Intermediate Period invaders now referred to as the Hyksos (Josephus' \"Shepherd Kings\"). The end date coincides with the death of Ramesses XI and the beginning of the the Third Intermediate Period. That the spatial reference is to lower Egypt/the Delta is inferred from the arrangement of this bar in the timeline." ;
    skos:inScheme <http://n2t.net/ark:/99152/p05hrsf> ;
    skos:prefLabel "Shepherd Kings" ;
    time:intervalFinishedBy [ skos:prefLabel "1070 BC" ;
            time:hasDateTimeDescription [ time:year "-1069"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1200 BC" ;
            time:hasDateTimeDescription [ time:year "-1199"^^xsd:gYear ] ] .

