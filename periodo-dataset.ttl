<http://n2t.net/ark:/99152/p044mt9z8hr> a skos:Concept ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/257445695> ;
            bibo:locator "viii" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38>,
        <http://www.wikidata.org/entity/Q41> ;
    skos:altLabel "Ancient Style"@en,
        "The First Period"@en,
        "La première époque"@fr,
        "l'ancien style"@fr ;
    skos:inScheme <http://n2t.net/ark:/99152/p044mt9> ;
    skos:note """"On sait l'extrème difficulté qu'il y a de fixer l'époque des monumens anciens avec quelque dégré de précision, soit en les considérant d'après le style de l'Art, soit d'après les principes de la paléographie, lorsqu'ils présentent des caractères. Mais en combinant ce qu'ont rapporté les auteurs anciens avec les monumens de toute espèce, surtout les médailles et les inscriptions, il semble qu'on peut établir trois époques principales." (Millingen 1813, viii)

cf. Millingen 1813, n. 6: "V. Planches XX à XXII, XXXI, XXXII".""" ;
    skos:prefLabel "La première époque" ;
    time:intervalFinishedBy [ skos:prefLabel "vers l'année 450 avant notre ére" ;
            time:hasDateTimeDescription [ time:year "-0449"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "vers l'année 700 avant notre ére" ;
            time:hasDateTimeDescription [ time:year "-0699"^^xsd:gYear ] ] .

