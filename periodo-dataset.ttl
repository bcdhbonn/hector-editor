    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/802950569> ;
            bibo:locator "pages 26-7" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q219060>,
        <http://www.wikidata.org/entity/Q801>,
        <http://www.wikidata.org/entity/Q810>,
        <http://www.wikidata.org/entity/Q822>,
        <http://www.wikidata.org/entity/Q858> ;
    skos:altLabel "Chalcolithic"@en,
        "Phase IA"@en ;
    skos:editorialNote "Alternate label \"Phase IA\" refers to the synopsis of \"Periodization of International Trade\" and corresponds with Amratian and Naqada I in Egypt. (page 40)" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0fk6s4> ;
    skos:note """"What we have just summarized pertains to the latter part of the period, which came to an end probably ca. 3500 B.C., a CRD terminus based on radiocarbon dates (I-353, I-285, I-1341) from Nahal Mishmar and the initial phase of EB I, which was contemporary with the Early Gerzean, or Naqada II, of Egypt." (page 27)
"How much before ca. 4000 B.C. early Chalcolithic culture begins, its origin, and its relationship, if any, to the terminal Neolithic must remain unanswered questions." (page 27)""" ;
    skos:prefLabel "Chalcolithic" ;
    time:intervalFinishedBy [ skos:prefLabel "ca. 3500 BCE" ;
            time:hasDateTimeDescription [ time:year "-3499"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "ca. 4000 B.C." ;
            time:hasDateTimeDescription [ time:year "-3999"^^xsd:gYear ] ] .

