<http://n2t.net/ark:/99152/p0s84tqvjs7> a skos:Concept ;
    periodo:spatialCoverageDescription "Noricum" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q183>,
        <http://www.wikidata.org/entity/Q215>,
        <http://www.wikidata.org/entity/Q2277>,
        <http://www.wikidata.org/entity/Q38>,
        <http://www.wikidata.org/entity/Q40> ;
    skos:altLabel "Spätantike (Römisches Noricum)"@de,
        "Late antiquity (Roman Noricum)"@en ;
    skos:editorialNote "While Gassner et al. (pages 371–372) define Late Antiquity in their book form AD 284 until AD 610, at this place AD 488, when Odoaker ordered parts of the remaining Roman people moving from Noricum to Italy (page 372), is used as a stop of the period. AD 488 is the commonly used date for marking the definite end of *Roman* Noricum and the beginning of the Early Medieval Period in that area (although the Western Roman Empire ceased to be in AD 476); nevertheless, various settlements continued in the Early Medieval Period, as well as seemingly not all Romans moved to Italy and stayed instead in Noricum. " ;
    skos:inScheme <http://n2t.net/ark:/99152/p0s84tq> ;
    skos:prefLabel "Late antiquity (Roman Noricum)" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 488" ;
            time:hasDateTimeDescription [ time:year "0488"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "AD 284" ;
            time:hasDateTimeDescription [ time:year "0284"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0ndpcqn83v> .

