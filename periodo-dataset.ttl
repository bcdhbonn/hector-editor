<http://n2t.net/ark:/99152/p08m57hz6wt> a skos:Concept ;
    periodo:spatialCoverageDescription "southern India" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x41567> ;
    skos:altLabel "Chola"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "South Indian dynasty, originally based in the Kaveri delta and with a capital at Thanjavur/Tanjore.  Came to prominence in the 8th century and flourished through into the 12th.  Held all of the Tamil country as well as other parts of southern India.  Under Rajaraja invaded Sri Lanka and Srivijaya, while under Rajendra (son of Rajaraja), invaded northern India as far as the Ganges." ;
    skos:prefLabel "Chola" ;
    time:intervalFinishedBy [ skos:prefLabel "12th century" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1101"^^xsd:gYear ;
