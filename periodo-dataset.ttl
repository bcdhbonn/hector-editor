<http://n2t.net/ark:/99152/p0fk6s459bb> a skos:Concept ;
    periodo:spatialCoverageDescription "Palestine" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/802950569> ;
            bibo:locator "page 30" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q219060>,
        <http://www.wikidata.org/entity/Q801>,
        <http://www.wikidata.org/entity/Q810>,
        <http://www.wikidata.org/entity/Q822>,
        <http://www.wikidata.org/entity/Q858> ;
    skos:altLabel "EB I"@en,
        "Early Bronze I"@en,
        "Phase IB"@en ;
    skos:editorialNote """Stager notes that the Early Bronze Age can be subdivided further and according to north/south regional variation: Early EB I (North); Early EB I (South); and Middle and Late EB; and EB I Sinae (page 31-5). He uses relative chronologies and does not propose definite periodizations for these subdivisions. On pages 28-30, he outlines scholarly debate on Early Bronze Age chronology with geographical considerations. 

Alternate label "Phase IB" comes from "The Periodization of International Trade" and coincides with Gerzean-Dynasty 0 and Naqada II-III in Egypt. (page 40)""" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0fk6s4> ;
    skos:note "\"this preurban period of EB I has been shrouded in confusing terminology, which reflects chronological uncertainty; this, in turn, has led to muddled periodization.\" (page 28)" ;
    skos:prefLabel "Early Bronze I" ;
    time:intervalFinishedBy [ skos:prefLabel "ca. 3100 BCE" ;
            time:hasDateTimeDescription [ time:year "-3099"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "ca. 3500 BCE" ;
            time:hasDateTimeDescription [ time:year "-3499"^^xsd:gYear ] ] .

