<http://n2t.net/ark:/99152/p08m57hz9dg> a skos:Concept ;
    periodo:spatialCoverageDescription "modern East Anglia - Norfolk, Suffolk and parts of Cambridgeshire" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114770> ;
    skos:altLabel "British Iron Age East Anglia"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 50 BC-AD 50. It refers to an area roughly equivalent to the modern East Anglia - Norfolk, Suffolk and parts of Cambridgeshire - in which similar styled coins are found. The various issuing authorities of this area seem to have relied on the same sources of technology and craftsmanship. The earliest coins were issued anonymously; later examples carry inscriptions that are assumed to be the names of local rulers. These include AESV, ALIIF SCAVO (or similar), ESVPRASTO, ECEN/ECE (if this is not a reference to the Iceni themselves) and ANTED. The ethnic or tribal identities of these issuers are unclear, but some may have belonged to the Iceni (who can perhaps be equated with the \"Cenimagni\" mentioned by Caesar - Caesar, De Bello Gallico, V.21)." ;
    skos:prefLabel "British Iron Age East Anglia" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 50" ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "50 BC" ;
            time:hasDateTimeDescription [ time:year "-0049"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114770> .

