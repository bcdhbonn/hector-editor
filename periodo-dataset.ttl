<http://n2t.net/ark:/99152/p02chr4gqd2> a skos:Concept ;
    periodo:spatialCoverageDescription "France" ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    skos:altLabel "العصر الجليدي المتأخر"@ar,
        "Spätglazial"@de,
        "Late Glacial"@en,
        "Máximo Tardiglaciar"@es,
        "Tardiglaciaire"@fr,
        "Würm IV"@fr,
        "Tardiglaciale"@it,
        "Tardiglaciaal"@nl ;
    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "Dernière phase du Pléistocène, précédant l'époque actuelle de l'Holocène. Il correspond à l'ultime subdivision de la dernière glaciation (glaciation de Würm dans les Alpes), durant laquelle le climat se réchauffe globalement même s'il est marqué par des oscillations froides. Il précède la période interglaciaire actuelle (on parle encore de postglaciaire), globalement chaude, qu'est l'Holocène. Les limites chronologiques du Tardiglaciaire varient selon les auteurs mais la plupart considèrent qu'il dure de la fin du Dernier Maximum Glaciaire ou LGM (vers environ 18 000 ans BP) à la dernière oscillation froide appelée Dryas récent (vers 11 650 ans BP calibré soit vers 9700 ans av. J.-C.). (Wikipédia)" ;
    skos:prefLabel "Tardiglaciaire" ;
    time:intervalFinishedBy [ skos:prefLabel "-7700" ;
            time:hasDateTimeDescription [ time:year "-7700"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "-9650" ;
            time:hasDateTimeDescription [ time:year "-9650"^^xsd:gYear ] ] ;
    foaf:page <https://ark.frantiq.fr/ark:/26678/pcrtm0TQrgSmdN> .

