<http://n2t.net/ark:/99152/p08m57h8x32> a skos:Concept ;
    periodo:spatialCoverageDescription "Mediterranean coast of the Middle East" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q81483> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x14417> ;
    skos:altLabel "Pre-Pottery Neolithic B"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Pre-Pottery Neolithic B (PPNB) (9,200-8,000 BP) is a division of the Neolithic named by Kathleen Kenyon during her excavations at Jericho.  The PPNB encompasses a major transition in the lifestyles of the inhabitants of the Mediterranean coast of the Middle East. The population increased and significant common traits within what has been termed an ‘Interaction Sphere’  include chipped stone typologies, subsistence based on cultivation and herding, rectangular architecture, the utilisation of burnt lime plaster and ritual practices focussed on skulls, symbolic statuary and baked clay figurines." ;
    skos:prefLabel "Pre-Pottery Neolithic B" ;
    time:intervalFinishedBy [ skos:prefLabel "8,000 BP" ;
            time:hasDateTimeDescription [ time:year "-6050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "9,200 BP" ;
            time:hasDateTimeDescription [ time:year "-7250"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x14417> .

<http://n2t.net/ark:/99152/p08m57h8zmq> a skos:Concept ;
