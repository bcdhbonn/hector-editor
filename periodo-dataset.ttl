<http://n2t.net/ark:/99152/p08m57h8c8c> a skos:Concept ;
    periodo:spatialCoverageDescription "Lincolnshire and parts of Yorkshire, Nottinghamshire, Leicestershire and Rutland" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114764> ;
    skos:altLabel "North Eastern British Iron Age"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 60 BC-AD 50. It refers to an area roughly equivalent to modern Lincolnshire and parts of Yorkshire, Nottinghamshire, Leicestershire and Rutland, in which similar styled coinages are found. The various issuing authorities of this area seem to have relied on the same sources of technology and craftsmanship. The earliest coins were issued anonymously; later examples carry inscriptions that are assumed to be the names of local rulers. These include VEP CORF, AVN COST, IISVPRASV, TATISOM and VOLISIOS. The ethnic or tribal identities of these issuers are unclear, but some may have belonged to the Corieltavi (formerly \"Corieltauvi\" or \"Coritani\"), who inhabited a similar area in the early Roman period. Other groups, however, may have existed in this area before AD 43." ;
    skos:prefLabel "North Eastern British Iron Age" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 50" ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "60 BC" ;
            time:hasDateTimeDescription [ time:year "-0059"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114764> .

