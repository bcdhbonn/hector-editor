<http://n2t.net/ark:/99152/p0dfxxpcnkv> a skos:Concept ;
    periodo:spatialCoverageDescription "Mediterranean islands" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Aceramic Neolithic"@en,
        "Pre-Pottery"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0dfxxp> ;
    skos:note "Modified from Shea (2013*: 7, table 1.1), whose focus is on the Levant. *Stone Tools in the Paleolithic and Neolithic Near East. Cambridge University Press, Cambridge. These start & end dates are calibrated. A large regional chronological variability is observed here, as with the Epipaleolithic. Typically, the Neolithic on the islands is later than on the mainland, having derived from that region. However, an early Neolithic contemporary with that of the mainland has been recently documented in Cyprus; thus, the wide chronological framework is used here, which includes both Pre-Pottery and Pottery phases." ;
    skos:prefLabel "Aceramic Neolithic" ;
    time:intervalFinishedBy [ skos:prefLabel "6,500 B.P." ;
            time:hasDateTimeDescription [ time:year "-4550"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "ca. 12,000 B.P." ;
            time:hasDateTimeDescription [ time:year "-10050"^^xsd:gYear ] ] .

