<http://n2t.net/ark:/99152/p02chr4cjmt> a skos:Concept ;
    periodo:spatialCoverageDescription "France" ;
    dcelements:language "fr" ;
    dcterms:language <http://lexvo.org/id/iso639-1/fr> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q142> ;
    skos:altLabel "بليستوسن"@ar,
        "Pleistozän"@de,
        "Pleistocene"@en,
        "Pleistoceno"@es,
        "Pléistocène"@fr,
        "Pleistocene"@it,
        "Pleistoceen"@nl ;
    skos:inScheme <http://n2t.net/ark:/99152/p02chr4> ;
    skos:note "Le Pléistocène (du grec ancien pleistos, nombreux, et kainos, récent) est la plus ancienne époque géologique du Quaternaire et l'avant-dernière sur l'échelle des temps géologiques (tant que la proposition de création de l'Anthropocène n'est pas retenue). Elle s'étend de 2,58 millions d'années à 11 700 ans avant le présent. Le Pléistocène est marqué par les récentes glaciations et sa fin correspond à celle du Paléolithique. (Wikipédia)" ;
    skos:prefLabel "Pléistocène" ;
    time:intervalFinishedBy [ skos:prefLabel "-9701" ;
            time:hasDateTimeDescription [ time:year "-9701"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "-2580000" ;
