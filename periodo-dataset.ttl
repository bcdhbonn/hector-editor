<http://n2t.net/ark:/99152/p0pgmrb57b5> a skos:Concept ;
    periodo:spatialCoverageDescription "Europe and Eurasia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "MCA"@en,
        "Medieval Climate Anomaly"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pgmrb> ;
    skos:note "Source describes \"the MCA, a prolonged, mostly warm period that began around 900 CE which, with one exception in the first half of the eleventh century, was likely due to a high solar irradiance. In the MCA, not only Europe but much of Eurasia flourished... The onset of the Wolf solar minimum signaled the end of this prolonged period.\" A note indicates that this onset began in 1282." ;
    skos:prefLabel "Medieval Climate Anomaly" ;
    time:intervalFinishedBy [ skos:prefLabel "1282" ;
            time:hasDateTimeDescription [ time:year "1282"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "around 900 CE" ;
            time:hasDateTimeDescription [ time:year "0900"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0pgmrbbr4c> a skos:Concept ;
    periodo:spatialCoverageDescription "Europe and Eurasia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Wolf solar minimum"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pgmrb> ;
    skos:note "\"A period of low solar irradiance starting around 1282 and continuing until 1342\" (n. 4), citing Campbell 2016 for the definition." ;
    skos:prefLabel "Wolf solar minimum" ;
    time:intervalFinishedBy [ skos:prefLabel "1342" ;
            time:hasDateTimeDescription [ time:year "1342"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "around 1282" ;
            time:hasDateTimeDescription [ time:year "1282"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0pgmrbbz3m> a skos:Concept ;
    periodo:spatialCoverageDescription "Northern Europe" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Great Northern European Famine"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pgmrb> ;
    skos:note "\"The late thirteenth and early fourteenth centuries saw repeated catastrophes, including a sheep-scab epizootic in the 1270s and 1280s, the Great Northern European Famine of 1315–17, and a cattle panzootic of 1319–20.\"" ;
    skos:prefLabel "Great Northern European Famine" ;
    time:intervalFinishedBy [ skos:prefLabel "1317" ;
            time:hasDateTimeDescription [ time:year "1317"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1315" ;
            time:hasDateTimeDescription [ time:year "1315"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0pgmrbgpcs> a skos:Concept ;
    periodo:spatialCoverageDescription "Eurasia and Africa" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Great Transition"@en ;
    skos:editorialNote "Start date range inferred from the range offered for the first phase of the Great Transition; stop date range inferred from the range offered for its last phase." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pgmrb> ;
    skos:note "\"For Campbell, a variety of climate-forcing factors and economic shifts argue for designating the Great Transition as its own separate period, with four distinct phases\"; these phases are divided into the 1260s-1330s (end of the Medieval Climate Anomaly), 1340s-1370s, 1370s-1470s, and 1470s-on, ending around 1500, at which point \"[t]his newly configured Europe, one where northern countries took over the economic power formerly wielded by Italy, had now adjusted to the new world the previous two centuries had made. In other words, the Great Transition was completed and the Old World had adjusted to the new climatic and economic balance.\"" ;
    skos:prefLabel "Great Transition" ;
    time:intervalFinishedBy [ skos:prefLabel "1470s to 1500" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1470"^^xsd:gYear ;
                    periodo:latestYear "1500"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1260s to 1330s" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1260"^^xsd:gYear ;
                    periodo:latestYear "1339"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0pgmrbkrv5> a skos:Concept ;
    periodo:spatialCoverageDescription "Europe and Eurasia" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Spörer solar minimum"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0pgmrb> ;
    skos:note "\"The Spörer minimum, ca. 1416–1534, had effects on the Indian Ocean monsoon, the Nile flood, and the North Atlantic oscillation, resulting in global temperature drops of 0.4–0.8°.\"" ;
    skos:prefLabel "Spörer solar minimum" ;
    time:intervalFinishedBy [ skos:prefLabel "ca. 1534" ;
            time:hasDateTimeDescription [ time:year "1534"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "ca. 1416" ;
            time:hasDateTimeDescription [ time:year "1416"^^xsd:gYear ] ] .

