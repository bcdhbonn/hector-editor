<http://n2t.net/ark:/99152/p08m57hgwp5> a skos:Concept ;
    periodo:spatialCoverageDescription "North Africa; Egypt; southern Syria" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1016>,
        <http://www.wikidata.org/entity/Q1028>,
        <http://www.wikidata.org/entity/Q262>,
