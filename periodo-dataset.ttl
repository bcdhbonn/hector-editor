    time:intervalStartedBy [ skos:prefLabel "1042" ;
            time:hasDateTimeDescription [ time:year "1042"^^xsd:gYear ] ] ;
    foaf:page <https://ark.frantiq.fr/ark:/26678/pcrt63ol7g6tGj> .

