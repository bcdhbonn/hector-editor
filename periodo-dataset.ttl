<http://n2t.net/ark:/99152/p08m57hjq4j> a skos:Concept ;
    periodo:spatialCoverageDescription "along the Mediterranean coastline from the Aegean to Egypt" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q229>,
        <http://www.wikidata.org/entity/Q81483> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x115760> ;
    skos:altLabel "Eastern Mediterranean"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The term is used by the Greek and Roman Department for objects with multiple centres of production along the Mediterranean coastline from the Aegean to Egypt. It reflects the broad cultural connections between regions at certain periods, particularly the 'International Style' c. 1400 BC-1200 BC. For this reason it is usually for objects from Bronze Age Cypriot sites: after this period, centres of production are better defined. The term is not used for Hellenistic (q.v.) or Roman (q.v.) objects. See also the Place term 'Mediterranean' with Comment 'East Mediterranean' for objects described as 'East Mediterranean' in the records for the Prehistory and Europe Department.  See also the term 'Cypriot' and its Narrow Terms." ;
    skos:prefLabel "Eastern Mediterranean" ;
    time:intervalFinishedBy [ skos:prefLabel "1200 BC" ;
            time:hasDateTimeDescription [ time:year "-1199"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 1400 BC" ;
            time:hasDateTimeDescription [ time:year "-1399"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x115760> .

