<http://n2t.net/ark:/99152/p08m57hj5tb> a skos:Concept ;
    periodo:spatialCoverageDescription "Greece; Anatolia; Egypt; Babylon; India" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x108703> ;
    skos:altLabel "Macedonian Dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Following the wars that led to the unification of Greece under Philip II of Macedon, his son Alexander III (“the Great”) began a series of campaigns eastwards in 333 BC. A series of victories over the Persians culminated in the final battle at Gaugamela in 331 BC. Already ruler over Anatolia and Egypt, he now became ruler of Babylon and went on to extend control as far east as India. Following Alexander’s death in 323 BC, nominal kingship passed to his brother Philip III, with Perdiccas -- commander of the Companion cavalry -- as regent. In 320 BC Perdiccas was assassinated and rule over Babylon was allotted to Seleucus. He was forced out by Antigonus in 316 BC, only to return triumphantly in 312 BC." ;
    skos:prefLabel "Macedonian Dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "312 BC " ;
            time:hasDateTimeDescription [ time:year "-0311"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "333 BC" ;
            time:hasDateTimeDescription [ time:year "-0332"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x108703> .

<http://n2t.net/ark:/99152/p08m57hj6vv> a skos:Concept ;
    periodo:spatialCoverageDescription "Hellenistic and Roman Egypt" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q79> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x13917> ;
    skos:altLabel "Graeco-Roman"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is only used by the Department of Ancient Egypt and Sudan to include both Hellenistic Egypt from 332 BC to 30 BC and Roman Egypt from 30 BC to around AD 400 (later Roman material in Egypt down to AD 641 usually being placed under Roman Period or Coptic). It is an imprecise term for material from Ptolemaic or Roman Egypt which has not yet been ascribed more accurately to one or the other. See also the terms 'Greek' and 'Roman'." ;
    skos:prefLabel "Graeco-Roman" ;
    time:intervalFinishedBy [ skos:prefLabel "around AD 400" ;
            time:hasDateTimeDescription [ time:year "0400"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "332 BC" ;
            time:hasDateTimeDescription [ time:year "-0331"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x13917> .

