    dcterms:spatial <http://www.wikidata.org/entity/Q189> ;
    skos:altLabel "Early Medieval"@en,
        "Epoca migratiilor"@ro ;
    skos:editorialNote "Visual timeline fades out before the 1000 tick on the timeline, indicating no clear start date. In the code for the interface, the start date is left blank, but in order to provide the date necessary for the PeriodO interface, we have included a range from AD 750 to AD 874 (that is, from remains dated to the about a century before the arrival of the Norwegian settlers, when both the Islendigabok and the Landnamabok suggest that some Gaelic monks had occupied the island, to the accepted date for Norwegian colonization; for potential archaeological evidence to support the first, see https://web.archive.org/web/20110608142510/http://www.icelandreview.com/icelandreview/daily_news/A_New_View_on_the_Origin_of_First_Settlers_in_Iceland_0_378670.news.aspx)." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0zj6g8> ;
