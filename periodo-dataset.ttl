<http://n2t.net/ark:/99152/p08m57h2bqm> a skos:Concept ;
    periodo:spatialCoverageDescription "Khurasan; Baghdad; Iraq" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q265>,
        <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q874>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52031> ;
    skos:altLabel "Tahirid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "821-875 (AH 205-AH 261). Governors of Khurasan, and in Baghdad and Iraq. The family receives its name from Tahir ibn al-Husain who was probably of Persian origin. He rose to favour under the caliph al-Ma'mun and after the fall of Baghdad became the governor that city and Jazira. He as then appointed Governor of the East. The Tahirid's had great wealth and estates in Baghdad and were renownd as patrons of Arabic culture." ;
    skos:prefLabel "Tahirid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "875 (AH 261)" ;
            time:hasDateTimeDescription [ time:year "0875"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "821 (AH 205)" ;
            time:hasDateTimeDescription [ time:year "0821"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x52031> .

