<http://n2t.net/ark:/99152/p08m57hdw58> a skos:Concept ;
    periodo:spatialCoverageDescription "Gloucestershire, Avon and western Oxfordshire, parts and parts of Herefordshire, Worcestershire, Warwickshire, Berkshire, Wiltshire and Somerset" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114767> ;
    skos:altLabel "Western British Iron Age"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 50 BC-AD 50. It refers to an area roughly equivalent to modern Gloucestershire, Avon and western Oxfordshire, parts and parts of Herefordshire, Worcestershire, Warwickshire, Berkshire, Wiltshire and Somerset. The various issuing authorities of this area seem to have relied on the same sources of technology and craftsmanship. The earliest coins were issued anonymously; later examples carry inscriptions that are assumed to be the names of local rulers. These include BODVOC, CORIO, COMVX, CATTI, ANTED and EISV. The ethnic or tribal identities of these issuers are unclear, but some may have belonged to the Dobunni who inhabited a similar area in the early Roman period. Other groups, however, may have existed in this area before AD 43." ;
    skos:prefLabel "Western British Iron Age" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 50" ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "50 BC" ;
            time:hasDateTimeDescription [ time:year "-0049"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114767> .

<http://n2t.net/ark:/99152/p08m57hdwjh> a skos:Concept ;
    periodo:spatialCoverageDescription "Altai region, Transoxiana" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x13947> ;
    skos:altLabel "Hephthalite"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Hephthalites, also known as the White Huns, were a group of Central Asian nomads who migrated from the Altai region to Transoxiana around AD 420-440, driving out the Kushans (q.v.). After defeat and being made tributary in turn by the Turks in 553 (q.v. 'Turkic'), some Hephthalites may have joined the Avars (q.v.) in their migration to the steppes and Central Europe." ;
    skos:prefLabel "Hephthalite" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 553" ;
            time:hasDateTimeDescription [ time:year "0553"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "around AD 420-440" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0420"^^xsd:gYear ;
                    periodo:latestYear "0440"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x13947> .

