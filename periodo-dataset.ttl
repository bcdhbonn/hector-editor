<http://n2t.net/ark:/99152/p02q72z37m3> a skos:Concept ;
    periodo:spatialCoverageDescription "Sicilien und Kampanien" ;
    dcelements:language "de" ;
    dcterms:language <http://lexvo.org/id/iso639-1/de> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/4829594> ;
            bibo:locator "144" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Zweiten Periode"@de,
        "Second Period"@en ;
    skos:editorialNote "Gerhard's dating is based on letter forms matched to the historical record and placed chronologically by Olympiad. See also citation of this source in Birch 1858 (p. 221)." ;
    skos:inScheme <http://n2t.net/ark:/99152/p02q72z> ;
    skos:note "Period label: \"Einer zweiten Periode, welche in jenen, hauptsächlich den Gefäfsen etruskischer Auffindung angehörigen Zeitraum.\" Spatial coverage: \"...fallen denn, ebenfalls aus paläographischen und zugleich aus artistischen Gründen, die meisten Vasen Siciliens und Kampaniens, hauptsächlich Nola's anheim\". Gerhard identifies a third period that follows this one; it is characterized by works from Apulia and Lucania, but is not given any absolute dates: \"dagegen eine dritte spätere Periode jener Vasenfabrikation den apulischen und lukanischen Vasen beizumessen ist.\" (1836, 144)." ;
    skos:prefLabel "Zweiten Periode" ;
    time:intervalFinishedBy [ skos:prefLabel "[Ol.] CXX" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0299"^^xsd:gYear ;
                    periodo:latestYear "-0295"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "Ol. XCIV" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0403"^^xsd:gYear ;
                    periodo:latestYear "-0399"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p02q72z6c67> a skos:Concept ;
    periodo:spatialCoverageDescription "Etrurien" ;
    dcelements:language "de" ;
    dcterms:language <http://lexvo.org/id/iso639-1/de> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/4829594> ;
            bibo:locator "143-44" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Vorgerückten Kunstsitte"@de,
        "Advanced Artistic Tradition"@en ;
    skos:editorialNote "See also Birch (1858, p. 221), who cites this page in Gerhard, though note that he attributes the starting point to Olymp. LXXXIV (444 BCE) in an apparent misreading of Gerhard's text." ;
    skos:inScheme <http://n2t.net/ark:/99152/p02q72z> ;
    skos:note "Period label: \"Vasen mit denen einer vorgerückten Kunstsitte\". Spatial coverage: \"von Volci aus alle umliegenden Gegenden Etruriens mit Thongefäfsen griechischer Kunst\". Dates based principally on the appearance of distinct Greek letter forms on some of the vases within the museum collection. From Gerhard 1836, 144: \"Fast alle dort gefundenen Vaseninschriften zeigen uns einen allgemeinen Gebrauch des simonideischen Alphabets, während sie mit wenigen Ausnahmen die euklideischen Doppelvokale verleugnen, wonach denn für die Mehrzahl jener Gefäfse der Zeitabschnitt von Olymp. LXXIV bis Olymp. XCIV begrenzend eintritt.\"" ;
    skos:prefLabel "Vorgerückten Kunstsitte" ;
    time:intervalFinishedBy [ skos:prefLabel "Olymp. XCIV" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0403"^^xsd:gYear ;
                    periodo:latestYear "-0399"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "Olymp. LXXIV" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0483"^^xsd:gYear ;
                    periodo:latestYear "-0479"^^xsd:gYear ] ] .

