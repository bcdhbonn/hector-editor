<http://n2t.net/ark:/99152/p08m57hcbrw> a skos:Concept ;
    periodo:spatialCoverageDescription "England" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x41145> ;
    skos:altLabel "Anglo-Viking"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Anglo-Viking is used in the context of numismatics only.  It is defined as the period from c. AD 875-954 in which there were settlements within England under the authority of Scandinavian rulers.  In this way, it applies to coins issued by Viking East Anglia (c. 880-910), Viking Northumbria (c. 895-954) and at unspecified sites within the Danelaw (c. 875-c. 930). It is not used with reference to Scandinavian imitations of Anglo-Saxon coins, or to coins of Cnut and his sons in the 11thC, since that period of Danish rule did not fundamentally affect the basic 'Anglo-Saxon' character of either culture or coinage." ;
    skos:prefLabel "Anglo-Viking" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 954" ;
            time:hasDateTimeDescription [ time:year "0954"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. AD 875" ;
            time:hasDateTimeDescription [ time:year "0875"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x41145> .

