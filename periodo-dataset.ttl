<http://n2t.net/ark:/99152/p08m57h96rf> a skos:Concept ;
    periodo:spatialCoverageDescription "Greek colonies established at Emporion and Rhode" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q29> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114178> ;
    skos:altLabel "Graeco-Iberian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term refers to the Greek colonies established at Emporion and Rhode in the 6thC BC which flourished until the Roman conquest of Spain in the late 3rdC BC-early 2ndC BC. It also refers to the indigenous cultures of Spain, or Iberians, contemporary to the aformentioned colonies. This includes the coinage minted by those settlements in the vicinity of Emporion and Rhode and also those minted by those colonies themselves." ;
    skos:prefLabel "Graeco-Iberian" ;
    time:intervalFinishedBy [ skos:prefLabel "early 2nd century BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0199"^^xsd:gYear ;
                    periodo:latestYear "-0166"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "6th century BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0599"^^xsd:gYear ;
                    periodo:latestYear "-0500"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114178> .

<http://n2t.net/ark:/99152/p08m57h97b5> a skos:Concept ;
    periodo:spatialCoverageDescription "Greece" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q41> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x14284> ;
    skos:altLabel "Mycenaean"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The term ‘Mycenaean' was originally used to describe Greek Bronze Age material of the period 1600BC-1060BC , following the discoveries made at the site of Mycenae by Heinrich Schliemann in the 19th century. Subsequently the term Helladic was introduced for material produced on mainland Greece during the Bronze Age, as a counterpart to Minoan and Cycladic. However, ‘Mycenaean’ continues to be used to describe Late Bronze Age Greek material culture, particularly that relating to the palatial era, when sites such as Mycenae flourished.  The term 'Mycenaean' is used in preference to ‘Late Helladic’. Where a specific 'Late Helladic' sub-division term (such as 'Late Helladic I') can be defined, particularly in the case of pottery, the specific sub-division term should be used instead of 'Mycenaean'." ;
    skos:prefLabel "Mycenaean" ;
    time:intervalFinishedBy [ skos:prefLabel "1060 BC" ;
            time:hasDateTimeDescription [ time:year "-1059"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1600 BC" ;
            time:hasDateTimeDescription [ time:year "-1599"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x14284> .

