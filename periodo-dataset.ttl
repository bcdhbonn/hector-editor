    dcterms:spatial <http://www.wikidata.org/entity/Q46> ;
    skos:altLabel "Century of Reformation"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0367jz> ;
    skos:note "\"The sixteenth is the Century of Reformation; the eighteenth is the Century of Enlightenment\" page 67." ;
    skos:prefLabel "Century of Reformation" ;
