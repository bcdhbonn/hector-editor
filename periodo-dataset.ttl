    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Roman"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p0b6j5m> ;
    skos:note "Start date provided by chersonesos.org, which notes that the city's close alliance with Romans starts in \"mid 60s\" of the 1st century CE." ;
    skos:prefLabel "Roman" ;
    time:intervalFinishedBy [ skos:prefLabel "329 CE" ;
            time:hasDateTimeDescription [ time:year "0329"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "60/70 CE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0060"^^xsd:gYear ;
                    periodo:latestYear "0070"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0nt759xcps> .

