<http://n2t.net/ark:/99152/p08m57hxhb7> a skos:Concept ;
    periodo:spatialCoverageDescription "Kabul to Punjab and Kashmir; Pakistan" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668>,
        <http://www.wikidata.org/entity/Q843>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x115757> ;
    skos:altLabel "Shahi"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Dynasty known as Turki Shahi, ruling from Kabul and established as far as Punjab and Kashmir, circa 750 - 850 AD. Became known as Hindu Shahi after they moved capital to Ohind on Indus river in the North-West Froniter (Pakistan) following the capture of Kabul by Arab general Ya'qub b. Layth in 871 AD. On coins they used the titles Spalapati Deva, Samanta Deva and Vakka Deva. Overthrown by Mahmud of Ghazna [q.v.] in a series of campaigns between 1018 and 1026." ;
    skos:prefLabel "Shahi" ;
    time:intervalFinishedBy [ skos:prefLabel "850 AD" ;
            time:hasDateTimeDescription [ time:year "0850"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "circa 750 AD" ;
            time:hasDateTimeDescription [ time:year "0750"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x115757> .

