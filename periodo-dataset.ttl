<http://n2t.net/ark:/99152/p0kh9ds2nxh> a skos:Concept ;
    periodo:spatialCoverageDescription "England" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q21> ;
    skos:altLabel "Phanerozoic"@en ;
    skos:editorialNote "Added to original vocabulary 2026-02-11" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0kh9ds> ;
    skos:note "The Phanerozoic is the current eon in the geologic time scale. It extends from approximately 542 million years ago until the present and is marked by the rapid expansion and evolution of life forms allowed by the development of plants carrying out photosynthesis, thus releasing oxygen into the atmosphere. It contains the Paleozoic, Mesozoic, and Cenozoic eras." ;
    skos:prefLabel "Phanerozoic" ;
    time:intervalFinishedBy [ skos:prefLabel "2026 CE" ;
            time:hasDateTimeDescription [ time:year "2026"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "542000000 BCE" ;
            time:hasDateTimeDescription [ time:year "-541999999"^^xsd:gYear ] ] ;
    foaf:page <http://purl.org/heritagedata/schemes/eh_period/concepts/GPHA> .

