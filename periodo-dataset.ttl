<http://n2t.net/ark:/99152/p0s84tq9w22> a skos:Concept ;
    periodo:spatialCoverageDescription "Noricum" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q183>,
        <http://www.wikidata.org/entity/Q215>,
        <http://www.wikidata.org/entity/Q38>,
        <http://www.wikidata.org/entity/Q40> ;
    skos:altLabel "Römische Antike (römisches Noricum)"@de,
        "Roman antiquity (Roman Noricum)"@en ;
    skos:editorialNote "The period subsumes from the overarching periods defined for Roman Noricum (\"Early Period,\" \"Imperial Period,\" and \"Late Antiquity\"; derived from Hagmann 2021, <http://n2t.net/ark:/99152/p0s84tq>). Furthermore, this overarching period takes into account the early pre-occupation activities in the area of the urban settlement at the Magdalensberg (\"Stadt auf dem Magdalensberg\", Carinthia/AUT), the beginning of which is put around 50 BC (cf., Gassner et al. 2002–2003, 70. 369). Finally, in addition to the absolute early period, the highly late period between 488 and 500 AD is also considered, in the context of which, according to \"classical\" doctrine and in view of the written tradition (vita Sancti Severini), 488 AD a settlement of the remaining Roman population (so-called \"Romanen\" in German-speaking research) should have already taken place and which represents a historically highly ambiguous period during the transition to the early Middle Ages (cf., Eichert - Richards 2022, <http://n2t.net/ark:/99152/p0cwwzn>)." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0s84tq> ;
    skos:prefLabel "Roman antiquity (Roman Noricum)" ;
    time:intervalFinishedBy [ skos:prefLabel "500 AD" ;
            time:hasDateTimeDescription [ time:year "0500"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "50 BC" ;
            time:hasDateTimeDescription [ time:year "-0049"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0cwwznw938>,
        <http://n2t.net/ark:/99152/p0ndpcqmz45>,
        <http://n2t.net/ark:/99152/p0ndpcqn83v>,
        <http://n2t.net/ark:/99152/p0s84tqhf4k>,
        <http://n2t.net/ark:/99152/p0s84tqkhhs>,
        <http://n2t.net/ark:/99152/p0s84tqvjs7> ;
    foaf:page <http://n2t.net/ark:/99152/p0s84tq> .

