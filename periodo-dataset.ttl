    dcterms:spatial <http://www.wikidata.org/entity/Q668>,
        <http://www.wikidata.org/entity/Q843> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113553> ;
    skos:altLabel "Dogra dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Local rulers of Kashmir under Sikh suzerainty (1819-46); then rulers of the Indian Princely State of Kashmir (1846-1979). From 1846 under the British, the following rulers issued anonymous coins dated in the Vikrama era: Gulab Singh 1846-1856 (VS 1903-1913); Ranbir Singh 1857-1885 (VS 1914-1942); Pertab Singh 1885-1925 (VS 1942-1979)." ;
