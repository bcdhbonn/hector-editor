<http://n2t.net/ark:/99152/p0mx5nbjmkh> a skos:Concept ;
    periodo:spatialCoverageDescription "Dura-Europos, Syria" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "pg. 167, 176" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q464266> ;
    skos:altLabel "Mithraeum I"@en ;
    skos:editorialNote "Mithraeum I = Early Mithraeum (EM) + Middle Mithraeum (MM) phases from the phasing proposed by the original excavators; Dirven and McCarty 2020 argue that the original excavators' Early Mithraeum (EM) phase was in error. This source updates the phasing proposed by the building's original excavators in Rostovtzeff, et al. 1939. As of its publication, it is considered the authoritative phasing for the Mithraeum. Note that this source, unlike Rostovtzeff, et al. 1939, decouples the phases of wall painting (Phase A, Phase B, Final Phase) from building construction phases (Mithraeum I, Mithraeum II)." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0mx5nb> ;
    skos:note "End of pre-mithraeum phase, start of Mithraeum I building phase determined by inscription YUAG accession # 1935.97, WD QID Q98270560; end of Mithraeum I and start of Mithraeum II building phase determined by the inscription referring to the rebuilding of a temple to mithras under Antonius Valentinus (CIMRM 1.53; AE 1940.220; PR VII + VIII no. 847, p. 85), found in the fill above the mithraeum (p. 167, 176)." ;
    skos:prefLabel "Mithraeum I" ;
    time:intervalFinishedBy [ skos:prefLabel "209-211" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0209"^^xsd:gYear ;
                    periodo:latestYear "0211"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "169 CE (or slightly earlier)" ;
            time:hasDateTimeDescription [ time:year "0169"^^xsd:gYear ] ] ;
    prov:wasDerivedFrom <http://n2t.net/ark:/99152/p0pkpgkvf9d> .

