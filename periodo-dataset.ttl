<http://n2t.net/ark:/99152/p08m57hs35q> a skos:Concept ;
    periodo:spatialCoverageDescription "Iran; southern Iraq; much of Syria" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q858> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x14390> ;
    skos:altLabel "Parthian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "At the height of its power, the Parthian state extended far beyond the modern political borders of Iran. It was ruled by the Arsacid dynasty and its first great ruler Mithradates I defeated his Seleucid overlords in a series of campaigns in the second century BC. Their earliest capital was at Mithradatkirt (modern Nysa) in Turkmenistan but they later established their capital at Ctesiphon in what is now southern Iraq and opposite the previous Seleucid capital of Seleucia on the Tigris. Parthia fought a number of wars with the Romans and at one period held much of Syria. The end of the period is marked by the defeat of the Parthian king Artabanus IV  in AD 224 by an Iranian noble called Ardashir who went on to establish the Sasanian empire." ;
    skos:prefLabel "Parthian" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 224" ;
            time:hasDateTimeDescription [ time:year "0224"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "second century BC" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0199"^^xsd:gYear ;
                    periodo:latestYear "-0100"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x14390> .

