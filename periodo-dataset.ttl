<http://n2t.net/ark:/99152/p08m57h9nf5> a skos:Concept ;
    periodo:spatialCoverageDescription "eastern Mediterranean" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q229>,
        <http://www.wikidata.org/entity/Q41>,
        <http://www.wikidata.org/entity/Q43> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x13731> ;
    skos:altLabel "Byzantine"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The term refers to the successor state to the Roman empire in the eastern Mediterranean, from the foundation  of Constantinople by Constantine the Great in AD 330 until its fall to the Ottoman Turks in AD 1453. The Byzantine period is often divided into three phases: the early Byzantine period from the early 4thC to the 7thC (see also the term Late Antique) which saw the losses of the key provinces of Syria and Egypt to the Arabs; the Middle Byzantine period from the 8thC to the early 13thC covering Iconoclasm and ending with the sack of Constantinople by the Fourth Crusade in 1204; the Late Byzantine period from the early 13thC to the mid-15thC, a period of geographical and political decline, but also of a flowering of the arts under the Palaeologan dynasty.  See also the terms Late Roman and Medieval and its Narrow Terms." ;
    skos:prefLabel "Byzantine" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 1453" ;
            time:hasDateTimeDescription [ time:year "1453"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "AD 330" ;
            time:hasDateTimeDescription [ time:year "0330"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x13731> .

<http://n2t.net/ark:/99152/p08m57h9nj2> a skos:Concept ;
    periodo:spatialCoverageDescription "Mosul; Ayyubid territory in the Jazira" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q858> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113047> ;
    skos:altLabel "Luluid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1234-1262 (AH 631-AH 660). Probably of Armenian origin. Badr al-Din Lulu was recognised by the Abbasid caliph as the ruler of the city of Mosul in 1234 (AH 631). He extended his authority into Ayyubid territory in the Jazira. His son's brief rule came to an end with the invasion of the region under Il-Khanid ruler Hulegu in 1260 (AH 658). Lu'lu's sons fled to the Mamluks in Egypt." ;
    skos:prefLabel "Luluid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1262 (AH 660)" ;
            time:hasDateTimeDescription [ time:year "1262"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1234 (AH 631)" ;
            time:hasDateTimeDescription [ time:year "1234"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113047> .

<http://n2t.net/ark:/99152/p08m57h9pd4> a skos:Concept ;
    periodo:spatialCoverageDescription "modern Dorset, parts of Somerset, Wiltshire, Hampshire and the Isle of Wight" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x114768> ;
    skos:altLabel "South Western British Iron Age"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "This term is restricted to Iron Age numismatics, and applies to coins produced between 80 BC-AD 50. It refers to an area roughly equivalent to modern Dorset, parts of Somerset, Wiltshire, Hampshire and the Isle of Wight, in which similar styled coins are found. The various issuing authorities of this area seem to have relied on the same sources of technology and craftsmanship. The ethnic or tribal identities of the issuers of South Western coinage - which is entirely uninscribed - are unknown, but they are often associated with the Durotriges, who are known to have inhabited this region during the early Roman period." ;
    skos:prefLabel "South Western British Iron Age" ;
    time:intervalFinishedBy [ skos:prefLabel "AD 50" ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "80 BC" ;
            time:hasDateTimeDescription [ time:year "-0079"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x114768> .

