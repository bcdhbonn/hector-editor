<http://n2t.net/ark:/99152/p0mrv3sn822> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "it" ;
    dcterms:language <http://lexvo.org/id/iso639-1/it> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/600657650> ;
            bibo:locator "page 97" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Periodo osco"@it,
        "Periodo presannitico"@it ;
    skos:editorialNote """"Periodo osco" translates to "Oscan Period," and "Periodo Presannitico" translates to "Pre-Samnite Period." This period refers to the chronology of fortifications at Pompeii. 
Translations of source notes: "From these explorations conducted in the different sectors of the walls, the type and development of the Pompeian fortification can be briefly summarized in the following chronological exposition." (page 97)
"This first period of the Pompeian fortification ended with the conquest of the city by the Samnites." (page 97)""" ;
    skos:inScheme <http://n2t.net/ark:/99152/p0mrv3s> ;
    skos:note """"Da queste esplorazioni condotte nei diversi settori delle mura, il tipo e lo sviluppo della fortificazione pompeiana può essere brevemente riassunto nella seguente esposizione cronologica" (page 97)
"Questo primo periodo della fortificazione pompeiana si chiude con l'espugnazione della città da parte dei Sanniti." (page 97)""" ;
    skos:prefLabel "Periodo osco" ;
    time:intervalFinishedBy [ skos:prefLabel "420 a.C." ;
            time:hasDateTimeDescription [ time:year "-0419"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "474 a.C." ;
            time:hasDateTimeDescription [ time:year "-0473"^^xsd:gYear ] ] .

