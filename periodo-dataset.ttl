<http://n2t.net/ark:/99152/p0b6j5mh78j> a skos:Concept ;
    periodo:spatialCoverageDescription "Tauric Chersonesos" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "Dark Ages"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0b6j5mmfbc> ;
    skos:inScheme <http://n2t.net/ark:/99152/p0b6j5m> ;
    skos:note "This period is only obliquely referenced in the Metropolitan Museum Heilbrunn Timeline as \"the Iconoclastic controversy\", which occupies the \"700s and early 800s\". Wikipedia has a more precise definition for the period of Iconoclasm (https://en.wikipedia.org/wiki/Byzantine_Iconoclasm), and divides it into two periods: 730-787 CE and 814-843. The history of the site provided at chersonesos.org notes that Chersonesos was made a thematic capital in 841 CE, so this may be a more natural end date for its \"Dark Ages\" (a term now deprecated)." ;
    skos:prefLabel "Iconoclasm" ;
    time:intervalFinishedBy [ skos:prefLabel "841/843 CE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0841"^^xsd:gYear ;
                    periodo:latestYear "0843"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "700 CE" ;
            time:hasDateTimeDescription [ time:year "0700"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0b6j5mh84m> a skos:Concept ;
