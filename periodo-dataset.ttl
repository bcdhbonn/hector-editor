<http://n2t.net/ark:/99152/p08m57hzvfw> a skos:Concept ;
    periodo:spatialCoverageDescription "Morocco; Spain" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q1028>,
        <http://www.wikidata.org/entity/Q29> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x52004> ;
    skos:altLabel "Almoravid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1056-1147; Morocco; Spain. Originating in religious movement among Berber nomads. Almoravid is the Spanish form of 'murabitun', meaning those dwelling in a hermitage or frontier fortress. This term was used for these warriors who wore veils over their faces against the sand and wind hence they were also known as 'al-mutalaththimun' meaning the veiled ones. The Almoravid recognised the Abbasid Caliphs as spiritual heads of Islam." ;
    skos:prefLabel "Almoravid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1147" ;
            time:hasDateTimeDescription [ time:year "1147"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1056" ;
            time:hasDateTimeDescription [ time:year "1056"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x52004> .

