<http://n2t.net/ark:/99152/p0mrr9cn2rq> a skos:Concept ;
    periodo:spatialCoverageDescription "Land of Israel, Diaspora (especially Egypt)" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q219060>,
        <http://www.wikidata.org/entity/Q39760>,
        <http://www.wikidata.org/entity/Q79>,
        <http://www.wikidata.org/entity/Q801> ;
    skos:altLabel "Second Temple Judaism"@en ;
    skos:editorialNote "Spatial coverage extent inferred conservatively from reference to \"the Land of Israel\" and \"the Diaspora (especially Egypt)\"; true extent of \"the Diaspora\" probably greater." ;
    skos:inScheme <http://n2t.net/ark:/99152/p0mrr9c> ;
    skos:note """““Second Temple Judaism” is a common designation for the Jewish traditions that flourished between the return of exiles from Babylon and the rebuilding of the Jerusalem Temple under Persian patronage from 538 to 515 BCE, and the destruction of the Temple by Roman forces in 70 CE. In practice, research on the period often focuses on the 4th century BCE and following, and stretches into the 2nd century CE” (Introduction).

“Evidence for Second Temple Judaism includes Jewish literature in Hebrew, Aramaic, and Greek, as well as material and documentary data from the Land of Israel and the Diaspora (especially Egypt)” (Primary Sources in Translation).
""" ;
    skos:prefLabel "Second Temple Judaism" ;
    time:intervalFinishedBy [ skos:prefLabel "70 CE, into the 2nd century CE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0070"^^xsd:gYear ;
                    periodo:latestYear "0199"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "538 to 515 BCE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0537"^^xsd:gYear ;
                    periodo:latestYear "-0514"^^xsd:gYear ] ] ;
    foaf:page <https://www.oxfordbibliographies.com/view/document/obo-9780195393361/obo-9780195393361-0087.xml> .

<http://n2t.net/ark:/99152/p0mrv3s24cv> a skos:Concept ;
