<http://n2t.net/ark:/99152/p046hphpgdz> a skos:Concept ;
    periodo:spatialCoverageDescription "Gulf of Chiriquí, Panama" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q804> ;
    skos:altLabel "Burica Phase"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p046hph> ;
    skos:note "“No radiocarbon dates are available as yet to establish the beginnings of the Burica Phase. I have nevertheless placed them at A.D. 300-500. This estimate is based on the presence of Coclé sherds, probably Early Coclé, and a possible Venado Beach sherd in levels of this phase… The terminal date of A.D. 800 for our Burica Phase is tentatively based on the radiocarbon date for the next phase.” (p. 86)" ;
    skos:prefLabel "Burica Phase" ;
    time:intervalFinishedBy [ skos:prefLabel "A.D. 800" ;
            time:hasDateTimeDescription [ time:year "0800"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "A.D. 300-500" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0300"^^xsd:gYear ;
                    periodo:latestYear "0500"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p046hphr2qz> a skos:Concept ;
    periodo:spatialCoverageDescription "Gulf of Chiriquí, Panama" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q804> ;
    skos:altLabel "Chiriquí Phase"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p046hph> ;
    skos:note "“The beginnings of our Chiriquí Phase should be placed in the Gulf at around A.D. 1100… A terminal date for the Chiriquí Phase should be placed at the time of the Conquest (A.D. 1500) or slightly later.” (p. 86)" ;
    skos:prefLabel "Chiriquí Phase" ;
    time:intervalFinishedBy [ skos:prefLabel "A.D. 1500 or slightly later" ;
