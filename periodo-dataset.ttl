<http://n2t.net/ark:/99152/p08m57hdjgb> a skos:Concept ;
    periodo:spatialCoverageDescription "Egypt, Palestine, Syria" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x25123> ;
    skos:altLabel "Tulunid dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "868-905 (AH 254-AH 292). First local dynasty of Egypt and Syria with some degree of autonomy from the Abbasid caliphate in Baghdad. Ahmad ibn Tulun was a Turkish soldier whose father had been sent as tribute fron Bukhara in the early 9th century. He first came to Egypt as deputy of the 'Abbasid governor there but then became governor himself and extended his power into Palestine and Syria. The age of the Tulunids was a golden age for Medieval Egyptian historians." ;
    skos:prefLabel "Tulunid dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "905 (AH 292)" ;
            time:hasDateTimeDescription [ time:year "0905"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "868 (AH 254)" ;
            time:hasDateTimeDescription [ time:year "0868"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x25123> .

