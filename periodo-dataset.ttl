<http://n2t.net/ark:/99152/p0s2rwkvbjp> a skos:Concept ;
    periodo:spatialCoverageDescription "Levant" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q81483> ;
    skos:altLabel "Masraqan"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0s2rwks8k2> ;
    skos:inScheme <http://n2t.net/ark:/99152/p0s2rwk> ;
    skos:note """Assemblages with finely retouched, elongated bladelets. Blanks narrow, slightly curved, not twisted. Elongated, narrow, single plat cores with intensive prep. Simple end scrapers, burins present. Microburin tech not used. Ambiguous use of backing rare. Summary: Non-geometric microliths, small, partially retouched bladelets, Larger blade tools blades, simple end scrapers, Mostly lat retouch, backing not habitual, No microburin tech, First ground stone tools, rare shell beads, bone tools.

The Masraqan is a term for sites also labeled late Ahmarian, late Upper Paleolithic, Terminal Upper Paleolithic, Proto-Kebaran and even Kebaran. The sites range from the Sinai and Negev, to Jordan and further north to Lebanon.""" ;
    skos:prefLabel "Masraqan" ;
    time:intervalFinishedBy [ skos:prefLabel "20000 BP2000" ;
            time:hasDateTimeDescription [ time:year "-18000"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "24000 BP2000" ;
            time:hasDateTimeDescription [ time:year "-22000"^^xsd:gYear ] ] .

