<http://n2t.net/ark:/99152/p08m57hcmzr> a skos:Concept ;
    periodo:spatialCoverageDescription "Cyclades" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q41> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x13799> ;
    skos:altLabel "Early Cycladic"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Early Cycladic period (3200BC – 2000BC) refers to material produced in the Cyclades during the Aegean Early Bronze Age. Although it is part of the tripartite scheme (Early, Middle and Late) into which the Aegean Bronze Age is conventionally divided, it is difficult to apply the same subdivisions (I,II,III) as for Early Minoan or Early Helladic. For this reason it is divided into partly overlapping cultural groups, initially defined by Colin Renfrew. The three main groups used to subdivide the period are Grotta-Pelos (q.v.), Keros-Syros (q.v.) and Phylakopi I (q.v.)." ;
    skos:prefLabel "Early Cycladic" ;
    time:intervalFinishedBy [ skos:prefLabel "2000 BC" ;
            time:hasDateTimeDescription [ time:year "-1999"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "3200 BC" ;
            time:hasDateTimeDescription [ time:year "-3199"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x13799> .

