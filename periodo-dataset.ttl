<http://n2t.net/ark:/99152/p08m57hdh7z> a skos:Concept ;
    periodo:spatialCoverageDescription "Mongolia; China; 'Abbasid empire; south Russian steppes; central Europe" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q148>,
        <http://www.wikidata.org/entity/Q159>,
