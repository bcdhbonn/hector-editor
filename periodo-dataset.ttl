<http://n2t.net/ark:/99152/p08m57hmkfm> a skos:Concept ;
    periodo:spatialCoverageDescription "Cyclades" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q41> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x14148> ;
    skos:altLabel "Late Cycladic"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Late Cycladic period (1600BC – 1060BC) refers to material produced in the Cyclades during the Aegean Late Bronze Age. As with the Late Minoan and Late Helladic periods, it is further divided into I, II and III." ;
    skos:prefLabel "Late Cycladic" ;
    time:intervalFinishedBy [ skos:prefLabel "1060 BC" ;
            time:hasDateTimeDescription [ time:year "-1059"^^xsd:gYear ] ] ;
