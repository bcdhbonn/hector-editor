<http://n2t.net/ark:/99152/p08m57h9qtw> a skos:Concept ;
    periodo:spatialCoverageDescription "Khurasan and Transoxania" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q794> ;
