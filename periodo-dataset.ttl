<http://n2t.net/ark:/99152/p0b6j5m3c4q> a skos:Concept ;
    periodo:spatialCoverageDescription "Tauric Chersonesos" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    skos:altLabel "12th to mid-13th century"@en ;
    skos:broader <http://n2t.net/ark:/99152/p0b6j5mmfbc> ;
    skos:inScheme <http://n2t.net/ark:/99152/p0b6j5m> ;
    skos:note "Period term used to describe stratigraphic deposits and objects that date broadly to the last two phases of activity in the South Region of Chersonesos, but that cannot be dated specifically to the final phase. This includes objects that were found in the destruction layers but may have been created decades beforehand. The stop year range is a terminus ante quem defined by the earliest date at which we think the destruction of the South Region might have taken place and the latest reasonable date that matches our evidence for the near-total destruction of the city in the 13th century (the material suggests that a date previously proposed to match historical records of an incursion by Nogay Khan in 1299 is too late). " ;
    skos:prefLabel "12th to mid-13th century" ;
    time:intervalFinishedBy [ skos:prefLabel "1220 to 1278 CE" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1220"^^xsd:gYear ;
                    periodo:latestYear "1278"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1100 CE" ;
            time:hasDateTimeDescription [ time:year "1100"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p0b6j5m3t44> a skos:Concept ;
    periodo:spatialCoverageDescription "World" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
