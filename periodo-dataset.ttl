<http://n2t.net/ark:/99152/p08m57hp2vq> a skos:Concept ;
    periodo:spatialCoverageDescription "large parts of Karnataka" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
