<http://n2t.net/ark:/99152/p08m57h9k85> a skos:Concept ;
    periodo:spatialCoverageDescription "hills of Nepal, north-west of Kathmandu" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q837> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113555> ;
    skos:altLabel "Gurkha dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Kingdom in the hills of Nepal, north-west of Kathmandu, which first minted coins in AD 1749 under the ruler Prithvi Narayan Shah (1742-1775). He conquered the Kathmandu valley in 1768, moved his capital to Kathmandu and established the Shah dynasty. He attacked Sikkim in 1789, then Tibet in 1790. Further territorial expansion southwards brought the kingdom into conflict with the British. Following the treaty of Sagauli in 1815, a British Resident was installed in Kathmandu. Men from this region are still recruited into the elite Gorkha regiment of the British army." ;
    skos:prefLabel "Gurkha dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1815" ;
            time:hasDateTimeDescription [ time:year "1815"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "AD 1749" ;
            time:hasDateTimeDescription [ time:year "1749"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113555> .

