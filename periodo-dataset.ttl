<http://n2t.net/ark:/99152/p08vvjkdcnx> a skos:Concept ;
    periodo:spatialCoverageDescription "Constantinople, Greece, Empire of Trebizond" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q41>,
        <http://www.wikidata.org/entity/Q43> ;
    skos:altLabel "Late Byzantium"@en ;
    skos:broader <http://n2t.net/ark:/99152/p08vvjk5t32> ;
    skos:inScheme <http://n2t.net/ark:/99152/p08vvjk> ;
    skos:note "\"The focus of Byzantine power was now centered in Constantinople, and extended westward to northern and central Greece, and south into the Peloponnesos. In the east, the Byzantine Empire of Trebizond, which had flourished during the Latin Occupation, continued to exist as an independently ruled Byzantine territory in competition with the Palaiologan-ruled empire with its capital at Constantinople. The last Byzantine lands would be conquered by the Ottoman Turks in the mid-fifteenth century, with Constantinople taken in 1453, and Mistra and Trebizond in 1460.\"" ;
    skos:prefLabel "Late Byzantium" ;
    time:intervalFinishedBy [ skos:prefLabel "1453/1460" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1453"^^xsd:gYear ;
                    periodo:latestYear "1460"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1261" ;
            time:hasDateTimeDescription [ time:year "1261"^^xsd:gYear ] ] ;
    foaf:page <https://www.metmuseum.org/toah/hd/byza/hd_byza.htm> .

