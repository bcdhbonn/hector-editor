<http://n2t.net/ark:/99152/p08m57hr5kk> a skos:Concept ;
    periodo:spatialCoverageDescription "Afghanistan north of the Hindu Kush, Central Asian Amu Darya region of Uzbekistan and Tajikistan" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q265>,
        <http://www.wikidata.org/entity/Q863>,
        <http://www.wikidata.org/entity/Q874>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x56682> ;
    skos:altLabel "Greco-Bactrian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The term refers to a Greek kingdom (c. 250-145 BC) in Bactria (Afghanistan north of the Hindu Kush) and Sogdiana (the Central Asian Amu Darya region of Uzbekistan and Tajikistan). The region was originally part of the Seleucid empire, but the Bactrian governor Diodotus gained independence in c. 250 BC. Sogdiana broke away in turn from Bactria c. 200 BC; the rest of the region was lost to nomadic tribes of the Indo-Scythians and Yuezhi by c. 145 BC." ;
    skos:prefLabel "Greco-Bactrian" ;
    time:intervalFinishedBy [ skos:prefLabel "145 BC" ;
            time:hasDateTimeDescription [ time:year "-0144"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 250 BC" ;
            time:hasDateTimeDescription [ time:year "-0249"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x56682> .

