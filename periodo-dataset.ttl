<http://n2t.net/ark:/99152/p05hrsfsvkj> a skos:Concept ;
    periodo:spatialCoverageDescription "China" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ bibo:locator "Row labeled \"China\"" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q148> ;
    skos:altLabel "Chinese"@en ;
    skos:editorialNote "The extent of this section of the timeline suggests that Priestley is referring to the entire extent of China -- north, south, and Leautong." ;
    skos:inScheme <http://n2t.net/ark:/99152/p05hrsf> ;
    skos:note "From \"A description of a new chart of History\", 6th ed., 1786, s.v. \"China\", p. 85: \"In 1356 Chu, a Chinese, recovered Nanking from the Tartars, and in 1368 he put an end to the authority of the Mungls, whose dynasty is called Iwen by the Chinese. In 1643 the Manchew Tartars invaded China, and completed the conquest in 1645.\"" ;
    skos:prefLabel "Chinese" ;
    time:intervalFinishedBy [ skos:prefLabel "1643 to 1645" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1643"^^xsd:gYear ;
                    periodo:latestYear "1645"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1356 to 1368" ;
            time:hasDateTimeDescription [ periodo:earliestYear "1356"^^xsd:gYear ;
