<http://n2t.net/ark:/99152/p08m57ht5pw> a skos:Concept ;
    periodo:spatialCoverageDescription "Diyar Bakr (center) to Khurasan, Iraq and the Persian Gulf" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q43>,
        <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q796>,
        <http://www.wikidata.org/entity/Q858> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x116004> ;
    skos:altLabel "Aq Qoyunlu"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The Aq Qoyunlu '[those with] white sheep' were a nomadic Turkmen confederation centred on Diyar Bakr 1378-1508 (AH 780-908), who established power through marital alliances with the Byzantines in the later 14th century. They submitted to Timur (q.v.) and were rewarded with the grant of Diyar Bakr. Under Uzun Hasan (1457-1478), they extended their rule as far as Khurasan, Iraq and the Persian Gulf, but were overthrown by the Ottomans (q.v.) and Safavids (q.v.)." ;
    skos:prefLabel "Aq Qoyunlu" ;
    time:intervalFinishedBy [ skos:prefLabel "1508 (AH 908)" ;
            time:hasDateTimeDescription [ time:year "1508"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1378 (AH 780)" ;
            time:hasDateTimeDescription [ time:year "1378"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x116004> .

