    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "The fourth period"@en ;
    skos:editorialNote "This period refers to one of the six architectural periods into which Mau divides Pompeii's history. It corresponds to the Architectural Style of wall decoration. The end date for this period is derived from the editor's interpretation of \"near the end of the Republic\" as 27 B.C.E." ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note "\"The fourth period covers the earlier decades of the Roman colony, from 80 B.C. to near the end of the Republic.\" (page 41)" ;
    skos:prefLabel "The fourth period" ;
    time:intervalFinishedBy [ skos:prefLabel "near the end of the Republic" ;
            time:hasDateTimeDescription [ time:year "-0026"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "80 B.C." ;
            time:hasDateTimeDescription [ time:year "-0079"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfz36p> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
