<http://n2t.net/ark:/99152/p03xjrf63k3> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 43-44" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Intricate Style"@en,
        "the fourth style"@en ;
    skos:editorialNote "This period is one of four decorative styles, referring to wall paintings rather than architecture. It corresponds to the fifth and sixth architectural periods. The end date is derived from the editor's parsing of \"the destruction of the city\" as 79 C.E. (page 44) " ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note "\"The fourth or Intricate Style came in about the year 50 A.D.\" (page 43)" ;
    skos:prefLabel "Intricate Style" ;
    time:intervalFinishedBy [ skos:prefLabel "the destruction of the city " ;
            time:hasDateTimeDescription [ time:year "0079"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "about the year 50 A.D." ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrf7pkp> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 42" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Architectural Style"@en,
        "second Pompeian style"@en ;
    skos:editorialNote "This period is one of four decorative styles, referring to wall painting rather than architecture. The end date is derived from the end date of the coinciding fourth architectural style and the editor's parsing of \"to the time of Augustus\" as 27 B.C.E." ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note """"The wall decoration of the fourth period is of the second Pompeian style, which came into vogue just after the founding of the colony, and which we shall call the Architectural Style." (page 42)

"The Architectural Style, already mentioned, remained in vogue to the time of Augustus." (page 43)""" ;
    skos:prefLabel "Architectural Style" ;
    time:intervalFinishedBy [ skos:prefLabel "to the time of Augustus" ;
            time:hasDateTimeDescription [ time:year "-0026"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "80 B.C." ;
            time:hasDateTimeDescription [ time:year "-0079"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrf8ccs> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 43" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "Ornate Style"@en,
        "third style"@en ;
    skos:editorialNote "This period is one of four decorative styles, referring to wall painting rather than architecture. It mainly falls within the fifth architectural period. Its start date is derived from the editor's parsing of the \"time of Augustus\" noted as the end of the preceding second style as 27 B.C.E. The end date is derived from the start date of the subsequent fourth decorative period (page 43). " ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note "\"The Architectural Style, already mentioned, remained in vogue to the time of Augustus; it then gave place to the third or Ornate Style.\" (page 43)" ;
    skos:prefLabel "Ornate Style" ;
    time:intervalFinishedBy [ skos:prefLabel "50 A.D." ;
            time:hasDateTimeDescription [ time:year "0050"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "the time of Augustus" ;
            time:hasDateTimeDescription [ time:year "-0026"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfcw9r> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 42" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "The fifth period"@en ;
    skos:editorialNote "This period is architectural rather than decorative. It overlaps with the fourth architectural period and corresponds to Architectural Style, the Ornate Style, and the Intricate Style of wall decoration. The start date is derived from the editor's parsing of \"the last decades of the Republic\" as 47 B.C.E. to 27 B.C.E. " ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:prefLabel "The fifth period" ;
    time:intervalFinishedBy [ skos:prefLabel "63 A.D." ;
            time:hasDateTimeDescription [ time:year "0063"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "the last decades of the Republic" ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0046"^^xsd:gYear ;
                    periodo:latestYear "-0026"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfd793> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 40" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "The third period"@en,
        "Tufa Period"@en ;
    skos:editorialNote "This period is one of the six architectural periods into which Mau divides Pompeian history. It corresponds with the Incrustation Style of wall decorating. It is preceded by a second architectural period, the Period of the Limestone Atriums, for which the start date \"cannot be determined even approximately,\" but the end date \"is fixed by the earlier limit of the next period.\" (page 40)" ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note "\"Certain Oscan inscriptions, an early Latin monumental inscription, and a few words, dating from 78 B.C., scratched upon the plaster of the Basilica, oblige us to place the Tufa Period before the time of the Roman colony; yet not long before, for the next oldest buildings date from the first years of the colony. The time of peace that furnished the background for the period can only have been that between the Second Punic War and the Social War, about 200 to 90 B.C.; the Tufa Period was approximately the second century before Christ.\" (page 40)" ;
    skos:prefLabel "The third period" ;
    time:intervalFinishedBy [ skos:prefLabel "90 B.C." ;
            time:hasDateTimeDescription [ time:year "-0089"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "200 B.C." ;
            time:hasDateTimeDescription [ time:year "-0199"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfg8cc> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 39" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "The first period"@en ;
    skos:editorialNote "This period is architectural; it refers to one of the six architectural periods into which Mau divides Pompeii's history. It is succeeded by a second architectural period, the Period of the Limestone Atriums, for which the start date \"cannot be determined even approximately,\" but the end date \"is fixed by the earlier limit of the next period.\" (page 40)" ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:prefLabel "The first period" ;
    time:intervalFinishedBy [ skos:prefLabel "sixth century B.C." ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0599"^^xsd:gYear ;
                    periodo:latestYear "-0500"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "sixth century B.C." ;
            time:hasDateTimeDescription [ periodo:earliestYear "-0599"^^xsd:gYear ;
                    periodo:latestYear "-0500"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfrq35> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
            bibo:locator "page 44" ] ;
    dcterms:spatial <http://www.wikidata.org/entity/Q38> ;
    skos:altLabel "The sixth period"@en ;
    skos:editorialNote "This period is architectural rather than decorative and falls within the period of the Intricate Style. The end date is derived from the editor's parsing of \"the destruction of the city\" as 79 C.E. (page 44)" ;
    skos:inScheme <http://n2t.net/ark:/99152/p03xjrf> ;
    skos:note "\"The sixteen years between the earthquake of 63 A.D. and the destruction of the city form the sixth period in the architectural history of Pompeii.\" (page 44) " ;
    skos:prefLabel "The sixth period" ;
    time:intervalFinishedBy [ skos:prefLabel "the destruction of the city " ;
            time:hasDateTimeDescription [ time:year "0079"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "63 A.D." ;
            time:hasDateTimeDescription [ time:year "0063"^^xsd:gYear ] ] .

<http://n2t.net/ark:/99152/p03xjrfz228> a skos:Concept ;
    periodo:spatialCoverageDescription "Pompeii" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:source [ dcterms:isPartOf <http://www.worldcat.org/oclc/427529380> ;
