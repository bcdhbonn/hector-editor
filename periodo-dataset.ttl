<http://n2t.net/ark:/99152/p08m57hx528> a skos:Concept ;
    periodo:spatialCoverageDescription "western part of the Bahmanid Sultanate at Bijapur" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113459> ;
    skos:altLabel "Adil Shahi dynasty"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "1490-1686 (AH 895-AH 1097). Dynasty ruling in the western part of the Bahmanid Sultanate at Bijapur. The founder of the dynasty was Yusuf Khan, previously a commander and provisional governor for the Bahmanids. He proclaimed his independence in 1489 (AH 895).  The capital Bijapur became a centre for learning and the arts, where Persian literature became part of the Persianisation process in the region. Bijapur was captured by the Mogul emperor Aurangzib Alamgir in 1686 (AH 1097)." ;
    skos:prefLabel "Adil Shahi dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1686 (AH 1097)" ;
            time:hasDateTimeDescription [ time:year "1686"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "1490 (AH 895)" ;
            time:hasDateTimeDescription [ time:year "1490"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113459> .

