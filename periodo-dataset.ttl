<http://n2t.net/ark:/99152/p08m57h2wzt> a skos:Concept ;
    periodo:spatialCoverageDescription "Sambhar, Amber district, Rajasthan" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113543> ;
    skos:altLabel "Chauhan dynasty"@en ;
    skos:editorialNote "Jaipur district" ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Chauhan dynasty (fl. 8th-12th century) was first established at Sambhar, the salt lake area in the Amber (later Jaipur) district, Rajasthan. In the early 11th century Ajayaraja (q.v.) founded the city of Ajayameru (Ajmer), and in the mid twelfth century, his successor Vigraharaja (q.v.) captured Delhi from the Tomaras (q.v.) and annexed territory along the Yamuna River. In 12th century the Chauhans dominated Delhi, Ajmer and Ranthambhor. The last king, Prithviraja III (q.v.), resisted Muslim attack at Tarain in 1191, but was defeated by Muhammad ibn Sam (q.v.) in a second battle at Tarain in 1192." ;
    skos:prefLabel "Chauhan dynasty" ;
    time:intervalFinishedBy [ skos:prefLabel "1192" ;
            time:hasDateTimeDescription [ time:year "1192"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "8th century" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0701"^^xsd:gYear ;
                    periodo:latestYear "0800"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113543> .

