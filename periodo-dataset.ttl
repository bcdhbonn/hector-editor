            time:hasDateTimeDescription [ time:year "1000"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "987" ;
            time:hasDateTimeDescription [ time:year "0987"^^xsd:gYear ] ] .

