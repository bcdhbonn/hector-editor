<http://n2t.net/ark:/99152/p08m57hspv3> a skos:Concept ;
    periodo:spatialCoverageDescription "north-west Pakistan to south-east Iran" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q794>,
        <http://www.wikidata.org/entity/Q843>,
        <http://www.wikidata.org/entity/Q889> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x113048> ;
    skos:altLabel "Indo-Parthian"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "The term refers to a culture from c. 1stC to 3rdC AD. Knowledge of the so-called Indo-Parthians derives largely from coins and a few inscriptions. Some of the names and coin designs suggest links with the Parthians of Iran, but the precise relationship is not clear. In the first century AD the Indo-Parthians seem to have gained control of the region stretching from the Punjab, Sind and Gandhara (north-west Pakistan) to Seistan (south-east Iran). The principal ruler is Gondophares (c. AD 32–60). The title ‘Gondophares’ (Old Persian Vindapharna ‘Winner of Glory’) was adopted by his successors in addition to their given names on coins from Arachosia (Qandahar) and the Punjab. However, in Sind and Seistan they also issued coins in their own right as ‘king’ or ‘king of kings’. This suggests a complex situation of rulers and sub-rulers who owed varying degrees of allegiance to the Indo-Parthian king." ;
    skos:prefLabel "Indo-Parthian" ;
    time:intervalFinishedBy [ skos:prefLabel "3rd century AD" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0201"^^xsd:gYear ;
                    periodo:latestYear "0300"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "c. 1st century AD" ;
            time:hasDateTimeDescription [ periodo:earliestYear "0001"^^xsd:gYear ;
                    periodo:latestYear "0100"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x113048> .

