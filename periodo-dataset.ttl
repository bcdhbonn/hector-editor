<http://n2t.net/ark:/99152/p08m57h54j8> a skos:Concept ;
    periodo:spatialCoverageDescription "Pakistan and western India" ;
    dcelements:language "en" ;
    dcterms:language <http://lexvo.org/id/iso639-1/en> ;
    dcterms:spatial <http://www.wikidata.org/entity/Q668>,
        <http://www.wikidata.org/entity/Q843> ;
    owl:sameAs <http://collection.britishmuseum.org/id/thesauri/x46239> ;
    skos:altLabel "Indus Civilisation"@en ;
    skos:inScheme <http://n2t.net/ark:/99152/p08m57h> ;
    skos:note "Urban civilisation based in the northwestern part of the Indian subcontinent, today in Pakistan and western India.  Developing out of earlier prehistoric cultures, it flourished over a very wide area between approximately 2,500 and 2,000 BC.  Script was known but is undeciphered today, not least as surviving inscriptions (mostly on seals) are no more than about a dozen characters.  Major settlements, such as Mohenjo-daro and Harappa, were laid out on a grid pattern with drainage and were clearly organised by a central power.  The earliest fragments of woven cotton from the subcontinent come from these sites.  Trade with sites in the Persian Gulf, as well as with settlements on the Oxus, has been substantiated." ;
    skos:prefLabel "Indus Civilisation" ;
    time:intervalFinishedBy [ skos:prefLabel "2000 BC" ;
            time:hasDateTimeDescription [ time:year "-1999"^^xsd:gYear ] ] ;
    time:intervalStartedBy [ skos:prefLabel "approximately 2500 BC" ;
            time:hasDateTimeDescription [ time:year "-2499"^^xsd:gYear ] ] ;
    foaf:page <http://collection.britishmuseum.org/id/thesauri/x46239> .

