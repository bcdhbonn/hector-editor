@prefix dct: <http://purl.org/dc/terms/> .
@prefix lvr_fund: <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

lvr_fund:abakus_rechengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Abakus ist ein Rechengerät, auf dem mit Hilfe von Rechensteinen oder Kugeln, die auf einer Führung innerhalb eines Rahmens bewegt werden, die vier Grundrechenarten sowie teilweise das Ziehen von Wurzeln ausgeführt werden, wobei der Wert der Rechensteine durch ihre Lage bestimmt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Abakus (Rechengerät)"@de .

lvr_fund:abschlag_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Abschlag ist eine Grundform, welche von einem Kern gewonnen wurde. In Schlagrichtung ist ein Abschlag mehr als doppelt so breit wie lang."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Abschlag (Steinartefakt)"@de .

lvr_fund:abschlagskern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Abschlagskern"@de .

lvr_fund:abspliss_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Abspliss (Steinartefakt)"@de .

lvr_fund:abzug_foto a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Abzug ist ein auf Fotopapier kopiertes Foto. Die Vorlage, etwa ein Negativfilm, ein Dia oder eine Bilddatei, wird dafür mittels fotografischer Verfahren wie Kontaktkopie, Vergrößerung oder Ausbelichtung übertragen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Abzug (Foto)"@de .

lvr_fund:aedikula a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Ädikula ist ein Architekturelement, das als kleine übergiebelte Hausfront in antikisierender Form eine Nische, ein Portal, ein Fenster oder ähnliches rahmt."@de,
        "Niches or small shrines, often intended for sculpture, or for frameworks around doors or windows formed of columns, corbeling, or pilasters, supporting a pediment or canopy."@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300002574>,
        <http://www.wikidata.org/entity/Q507286> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ädikula"@de,
        "aedicules"@en ;
    skos:scopeNote "Eine Ädikula besteht wenigstens aus Stützen (Pilaster, Wandpfeiler o.ä.) und einer Überdachung. Die Ädikula wird von der Bekrönung dadurch unterschieden, dass die Höhe der Stützen der Höhe des gerahmten Elements entsprechen. Eine Ädikula ist immer Zierelement, nicht Front eines Gebäudes oder Raumes."@de .

lvr_fund:ahle_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ahle (Werkzeug)"@de .

lvr_fund:altar a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Ein Altar ist ein sakrales Bauwerk, das im ursprünglichen Sinn als erhöhter Platz zur Darbringung eines Opfers dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Altar"@de ;
    skos:scopeNote "In der christlichen Kirche ist er als Platz des Messopfers wichtigstes Stück der Kirchenausstattung."@de .

lvr_fund:altarbild a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Altarbild"@de .

lvr_fund:amboss_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Amboss ist ein Gerät zur Metallbearbeitung. Er besteht aus gehärtetem Stahl und dient als Unterlage beim Schmieden des meist glühenden Eisens."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Amboss (Werkzeug)"@de .

lvr_fund:amphore a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Amphore ist ein Transportgefäß und Vorratsgefäß der Antike, das zwei Henkel, einen engen Hals und einen bauchigen, ovalen Körper besitzt. Die meisten Amphoren wurden aus Ton hergestellt. Viele antike Amphoren haben einen spitzen Fuß und konnten dadurch nur in dafür vorgesehenen Halterungen aufrecht gelagert werden. In ihnen wurde beispielsweise  Olivenöl, Wein oder Garum aufbewahrt."@de,
        "Ancient Greek and Roman storage vessels of many variations usually having a large oval body with a narrow neck and two or more handles extending from the mouth or neck to the shoulders on the body."@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300148696>,
        <http://www.wikidata.org/entity/Q178401>,
        <https://d-nb.info/gnd/4001770-9> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Amphore"@de,
        "amphorae"@en ;
    skos:scopeNote "Viele antike Amphoren haben einen spitzen Fuß und konnten dadurch nur in dafür vorgesehenen Halterungen aufrecht gelagert werden. In ihnen wurde beispielsweise  Olivenöl, Wein oder Garum aufbewahrt."@de .

lvr_fund:amulett a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Amulett"@de .

lvr_fund:angelhaken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Angelhaken ist ein Haken, der zur Befestigung eines Köders dient und die gefangene Beute an der Angelleine hält. Ein Angelhaken besteht aus den Teilen Kopf, Schenkel, Bogen, Spitze und ist in verschiedenen Formen und Größen erhältlich."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Angelhaken"@de .

lvr_fund:ango a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Ango ist ein Speer, dessen Spitze aus einem Blatt mit Widerhaken, einem langen Schaft und einer schmalen Tülle besteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ango"@de .

lvr_fund:anhaenger_schmuck a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Anhänger ist ein Schmuckstück, das in der Regel mittels einer Öse an einer Kette um den Hals aber auch an Ohrringen, Armketten oder Broschen getragen wird. Das Formenspektrum umfasst hauptsächlich geometrische bis figürliche Darstellungen; die Verarbeitung kann sehr detailreich sein, aufwendig verziert, besetzt mit Edelsteinen und anderem."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Anhänger (Schmuck)"@de .

lvr_fund:anker_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Anker ist ein Gerät, mit dem ein Wasserfahrzeug an einem bestimmten Platz festgehalten wird und nicht durch äußere Einwirkungen wie Wind, Strömung oder Wellen abgetrieben werden kann. Ein Anker besteht in der Regel aus einem Schaft und mehreren hakenförmigen Armen, auch Flunken genannt. Er ist durch eine Ankerkette mit dem Wasserfahrzeug verbunden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Anker (Gerät)"@de .

lvr_fund:aquamanile a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Aquamanile ist eine figürliche Kanne zum Ausgießen von Wasser. In der Regel besitzen die Gefäße einen Henkel und werden je nach Verwendungszweck aus Metall oder Keramik herstellt. Es wird zur Handwaschung für den liturgischen und profanen Gebrauch verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Aquamanile"@de .

lvr_fund:architekturfragment a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Architekturfragment ist ein Bruchstück eines Bauwerks, das durch Zerstörung, Verfall oder gezielte Demontage entstanden ist und das in der Regel keinen funktionalen Zusammenhang mehr mit dem ursprünglichen Bauwerk hat. Beispiele sind Teile von Säulen, Sockeln, Mauern oder Ornamenten, die etwa bei Ausgrabungen gefunden werden."@de ;
    skos:editorialNote "Verwendet insbesondere für fragmentierte Fundobjekte ohne Zusammenhang mit dem ursprünglichen Bauwerk. Für vollständige Architekturelemente verwende Bauteil (wk000112)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Architekturfragment"@de .

lvr_fund:archivale a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Archivale"@de .

lvr_fund:armbrustfibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Armbrustfibel"@de .

lvr_fund:armring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:definition "Ein Armring ist Armschmuck in Form eines starren Reifs, der um das Handgelenk oder den Oberarm getragen wird. Er kann die Form eines geschlossenen oder offenen Rings haben und wird übergestreift oder mithilfe von Scharnieren geöffnet und um den Arm gelegt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Armring"@de .

lvr_fund:armschiene_kleidung a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Armschiene ist Bestandteil einer Rüstung, der einen Teil des Arms schützt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Armschiene (Kleidung)"@de .

lvr_fund:armschutzplatte a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Armschutzplatte ist eine Panzerung und schützt den Arm eines Bogenschützen vor der zurückschnellenden Sehne."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Armschutzplatte"@de .

lvr_fund:aschenkiste a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Aschenkiste ist ein Behältnis, in dem die Reste einer Brandbestattung aufbewahrt werden."@de ;
    skos:editorialNote "Benutzt für das Behältnis zur Aufbewahrung von Resten einer Brandbestattung; für den Bestandteil eines Ofens siehe Aschkasten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Aschenkiste"@de ;
    skos:scopeNote "Eine Aschenkiste ist ähnlich einem Sarkophag, kann aber deutlich kleiner sein. Sie nimmt die vom Verbrennungsplatz ausgelesenen Reste der Brandbestattung auf. Eine Aschenkiste muss nicht in der Erde bestattet sein."@de .

lvr_fund:aucissafibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Aucissafibel"@de .

lvr_fund:aurignacienklinge a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Aurignacienklinge"@de .

lvr_fund:ausgesplittertes_stueck a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ausgesplittertes Stück"@de .

lvr_fund:ausguss_gefaessbestandteil a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ausguss (Gefäßbestandteil)"@de .

lvr_fund:ausgussbecken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Ausgussbecken ist ein Becken, das dem Ausgießen von Schmutzwasser dient. Für diesen Zweck ist es in der Regel besonders tief, mit einem Rost zum Abstellen von großen Gefäßen sowie oft auch mit einem Rand zum Abstützen von beispielsweise Eimern ausgestattet. Ausgussbecken können über eine hohe Rückwand verfügen und finden sich heute typischerweise in Großküchen, Laboren, Unreinräumen oder Putzräumen, früher auch in Haushalten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ausgussbecken"@de .

lvr_fund:ausgusstuelle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ausgusstülle"@de .

lvr_fund:axt_waffe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Axt ist eine Schlagwaffe, die im Nahkampf genutzt wird und auch in die Ferne geschleudert werden kann."@de ;
    skos:editorialNote "Benutzt für die Nutzung der Axt als Waffe; bei Nutzung als Werkzeug siehe Axt (Werkzeug). Benutzt für die vollständige Waffe Axt, bestehend aus Axtklinge und Axtschaft; bei Fehlen des Axtschaftes Axtklinge verwenden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Axt (Waffe)"@de .

lvr_fund:axt_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für die Nutzung der Axt als Werkzeug; bei Nutzung als Waffe s. Axt (Waffe). Benutzt für das vollständige Werkzeug Axt, bestehend aus Axtklinge und Axtschaft; bei Fehlen des Axtschaftes Axtklinge verwenden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Axt (Werkzeug)"@de ;
    skos:scopeNote "Eine Axt dient zum Fällen von Bäumen oder der Bearbeitung von Holz."@de .

lvr_fund:axtklinge a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für den Axtkopf. Ist der Schaft auch erhalten, benutze Schlagwörter für Axt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Axtklinge"@de .

lvr_fund:balken_bauteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Balken ist ein Bauteil, das als Träger horizontal gelagert ist und vertikal wirkende Kräfte aufnimmt und weitergibt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Balken (Bauteil)"@de .

lvr_fund:balkenkopf a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Balkenkopf ist der Bestandteil eines Balkens, der dessen Ende bildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Balkenkopf"@de ;
    skos:scopeNote "Der Balkenkopf kann in einer Mauer oder Wand liegen aber auch darüber hinaus ragen."@de .

lvr_fund:barren_metall a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:definition "Ein Barren ist ein Objekt aus einer einzelnen, relativ reinen Metallsorte, das in eine einheitliche Form gegossen wurde."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Barren (Metall)"@de ;
    skos:scopeNote "In prähistorischer Zeit wurden Barren auch als Tauschmittel und Zahlungsmittel eingesetzt."@de .

lvr_fund:basis_bestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Basis ist ein Bestandteil, der sich am Boden von Bauteilen oder ähnlichem befindet und aufgehende Teile trägt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Basis (Bestandteil)"@de .

lvr_fund:bauinschrift a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Bauinschrift ist eine Inschrift an einem Bauwerk oder Bauteil, die über dessen Errichtung und Veränderung Auskunft gibt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bauinschrift"@de .

lvr_fund:baukeramik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Baukeramik ist gebrannter, tonhaltiger Baustoff, der in und um Bauten verwendet wird und beispielsweise Keramikfliesen, Formsteine oder Fassadenschmuck umfasst."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Baukeramik"@de .

lvr_fund:bauornament a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bauornament ist ein Ornament, das dem Schmuck und der Gliederung eines Bauwerks dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bauornament"@de .

lvr_fund:baustein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Baustein"@de .

lvr_fund:bauteil_bauwesen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bauelement (das Bauteil) ist ein Bestandteil von Bauwerken, das eine funktionelle Einheit bildet und dabei meist kleiner ist als ein Raum. Dazu gehören etwa Wände, Decken, Stützen, aber auch Bauteilgruppen wie Fenster und Treppen und dekorative Architekturelemente wie Gesimse, Friese oder Kapitelle."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bauteil (Bauwesen)"@de .

lvr_fund:becher_trinkgefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Becher ist ein Trinkgefäß mit zylindrischer, konischer oder bauchiger Form, normalerweise höher als der Mündungsdurchmesser breit ist. Er kann einen Fuß besitzen, aber keinen Stiel, auch Henkel treten auf, dann aber meist an Exemplaren ohne Fuß."@de ;
    skos:editorialNote "Verwendet für das Trinkgefäß. Für andere Behälter, die die Form eines Bechers haben, benutze spezifischere Begriffe, etwa Eierbecher, Würfelbecher, Messbecher."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Becher (Trinkgefäß)"@de .

lvr_fund:befestigungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Begriff nicht mehr verwenden. Wird mit Verbindungselement zusammengeführt. Bitte wk006114 (Oberbegriff \"Verbindungselement\") nutzen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Befestigungselement"@de .

lvr_fund:beil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für das vollständige Werkzeug, bestehend aus Beilklinge und Beilschaft. Bei Fehlen des Beilschaftes verwende Beilklinge."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Beil"@de ;
    skos:scopeNote "Ein Beil dient zum Fällen von Bäumen oder der Bearbeitung von Holz."@de .

lvr_fund:beilklinge a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für die schneidende Klinge des Beils, ist der Schaft erhalten s. Beil"@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Beilklinge"@de ;
    skos:scopeNote "Die Oberfläche der Beilklinge von Steinbeilen wird partiell oder ganz geschliffen. Längs- und Querschnitt sind symmetrisch. Die Beilklinge wird längs zum Schaft geschäftet."@de .

lvr_fund:beinschiene_kleidung a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Beinschiene ist ein Rüstungsteil, das zum Schutz der Schienbeine dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Beinschiene (Kleidung)"@de .

lvr_fund:beitel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Beitel"@de ;
    skos:scopeNote "Ein Beitel besteht aus einem Griff und einer Klinge. Er wird in Verbindung mit einem Hammer oder Schlägel verwendet."@de .

lvr_fund:bekleidungszubehoer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bekleidungszubehör"@de .

lvr_fund:beschlag_objekt a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Beschlag ist ein Verbindungselement und kann Bestandteil von verschiedenen Objekten sein. Er ist meist aus Metall und dient je nach Ausprägung zum Bedienen und Bewegen, zum Schließen und Sichern, zum Schutz und gleichzeitig oder ausschließlich zur Zierde des Objektes, an dem es angebracht ist. Dies können Teile von Gebäuden, etwa Türen und Fenster oder Möbel, Kleidung, Waffen, kleinere Objekte und Zubehör sein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Beschlag (Objekt)"@de .

lvr_fund:besteck_kuechengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Besteck ist ein Küchengerät, das die Gesamtheit der zum Essen benutzten Geräte, wie Messer, Gabel und Löffel darstellt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Besteck (Küchengerät)"@de .

lvr_fund:bett_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bett ist ein Liegemöbel, das als Schlafstätte, Liegestätte oder Ruhestätte dient und sich aus einem Gestell mit Auflegematratze und Federbetten zusammensetzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bett (Möbel)"@de .

lvr_fund:bifazialer_schaber a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bifazialer Schaber"@de .

lvr_fund:bifazielle_spitze a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bifazielle Spitze"@de .

lvr_fund:blattfoermiger_schaber a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Blattförmiger Schaber"@de .

lvr_fund:blattspitze a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Blattspitze"@de .

lvr_fund:blech_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Blech (Objekttyp)"@de .

lvr_fund:bleirute a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bleirute"@de .

lvr_fund:bleiverglasung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Bleiverglasung ist eine Verglasung, die aus Butzenscheiben oder kleinen Glasstücken besteht und mit Bleiruten eingefasst ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bleiverglasung"@de .

lvr_fund:bodenfliese a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenfliese"@de .

lvr_fund:bodenplatte_bauteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenplatte (Bauteil)"@de .

lvr_fund:bodenprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Bodenprobe ist eine Materialprobe, die aus Erdboden besteht, der für unterschiedliche naturwissenschaftliche Fragestellungen analysiert werden soll."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenprobe"@de .

lvr_fund:bodenscherbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Bodenscherbe ist eine Scherbe aus dem unteren Abschluss eines Gefäßes."@de ;
    skos:editorialNote "Benutzt für Scherben aus Ton, Glas und Porzellan; für Fragmente aus anderen Materialien benutze Gefäßboden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenscherbe"@de .

lvr_fund:bodenstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenstein"@de .

lvr_fund:bodenziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Bodenziegel ist Baukeramik, die abriebfest ist und zur Nutzung als Bodenbelag im Innenbereich und Außenbereich verwendet wird. Die aus tonhaltigem Lehm gebrannten Ziegeln haben eine rechteckige bis quadratische Form."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bodenziegel"@de .

lvr_fund:bogen_schusswaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Bogen ist eine Schusswaffe zum Verschießen von Pfeilen mittels einer gespannten Sehne. Während traditionelle Bögen aus Holz, Horn und Tiersehnen gefertigt wurden, bestehen moderne Bögen in der Regel aus Holz sowie unterschiedlichen Verbundwerkstoffen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bogen (Schusswaffe)"@de .

lvr_fund:bohrer_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bohrer ist ein Steinwerkzeug, welches mindestens eine retuschierte Spitze oder Zinke hat. Es gibt sehr variable Bohrerformen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bohrer (Steinwerkzeug)"@de .

lvr_fund:bohrer_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bohrer ist ein Werkzeug zum Zerspanen, das durch Drehbewegung um die eigene Achse Löcher in festen Materialien erzeugt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bohrer (Werkzeug)"@de .

lvr_fund:bolzen_geschoss a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bolzen ist ein Geschoss für die Armbrust. Es besteht aus einer gedrungenen, meist vierkantigen Spitze, die auf einen Holzstab aufgesetzt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bolzen (Geschoss)"@de .

lvr_fund:bolzen_verbindungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bolzen (Verbindungselement)"@de .

lvr_fund:bombe_sprengkoerper a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Für Sprengkörper, die von einer Treibladung oder manuell eine Initialbeschleunigung erfahren, Granate verwenden. Für Sprengkörper, die verlegt werden und zeitverzögert zünden, Mine verwenden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bombe (Sprengkörper)"@de .

lvr_fund:boot_wasserfahrzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Boot ist ein meist offenes, kleineres Wasserfahrzeug, das auf dem Wasser schwimmt und dessen Antrieb durch Paddel, Riemen, Segel oder Motoren erfolgt. Wie das Schiff besitzt es einen länglichen Rumpf, selten mehrere, der an einem oder beiden Enden schmal oder spitz zuläuft. Im Unterschied zu diesem ist das Boot aber insgesamt kleiner und aufgrund seiner Bauweise weniger seetüchtig."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Boot (Wasserfahrzeug)"@de .

lvr_fund:bootshaken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bootshaken"@de .

lvr_fund:bratrost a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bratrost ist ein Küchengerät, das zum Braten von Fleisch oder Ähnlichem dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bratrost"@de .

lvr_fund:bratspiess a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bratspieß"@de .

lvr_fund:brennhilfe_ofen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Brennhilfe (Ofen)"@de .

lvr_fund:brett a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Brett"@de .

lvr_fund:brief a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Brief ist Schriftverkehr, der in der Regel auf Papier verfasst und dann per Post verschickt wird. Ein Brief besteht typischerweise aus den Angaben Ort und Tag des Verfassens, einer Anrede, einem Hauptteil und einer Schlussformel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Brief"@de .

lvr_fund:briefmarke a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Briefmarke"@de .

lvr_fund:brosche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Brosche ist eine Schmucknadel zum Anstecken an Kleidungsstücke. Häufig werden Broschen in Brusthöhe getragen, durch modische Impulse aber ebenfalls am Halsausschnitt und an Ärmeln befestigt. Hauptsächlich erfüllen Broschen dekorative Zwecke, können aber auch dem Zusammenhalten leichter Kleidung, Kragen oder Schals dienen. Oft sind sie, angepasst an den vorherrschenden Modestil, kunstvoll verziert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Brosche"@de ;
    skos:scopeNote "Eine Brosche besitzt keinen Verschließmechanismus ähnlich einer Sicherheitsnadel."@de .

lvr_fund:buch_informationstraeger a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Buch ist ein Informationsträger, der aus einer Sammlung gedruckter, beschriebener aber auch leerer Blätter aus Papier oder ähnlichen Materialien bestehen kann. Diese Einzelblätter sind durch eine Bindung oder Heftung verbunden und zumeist durch einen Bucheinband geschützt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Buch (Informationsträger)"@de .

lvr_fund:buchdeckel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Buchdeckel ist der Bestandteil eines Bucheinbandes, der die Aufgabe erfüllen soll, den Buchblock vor Schäden zu schützen, wozu er etwas über den Buchblock hinaussteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Buchdeckel"@de .

lvr_fund:bucheinband a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Bucheinband ist der Bestandteil eines Buches und Bestandteil der Buchkunst, der als Hülle den Buchblock umschließt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bucheinband"@de .

lvr_fund:buchmalerei_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Buchmalerei ist ein visuelles Werk, durch das ein Buchtext durch Hinzufügen eines Bildes oder einer Zeichnung illustriert wird. Die Bilder oder Zeichnungen sind entweder in den Text eingefasst oder auf einer gesonderten Seite untergebracht."@de ;
    skos:editorialNote "Benutzt für Illustrationen und ähnliches in Handschriften; für Abbildungen in Druckwerken benutze Buchillustration."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Buchmalerei (visuelles Werk)"@de .

lvr_fund:buchschliesse a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Buchschließe ist eine Schließe, die konstruktionstechnische Schwächen eines Bucheinbands kompensiert. Häufig aus Metall hergestellt, diente sie in erster Linie zum Schutz aber auch als Zierde des vorderen und hinteren Einbandes. Sie gehörte besonders während des Mittelalters und bis Ende des 16. Jahrhunderts zur Ausstattung eines Holzdeckbands."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Buchschließe"@de ;
    skos:scopeNote "Die im 16. Jh. zunehmend umfangreicher werdenden Büchersammlungen hatten dazu geführt, dass die ehemals auf Pulten oder in Schränken liegend aufbewahrten Bücher nun aufrecht in Regale gestellt wurden, „die man nebeneinander stellen und bequem einzeln aus der Reihe ziehen wollte”. Bei der Aufstellung von Büchern „fand man doch, daß sie [Schließen und Beschläge] für die Massenaufstellung von Büchern unbequem waren”, so dass sie in der Konsequenz zunehmend seltener verwendet wurden."@de .

lvr_fund:buegelfibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bügelfibel"@de .

lvr_fund:buerste a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Bürste ist eine Gerätschaft mit rechtwinklig auf einem Körper angeordneten Borsten, mit oder ohne Stiel, die, je nach Ausführung, zum Reinigen, zum Aufbringen von Pasten, für die Körperpflege und Ähnliches genutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Bürste"@de .

lvr_fund:bueste_kunst a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Büste ist ein visuelles Werk, das die rundplastische oder reliefplastische Darstellung eines Menschen zeigt. Es ist durch Schulter, Brust oder Körpermitte begrenzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Büste (Kunst)"@de .

lvr_fund:chopper_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Chopper konnten in Deutschland bisher nicht überzeugend nachgewiesen werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Chopper (Steinwerkzeug)"@de .

lvr_fund:chopping_tool a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Chopping Tools konnten in Deutschland bisher nicht überzeugend nachgewiesen werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Chopping Tool"@de .

lvr_fund:cleaver a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Cleaver ist ein keilförmiges Steingerät mit einer beilähnlichen oder meißelartigen Schneide. Cleaver können einseitig oder beidseitig flächenretuschiert sein und werden meist aus Abschlägen hergestellt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Cleaver"@de .

lvr_fund:concept_3e22296d a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Großer Topf, in dem Brühe für Suppen oder Soßen hergestellt oder aufbewahrt wird."@de,
        "Large pots in which stock for soup or sauce is made or kept."@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300198953>,
        <http://www.wikidata.org/entity/Q15711817>,
        <https://d-nb.info/gnd/4144229-5> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kochtopf"@de,
        "stockpots"@en .

lvr_fund:concept_472944f2 a skos:Concept ;
    skos:broader lvr_fund:concept_72063f7f ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Niederbieber"@de .

lvr_fund:concept_56dd9620 a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Stein als Reibefläche für Zerkleinerung"@de,
        "stones used in gristmills, for grinding wheat or other grains"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q670985>,
        <https://d-nb.info/gnd/4327809-7> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mühlstein"@de,
        "millstone"@en .

lvr_fund:concept_71c30401 a skos:Concept ;
    skos:broader lvr_fund:concept_ffc93794 ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ziegeelstück"@de .

lvr_fund:concept_afb0b3b1 a skos:Concept ;
    skos:broader lvr_fund:concept_5628c1a0 ;
    skos:definition "keramische Masse der Klasse Sinterzeug"@de,
        "vitreous or semi-vitreous ceramic made primarily from stoneware clay or non-refractory fire clay"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300010672>,
        <http://www.wikidata.org/entity/Q830894>,
        <https://d-nb.info/gnd/4183075-1> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Steinzeug"@de,
        "stoneware"@en .

lvr_fund:concept_c4350e3c a skos:Concept ;
    skos:broader lvr_fund:krug_gefaess ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Einhenkelkrug"@de .

lvr_fund:concept_e669ec77 a skos:Concept ;
    skos:broader lvr_fund:concept_5628c1a0 ;
    skos:definition "antike Schwarzkeramik"@de,
        "stoneware produced in early Gaul"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q2405109> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Terra Nigra"@de,
        "Terra Nigra"@en .

lvr_fund:concept_f447fe5e a skos:Concept ;
    skos:broader lvr_fund:krug_gefaess ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zweihenkelkruge"@de .

lvr_fund:dach a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Dach ist ein Bauteil, welches ein Bauwerk nach oben abschließt und gegen Witterungseinflüsse schützt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dach"@de .

lvr_fund:dachrinne a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Dachrinne ist der Bestandteil eines Daches, die das ablaufende Regenwasser durch einen Trichter über ein Fallrohr ableitet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dachrinne"@de .

lvr_fund:dachziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Dachziegel ist Baukeramik, die als Dachdeckung verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dachziegel"@de .

lvr_fund:daube_holz a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Daube (Holz)"@de .

lvr_fund:dechsel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für das vollständige Werkzeug Dechsel, bestehend aus Dechselklinge und Dechselschaft; bei Fehlen des Dechselschaftes Dechselklinge verwenden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dechsel"@de ;
    skos:scopeNote "Die Schneide der Dechselklinge steht quer zur Schäftung und hat einen asymmetrischen Längsschnitt und kann einen symmetrischen oder asymmetrischen Querschnitt haben. Die Oberfläche der Dechselklinge wird partiell oder ganz geschliffen und hat kein Schaftloch."@de .

lvr_fund:dechselklinge a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Die Dechselklinge ist der schneidende Bestandteil des Werkzeugs Dechsel; ihr Längsschnitt ist asymmetrisch, sie hat kein Schaftloch, sondern wird in den Dechselschaft eingesetzt."@de ;
    skos:editorialNote "Benutzt für die schneidende Klinge des Dechsels, ist der Schaft erhalten s. Dechsel"@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dechselklinge"@de ;
    skos:scopeNote "Die Schneide der Dechselklinge steht quer zur Schäftung und hat einen asymmetrischen Längsschnitt und kann einen symmetrischen oder asymmetrischen Querschnitt haben. Die Oberfläche der Dechselklinge wird partiell oder ganz geschliffen und hat kein Schaftloch."@de .

lvr_fund:decke_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Decke ist ein Bauteil, das einen Raum nach oben als weitgehend ebene Fläche abschließt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Decke (Architektur)"@de .

lvr_fund:deckel_verschluss a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Deckel ist ein abnehmbarer oder aufklappbarer Verschluss, der auf die obere Öffnung von Behältern aufgesetzt wird. Im Gegensatz zu Stöpseln verschließen Deckel Behälter von außen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Deckel (Verschluss)"@de .

lvr_fund:deichsel_fahrzeugteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Deichsel ist ein Fahrzeugteil, das als feste oder bewegliche Zugvorrichtung und Lenkvorrichtung an antriebslosen Fahrzeugen genutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Deichsel (Fahrzeugteil)"@de .

lvr_fund:dendroprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Dendroprobe ist eine Materialprobe, die aus Hölzern zumeist Bauhölzern, für eine dendrochronologische Datierung entnommen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dendroprobe"@de .

lvr_fund:devotionalie a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Devotionalie ist ein religiöser Gegenstand, der zur privaten religiösen Andacht oder Verehrung genutzt wird. Vorrangig werden Devotionalien im Christentum genutzt, finden aber auch in anderen Religionen Anwendung."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Devotionalie"@de .

lvr_fund:dia_foto a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Dia ist eine Fotografie aus einem positiv belichteten Film, das zum Zweck der Projektion auf einen transparenten physischen Bildträger aufgetragen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dia (Foto)"@de .

lvr_fund:diafilm a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Diafilm ist ein fotografischer Film, der nach dem Entwickeln ein positives Bild zeigt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Diafilm"@de .

lvr_fund:dihedralstichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dihedralstichel"@de .

lvr_fund:diptychon a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Diptychon ist ein visuelles Werk, das ein schmal-rechteckiges, zusammenklappbares Paar von Täfelchen aus Holz bezeichnet, das aus Elfenbein oder Edelmetall besteht und innen mit einer Wachseinlage ausgestattet ist, die zum Schreiben benutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Diptychon"@de .

lvr_fund:diskoider_kern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Diskoider Kern"@de .

lvr_fund:dokument_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dokument (Objekttyp)"@de .

lvr_fund:dolch_waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Dolch ist eine Blankwaffe, die eine kurze mehrschneidige Klinge, eine Griffstange und einen in der Regel symmetrischen Griff besitzt. Sie ist für eine stoßende Bewegung konzipiert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dolch (Waffe)"@de .

lvr_fund:dolchklinge a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dolchklinge"@de .

lvr_fund:dolchscheide a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dolchscheide"@de .

lvr_fund:dolium a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Dolium ist ein sehr großes Gefäß aus gebranntem Ton, das in weiten Teilen des Römischen Reichs vor allem zur Lagerung von Lebensmitteln verwendet wurde. Diese größte römische Gefäßform zeichnet sich durch einen bauchigen Körper ohne Henkel, meist ohne Hals und eine weite Öffnung aus. Dolia konnten mannshoch sein und ein Volumen von bis zu zwei Kubikmetern besitzen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dolium"@de .

lvr_fund:dose_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Dose ist ein kleiner Behälter mit Deckel, oft dekorativ gestaltet, der der Aufbewahrung dient."@de ;
    skos:editorialNote "Für die ebenfalls als Dose bezeichnete Verkaufsverpackung aus Blech verwende Konservendose wk007588."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dose (Behälter)"@de .

lvr_fund:draht a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Draht ist ein Metall, das schnurförmig lang ausgezogen, dünn und biegsam ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Draht"@de .

lvr_fund:drehhandmuehle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Drehhandmühle"@de .

lvr_fund:dreieck_mikrolith a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dreieck (Mikrolith)"@de .

lvr_fund:dreifuss_staender a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Dreifuß ist ein Ständer, der dem Erhitzen oder Kochen dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dreifuß (Ständer)"@de .

lvr_fund:druckgrafik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Druckgrafik"@de .

lvr_fund:dufourlamelle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Dufourlamelle"@de .

lvr_fund:egge_bodenbearbeitungsgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Egge ist ein Bodenbearbeitungsgerät, das der Auflockerung des Bodens, der Unkrautbekämpfung und dem Einarbeiten von Saatgut und Dünger auf dem Acker dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Egge (Bodenbearbeitungsgerät)"@de .

lvr_fund:eimer a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Eimer ist ein großes Gefäß mit zylindrischer oder leicht konischer Form, meist mit beweglichem Henkel über der Öffnung, seltener mit Griffen. Die Höhe ist größer als seine Breite und sein Fassungsvermögen beträgt mehrere Liter. Eimer sind typischerweise aus Holzdauben, aus Blech oder heute meist aus Kunststoff hergestellt und werden vorwiegend für das Tragen, Schöpfen und Vorhalten von Flüssigkeiten und losen Materialien genutzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Eimer"@de .

lvr_fund:endretusche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Endretusche"@de .

lvr_fund:faden_textilie a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Faden (Textilie)"@de .

lvr_fund:fahrwerk_landfahrzeugteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fahrwerk ist ein Landfahrzeugteil, das zur Federung, Lenkung, Spurhaltung und Fortbewegung dient."@de ;
    skos:editorialNote "Benutzt für den Bestandteil von Landfahrzeugen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fahrwerk (Landfahrzeugteil)"@de .

lvr_fund:fahrzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fahrzeug ist ein Transportmittel, das zur Beförderung von Personen, Gütern, Tieren oder zum Bewegen von Geräten genutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fahrzeug"@de .

lvr_fund:fangnetz_fanggeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fangnetz ist ein Fanggerät hauptsächlich aus geknüpften Schnüren oder Fäden, mit dem Tiere, etwa Wild, Fische oder Insekten, eingefangen werden können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fangnetz (Fanggerät)"@de .

lvr_fund:fass a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fass ist ein Gefäß mit bauchiger bis steiler Form, das zur Aufnahme und Aufbewahrung von Flüssigkeiten, Materialien und Nahrungsmitteln dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fass"@de .

lvr_fund:faustkeil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Faustkeil"@de .

lvr_fund:federmesser_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Federmesser (Steinwerkzeug)"@de .

lvr_fund:feile a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feile"@de .

lvr_fund:fenster_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Fenster ist ein Bauteil, das als Öffnung in Mauer oder Wand zur Belichtung und Belüftung der Innenräume dient und einen Ausblick oder Einblick ermöglicht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fenster (Architektur)"@de .

lvr_fund:fensterbank a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fensterbank"@de .

lvr_fund:fenstergitter a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Fenstergitter ist ein Gitter, das aus Sicherheitsgründen oder als Fassadenschmuck in oder vor einer Fensteröffnung angebracht wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fenstergitter"@de .

lvr_fund:fensterrahmen a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Fensterrahmen ist der Bestandteil eines Fensters, der fest mit der Mauer verbunden ist und aus Holz, Aluminium oder Kunststoff gefertigt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fensterrahmen"@de .

lvr_fund:feuerbock_hausrat a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für das zweiteilige Haushaltsgerät; für das einteilige Idol siehe Mondidol."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerbock (Hausrat)"@de ;
    skos:scopeNote "Die Funktion eines Feuerbockes setzt eine Paarigkeit voraus, dies wird in der Archäologie als Unterscheidungsmerkmal zu einem singulären Mondidol verwendet."@de .

lvr_fund:feuerschaufel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Feuerschaufel ist eine Schaufel, die zum Ausräumen kalter Asche aus Öfen, Kaminen oder offenen Feuerstellen dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerschaufel"@de .

lvr_fund:feuerschlagstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Feuerschlagstein ist ein Steinartefakt, der zur Erzeugung von Funken verwendet wird. In der Regel sind die Schlagsteine langschmal und an einer oder beiden Enden durch den Gebrauch stark verrundet oder vernarbt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerschlagstein"@de .

lvr_fund:feuerstahl a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Feuerstahl ist eine Gerät, das aus Eisen besteht und der Feuererzeugung dient. Feuerstahl ist Bestandteil eines Schlagfeuerzeuges."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerstahl"@de .

lvr_fund:feuerstuelpe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Feuerstülpe ist eine Gerätschaft, die über die Glut von offenen Herdstellen gestülpt wird, um zu verhindern, dass das Feuer von Haustieren verschleppt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerstülpe"@de .

lvr_fund:feuerzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Feuerzeug"@de .

lvr_fund:figuerliches_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein figürliches Gefäß ist ein Gefäß, das die Gestalt eines Tieres, Mischwesens oder einer menschlichen Figur besitzt oder aber entsprechende figürliche Darstellungen im Relief herausgearbeitet sind."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Figürliches Gefäß"@de .

lvr_fund:figur_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Figur ist ein visuelles Werk, das den Körper eines Menschen, Tieres, Gegenstands oder einer abstrakten Form darstellt. Sie kann zweidimensional, etwa in Zeichnungen oder Gemälden, oder dreidimensional, wie als Skulptur oder Spielzeug, vorkommen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Figur (visuelles Werk)"@de .

lvr_fund:fingerhut_naehzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fingerhut ist ein Nähzubehör, das auf dem obersten Glied des Mittelfingers als Schutz getragen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fingerhut (Nähzeug)"@de .

lvr_fund:fingerring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:definition "Ein Fingerring ist ein Schmuckstück, das an einem Finger getragen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fingerring"@de .

lvr_fund:firmalampe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Firmalampe ist eine römische Leuchte mit kreisrundem Lampenkörper und mehr oder weniger langgezogener Brennschnauze. Die Lampen wurden mit flüssigem Brennstoff befüllt und aus Ton hergestellt. Sie sind mit einem Bodenstempel mit Herstellernamen versehen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Firmalampe"@de .

lvr_fund:fischereigeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fischereigerät ist ein Fanggerät, das zur Ausrüstung von Fischern gehört. Hierzu zählen etwa Angeln, Netze und Fangkammern."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fischereigerät"@de .

lvr_fund:flachboden a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Flachboden ist ein ebener Gefäßboden, der als Standfläche dient und ohne Absatz in die Gefäßwandung übergeht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flachboden"@de .

lvr_fund:flasche a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Flasche ist ein dicht verschließbares Gefäß mit enger, oft deutlich abgesetzter Halspartie, in der Regel ohne Handhabe. Im Verhältnis zur Höhe weist die Flasche typischerweise einen geringen Durchmesser auf. Das Gefäß wird hauptsächlich zum Transport und zur Lagerung von Flüssigkeiten verwendet und besteht üblicherweise aus Glas, Keramik, Kunststoff oder Metall."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flasche"@de ;
    skos:scopeNote "Die Flasche ist aus typologischer und herstellungstechnischer Sicht durch eine große Bandbreite an Varianten vertreten. Eine einheitliche Beschreibung der Gefäße ist durch die vielen unterschiedlichen regionalen Prägungen schwierig. Formenkundliche Ausnahmen bilden beispielsweise Flaschenformen mit Henkel und auch solche, die in ihrer Funktion für keine trinkbaren Flüssigkeiten gedacht sind."@de .

lvr_fund:fliese_objekt a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Fliese ist ein Objekt, das in der Regel aus einer viereckigen dünnen Platte aus Keramik, Stein, Kunststoff oder Glas besteht und vorwiegend als Bodenbelag oder Wandverkleidung im Innenbereich und Außenbereich verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fliese (Objekt)"@de .

lvr_fund:flintenstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flintenstein"@de ;
    skos:scopeNote "Der Flintenstein schlägt bei Betätigung des Schlosses Funken, die Schwarzpulver entzünden. Die entstandene Stichflamme zündet die Treibladung im Lauf des Gewehres und beschleunigt das Geschoss."@de .

lvr_fund:floete_musikinstrument a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flöte (Musikinstrument)"@de .

lvr_fund:flugmotor a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Flugmotor ist ein Motor für den Antrieb von Luftfahrzeugen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flugmotor"@de .

lvr_fund:flugzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Flugzeug ist ein Luftfahrzeug mit festen Tragflächen, das schwerer ist als die verdrängte Luftmasse und durch dynamischen Auftrieb fliegt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Flugzeug"@de .

lvr_fund:formwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Formgerät ist ein Gerät, das in einem handwerklichen oder industriellen Prozess für die Formgebung und Formgestaltung benutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Formwerkzeug"@de ;
    skos:scopeNote "Die Werkzeuge werden in der Metallindustrie, vor allem in der blechverarbeitenden Industrie (z. B. im Karosseriebau) und in der gesamten Gusstechnik, in der Kunststoffverarbeitung (z. B. beim Spritzgießen) sowie in einigen Handwerksbereichen (z. B. in der Schmiedekunst) verwendet."@de .

lvr_fund:foto a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Foto"@de .

lvr_fund:fund_objekt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für Funde, die als Quelle im Rahmen einer wissenschaftlichen Untersuchung genutzt werden können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fund (Objekt)"@de .

lvr_fund:fussboden a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Fußboden ist ein Bauteil, der einen Raum als begehbare Fläche nach unten hin begrenzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fußboden"@de .

lvr_fund:fussbodenmosaik a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Fußbodenmosaik"@de .

lvr_fund:gabel_besteck a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Gabel ist der Bestandteil eines Bestecks, der mit zwei oder mehr Zinken ausgestattet ist und zum Aufnehmen oder Zerlegen von Essen dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gabel (Besteck)"@de .

lvr_fund:gabel_landwirtschaftliches_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Gabel ist ein landwirtschaftliches Gerät mit zwei oder mehr Zinken, die an einem langen Stiel montiert sind, und das je nach Ausprägung zum Schaufeln, Aufheben und Kurzzeittransport verschiedener loser Güter, oder zum Graben verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gabel (landwirtschaftliches Gerät)"@de .

lvr_fund:garderobe_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Garderobe (Möbel)"@de .

lvr_fund:gedenkmuenze a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gedenkmünze"@de .

lvr_fund:gefaessboden a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Gefäßboden ist der Teil eines Gefäßes, auf dem es üblicherweise steht und der sich meist auf der der Öffnung gegenüberliegenden Seite befindet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gefäßboden"@de ;
    skos:scopeNote "Benutzt für Gefäßböden von Hohlformen aus Metall, organischen Materialien usw.; bei Scherben eines Bodens von Hohlformen aus Ton, Glas oder Porzellan siehe Bodenscherbe."@de .

lvr_fund:gefaesshals a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gefäßhals"@de .

lvr_fund:gefaessprofil a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Gefäßprofil ist der Bestandteil eines Gefäßes, der die Kontur abbildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gefäßprofil"@de .

lvr_fund:gefaessrand a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gefäßrand"@de .

lvr_fund:gefaesswand a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gefäßwand"@de .

lvr_fund:geld a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:definition "Geld ist ein Zahlungsmittel, das von einem Staat in Umlauf gebracht wird und anderen Waren und Dienstleistungen gegenüber als handelbares Tauschmittel dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geld"@de .

lvr_fund:gemaelde a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Gemälde ist ein visuelles Werk, bei dem ein Bild mit gelöster Farbe auf einen Bildträger gemalt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gemälde"@de .

lvr_fund:gemme_kunst a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gemme (Kunst)"@de .

lvr_fund:geofakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geofakt"@de .

lvr_fund:geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gerät"@de .

lvr_fund:geroell a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geröll"@de .

lvr_fund:geroellgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Geröllgeräte wurden in Deutschland bislang noch nicht zweifelsfrei nachgewiesen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geröllgerät"@de .

lvr_fund:geroellkeule a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geröllkeule"@de .

lvr_fund:geschoss_munition a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Geschoss ist Munition, die durch eine Abwurfvorrichtung oder Abschussvorrichtung auf eine hohe Geschwindigkeit gebracht wird. Das Geschoss fliegt nach dem Abschuss ungelenkt und ohne weiteren Antrieb."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geschoss (Munition)"@de .

lvr_fund:geschuetz a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Geschütz"@de .

lvr_fund:gesims a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Gesims ist ein Architekturelement, das als verhältnismäßig schmaler Streifen plastisch hervortritt, meist horizontal verläuft und Wände in einzelne Abschnitte gliedert oder abschließt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gesims"@de ;
    skos:scopeNote "Ein Gesims kann von Wandöffnungen unterbrochen oder um diese herumgeführt werden."@de .

lvr_fund:getestetes_rohstueck a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Getestetes Rohstück"@de .

lvr_fund:gewehr_handfeuerwaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Gewehr ist eine Handfeuerwaffe, die über einen langen Lauf verfügt, an der Schulter in Anschlag gebracht wird und mit zwei Händen zu bedienen ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gewehr (Handfeuerwaffe)"@de ;
    skos:scopeNote "Ein Gewehr besteht aus einem langem Lauf oder mehreren langen Läufen, Schloss, Abzugseinrichtung, lang gezogenem Vorderschaft, unterschiedlich ausgeformtem Kolbenhals und Kolbenwangen. Kurze bzw. gestutzte Gewehre werden Karabiner oder Stutzen genannt. Nach deutschem Waffengesetz ist das Gewehr eine Langwaffe."@de .

lvr_fund:gewehrkugel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Gewehrkugel ist ein rundes Geschoss aus Metall, das aus einem Gewehr abgefeuert wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gewehrkugel"@de .

lvr_fund:gewichtsstueck a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:definition "Ein Gewichtsstück ist der Bestandteil einer Waage, der beim Wiegen als Vergleichsmasse angebracht wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gewichtsstück"@de .

lvr_fund:gewoelbe_bauteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Gewölbe ist ein Bauteil, der als gebogene Fläche einen Raum nach oben abschließt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gewölbe (Bauteil)"@de .

lvr_fund:gewuerzstreuer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gewürzstreuer"@de .

lvr_fund:giebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Giebel ist ein Bauteil, der den quer zur Firstrichtung stehenden Abschluss eines Dachgeschosses bildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Giebel"@de .

lvr_fund:glaettstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Der Glättstein ist ein Gerät zur Oberflächenbehandlung, meist aus Stein oder Glas. Er besitzt eine flache, glatte Unterseite, mit der organische Materialien wie Leder, Textilien und Tongefäße geglättet werden können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Glättstein"@de .

lvr_fund:glasofen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Glasofen ist ein Ofen, in dem Glas hergestellt oder bearbeitet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Glasofen"@de .

lvr_fund:glocke_idiofon a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Glocke ist ein Idiofon, das nach unten offen und hohl ist und durch einen im Inneren befestigten oder von außen anzuschlagenden Klöppel zum Klingen gebracht wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Glocke (Idiofon)"@de .

lvr_fund:grabinschrift a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Eine Grabinschrift ist eine Inschrift an einem Grabmal, die an einen Toten erinnert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grabinschrift"@de .

lvr_fund:grabplatte a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Eine Grabplatte ist ein Grabmal, das die Form einer großen, das Grab abdeckenden Platte hat."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grabplatte"@de .

lvr_fund:grabstein a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Ein Grabstein ist ein Grabmal, das in Form eines bearbeiteten und beschrifteten Natursteins am Kopfende eines Grabes aufgestellt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grabstein"@de .

lvr_fund:grabstichel a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grabstichel"@de .

lvr_fund:graffiti a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Graffiti"@de .

lvr_fund:grafik_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grafik (visuelles Werk)"@de .

lvr_fund:granate_waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Granate ist ein Sprengkörper, der aus Geschützen oder Werfern abgefeuert wird. Sie wird in der Regel mit einer Treibladung verschossen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Granate (Waffe)"@de .

lvr_fund:grapen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Grapen ist ein bauchiger Kochtopf mit drei Standfüßen. Mit Henkel oder Griff versehen, wurden Grapen über die heiße Glut gestellt oder gehängt und dienten in erster Linie zum Kochen von Speisen. Frühe Exemplare wurden aus Irdenware, spätere Gefäße auch aus Metall hergestellt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grapen"@de .

lvr_fund:gravettespitze a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gravettespitze"@de .

lvr_fund:grenzstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Grenzstein ist ein Bauwerk, das im Gelände der Kennzeichnung eines eingemessenen Grenzpunktes dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grenzstein"@de .

lvr_fund:griff_bestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Griff ist der Bestandteil von Objekten, der es ermöglicht diese anzufassen, zu tragen oder zu bedienen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Griff (Bestandteil)"@de .

lvr_fund:griffel_schrift a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Griffel ist ein schmales, stabförmiges Gerät, das zum Schreiben, Zeichnen oder Ritzen auf verschiedenen Oberflächen, beispielsweise Wachs, Schiefer, Metall, Stein, verwendet wird. Er besitzt häufig eine angespitzte oder abgerundete Spitze, je nach Verwendungszweck. In der Regel wird er aus Metall, Holz, Knochen, Stein oder Kunststoff hergestellt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Griffel (Schrift)"@de .

lvr_fund:griffelkasten a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Griffelkasten"@de .

lvr_fund:griffknubbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Griffknubbe beschreibt die seitliche Handhabe an einem Gefäßkörper, die Handhabe an einem Deckel siehe Deckelknauf."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Griffknubbe"@de .

lvr_fund:griffoese a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grifföse"@de .

lvr_fund:grifftuelle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grifftülle"@de .

lvr_fund:grundform_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Grundform (Steinartefakt)"@de .

lvr_fund:guertel_bekleidungszubehoer a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Gürtel ist Bekleidungszubehör, das als Band mit einer Schnalle um die Taille oder Hüfte getragen wird, um Kleidungsstücke wie Röcke oder Hosen zu halten oder zu raffen, Gegenstände daran zu befestigen oder zu rein modischen Zwecken."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtel (Bekleidungszubehör)"@de .

lvr_fund:guertelbeschlag a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelbeschlag"@de .

lvr_fund:guertelbestandteil a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelbestandteil"@de .

lvr_fund:guertelgehaenge a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Gürtelgehänge sind Bekleidungszubehör, die auf oder unterhalb der Hüfte getragen werden. Es handelt sich um an einem Gürtel angebrachte Teile, wie beispielsweise Beutel, Toilettegeräte, Amulette und Schlüssel, die in einem Gehänge zusammengefasst sein können. Sie werden hauptsächlich von Frauen getragen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelgehänge"@de .

lvr_fund:guertelhaken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelhaken"@de .

lvr_fund:guertelring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelring"@de .

lvr_fund:guertelschnalle a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Eine Gürtelschnalle ist eine Schnalle, die zum Verschließen eines Gürtels dient. Dabei handelt es sich um einen Bügel mit einem oder mehreren Dornen, der an einem Riemen befestigt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürtelschnalle"@de .

lvr_fund:guerteltasche a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Eine Gürteltasche ist eine Tasche, die auf einen Gürtel gefädelt ist. Sie wird in der Regel um die Hüfte oder um die Taille geschnallt, vorwiegend seitlich oder vor dem Bauchbereich oder hinten über dem Gesäßbereich getragen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gürteltasche"@de .

lvr_fund:gussform a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gussform"@de .

lvr_fund:gusskuchen a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gusskuchen"@de .

lvr_fund:gusstiegel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Gusstiegel"@de .

lvr_fund:haarnadel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Haarnadel ist ein Haaraccessoire zum Feststecken und/oder zum Schmücken der Haare. Haarnadeln bestehen aus einem einzelnen dünnen Stab mit oft mehr oder weniger verziertem Kopf. Modernere Versionen können auch aus einem schlichten u-förmig gebogenen Draht oder Kunststoff bestehen, der bisweilen rein funktional und in der Frisur unsichtbar ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Haarnadel"@de .

lvr_fund:hacke_landwirtschaft a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Hacke ist ein manuelles Bodenbearbeitungsgerät, das der Lockerung der Erde dient. Sie besteht aus einem flachen, spitzen oder gezinkten Blatt, das quer zum Schaft stehend auf einem Stiel montiert ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hacke (Landwirtschaft)"@de .

lvr_fund:haken_befestigungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Haken (Befestigungselement)"@de .

lvr_fund:halbfabrikat a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Halbfabrikat"@de .

lvr_fund:halbkeil_kerngeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Halbkeil (Kerngerät)"@de .

lvr_fund:halskette a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Halskette ist ein Schmuckstück, das um den Hals getragen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Halskette"@de .

lvr_fund:halsring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Halsring"@de .

lvr_fund:hammer_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für das vollständige Werkzeug Hammer bestehend aus Kopf und Stiel, ist nur der Kopf erhalten s. Hammerkopf"@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hammer (Werkzeug)"@de ;
    skos:scopeNote "Unter Nutzung seiner beschleunigten Masse werden mit einem meist stumpfen Kopf Schläge auf Körper ausgeübt."@de .

lvr_fund:handhabe_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Handhabe (Behälter)"@de .

lvr_fund:handschuh a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Handschuh"@de .

lvr_fund:harpune a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Harpune ist ein Fischereigerät, das in Speerform oder Pfeilform mit Widerhaken und Fangleine zur Jagd auf Wassertiere genutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Harpune"@de ;
    skos:scopeNote "Harpunen zählen zu den ältesten und am weitesten verbreiteten Jagdgeräten und Fanggeräten; in Folge dessen gibt es eine stete technische Fortentwicklung."@de .

lvr_fund:haushaltsgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Haushaltsgerät ist ein Gerät, das zur Bewältigung von Arbeiten und Aufgaben im Haushalt verwendet wird. Es gibt elektrisch (etwa Herd, Waschmaschine, Staubsauger, Haartrockner) und mechanisch (beispielsweise Dosenöffner, Küchenwaage) betriebene sowie einfache Haushaltsgeräte (etwa Messbecher, Besen)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Haushaltsgerät"@de .

lvr_fund:hechel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hechel (Gerät)"@de .

lvr_fund:heizanlage a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Heizanlage ist eine Gerätschaft, die ein Gebäude in seiner Gesamtheit oder seine einzelnen Räume erwärmt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Heizanlage"@de .

lvr_fund:helm_kopfbedeckung a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Helm ist eine schützende Kopfbedeckung, die aus formstabilem, in der Regel schlagfestem und stoßfestem Material besteht und die den Kopf ganz oder teilweise umschließt. Neben der Schutzfunktion vor Kopfverletzungen in den Bereichen Militär, Beruf, Sport und Freizeit gibt es auch Helme, die der Repräsentation dienen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Helm (Kopfbedeckung)"@de .

lvr_fund:hemd_oberbekleidung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Hemd ist Oberbekleidung mit kurzen oder langen Ärmeln, welches hauptsächlich locker in oder über den Bund einer Hose oder eines Rockes getragen wird. Hemden haben häufig einen Kragen und werden in klassischer Form durch Knöpfe geschlossen. Kleine Taschen, vor allem auf Brusthöhe, kommen vor."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hemd (Oberbekleidung)"@de .

lvr_fund:henkel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Henkel ist ein Griff, der oben oder seitlich an einem Behälter sitzt, meist die Form eines gebogenen Bandes besitzt und der es ermöglicht, den Behälter mit der Hand zu heben oder zu halten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Henkel"@de .

lvr_fund:hobel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Hobel ist ein Gerät zur Holzbearbeitung, mit dem die Oberfläche eines hölzernen Gegenstandes durch das Abheben von Spänen bearbeitet und geglättet werden kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hobel"@de .

lvr_fund:horn_musikinstrument a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Horn (Musikinstrument)"@de .

lvr_fund:hose a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hose"@de .

lvr_fund:hufeisen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hufeisen"@de .

lvr_fund:hypokaustum a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Hypokaustum ist eine Fußbodenheizung, die für einzelne Räume in römischen Thermen, vornehmen Wohnhäusern, Villen und Palästen verwendet wurde."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hypokaustum"@de .

lvr_fund:hypokaustziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hypokaustziegel"@de .

lvr_fund:hypokaustziegelplatte a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Hypokaustziegelplatte"@de .

lvr_fund:imbrex a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Imbrex ist ein halbröhrenförmiger römischer Dachziegel, der die Stoßfuge zweier nebeneinander liegender Tegulae abdeckt, um die Dachbedeckung abzudichten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Imbrex"@de .

lvr_fund:inschrift a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Inschrift ist ein Dokument, das aus Zeichen besteht, die in oder auf hartem Material wie Stein, Glas, Keramik oder Metall eingetragen wurden und eine auf Dauer bestimmte Mitteilungen ist"@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Inschrift"@de .

lvr_fund:joch_geschirrbestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Joch ist Bestandteil eines Zuggeschirrs und besteht aus einem oft geschwungenen hölzernen Balken, der den Zugtieren an Stirn, Nacken oder Widerrist befestigt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Joch (Geschirrbestandteil)"@de .

lvr_fund:kalender a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Der Kalender ist eine Dokumentengattung, bei der die zeitliche Abfolge innerhalb eines Jahres abgebildet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kalender"@de .

lvr_fund:kamin_architekturelement a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kamin (Architekturelement)"@de .

lvr_fund:kamm_koerperpflege a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kamm (Körperpflege)"@de .

lvr_fund:kandare a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Kandare ist ein Gebiss in Form einer ungebrochenen Stange aus Metall mit seitlichen Querschenkeln und Kinnkette, das eine Hebelwirkung auf das Pferdemaul ausübt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kandare"@de .

lvr_fund:kandelaber_mobiler_standleuchter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kandelaber ist ein mehrarmiger Leuchter mit Standfuß."@de ;
    skos:editorialNote "Nur für den mobilen Standleuchter zu verwenden, für die Straßenlaterne benutze Unterbegriffe von [Straßenleuchte] (wk007113)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kandelaber (mobiler Standleuchter)"@de .

lvr_fund:kanne_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Kanne ist ein Gefäß mit einer Ausgußvorrichtung, meist in Form eines schnabelförmigen, schnauzenförmigen oder röhrenförmigem Ausgusses. Außerdem verfügen Kannen über mindestens einen Henkel, seltener einen Bügel; ein Deckel ist möglich. Vor allem antike Gefäße können eine abgesetzte Halszone besitzen. Prinzipiell werden Kannen zum Ausgießen und Aufbewahren von Flüssigkeiten verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kanne"@de ;
    skos:scopeNote "Die Fachliteratur ist besonders in Bezug auf die typologischen Merkmalen von Kanne und Krug nicht immer kongruent. Der Begriff Kanne soll hier als Gefäß mit Ausguss im Gegensatz zu dem Begriff Krug ohne Ausguss verstanden werden. Formale und funktionale Überlappungen beider Gefäße sind bekannt, sollen aber in der Definition nicht berücksichtigt werden."@de .

lvr_fund:kanonenkugel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kanonenkugel"@de .

lvr_fund:kapitell a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Kapitell ist ein Architekturelement, das als oberer Abschluss einer Säule oder einem Pilaster aufgesetzt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kapitell"@de .

lvr_fund:kasserolle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Die Kasserolle ist ein flacher, runder Kochtopf mit Stiel oder zwei Henkeln. Sie wird vorwiegend zum Braten und zum Schmoren verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kasserolle"@de .

lvr_fund:kasten_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kasten ist ein rechteckiger Behälter mit oder ohne Deckel, der zur Aufbewahrung oder zum Transport von Gegenständen oder Materialien dient"@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kasten (Behälter)"@de .

lvr_fund:keil_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Keil (Gerät)"@de .

lvr_fund:keilmesser a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Keilmesser"@de .

lvr_fund:kelch_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Kelch ist ein liturgisches Gefäß, das als Trinkgefäß für den Messwein in der christlichen Messe dient. Er besteht aus Fuß, Schaft mit Knauf sowie Kuppa und ist meist aus Metall gefertigt."@de ;
    skos:editorialNote "Benutzt für das liturgische Trinkgefäß. Für profane Gefäße in Kelchform oder ähnlich benutze Stielglas für solche aus Glas, Fußbecher wk020814 für solche aus anderen Materialien und ohne Stiel oder Pokal (Trinkgefäß) wk019116 für besonders große oder repräsentative Exemplare."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kelch"@de .

lvr_fund:kerbrest a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kerbrest"@de .

lvr_fund:kerbspitze_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kerbspitze (Steinwerkzeug)"@de .

lvr_fund:kern_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kern (Steinartefakt)"@de .

lvr_fund:kerngeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kerngerät ist ein Steinwerkzeug, welches subtraktiv aus einer Rohknolle herausgearbeitet wurde und keine Grundform zur Basis hat."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kerngerät"@de .

lvr_fund:kernscheibe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kernscheibe"@de .

lvr_fund:kerzenhalter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kerzenhalter ist eine Leuchte, die Kerzen als Leuchtmittel fasst."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kerzenhalter"@de .

lvr_fund:kessel_topf a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Kessel ist ein großer Topf aus Metall mit offenem, bauchigem Gefäßkörper und rundem oder abgerundetem Boden. Er besitzt meist einen Bügel oder mehrere Ösen zur Aufhängung."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kessel"@de .

lvr_fund:kesselhaken a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Kesselhaken ist eine Gerätschaft, die dem höhenverstellbaren Aufhängen des Kessels über einer Herd- oder Feuerstelle dient. Sie besitzt Haken und kann darüberhinaus aus Ringen, Stangen- oder Kettengliedern, und/oder einer Platte mit Zähnen bestehen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kesselhaken"@de .

lvr_fund:kette_objektgattung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Kette ist eine Objektgattung, die aus in Reihe verbundenen Gliedern, meist aus Metall, besteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kette (Objektgattung)"@de .

lvr_fund:kettenpanzer a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Der Kettenpanzer ist eine Schutzausrüstung, bei der die einzelnen Teile aus kleinen, ineinander verflochtenen Metallringen bestehen, die auf einem Lederstück befestigt waren."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kettenpanzer"@de .

lvr_fund:keule_schlagwaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Keule ist eine Schlagwaffe, oft aus Holz, Knochen oder Metall, die am unteren Ende verdickt ist oder einen Schlagkopf aus Stein oder anderen schweren Materialien besitzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Keule (Schlagwaffe)"@de .

lvr_fund:keulenkopf a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Keulenkopf"@de .

lvr_fund:kielkratzer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kielkratzer"@de .

lvr_fund:kielstichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kielstichel"@de .

lvr_fund:kienspanhalter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kienspanhalter"@de .

lvr_fund:klammer_technik a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klammer (Technik)"@de .

lvr_fund:klapper_musikinstrument a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Klapper ist ein Idiofon, das aus zwei gegeneinander schlagenden Teilen besteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klapper (Musikinstrument)"@de .

lvr_fund:kleid a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kleid ist eine einteilige Oberbekleidung für Frauen und Mädchen, mit einem Oberteil und einem Rockteil."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kleid"@de .

lvr_fund:kleidungsstueck a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kleidungsstück ist Ausstattung, die den Körper des Menschen bedeckt. Seine Funktion ist der Schutz vor Witterung, vor Verletzung und das Verhüllen, sie dient aber auch als Kommunikationsmittel, zum Schmuck und als Ausdruck von Mode."@de ;
    skos:editorialNote "Für konfektionierte Kleidung aus Leder, Pelz und Ähnlichem, zu denen auch Kopfbedeckungen und Fußbekleidung zählen. Für rein schmückende Accessoires verwende Schmuckstück (wk005710)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kleidungsstück"@de .

lvr_fund:klinge_geraeteteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klinge (Geräteteil)"@de .

lvr_fund:klinge_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klinge (Steinartefakt)"@de .

lvr_fund:klingengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klingengerät"@de .

lvr_fund:klingenkern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klingenkern"@de .

lvr_fund:klingenkratzer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Klingenkratzer"@de .

lvr_fund:knauf a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Knauf ist ein knopfartiger, gerundeter Griff."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Knauf"@de .

lvr_fund:kniefibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kniefibel"@de .

lvr_fund:knopf_verschluss a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Knopf (Verschluss)"@de .

lvr_fund:koerperschmuck a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Körperschmuck"@de .

lvr_fund:kombinationsgeraet_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kombinationsgerät (Steinwerkzeug)"@de .

lvr_fund:kommode a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kommode"@de .

lvr_fund:korb_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Korb ist ein geflochtener Behälter, meist aus biegsamem Holz oder anderen flexiblen Materialien, der zum Transport und Lagern von Lasten oder Materialien verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Korb (Behälter)"@de .

lvr_fund:kostenki_ende a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kostenki-Ende"@de .

lvr_fund:kratzer_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kratzer (Steinwerkzeug)"@de .

lvr_fund:kreuz_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kreuz ist ein visuelles Werk in Form eines Kreuzes. Es handelt sich dabei um größere, im Raum errichtete Bildwerke oder um bewegliche Gegenstände der christlichen Kultur."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kreuz (visuelles Werk)"@de .

lvr_fund:kuechenherd a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Küchenherd ist eine Gerätschaft, mit der man Speisen kochen, braten und backen kann und die die Kochstelle innerhalb eines Hauses darstellt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Küchenherd"@de .

lvr_fund:kugel_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kugel (Objekttyp)"@de .

lvr_fund:kugelboden a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kugelboden ist ein Gefäßboden, der nach außen gewölbt ist und keinen Absatz zur Gefäßwandung sowie keine Standfläche besitzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kugelboden"@de ;
    skos:scopeNote "Kugelböden sind vor allem von hochmittelalterlichen Kugeltöpfen bekannt, kommen aber auch in anderen Zeitepochen wie beispielsweise in der jungneolithischen Michelsberger Kultur vor."@de .

lvr_fund:kultgeraet a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kultgerät"@de .

lvr_fund:kummet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Kummet ist ein Zuggeschirr, dessen Hauptbestandteil ein gepolsterter Bügel ist, der den Zugtieren um den Hals gelegt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kummet"@de .

lvr_fund:kumpf_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Kumpf ist ein bauchiges Gefäß mit rundem Boden, in der Regel ohne Handhabe. Häufig weisen Kumpfe eingeritzte oder erhabene Verzierungen auf."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kumpf"@de .

lvr_fund:kurzer_kratzer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Kurzer Kratzer"@de .

lvr_fund:lacan_stichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lacan-Stichel"@de .

lvr_fund:laeuferstein_muehle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Läuferstein (Mühle)"@de .

lvr_fund:lamelle_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lamelle (Steinartefakt)"@de .

lvr_fund:lamellenkern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lamellenkern"@de .

lvr_fund:lamellenpanzer a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Lamellenpanzer ist eine Panzerung, die aus überlappend miteinander vernähten, meist rechteckigen Plättchen besteht. Diese Lamellen können aus Metall, gehärtetem Leder, Knochen oder anderen Materialien sein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lamellenpanzer"@de .

lvr_fund:landkarte a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Landkarte ist analoges oder digitales kartographisches Material, das als zweidimensionales Medium geographische Daten maßstäblich repräsentiert. Georäumliches Wissen wird auf Basis kartographischer Abbildungsbedingungen eingeebnet, verkleinert, vereinfacht und mit Beschreibungen und Zeichen versehen dargestellt. Sachverhalte und Prozesse können über eine Karte in einen inhaltlichen Zusammenhang gestellt und übersichtlich vermittelt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Landkarte"@de .

lvr_fund:landwirtschaftliches_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein landwirtschaftliches Gerät ist ein Gerät, das zur Bodenkultivierung, zur Produktion von Kulturpflanzen oder für die Aufzucht von Vieh verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Landwirtschaftliches Gerät"@de .

lvr_fund:lanzenschuh a skos:Concept ;
    skos:broader lvr_fund:lanze_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lanzenschuh"@de .

lvr_fund:lanzenspitze a skos:Concept ;
    skos:broader lvr_fund:lanze_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lanzenspitze"@de .

lvr_fund:lateralretusche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lateralretusche"@de .

lvr_fund:laterne_objekt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für Beleuchtungskörper bestehend aus einer Lichtquelle mit Schutzgehäuse; für den Beleuchtungskörper der Straßenbeleuchtung siehe Straßenlampe."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Laterne (Objekt)"@de .

lvr_fund:leichenbrand a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Leichenbrand"@de ;
    skos:scopeNote "Meist handelt es sich um die verbrannten und kalzinierten Knochen der Verstorbenen."@de .

lvr_fund:leitungsrohr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Leitungsrohr"@de .

lvr_fund:leuchte a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Leuchte"@de .

lvr_fund:levalloiskern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Levalloiskern"@de .

lvr_fund:levalloisspitze a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Levalloisspitze"@de .

lvr_fund:linsenboden a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Linsenboden ist ein Gefäßboden, der am Übergang zur Wandung abgerundet oder geknickt erscheint. Im Unterschied zum Kugelboden ist er weniger gerundet und nicht durch Druck geformt sondern durch Beschneiden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Linsenboden"@de ;
    skos:scopeNote "Der Linsenboden ist ein Charakteristikum karolingischer Gefäßkeramik. Bei der Herstellung wird der verdickte Boden, von der unteren Gefäßwandung ausgehend, mittels Schnitten in eine rundliche Form gebracht. Am Übergang von Wandung zu Boden können deshalb Schnittgrate beobachtet werden. Das Gefäß kann noch stehen, ist aber durch die Rundung im Stand instabil."@de .

lvr_fund:liturgisches_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Liturgisches Gerät"@de .

lvr_fund:liturgisches_gewand a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Liturgisches Gewand ist eine Zeremonialkleidung, die während eines Gottesdienstes oder gottesdienstlicher Feiern getragen wird und das verhüllen des Irdischen versinnbildlicht. Liturgische Gewänder werden ausschließlich vom Leiter der Feier und den liturgischen Diensten getragen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Liturgisches Gewand"@de .

lvr_fund:loeffel_kuechengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Löffel (Küchengerät)"@de .

lvr_fund:lot_bauwesen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Lot ist ein Messgerät zur Bestimmung der Vertikalen, bestehend aus einem spitz zulaufenden Stück Metall, das am Ende einer Schnur hängt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Lot (Bauwesen)"@de .

lvr_fund:maasei a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Maasei ist ein natürliches Objekt, das als kleine stark abgerollte Feuersteinknolle eine kugelige bis ellipsoide Form besitzt. Die charakteristische Rinde der Knolle ist schwarz, dunkelgrau bis hellgrau beziehungsweise grau-blau."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Maasei"@de .

lvr_fund:mahlstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mahlstein"@de .

lvr_fund:malerei_verfahren a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Malerei (Verfahren)"@de .

lvr_fund:mappe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Mappe ist ein Dokumentenbehälter zur Aufbewahrung von Dokumenten oder ähnlich dünnen Gegenständen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mappe"@de .

lvr_fund:marke_informationstraeger a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Marke (Informationsträger)"@de .

lvr_fund:markenzeichen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Markenzeichen ist ein Logo, das als visuelles Erkennungszeichen eines bestimmten Produkts oder einer Handelsmarke dient und als solches rechtlich geschützt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Markenzeichen"@de .

lvr_fund:maske_kostuemierung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Maske ist ein Kleidungsstück, das das Gesicht ganz oder teilweise verdeckt. Sie kann auch über das Gesicht hinaus den Kopf bedecken. In der Regel gibt es Öffnungen für die Augen, Mund oder Nase. Sie wird hauptsächlich zur Veränderung des Aussehens, zur Verschleierung der Identität getragen; vor allem im Zusammenhang mit Bräuchen, Zeremonien oder aus künstlerischen Aspekten."@de ;
    skos:editorialNote "Verwendet für Masken, die das Gesicht bedecken und im Zusammenhang mit einer Verkleidung stehen. Für Masken, die dem Schutz dienen, benutze Atemmaske (Schutzausrüstung) (wk017587). Für Masken, die nicht zur Kleidung gehören, sondern etwa als Schmuck an Objekten dienen, benutze Maske (Bildwerk) (wk020930)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Maske (Kostümierung)"@de .

lvr_fund:materialprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Materialprobe ist eine Probe, die unterschiedliche Materialentnahmen zum Zwecke der weiteren wissenschaftlichen Untersuchung zusammenfasst."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Materialprobe"@de .

lvr_fund:matrize_stempel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Matrize (Stempel)"@de .

lvr_fund:mauer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Mauer ist ein begrenzendes Bauteil oder Bauwerk, das als massive Konstruktion aus anorganischen Materialien wie Naturstein, Backstein, Beton usw. besteht und dessen Dicke deutlich geringer ist als seine horizontale und vertikale Ausdehnung."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mauer"@de .

lvr_fund:mauerziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Mauerziegel ist Baukeramik, die aus Ton oder Lehm geformt ist, durch Brennen gehärtet und wetterfest gemacht und als Mauerstein verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mauerziegel"@de .

lvr_fund:medaille a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Medaille"@de .

lvr_fund:medaillon_schmuckstueck a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Medaillon ist ein Anhänger in Form eines kleinen aufklappbaren Behältnisses, das in der Regel ein Erinnerungsstück enthält. Die vordere Schauseite ist oft aufwendig verziert; die Rückseite graviert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Medaillon (Schmuckstück)"@de .

lvr_fund:medizinisches_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein medizinisches Gerät ist ein Gerät, das für medizinische Anwendungen genutzt wird. Dazu gehören Instrumente, Apparate und Vorrichtungen, die der Diagnostik, Therapie, gesundheitlichen Überwachung und Verhütung von Krankheiten oder Verletzungen am Menschen dienen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Medizinisches Gerät"@de ;
    skos:scopeNote "Medizinische Geräte umfassen eine Vielzahl von Geräten, Instrumenten, Apparaten oder Maschinen, die in der medizinischen Versorgung eingesetzt werden. Medizinische Geräte können sowohl für diagnostische als auch therapeutische Zwecke verwendet werden und reichen von einfachen Instrumenten bis hin zu komplexen technologischen Systemen."@de .

lvr_fund:mehrschlagstichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mehrschlagstichel"@de .

lvr_fund:meilenstein_entfernungsanzeiger a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Meilenstein (Entfernungsanzeiger)"@de .

lvr_fund:meissel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Meißel"@de ;
    skos:scopeNote "Ein Meißel ist meist aus Metall und hat eine keilartige Schneide sowie eine Schlagfläche. Er wird in Verbindung mit einem Hammer oder Schlägel verwendet."@de .

lvr_fund:menschlicher_ueberrest a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Menschlicher Überrest ist ein organischer Überrest, der vom Menschen stammt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Menschlicher Überrest"@de .

lvr_fund:messer_schneidewerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Messer ist ein Schneidewerkzeug, das über eine Klinge mit Schneide und einen Griff verfügt."@de ;
    skos:editorialNote "Messer können in ihrer Funktion sowohl als Schneidwerkzeug für gezielte Schneidvorgänge, als Küchengerät zur Zubereitung von Lebensmitteln als auch als Waffe verwendet werden. Der Begriff „Messer“ (wk005412) kann als allgemeindeutiger Begriff genutzt werden. Entsprechende Unterbegriffe werden gezielt polyhierarchisch unter dem jeweils spezifischeren Oberbegriff abgelegt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Messer (Schneidewerkzeug)"@de .

lvr_fund:messgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Messgerät ist ein Gerät zur Bestimmung von geometrischen oder physikalischen Größen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Messgerät"@de .

lvr_fund:mikrolith_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mikrolith (Steinwerkzeug)"@de .

lvr_fund:mikrospitze_mikrolith a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mikrospitze (Mikrolith)"@de .

lvr_fund:miniaturgemaelde a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Miniaturgemälde"@de .

lvr_fund:model_form a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Model (Form)"@de .

lvr_fund:moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Möbel ist ein großer Einrichtungsgegenstand, der der funktionalen oder dekorativen Ausstattung von Innenräumen und Außenräumen dient. Dazu zählen in erster Linie Gegenstände zum Sitzen und Liegen, Behältnismöbel sowie Tische und andere Ablagemöbel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Möbel"@de .

lvr_fund:moebelbeschlag a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Möbelbeschlag"@de .

lvr_fund:moebelbestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Möbelbestandteil ist ein zu einem Möbelstück gehörendes Element."@de ;
    skos:editorialNote "Benutzt für Bestandteile von Möbeln."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Möbelbestandteil"@de .

lvr_fund:moench_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mönch (Architektur)"@de .

lvr_fund:moerser_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Mörser ist ein Gerät zum Zerkleinern von trockenem Material, das aus einem schalenartigen oder napfartigen Gefäß und einem Stößel besteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mörser (Werkzeug)"@de ;
    skos:scopeNote "Die Schale (ohne den Stößel) wird umgangssprachlich auch als Mörser bezeichnet."@de .

lvr_fund:monstranz a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Monstranz ist ein liturgisches Gefäß der katholischen Kirche, in dem eine geweihte Hostie zur Schau gestellt wird. Es ist üblicherweise reich verziert und aus kostbaren Materialien. Der oft verglaste Aufsatz mit Halterung für die Hostie steht auf Fuß und Schaft."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Monstranz"@de .

lvr_fund:mosaik_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mosaik (visuelles Werk)"@de .

lvr_fund:mosaikstein a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Mosaikstein ist Teil eines Mosaiks, das aus viereckigen, mehreckigen oder runden Plättchen oder Stiften von farbigem Marmor, Glas, Stein, Fliesen oder ähnlichen harten Materialien besteht. Die Mosaiksteine werden in unterschiedlichen Größen, in der Regel von 0,1 cm bis 2,0 cm, verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mosaikstein"@de .

lvr_fund:muenze_tauschmittel a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Münze (Tauschmittel)"@de .

lvr_fund:mundblech a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Mundblech"@de .

lvr_fund:murmel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Murmel"@de .

lvr_fund:musikinstrument a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Musikinstrument ist ein Tonerzeuger, das dazu bestimmt ist, auf ihm Musik zu spielen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Musikinstrument"@de .

lvr_fund:nadel_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Nadel ist ein Objekt, das aus einem länglichen, schmalen Schaft und einem spitz zulaufenden Ende besteht. Das andere Ende ist unterschiedlich geformt, je nach Verwendungszweck."@de ;
    skos:editorialNote "Eine Nadel kann zur Verarbeitung von Textilien, zum Verschluss von Kleidungsstücken, zur Verarbeitung von Metallen, zur Körperverzierung, zum Feststecken von Kopfschmuck und Haaren usw. verwendet werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nadel (Objekttyp)"@de .

lvr_fund:naehnadel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Nähnadel ist ein schlankes, spitzes Gerät zum Nähen und zum Durchstechen von textilem Material. Am oberen Ende besitzt die Nähnadel eine kreisförmige oder ovale Öffnung, durch die ein Faden geführt werden kann. Heutzutage sind Nähnadel üblicherweise aus Metall gefertigt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nähnadel"@de .

lvr_fund:nagel_befestigungselement a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Nagel ist ein Befestigungselement aus Metall oder Holz, das aus einem schlanken Schaft mit einem zugespitzten Ende und einem flachen Kopf besteht. Er wird in der Regel mit einem Hammer eingeschlagen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nagel (Befestigungselement)"@de .

lvr_fund:napf a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Napf ist ein kleines, offenes und breites Gefäß mit geringer Wandungshöhe. Er ist schmaler und höher als eine Schale und niedriger als ein Becher."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Napf"@de .

lvr_fund:napoleonshut_mahlstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Napoleonshut (Mahlstein)"@de .

lvr_fund:natuerlicher_truemmer a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Natürlicher Trümmer"@de .

lvr_fund:natur a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Natur"@de .

lvr_fund:netzschwimmer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Netzschwimmer"@de .

lvr_fund:netzsenker a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Netzsenker ist ein Fischereigerät in Form eines kleinen Gewichts, das das ausgebrachte Netz im Wasser beschwert, das heißt strafft und senkrecht hält. Netzsenker gibt es aus Blei, Ton und Stein, durchlocht oder mit Kerben versehen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Netzsenker"@de .

lvr_fund:niet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Niet ist ein Befestigungselement, das aus einen Metallbolzen besteht, der auf jeder Seite im einem Kopf endet. Ein Kopf ist vorgeformt und der zweite wird durch Druck erst geformt, wenn der Metallbolzen durch die zu verbindenden Teilen gesteckt wurde."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Niet"@de .

lvr_fund:nische_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Nische ist ein Bauteil, der als einseitig offene halbrunde, rechteckige oder polygonale Aussparung in einer Mauer, im Einzelfall auch in einem massiven Holz liegt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nische (Architektur)"@de ;
    skos:scopeNote "Wichtig an der Nische ist, dass sie zur Außenseite nicht vortritt. Andernfalls handelt es sich um einen Erker oder eine Auslucht. Im modernen Innenausbau kann eine Nische auch aus Leichtbauteilen hergestellt werden."@de .

lvr_fund:noailles_stichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Noailles-Stichel"@de .

lvr_fund:nonne_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nonne (Architektur)"@de .

lvr_fund:nuss_botanik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Nuss ist eine Frucht, deren Außenhülle vollständig verholzt ist. Im Inneren einer Nuss befindet sich ein Samen, der zumeist essbar ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Nuss (Botanik)"@de .

lvr_fund:obstkern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Obstkern ist ein Kern, der den Samen im Innern der Früchte von Kernobst bildet."@de ;
    skos:editorialNote "Für Kerne von Steinobst wie zum Beispiel Pflaumen oder Kirschen Obststein verwenden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Obstkern"@de ;
    skos:scopeNote "Kernobst gehört zur Familie der Rosengewächse. Dies sind unter anderem: Apfel, Birne, Quitte, Mispel, Eberesche."@de .

lvr_fund:oese_verbindungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Öse ist ein Verbindungselement, das die Form einer Schlinge oder eines Ringes hat. Ösen sind sowohl an Textilien und Lederwaren als auch an Konstruktionen zu finden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Öse (Verbindungselement)"@de ;
    skos:scopeNote "In die Ösen werden Haken eingehakt bzw. Schnüre durchgezogen, um so ein Gegenstück zu befestigen."@de .

lvr_fund:ofen_vorrichtung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Ofen ist eine Vorrichtung, die sowohl transportabel als auch fest eingebaut sein kann und zur Erzeugung von Wärme dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ofen (Vorrichtung)"@de .

lvr_fund:ofenkachel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Ofenkachel ist Keramik mit einer meist farbigen Glasur. Ofenkacheln sind namensgebende Bestandteile des Kachelofens, wärmespeichernd sowie wärmeabstrahlend."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ofenkachel"@de .

lvr_fund:ofensau a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ofensau"@de .

lvr_fund:ofenziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:editorialNote "Ofenziegel benutzt für Ziegel, die im Ofen verbaut sind und von außen nicht sichtbar sind; für die außen angebrachten Kacheln siehe Ofenkachel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ofenziegel"@de .

lvr_fund:ohrloeffel_toilettegeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ohrlöffel (Toilettegerät)"@de .

lvr_fund:ohrring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:definition "Ein Ohrring ist Ohrschmuck, der durch ein Loch im oder als Ohrclip am Ohrläppchen getragen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ohrring"@de .

lvr_fund:ohrschmuck a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ohrschmuck ist ein am Ohr getragenes Schmuckstück, das je nach Objekttyp auf unterschiedliche Art am oder im Ohr befestigt werden kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ohrschmuck"@de .

lvr_fund:optisch_stimulierte_lumineszenzprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine optisch stimulierte Lumineszenzprobe ist eine Materialprobe, die mit Hilfe einer Lumineszenz-Methode datiert wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Optisch stimulierte Lumineszenzprobe"@de .

lvr_fund:ortband a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Ortband ist ein Beschlag, der verhindern soll, dass die Scheidenspitze von Blankwaffen durch diese durchschnitten wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ortband"@de .

lvr_fund:paddel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Paddel (Gerät)"@de .

lvr_fund:panzerung_schutzkleidung a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Panzerung ist feste Schutzkleidung, die den Körper im Kampf vor Verletzungen durch Stiche, Stöße oder Schüsse schützen soll."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Panzerung (Schutzkleidung)"@de .

lvr_fund:patrize_stempel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Patrize (Stempel)"@de .

lvr_fund:perle_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Eine Perle ist ein visuelles Werk in Form eines kleinen, durchlochten Objektes, das aus unterschiedlichen Materialien und in verschiedenen Formen gefertigt sein kann. Perlen dienen, aufgefädelt oder aufgenäht, häufig als Schmuck."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Perle (visuelles Werk)"@de .

lvr_fund:pfahl_bauwesen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfahl (Bauwesen)"@de .

lvr_fund:pfahlschuh a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfahlschuh"@de .

lvr_fund:pfanne_kuechengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfanne (Küchengerät)"@de ;
    skos:scopeNote "Pfannen werden üblicherweise zum Braten benutzt, darin kann jedoch auch geschmort oder gebacken werden."@de .

lvr_fund:pfefferstreuer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfefferstreuer"@de .

lvr_fund:pfeife_tonerzeugendes_instrument a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfeife (Tonerzeugendes Instrument)"@de .

lvr_fund:pfeiler a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Pfeiler ist eine Stütze, die aus Mauerwerk besteht und rechteckigen, quadratischen, polygonalen oder runden Querschnitt hat."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfeiler"@de .

lvr_fund:pfeilschaftglaetter a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfeilschaftglätter"@de ;
    skos:scopeNote "Pfeilschaftglätter bestehen aus zwei Sandsteinen unterschiedlicher Härtegrade mit einer geraden und einer gewölbten Fläche. Parallel zur Längsachse verläuft auf der geraden Fläche eine Rille mit U-förmigem Querschnitt. Sie können paarig genutzt werden und waren meist aus Sandstein gefertigt."@de .

lvr_fund:pfeilspitze a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Pfeilspitze ist ein Waffenteil, das spitz zulaufend gefertigt und vorne am Schaft eines Projektils wie Pfeil oder Bolzen befestigt ist. Pfeilspitzen unterliegen einer großen Formenvielfalt und können nach Material, Schäftung und Form der Spitze klassifiziert werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfeilspitze"@de .

lvr_fund:pflanzlicher_ueberrest a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pflanzlicher Überrest"@de .

lvr_fund:pflug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Pflug ist ein Bodenbearbeitungsgerät zum Lockern und Wenden der Ackerkrume."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pflug"@de .

lvr_fund:pfosten a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfosten"@de .

lvr_fund:pfriem_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pfriem (Werkzeug)"@de .

lvr_fund:pilaster a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Pilaster ist ein Architekturelement, das wie eine Säule in Basis, Schaft und Kapitell gegliedert ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pilaster"@de .

lvr_fund:pilgerandenken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Pilgerandenken ist ein Souvenir, das an die Reise zu einer religiösen Stätte erinnert und als gesegnetes Objekt auch zum Schutz und als Heilsvermittler verwendet wurde."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pilgerandenken"@de .

lvr_fund:pilgerhorn a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pilgerhorn"@de .

lvr_fund:pilum a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Pilum ist ein Speer, der in römischen Legionen benutzt wurde und aus einem hölzernen Schaft und einer ebenso langen eisernen Pilumspitze mit Widerhaken bestand."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pilum"@de .

lvr_fund:pinzette a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pinzette"@de .

lvr_fund:pistole_handfeuerwaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Pistole ist eine Handfeuerwaffe mit kurzem Lauf, die mit einer Hand geschossen werden kann. Differenziert wird zwischen Einzelladerpistolen, Mehrladerpistolen und Revolvern."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pistole (Handfeuerwaffe)"@de .

lvr_fund:pistolenkugel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pistolenkugel"@de .

lvr_fund:plakat a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Plakat"@de .

lvr_fund:plakette a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Plakette"@de .

lvr_fund:planke_brett a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Planke (Brett)"@de .

lvr_fund:plastik_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Plastik ist ein visuelles Werk, das modelliert oder gegossen wird."@de ;
    skos:editorialNote "Benutzt für visuelle Werke, die aus Materialien modelliert oder gegossen werden; für visuelle Werke, die aus einem Material herausgearbeitet werden, siehe Skulptur."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Plastik (visuelles Werk)"@de .

lvr_fund:platte_geschirr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Platte (Geschirr)"@de .

lvr_fund:platte_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Platte ist ein Objekttyp, der flächig ist und aus steifem Material hergestellt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Platte (Objekttyp)"@de .

lvr_fund:plombe_siegel a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Plombe (Siegel)"@de .

lvr_fund:pokal_trinkgefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Pokal ist ein Trinkgefäß, dessen Kuppa auf einem hohen Schaft mit Fuß sitzt und das reich verziert ist. Im Gegensatz zum Kelch ist der Pokal ein profanes und oft größeres Prunkgefäß."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pokal (Trinkgefäß)"@de ;
    skos:scopeNote "Die weltlichen Pokale entwickelten sich im späten Mittelalter aus den christlichen Kelchen und waren bis etwa ins 18. Jahrhundert verbreitet. Später entstand die gleichnamige Trophäe nach dem Vorbild des Pokals."@de .

lvr_fund:pollenprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pollenprobe"@de .

lvr_fund:positiv_foto a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Positiv (Foto)"@de .

lvr_fund:posthorn a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Posthorn"@de .

lvr_fund:probe_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Probe (Objekttyp)"@de .

lvr_fund:probierstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Probierstein ist ein einfaches Gerät aus einem einfarbig dunklen Gestein, mit dem Zusammensetzung und Reinheitsgrad von Edelmetallen geprüft werden. Oft wird ein Lydit als Probierstein verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Probierstein"@de .

lvr_fund:produktionsabfall a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Materialabfall ist ein Reststoff, der während des Produktionsprozesses anfällt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Produktionsabfall"@de .

lvr_fund:pumpe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Pumpe ist ein Fördersystem, das der Förderung von Flüssigkeiten, Gasen und ähnlichem dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Pumpe"@de .

lvr_fund:puppe_spielzeug a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Puppe ist ein Spielzeug in Form einer dreidimensionalen und manipulierbaren Nachbildung eines Menschen oder einer menschenähnlichen Gestalt, die beim kindlichen Rollenspiel Verwendung findet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Puppe (Spielzeug)"@de .

lvr_fund:putz_baustoff a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Putz (Baustoff)"@de .

lvr_fund:quina_schaber a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Quina-Schaber"@de .

lvr_fund:rad_maschinenelement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rad (Maschinenelement)"@de .

lvr_fund:radiokarbonprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Radiokarbonprobe ist eine Materialprobe, die für die Datierung, insbesondere von organischen Stoffen, mit der Radiokarbonmethode genommen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Radiokarbonprobe"@de .

lvr_fund:radnabe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Radnabe"@de .

lvr_fund:radspeiche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Radspeiche ist ein Bestandteil einiger Räder, der die Verbindung zwischen Radnabe und Felge bildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Radspeiche"@de .

lvr_fund:raeuchergeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Räuchergerät"@de .

lvr_fund:randscherbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Randscherbe ist eine Scherbe, die von der Randzone eines Gefäßes stammt."@de ;
    skos:editorialNote "Benutzt für Scherben aus Ton, Glas und Porzellan; für Fragmente aus anderen Materialien nutze Gefäßrand."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Randscherbe"@de .

lvr_fund:rasiermesser a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "In der vorgeschichtlichen Archäologie werden sowohl einschneidige, halbmondförmige Objekte mit seitlichem Griff als auch zweischneidige Objekte mit zentralem Griff und sehr dünnen Schneiden als Rasiermesser bezeichnet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rasiermesser"@de .

lvr_fund:rassel_musikinstrument a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Rassel ist ein Idiofon, das aus einem Hohlkörper besteht, der mit Kleinteilen unterschiedlicher Art befüllt ist. Durch Schütteln des Instruments schlagen die losen Teile im Inneren des Hohlkörpers gegeneinander oder gegen den festen Teil und erzeugen so Geräusche."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rassel (Musikinstrument)"@de .

lvr_fund:rechen_bodenbearbeitungsgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Rechen ist ein Ackergerät, das sowohl zum Sammeln von pflanzlichem Material wie Gras, Heu oder Stroh sowie zum Einebnen des Bodens verwendet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rechen (Bodenbearbeitungsgerät)"@de .

lvr_fund:rechengeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rechengerät"@de .

lvr_fund:regal_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Regal (Möbel)"@de .

lvr_fund:reibplatte a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für Reibplatten zum Zermahlen von Kräutern, Getreiden, Farbpigmenten, Erzen usw.; für die Verwendung im kosmetischen Bereich siehe Schminkpalette."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Reibplatte"@de .

lvr_fund:reibschale a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Reibschale ist ein schalenförmiger Mörser aus Keramik, dessen Innenwandung geraut oder mit Steingrus besetzt ist. Sie hat einen deutlich abgesetzten Rand mit flachem Ausguss und wurde in römischer Zeit etwa zum Zerreiben und Mischen von Milchprodukten, Würzsaucen, Kräutern, Gewürzen und ähnlichem verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Reibschale"@de .

lvr_fund:reibstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Reibstein"@de .

lvr_fund:relief_kunst a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Relief ist eine Bildhauertechnik, bei der Figuren oder Ornamente plastisch auf einer Fläche gestaltet werden, sodass sie sich von dieser abheben oder in diese eingesenkt sind. Die Gestaltung kann durch direktes Bearbeiten des Materials, durch Gießen in eine vorgeformte Negativform oder durch andere formgebende Verfahren erfolgen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Relief (Kunst)"@de .

lvr_fund:reliquiar a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Reliquiar"@de .

lvr_fund:retuscheur_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Retuscheur (Gerät)"@de .

lvr_fund:riegel_bauteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Riegel ist der Bestandteil eines Fachwerks, der waagerecht zwischen Stützen gezapft oder auf diese aufgeblattet ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Riegel (Bauteil)"@de .

lvr_fund:riemen_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Riemen ist ein Gerät, das zur Fortbewegung von Ruderbooten und Ruderschiffen genutzt wird. Es besteht in der Regel aus einem Schaft mit beweglicher Manschette, einem Griff und einem Ruderblatt. Beim Rudern wird ein Riemen mit beiden Händen bedient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Riemen (Gerät)"@de ;
    skos:scopeNote "Im Rudersport wird der Riemen in eine Dolle eingelegt. Diese Vorrichtung befestigt den Riemen an der Bordkante oder am Ausleger."@de .

lvr_fund:riemenverteiler a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Riemenverteiler"@de ;
    skos:scopeNote "Ein Riemenverteiler besteht zumeist aus einem Ring oder einer Platte mit oder ohne Ösen, das die gleichmäßige und passgenaue Position der einzelnen abgehenden Riemen von Schwert- und anderen Gehängen oder Pferdegeschirren sicherstellt."@de .

lvr_fund:riemenzunge_beschlag a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Riemenzunge (Beschlag)"@de ;
    skos:scopeNote "Die Riemenzunge dient zum leichteren Durchziehen des Riemens durch die Gürtelschnalle oder zum Beschweren eines frei nach unten hängenden Gürtelendes, das er gleichzeitig schützt und schmückt."@de .

lvr_fund:ring_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Ring ist ein Objekttyp, der durch eine geschlossene kreisförmige Form gekennzeichnet ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ring (Objekttyp)"@de .

lvr_fund:rohknolle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Sollte ausschließlich für im Grabungskontext aufgefundene Stücke verwendet werden, deren Zusammenhang mit der Fundstelle eindeutig ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rohknolle"@de .

lvr_fund:rohling_fertigung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Rohling ist ein Halbfabrikat, das erst durch Fertigungsprozesse eine individuelle Form erhält, eine Weiterverarbeitung ist vorgesehen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rohling (Fertigung)"@de .

lvr_fund:rohr_technik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rohr (Technik)"@de .

lvr_fund:rohstoff a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rohstoff"@de .

lvr_fund:rossharnisch a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Rossharnisch ist eine Schutzwaffe oder ein Tierzubehör, das als Plattenrüstung auf ein Schlachtross gelegt wird und zu dessen Schutz dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rossharnisch"@de .

lvr_fund:rueckenmesser_lateralretusche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Rückenmesser (Lateralretusche)"@de .

lvr_fund:saege_schneidewerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Säge ist ein Schneidewerkzeug zum Zerteilen harter Materialien, das aus einer Halterung besteht, in die ein gezähntes Blatt aus Stahl eingespannt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Säge (Schneidewerkzeug)"@de .

lvr_fund:saeule a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Säule ist eine Stütze, die einen kreisförmigen Querschnitt hat, im Gegensatz zum Rundpfeiler in der Regel mit Verjüngung und manchmal auch mit Entasis. Sie lässt sich gewöhnlich in Basis, Schaft und Kapitell gliedern."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Säule"@de .

lvr_fund:saeulenbasis a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Säulenbasis"@de .

lvr_fund:saeulenschaft a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Säulenschaft"@de .

lvr_fund:salbentopf a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Salbentopf ist ein kleines Vorratsgefäß für medizinische und kosmetische pastöse Zubereitungen. Es bestand früher in der Regel aus Keramik, heute meist aus Kunststoff. Klassisch ist der Binderand, später Stülpdeckel oder Steckdeckel, heute meist Schraubdeckel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Salbentopf"@de .

lvr_fund:salzstreuer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Salzstreuer"@de .

lvr_fund:samen_botanik a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:definition "Ein Samen ist der Bestandteil einer Pflanze, der den befruchteten Keim enthält und aus dem eine neue Pflanze heranwachsen kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Samen (Botanik)"@de ;
    skos:scopeNote "Samen sind häufig von einer schützenden Hülle umgeben."@de .

lvr_fund:sanduhr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sanduhr"@de .

lvr_fund:sarg a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Ein Sarg ist ein Behälter, in den Tote gelegt und beigesetzt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sarg"@de ;
    skos:scopeNote "Ein Sarg hat die Form eines langen Kastens. Er wird mit einem Deckel verschlossen und kann aus unterschiedlichen Materialien hergestellt sein."@de .

lvr_fund:sarggriff a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Ein Sarggriff ist ein Griff, der an einem Sarg zum Tragen und Heben angebracht sein kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sarggriff"@de .

lvr_fund:sargnagel a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sargnagel"@de .

lvr_fund:sarkophag a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:definition "Ein Sarkophag ist ein Sarg, der aus Stein gefertigt ist, mit Reliefs verziert, bemalt oder auch mit Inschriften versehen ist. Vorwiegend dient er der repräsentativen Bestattung höhergestellter Personen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sarkophag"@de .

lvr_fund:sattelzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Sattelzeug ist ein Sammelbegriff für Gerätschaften, die zum Satteln eines Reittieres benötigt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sattelzeug"@de .

lvr_fund:saufeder a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Saufeder ist ein Spieß für die Jagd auf Wildschweine. An einem langen Schaft sitzt ein breiter und spitzer Klingenkopf, der zum Schaft hin über eine Querstange verfügt, die ein zu tiefes Eindringen in den Tierkörper verhindern soll."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Saufeder"@de .

lvr_fund:sax_waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Sax ist ein Kurzschwert, das als Hiebwaffe eine einschneidige kurze und schwere Klinge aufweist und für den Nahkampf geeignet ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sax (Waffe)"@de .

lvr_fund:schaber_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schaber ist ein Steinwerkzeug, das mindestens eine halbsteil kontinuierlich retuschierte Lateralseite aufweist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schaber (Steinwerkzeug)"@de ;
    skos:scopeNote "Beim Schaber liegt die Arbeitskante lateral, auch wenn sie bis zum terminalen Ende reichen kann. Im Gegensatz zum Kratzer und zur Endretusche, die an einem terminalen Ende sitzen."@de .

lvr_fund:schachfigur a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Schachfigur ist ein Spielstein, der Bestandteil eines Schachspiels ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schachfigur"@de .

lvr_fund:schale_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Schale ist ein weites und flach gewölbtes Gefäß. Sie kann einen Fuß, Griffe und einen Deckel besitzen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schale (Gefäß)"@de ;
    skos:scopeNote "Der Übergang zur Schüssel und zum Teller sind fließend, aber bei Schalen ist die Gefäßhöhe relativ zur Breite üblicherweise kleiner als bei der Schüssel und größer als beim Teller. Zudem sind die einzelnen Gefäßzonen der Schale meist weniger deutlich abgesetzt als bei der Schüssel und sie besitzt in der Regel ein insgesamt kleineres Volumen als diese."@de .

lvr_fund:schaufel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Schaufel ist ein Gerät, das aus einem breiten Blatt aus Metall und einem daran befestigten langen Stiel besteht. Mit einer Schaufel können lose Materialien, wie zum Beispiel Schüttgut oder Schnee aufgenommen und bewegt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schaufel (Gerät)"@de .

lvr_fund:scheibe_architekturelement a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scheibe (Architekturelement)"@de .

lvr_fund:scheibe_objektgattung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scheibe (Objektgattung)"@de .

lvr_fund:scheibenfibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scheibenfibel"@de .

lvr_fund:scheibenkeule a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scheibenkeule"@de .

lvr_fund:scheide_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Scheide ist ein Behälter, dessen Hülse aus festem Material besteht, in die eine Stichwaffe bis zu ihrem Knauf hineingesteckt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scheide (Behälter)"@de .

lvr_fund:schemel_sitzmoebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schemel ist ein Sitzmöbel ohne Lehnen, das mit einem, drei, vier oder fünf Beinen hergestellt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schemel (Sitzmöbel)"@de .

lvr_fund:scherbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Scherbe ist ein Fragment eines zerbrochenen Objektes aus Keramik, Glas oder Porzellan."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Scherbe"@de .

lvr_fund:schere_schneidewerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Schere ist ein Schneidewerkzeug zum Zertrennen oder Einschneiden diverser Materialien mittels zweier gegeneinander beweglicher Klingen mit Schneiden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schere (Schneidewerkzeug)"@de ;
    skos:scopeNote "Zum Öffnen und Schneiden müssen die Finger in den meist ringförmig auslaufenden Griffen verkantet werden. Das Schneiden erfolgt durch die gegeneinander gerichtete Bewegung der zwei Hebelenden."@de .

lvr_fund:schienenpanzer a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schienenpanzer"@de .

lvr_fund:schiff_wasserfahrzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schiff ist ein größeres Wasserfahrzeug, das auf dem Wasser schwimmt und über einen eigenen Antrieb in Form von Segeln, Motoren oder Riemen verfügt. Es besitzt einen länglichen Rumpf, selten mehrere, der an einem oder beiden Enden schmal oder spitz zuläuft. Im Unterschied zum Boot ist es größer und aufgrund seiner Bauweise in der Regel seetüchtiger."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schiff (Wasserfahrzeug)"@de .

lvr_fund:schiffselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schiffselement ist ein Fahrzeugteil, das fester Bestandteil von Wasserfahrzeugen ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schiffselement"@de .

lvr_fund:schiffsmast a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schiffsmast ist ein Mast, der zur Befestigung von Segeln und weiterem Schiffszubehör wie beispielsweise Funkantennen, Windmessern oder akustischen Signalgebern dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schiffsmast"@de .

lvr_fund:schildbuckel a skos:Concept ;
    skos:broader lvr_fund:schild_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schildbuckel"@de .

lvr_fund:schildfessel a skos:Concept ;
    skos:broader lvr_fund:schild_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schildfessel"@de .

lvr_fund:schirmstaender_ablagemoebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schirmständer ist ein Ständer für den Innenraum, der zum Abstellen und zur Aufbewahrung von Regenschirmen dient. Der Abschluss zum Boden hin ist geschlossen, um abtropfendes Regenwasser aufzufangen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schirmständer (Ablagemöbel)"@de .

lvr_fund:schlacke_reststoff a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Schlacke ist ein Reststoff mit glasigem bis kristallinem Gefüge, der bei der Verhüttung von Erzen entsteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlacke (Reststoff)"@de .

lvr_fund:schlaginstrument a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schlaginstrument ist ein Musikinstrument, auf dem durch Schlagen oder Schütteln Klänge erzeugt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlaginstrument"@de .

lvr_fund:schlagstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlagstein"@de .

lvr_fund:schlagzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlagzeug"@de .

lvr_fund:schleifstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schleifstein"@de .

lvr_fund:schleudergeschoss a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Ein Schleudergeschoss ist ein Geschoss, das mit einer Schleuderwaffe verschossen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schleudergeschoss"@de .

lvr_fund:schleuderkugel a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schleuderkugel"@de .

lvr_fund:schleuderwaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schleuderwaffe"@de ;
    skos:scopeNote "Eine Schleuder ist eine Fernwaffe. Die Bauform variiert von Handschleudern bis hin zu Katapulten, die große Geschosse schleudern können."@de .

lvr_fund:schloss_vorrichtung a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Schloss ist eine Vorrichtung, die dem sicheren Verriegeln von Gebäuden, Innenräumen oder Gegenständen dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schloss (Vorrichtung)"@de .

lvr_fund:schluessel_schloss a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Schlüssel ist der Bestandteil eines Schlosses, mit dem dieses geöffnet oder geschlossen werden kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlüssel (Schloss)"@de .

lvr_fund:schlussstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schlussstein ist ein Gewölbedetail, das im Scheitelpunkt sitzt und häufig durch Form und/oder Verzierung hervorgehoben wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schlussstein"@de .

lvr_fund:schmelzofen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schmelzofen"@de .

lvr_fund:schmelztiegel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schmelztiegel"@de .

lvr_fund:schminkpalette a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:editorialNote "Benutzt für Reibplatten im kosmetischen Bereich; für die Verwendung zum Zermahlen von Kräutern, Getreiden, Farbpigmenten, Erzen usw. siehe Reibplatte."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schminkpalette"@de .

lvr_fund:schmuckstueck a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Ein Schmuckstück ist Bekleidungszubehör, das als optische Aufwertung von Kleidung oder zur Zierde des Trägers am Körper getragen wird. Schmuck wird sowohl nach Form, Funktion und Material kategorisiert als auch nach Preis, Anlass und Art der Anbringung."@de ;
    skos:editorialNote "Verwendet für Schmuckstücke, die am Körper oder an Kleidungsstücken getragen werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schmuckstück"@de .

lvr_fund:schnalle_verschluss a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:definition "Eine Schnalle ist eine Schließe in Form eines Bügels mit einem oder mehreren an einem Riemen befestigten, beweglichen Dorn."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schnalle (Verschluss)"@de .

lvr_fund:schneide_geraetebestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schneide (Gerätebestandteil)"@de .

lvr_fund:schrank_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schrank ist ein Kastenmöbel, das mit Türen verschlossen wird und dem Verstauen verschiedenster Objekte dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schrank (Möbel)"@de ;
    skos:scopeNote "Je nach Zweck und aufbewahrtem Inhalt variiert die Form des Schrankes und die Art und Weise wie er aufgestellt, eingebaut oder an der Wand angebracht wird."@de .

lvr_fund:schraube_verbindungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schraube (Verbindungselement)"@de .

lvr_fund:schreibgeraet a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Schreibgerät ist ein Gerät, mit dem man handschriftlich oder maschinell Texte auf einer beschreibbaren Fläche anbringen kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schreibgerät"@de .

lvr_fund:schuerhaken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schürhaken ist ein Gerät, das aus einer dünnen Eisenstange besteht, die in einem Haken endet. Es dient zur Umlagerung des heißen Brennmaterials innerhalb der Feuerstelle."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schürhaken"@de .

lvr_fund:schuessel_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Schüssel ist ein weites und tief gewölbtes Gefäß. Sie kann einen Fuß, Griffe und einen Deckel besitzen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schüssel (Gefäß)"@de ;
    skos:scopeNote "Der Übergang zur Schale ist fließend, aber bei Schüsseln ist die Gefäßhöhe relativ zur Breite üblicherweise größer und die einzelnen Gefäßzonen sind meist deutlicher abgesetzt als bei der Schale. Zudem besitzt die Schüssel in der Regel ein insgesamt größeres Volumen."@de .

lvr_fund:schuh_fussbekleidung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Schuh ist Fußbekleidung, die durch unterschiedliche Einsatzzwecke, Konstruktionen, Formen und Verschlüssen eine breite Palette an Modellen aufweist. Die Herstellung erfolgt heutzutage fast ausschließlich maschinell und je nach Preiskategorie mit künstlichen oder natürlichen Werkstoffen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schuh (Fußbekleidung)"@de .

lvr_fund:schuhnagel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schuhnagel"@de .

lvr_fund:schuhschnalle a skos:Concept ;
    skos:broader lvr_fund:Tracht_und_Schmuck ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schuhschnalle"@de .

lvr_fund:schusswaffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Schusswaffe ist eine Waffe, die ein Geschoss verschießt. Zu den Schusswaffen gehören Feuerwaffen und mechanische Schusswaffen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schusswaffe"@de .

lvr_fund:schwertklinge a skos:Concept ;
    skos:broader lvr_fund:schwert_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schwertklinge"@de .

lvr_fund:schwertscheide a skos:Concept ;
    skos:broader lvr_fund:schwert_waffe ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Schwertscheide"@de .

lvr_fund:segment_mikrolith a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Segment (Mikrolith)"@de .

lvr_fund:seil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Seil ist ein längliches, gedrehtes oder geflochtenes Objekt, das über eine hohe Zugfestigkeit verfügt, flexibel und elastisch ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Seil"@de .

lvr_fund:sekretaer_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Sekretär ist ein Schreibmöbel, das kommodenartig bis schrankartig ist und eine klappbare oder herausziehbare Schreibfläche besitzt, die im geschlossenen Zustand eine gerade oder schräge Fläche bildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sekretär (Möbel)"@de .

lvr_fund:sense a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Sense ist ein landwirtschaftliches Gerät, das aus einer langen, leicht gebogenen, spitz zulaufenden Klinge besteht, die an einem langen Stiel mit Handgriff befestigt ist. Es wird zum Mähen von größeren Gras- und Getreidefeldern verwendet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sense"@de .

lvr_fund:servierwagen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Servierwagen"@de .

lvr_fund:sessel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Sessel ist ein weich gepolstertes Sitzmöbel für eine Person, das eine Rückenlehne und meist auch Armlehnen besitzt und deren Sitzfläche eher niedrig ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sessel"@de .

lvr_fund:sichel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Sichel ist ein landwirtschaftliches Gerät zum Schneiden von Gras oder Getreide. Sie besitzt eine halbkreisförmig gebogene Klinge und einen hölzernen Stiel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sichel"@de .

lvr_fund:sicheleinsatz a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sicheleinsatz"@de .

lvr_fund:sieb_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Sieb ist ein Gerät, das im Ganzen oder am Boden aus einem netzartigem Geflecht besteht und mit einem Rahmen oder Ähnlichem eingefasst ist. Es dient zur Sortierung von festen Bestandteilen eines Materials nach Korngröße oder der Trennung von flüssigen und festen Anteilen eines Stoffes."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sieb (Gerät)"@de .

lvr_fund:siegel a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Siegel"@de .

lvr_fund:skalpell a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Skalpell ist ein Messer mit einer schmalen feststehenden Klinge. Es zählt zu den chirurgischen Instrumenten, wird aber auch zur Präparation in anderen Fachgebieten eingesetzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Skalpell"@de .

lvr_fund:skelett_koerperbestandteil a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:definition "Ein Skelett ist der Bestandteil eines Tiers oder Menschen, der das tragende Gerüst aus festem Gewebe bildet. So handelt es sich dabei etwa bei Wirbeltieren um die Gesamtheit der Knochen oder bei bestimmten Fischen um die der Knorpel."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Skelett (Körperbestandteil)"@de .

lvr_fund:skulptur a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Skulptur ist ein Bildwerk, das durch Abtragen aus festem Material herausgearbeitet wird."@de ;
    skos:editorialNote "Benutzt für Bildwerke, die aus einem Material herausgearbeitet werden; für visuelle Werke, die aus Materialien modelliert oder gegossen werden benutze Plastik."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Skulptur"@de .

lvr_fund:sofa a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Sofa ist ein gepolstertes Sitzmöbel für mehrere Personen mit Rückenlehne und Armlehnen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sofa"@de .

lvr_fund:sonnenuhr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Sonnenuhr ist eine Elementaruhr, welche die Zeit durch den Schattenwurf eines von der Sonne beschienenen Zeigers oder durch die Position eines kanalisierten Lichtstrahls abbildet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sonnenuhr"@de .

lvr_fund:spachtel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Spachtel ist ein Gerät, das ein flaches breites Blatt hat, welches in einem Handgriff steckt. Er dient zum Aufbringen und Glätten dickflüssiger Massen, kann aber auch zum Abkratzen dieser genutzt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spachtel"@de .

lvr_fund:spange_befestigungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Spange ist ein Befestigungselement, das aus zwei Teilen besteht, die ineinander greifen und so Objekte miteinander verbinden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spange (Befestigungselement)"@de ;
    skos:scopeNote "Spangen sind nicht nur in ihrer Funktion als Verschluss anzutreffen, sondern haben häufig auch schmückenden Charakter."@de .

lvr_fund:spatel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spatel"@de .

lvr_fund:spaten_werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Spaten ist ein Gerät, mit dem der Erdboden umgegraben, abgestochen oder ausgehoben werden kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spaten (Werkzeug)"@de .

lvr_fund:spatha_waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spatha (Waffe)"@de .

lvr_fund:speer_waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Speer (Waffe)"@de .

lvr_fund:speerschleuder a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Speerschleuder"@de ;
    skos:scopeNote "Die Speerschleuder verlängert den Wurfarm, wodurch die mit ihr beschleunigten Speere eine gegenüber von Hand geworfenen Speeren wesentlich erhöhte Geschwindigkeit erreichen."@de .

lvr_fund:spiegel_optik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Spiegel ist ein Einrichtungsgegenstand, der eine glatt polierte Oberfläche besitzt. Da diese Lichtstrahlen reflektiert, entsteht dadurch ein Abbild."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spiegel (Optik)"@de .

lvr_fund:spielbrett a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Spielbrett ist Bestandteil eines Brettspiels, auf dem Markierungen für den Spielverlauf angebracht sind."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spielbrett"@de .

lvr_fund:spielgeraet a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spielgerät"@de .

lvr_fund:spielstein a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Spielstein ist ein Bestandteil eines Spielsets, der von den Spielern während des Spiels bewegt wird. Er ist üblicherweise klein und aus hartem Material. Seine Form reicht dabei von einfachen, in der Natur vorkommenden Objekten wie etwa tatsächlichen Steinen oder Muscheln bis hin zu detailreich gestalteten Figuren."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spielstein"@de .

lvr_fund:spielzeug a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Ein Spielzeug ist ein Freizeitgegenstand, der der spielerischen Beschäftigung dient und sich in erster Linie an Kinder richtet, aber auch eigens für Erwachsene und Haustiere bestimmt sein kann. Über die spielerische Komponente hinaus kann ein Spielzeug auch eine pädagogische oder sozialisierende Funktion besitzen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spielzeug"@de .

lvr_fund:spindel_textiltechnik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spindel (Textiltechnik)"@de .

lvr_fund:spinnrocken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Spinnrocken ist ein Gerät, das zumeist stabförmig ist und auf das die unversponnenen Fasern gesteckt werden."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spinnrocken"@de .

lvr_fund:spinnwirtel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Spinnwirtel ist der Bestandteil der Handspindel, der als Schwungmasse dafür sorgt, dass die Spindel sich möglichst lange und gleichmäßig dreht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spinnwirtel"@de .

lvr_fund:spirale_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spirale (Objekttyp)"@de .

lvr_fund:spiralfibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spiralfibel"@de .

lvr_fund:spitze_bestandteil a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Spitze ist der Bestandteil eines Objektes, der an seinem Ende spitz zu läuft."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spitze (Bestandteil)"@de .

lvr_fund:spitzklinge_lateralretusche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Spitzklinge (Lateralretusche)"@de .

lvr_fund:splint_sicherungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Splint ist ein Sicherungselement, das aus einem gespaltenen Stift aus Metall besteht und der Lagesicherung verbundener Bauteile dient. Er wird durch eine gebohrte Öffnung in  Radnaben, Schrauben und Bolzen gesteckt und durch Auseinanderbiegen seiner Enden befestigt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Splint (Sicherungselement)"@de .

lvr_fund:sporn_bekleidungszubehoer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Sporn ist Bekleidungszubehör, das am Reitstiefel befestigt ist und aus einem gebogenen Metallstück mit Dorn oder Rädchen besteht. Beim Reiten wird der Sporn zum Antreiben des Pferdes genutzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Sporn (Bekleidungszubehör)"@de ;
    skos:scopeNote "Er besteht aus einem Bügel, an dem ein Dorn befestigt ist, der ein Rädchen trägt. Sporen wurden auch zu Rüstungen getragen."@de .

lvr_fund:stab_objekttyp a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Stab ist ein Objekt, das länglich ist und einen meist runden Querschnitt hat."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stab (Objekttyp)"@de .

lvr_fund:standfuss_gefaessfuss a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Ein Standfuß ist ein Gefäßfuß, der aus einer Standplatte oder einem Standring und einem mehr oder weniger ausgeprägten Schaft besteht. Er ist vom Gefäßkörper abgesetzt und in der Regel gesondert gearbeitet und appliziert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Standfuß (Gefäßfuß)"@de ;
    skos:scopeNote "Benutzt für einen massiven Standfuß, für mehrere kleine Füßchen (wie beim Grapen) siehe Standknubbe."@de .

lvr_fund:standknubbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Standknubbe"@de .

lvr_fund:standplatte_gefaessbestandteil a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Standplatte (Gefäßbestandteil)"@de .

lvr_fund:standring a skos:Concept ;
    skos:broader lvr_fund:schmuckring ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Standring"@de .

lvr_fund:standuhr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Standuhr"@de .

lvr_fund:statue a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Statue"@de .

lvr_fund:statuette a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:definition "Eine Statuette ist eine kleine Statue."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Statuette"@de .

lvr_fund:steigbuegel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Steigbügel ist ein Gerät, das dem im Sattel sitzenden Reiter als Fußstütze dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Steigbügel (Gerät)"@de .

lvr_fund:steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Steinartefakt ist ein Artefakt aus Stein. Im engeren Sinne werden darunter vom Menschen geschlagene oder überschliffene Objekte aus Silikat- oder Felsgestein bezeichnet."@de ;
    skos:editorialNote "Steinartefakt bezieht sich hier auf geschlagene oder geschliffene Steinartefakte. Dies schließt keine Baumaterialien wie Steinquader o.ä. ein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Steinartefakt"@de .

lvr_fund:steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Steinwerkzeug"@de .

lvr_fund:stempel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Stempel ist ein Gerät, das aus einer Fläche, an der ein Griff befestigt ist, und in die ein Text oder eine Abbildung eingeschnitten ist, besteht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stempel (Gerät)"@de ;
    skos:scopeNote "Die Informationen auf der Fläche können durch Farbauftrag oder Abdruck auf andere Objekte übertragen werden."@de .

lvr_fund:stichel_steinwerkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stichel (Steinwerkzeug)"@de .

lvr_fund:stichellamelle a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stichellamelle"@de .

lvr_fund:stielspitze a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Stielspitze ist eine Spitze, die einen beidseitig retuschierten Stiel aufweist, was sie von der einseitig retuschierten Kerbspitze unterscheidet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stielspitze"@de .

lvr_fund:stoepsel_verschluss a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Stöpsel ist ein Verschluss von zylindrischer oder konischer Form, der dem dichten Verschließen von kleinen Öffnungen in Behältern dient. Im Gegensatz zum Deckel wird der Stöpsel in ein Loch hineingedrückt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stöpsel (Verschluss)"@de .

lvr_fund:stoessel_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Stößel ist ein Gerät, das zur Zerkleinerung von Material wie Gewürzen in einem Mörser oder einem schalenförmigen Gefäß dient. Die Form erinnert an eine Keule mit gerundetem Ende."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stößel (Gerät)"@de .

lvr_fund:streuer_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Streuer (Behälter)"@de .

lvr_fund:strigilis a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Strigilis ist ein Gerät, das ein gebogenes Blatt besitzt. Es wurde in der Antike vor allem in Badeanlagen benutzt, um feuchte oder ölige Schmutzschichten vom Körper abzuschaben."@de ;
    skos:editorialNote "Verwendet für das antike Instrument zum Abschaben von Öl, Schweiß und Staub vom Körper; für das Werkzeug zur Oberflächenbearbeitung siehe Schabeisen (wk008712) (de)."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Strigilis"@de .

lvr_fund:stuck_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Stuck ist ein Architekturelement, das aus dem gleichnamigen Material hergestellt wird und der Herstellung frei aufgetragener Dekorationen, dem Ziehen von Profilen mit Schablonen oder dem geschliffenen und polierten Wandputz dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stuck (Architektur)"@de .

lvr_fund:stuetze_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Stütze ist ein Bauteil, das die Form eines aufrechten, meist stabförmigen Baugliedes hat, das je nach Form als Säule oder Pfeiler bezeichnet wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stütze (Architektur)"@de .

lvr_fund:stuhl_moebel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Stuhl ist ein Sitzmöbel für eine Person, das eine Rückenlehne besitzt und deren Sitzfläche eher hoch ist. Stühle können auch über Armlehnen verfügen und teilweise gepolstert sein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Stuhl (Möbel)"@de .

lvr_fund:tabakspfeife a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Tabakspfeife ist ein Gerät, das zum Rauchen von Tabak verwendet wird. Sie besteht aus Kopf, Rohr und Mundstück."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tabakspfeife"@de .

lvr_fund:tabernakel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Tabernakel ist ein liturgischer Behälter, der verschließbar ist und in einer katholischen Kirche der sicheren Aufbewahrung der konsekrierten Hostien, des Allerheiligsten, dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tabernakel"@de ;
    skos:scopeNote "Die Verwendung des Begriffs „Tabernakel“ im heutigen Sinn beginnt im 13. Jh. Bis dahin wird mit „tabernaculum“ lediglich ein Gefäß bezeichnet, in dem die konsekrierten Hostien aufbewahrt werden."@de .

lvr_fund:tablett a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Tablett ist ein Behälter, der zum Transport und Servieren von Speisen, Getränken und Geschirr genutzt wird. Er hat die Form einer Platte mit erhöhtem Rand und seitlichen Handhaben."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tablett"@de .

lvr_fund:tafel_informationstraeger a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tafel (Informationsträger)"@de .

lvr_fund:tasche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Tasche ist ein Behälter, meist aus flexiblem Material und häufig mit einer Tragevorrichtung versehen, in dem Personen Gegenstände transportieren können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tasche"@de .

lvr_fund:tasse a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Tasse ist ein Trinkgefäß mit Henkel für Heißgetränke, meist aus Keramik, dessen Form schalenförmig bis becherförmig ist. Es besitzt üblicherweise einen kleinen Standring und oft gehört eine Untertasse dazu. Bei größeren Tassen besteht eine Überschneidung mit Henkelbechern."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tasse"@de .

lvr_fund:taufbecken a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Taufbecken ist ein Behälter in Form eines Beckens, das der Aufnahme von Taufwasser dient."@de ;
    skos:editorialNote "Benutzt für das nicht transportable Taufgefäß; für die zur Kirchenausstattung gehörende und zur Aufnahme des Taufwassers dienende, transportable Schale siehe Taufschale."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Taufbecken"@de .

lvr_fund:tegula_dachziegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Tegula ist ein rechteckiger, flacher römischer Dachziegel mit hochgezogenen Leisten an den beiden Seitenflächen. Über die aneinanderstoßenden seitlichen Leisten zweier Tegulae wird zur Abdichtung der Dachbedeckung ein halbröhrenförmiger Imbrex gelegt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tegula (Dachziegel)"@de ;
    skos:scopeNote "In archäologischen Fundkontexten sind Tegulae vor allem aus Städten, Siedlungen und Militärlagern der römischen Provinzen bekannt. Nicht selten tragen sie einen Herstellerstempel oder einen Abdruck einer Tierpfote."@de .

lvr_fund:teller_essgeschirr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Teller ist ein flaches, gegliedertes Gefäß zum Servieren oder für den Verzehr von Lebensmitteln. Teller besitzen in der Regel eine muldenförmige Vertiefung, sind in ihrer klassischen Ausführung rund und haben einen Durchmesser von circa 26 cm. Sie besitzen häufig einen glatten Standboden, einen abgesetzten Standring, selten einen Standfuß."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Teller (Essgeschirr)"@de ;
    skos:scopeNote "Im Unterschied zur Platte (Geschirr) sind die einzelnen Gefäßzonen eines Tellers meist deutlicher abgesetzt. Teller sind in der Regel kleiner als Platten."@de .

lvr_fund:terrine_gefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Terrine ist eine dickbauchige Schüssel mit Deckel, die oft auch einen oder mehrere Standfüße sowie zwei gegenständige Griffe besitzt. Der Deckel kann eine Aussparung für einen Schöpflöffel aufweisen. Darüber hinaus existieren auch figürliche Terrinen, oft in Form von Tieren oder Tierköpfen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Terrine (Gefäß)"@de .

lvr_fund:textilerzeugnis a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:editorialNote "Benutzt für gegenständliche Erzeugnisse aus Textilien; für Stoffe und Fasern siehe Material."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Textilerzeugnis"@de .

lvr_fund:textilfaser a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Textilfaser"@de .

lvr_fund:thermisch_stimulierte_lumineszenzprobe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine thermisch stimulierte Lumineszenzprobe ist eine Materialprobe, die mit Hilfe einer Lumineszenz-Methode datiert wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Thermisch stimulierte Lumineszenzprobe"@de .

lvr_fund:tiegel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tiegel"@de .

lvr_fund:tierhorn a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:definition "Ein Tierhorn ist ein Bestandteil von Tieren, der als Auswuchs an den Stirnknochen von Hornträgern und Nashörnern zu finden ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tierhorn"@de .

lvr_fund:tierischer_ueberrest a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:definition "Tierischer Überrest ist ein organischer Überrest, der von Tieren stammt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tierischer Überrest"@de .

lvr_fund:tintenfass a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Tintenfass ist ein Behälter, in den Tinte gefüllt werden kann und der so geformt ist, dass Schreibfedern in die Flüssigkeit eingetaucht werden können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tintenfass"@de .

lvr_fund:tisch a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Tisch ist ein Ablagemöbel, das aus einer waagerechten Platte besteht, die auf einem oder mehreren Tragelementen ruht."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tisch"@de .

lvr_fund:toepfereigeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Töpfereigerät"@de .

lvr_fund:toepferofen a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Töpferofen ist ein Brennofen, in dem aus Ton gefertigte Waren zur Gebrauchsfähigkeit fest gebrannt werden. Dessen Bau, Form und Einrichtungen richten sich nach der Beschaffenheit der zu brennenden Ware und des Brennmaterials."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Töpferofen"@de .

lvr_fund:toilettegeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Toilettegerät ist ein Gerät zur Körperpflege, Hygiene und Gesundheitsvorsorge, das in der Regel aus Metall oder Knochen gefertigt war."@de ;
    skos:editorialNote """Nur im historischen und archäologischen Kontext zu verwenden.
Überschneidung mit medizinischem Gerät."""@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Toilettegerät"@de ;
    skos:scopeNote "Toilettegeräte, häufig als Bestandteil von Toilettebestecken unterschiedlichen Geräteumfangs, können beispielsweise Pinzetten, Ohrlöffel, Sonden oder Nagelschneider sein. Sie fanden unterschiedlichen Einsatz in der Leibespflege wie beispielsweise zur Nagel-, Haar-, Bart- oder Zahnpflege. Die Werkzeuge wurden in der Regel aus Eisen, einer Kupferlegierung oder Knochen gefertigt."@de .

lvr_fund:topf_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Topf ist ein getöpfertes Gefäß für Lebensmittel, das eine zylindrische bis bauchige oder leicht konische und eher hohe Form ohne Hals und mit einer weiten Öffnung besitzt."@de ;
    skos:editorialNote "Benutzt für vor- und frühgeschichtliche Funde. Für Kochgefäße in Topfform benutze Kochtopf, für Pflanzgefäße benutze Blumentopf."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Topf (Behälter)"@de .

lvr_fund:tor_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ein Tor ist ein Bauteil, das als Durchgang oder Durchfahrt für Tiere und Fahrzeuge genutzt wird und in der Regel verschließbar ist."@de ;
    skos:editorialNote "Benutzt für das als Durchgang oder Durchfahrt genutzte funktionelle Architekturelement; für Baukomplexe bei Befestigungen siehe Toranlage."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tor (Architektur)"@de .

lvr_fund:totenleuchte a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Totenleuchte ist ein Bauwerk und ein Denkmal, in Form eines tabernakelartigen Türmchens, das auf einem Friedhof errichtet wird und zur Aufnahme eines Totenlichts bestimmt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Totenleuchte"@de .

lvr_fund:tragflaeche a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Tragfläche ist ein flächiges Fahrzeugteil, das üblicherweise als Paar, also an beiden Seiten eines Fahrzeugs, dazu dient, dynamischen Auftrieb aus Vortrieb zu erzeugen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tragfläche"@de .

lvr_fund:trapez_mikrolith a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trapez (Mikrolith)"@de .

lvr_fund:trense a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Trense ist ein Gebiss, das aus einem Mundstück und zwei seitlichen Ringen zur Befestigung der Zügel oder Leinen besteht. Das Mundstück kann ungebrochen (durchgehend) oder gebrochen sein, das heißt mit einem oder mehreren Gelenken. Im Unterschied zur Kandare hat ein Trensengebiss keine Hebelwirkung."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trense"@de .

lvr_fund:treppe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Von Stufen gebildeter Aufgang, der unterschiedlich hoch liegende Ebenen innerhalb und außerhalb von Gebäuden verbindet bzw. an Steigungen im Gelände angelegt ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Treppe"@de .

lvr_fund:treppengelaender a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Treppengeländer ist ein Geländer, das sich an der freien Seite von Treppen befindet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Treppengeländer"@de .

lvr_fund:treppenstufe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Treppenstufe"@de .

lvr_fund:trichter_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Trichter ist ein Gerät, das im oberen Teil kegelförmig ist und verjüngend ausläuft. Er wird zum Abfüllen bzw. Auffüllen von Substanzen in Behälter benutzt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trichter (Gerät)"@de .

lvr_fund:trinkhorn a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Trinkhorn ist ein Trinkgefäß, das aus einem Horn z.B. eines Rindes, gefertigt und häufig mit Metallbeschlägen versehen ist, oder aus anderen Materialien in Form eines Horns nachgebildet ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trinkhorn"@de .

lvr_fund:triptychon a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Triptychon ist ein visuelles Werk, das aus drei Tafeln besteht, von denen die mittlere feststehend ist, während die anderen beiden als klappbare Flügel angebracht sind. Triptychen gibt es sowohl als Gemälde als auch als Schnitzereien."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Triptychon"@de .

lvr_fund:trommel_musik a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trommel (Musik)"@de .

lvr_fund:trompete a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trompete"@de .

lvr_fund:truemmer_steinartefakt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Trümmer (Steinartefakt)"@de .

lvr_fund:truhe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Truhe ist ein Kastenmöbel, in Form eines rechteckigen, meist länglichen Kastens, der mit einem Klappdeckel verschlossen wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Truhe"@de .

lvr_fund:tubulus a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tubulus"@de .

lvr_fund:tuer a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Einrichtung zum Schließen einer Öffnung in einer Wand, einer Mauer usw."@de,
        "flat, movable structure used to open and close an entrance"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300002803>,
        <http://www.wikidata.org/entity/Q36794>,
        <https://d-nb.info/gnd/4061159-0> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Tür"@de,
        "door"@en .

lvr_fund:tuergriff a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Türgriff"@de .

lvr_fund:tuerriegel a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Türriegel"@de .

lvr_fund:tuerschwelle a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Türschwelle ist ein Bauteil, das als Bestandteil einiger Türen deren Öffnung nach unten abschließt."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Türschwelle"@de .

lvr_fund:uhr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Uhr ist ein Messgerät, auf dem die aktuelle Uhrzeit ablesbar ist oder das eine Zeitspanne misst."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Uhr"@de .

lvr_fund:unbekannt a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "unbekannt"@de .

lvr_fund:unifaziales_messer a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Unifaziales Messer"@de .

lvr_fund:urne_grabgefaess a skos:Concept ;
    skos:broader lvr_fund:gefaess_behaelter ;
    skos:definition "Eine Urne ist ein Zeremonialgefäß zur Aufbewahrung und Bestattung der Überreste, die nach der Verbrennung eines Leichnams verbleiben, vor allem Leichenbrand oder Asche, sowie in vorchristlicher Zeit von Grabbeigaben. Sie hat meist eine bauchige Form und wird in der Regel verschlossen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Urne (Grabgefäß)"@de .

lvr_fund:verbindungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Verbindungselement"@de .

lvr_fund:verschluss_vorrichtung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Verschluss ist ein Bekleidungsbestandteil, mit dem ein Kleidungsstück oder Teile davon geschlossen werden können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Verschluss (Vorrichtung)"@de .

lvr_fund:vollkern a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Vollkern"@de .

lvr_fund:vortragekreuz a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Vortragekreuz"@de .

lvr_fund:votivinschrift a skos:Concept ;
    skos:broader lvr_fund:Kult_Sakral_und_Bestattungsobjekt ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Votivinschrift"@de .

lvr_fund:waage_messgeraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Waage ist ein Messgerät, mit dessen Hilfe die Körpermasse ermittelt wird. Die Wägung erfolgt, indem Kräfte miteinander verglichen werden, woraus die Masse ermittelt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Waage (Messgerät)"@de .

lvr_fund:wachsspatel a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wachsspatel"@de .

lvr_fund:waffe a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:definition "Eine Waffe ist ein Instrument oder eine Vorrichtung, die bei Angriff, Verteidigung oder bei der Jagd zum Verletzen von Lebewesen oder zum Beschädigen von Objekten dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Waffe"@de .

lvr_fund:waffenzubehoer a skos:Concept ;
    skos:broader lvr_fund:Waffe_und_Ruestung ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Waffenzubehör"@de .

lvr_fund:wagen_fahrzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Wagen ist ein nicht spurgebundenes Landfahrzeug, das üblicherweise über zwei Achsen mit je zwei Rädern verfügt und, je nach Ausführung, gezogen oder geschoben wird, in jedem Fall aber über keinen eigenen Antrieb verfügt."@de ;
    skos:editorialNote "Benutzt für Fahrzeuge ohne Kraftantrieb; für Fahrzeuge mit Kraftantrieb benutze Kraftfahrzeug. Nach Möglichkeit mit Unterbegriff verschlagworten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wagen (Fahrzeug)"@de .

lvr_fund:wagenrad a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Wagenrad ist ein Rad an einem nicht spurgebundenen Wagen, Karren oder Fuhrwerk. Es besteht meist aus Holz und kann metallbereift sein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wagenrad"@de .

lvr_fund:wand_architektur a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Eine Wand ist ein Architekturelement, das einen Raum in der Senkrechten in voller Höhe und Breite begrenzt. Besteht die Raumbegrenzung aus Mauern, so meint Wand lediglich die sichtbare Oberfläche."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wand (Architektur)"@de .

lvr_fund:wandbehang a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandbehang"@de .

lvr_fund:wandfliese a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Wandfliesen im Gebäude Gartenstraße 1 in Kellinghusen"@de ;
    skos:exactMatch <http://www.wikidata.org/entity/Q58399655> ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandfliesen"@de,
        "Wandfliesen"@en .

lvr_fund:wandmosaik a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandmosaik"@de .

lvr_fund:wandputz a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandputz"@de .

lvr_fund:wandscherbe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Wandscherbe ist eine Scherbe aus dem Bereich zwischen Randzone und Boden."@de ;
    skos:editorialNote "Benutzt für Scherben aus Ton, Glas und Porzellan; für Fragmente aus anderen Materialien benutze Gefäßwand."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandscherbe"@de .

lvr_fund:wandteppich a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wandteppich"@de .

lvr_fund:wangenklappe a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Wangenklappe ist Bestandteil eines Helmes, der den Bereich der Wangen vor Stößen und Schlägen schützt. Darüber hinaus erleichtern die Wangenklappen die Befestigung des Helms am Kinn. Nicht selten sind Wangenklappen verziert und können der Kennzeichnung des Besitzers dienen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wangenklappe"@de ;
    skos:scopeNote "Eine Wangenklappe ist in der Regel Bestandteil eines Helmes, der zu militärischen Zwecken genutzt wurde."@de .

lvr_fund:wanne_behaelter a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Wanne ist ein Behälter mit einer länglichen, tiefen und offenen Form zur Aufnahme von Flüssigkeiten."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wanne (Behälter)"@de .

lvr_fund:wasserrohr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Wasserrohr ist ein Leitungsrohr, das der Bestandteil einer Wasserleitung ist, durch den das Wasser geführt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wasserrohr"@de .

lvr_fund:webgewicht a skos:Concept ;
    skos:broader lvr_fund:Muenze_Gewicht_und_Tauschmittel ;
    skos:definition "Ein Webgewicht ist der Bestandteil eines Gewichtswebstuhls, der der Straffung der senkrecht hängenden Kettfäden dient."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Webgewicht"@de .

lvr_fund:webschwert a skos:Concept ;
    skos:broader lvr_fund:schwert_waffe ;
    skos:definition "Ein Webschwert ist ein Gerät, dessen Form an eine Klinge erinnert. Mit seiner Hilfe wird der Schuss, besonders bei Gewichtswebstühlen, angeschlagen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Webschwert"@de .

lvr_fund:weihedenkmal a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Weihedenkmal ist ein Denkmal, das anlässlich eines Ereignisses einer Person oder einer Gottheit geweiht ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Weihedenkmal"@de .

lvr_fund:weihrauchfass a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Weihrauchfass ist ein liturgisches Räuchergerät, in dem Weihrauch im Rahmen einer Zeremonie verbrannt wird. Eine typische Form besteht aus einer Schale für die Kohle mit einem durchbrochenen Deckel, die an Ketten aufgehängt ist, damit das Weihrauchfass geschwenkt werden kann."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Weihrauchfass"@de .

lvr_fund:wellenfuss a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wellenfuß"@de .

lvr_fund:werkstueck a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Werkstück"@de .

lvr_fund:werkzeug a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Werkzeug ist ein Gerät, das zur Herstellung oder zur Bearbeitung von Werkstücken oder Rohstoffen verwendet wird."@de ;
    skos:editorialNote "Benutzt auch für Werkzeuge, die in Maschinen eingespannt werden (Bearbeitungswerkzeuge) oder umgangssprachlich als Instrumente bezeichnet werden, z.B. ärztliche Instrumente."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Werkzeug"@de .

lvr_fund:wetzstein a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Wetzstein ist ein Gerät, das zum Schärfen von Schneiden per Hand genutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wetzstein"@de .

lvr_fund:wollkamm a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Wollkamm"@de .

lvr_fund:wuerfel_spielelement a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Würfel (Spielelement)"@de .

lvr_fund:zahnrad a skos:Concept ;
    skos:broader lvr_fund:Organisches_und_Naturmaterial ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zahnrad"@de .

lvr_fund:zange_geraet a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zange (Gerät)"@de ;
    skos:scopeNote "Zangen dienen zur Fixierung oder Bearbeitung von Werkstücken."@de .

lvr_fund:zapfen_verbindungselement a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zapfen (Verbindungselement)"@de .

lvr_fund:zapfhahn a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Zapfhahn ist ein Hahn, der an einem Behälter angebracht wird, meist einem Fass, und dazu dient, kontrolliert Flüssigkeit aus diesem Behälter zu entnehmen."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zapfhahn"@de .

lvr_fund:zeichnung_visuelles_werk a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zeichnung (visuelles Werk)"@de .

lvr_fund:zeitschrift a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Zeitschrift ist ein Periodikum, das in der Regel wöchentlich bis mindestens einmal jährlich erscheint und themenorientierte Beiträge beinhaltet."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zeitschrift"@de ;
    skos:scopeNote "Die zu den klassischen gedruckten Informationsquellen  gehörende Zeitschrift erscheint im Allgemeinen in gleicher Einbandform und ist neben der Periodizität durch einen öffentlichen Zugang und eine freie Verfügbarkeit gekennzeichnet. Differenziert wird hauptsächlich zwischen Publikumszeitschrift, Fachzeitschrift und Corporate Publishing."@de .

lvr_fund:zeitung a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Eine Zeitung ist ein Periodikum, das täglich oder wöchentlich erscheint und vielseitig über aktuelle Ereignisse in Politik, Wirtschaft, Sport und Kultur informiert."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zeitung"@de .

lvr_fund:zeitungsstaender a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Zeitungsständer ist ein Ständer, der zum Aufbewahren von Zeitungen und Illustrierten benutzt wird."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zeitungsständer"@de .

lvr_fund:ziegelbruch a skos:Concept ;
    skos:broader lvr_fund:Bau_und_Architekturelement ;
    skos:definition "Ziegelbruch ist Baukeramik, die nicht eindeutig als Dachziegel oder als Mauerziegel zu bezeichnen ist."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Ziegelbruch"@de .

lvr_fund:zinnfigur a skos:Concept ;
    skos:broader lvr_fund:Bildkunst_Schrift_und_Spiel ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zinnfigur"@de .

lvr_fund:zirkel_technik a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zirkel (Technik)"@de .

lvr_fund:zuggeschirr a skos:Concept ;
    skos:broader lvr_fund:Werkzeug_und_Geraet ;
    skos:definition "Ein Zuggeschirr ist Tierausrüstung, mit dem Zugtiere eingespannt werden, um ein Fahrzeug oder ein Gerät, wie etwa einen Pflug, ziehen zu können."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zuggeschirr"@de .

lvr_fund:zwiebelknopffibel a skos:Concept ;
    skos:broader lvr_fund:fibel_verschluss ;
    skos:definition "Eine Zwiebelknopffibel ist eine Fibel mit halbkreisförmig gebogenem Bügel von meist trapezförmigem Querschnitt, einem gerade ausgezogenen, auf der Unterseite auf ganzer Länge mit einer Nadelröhre versehenen Fuß und einem an den Bügelkopf anschließenden langen Querbalken. Am Bügelkopfende und an den Enden des Querbalkens sitzen die namengebenden großen, meist zwiebelförmigen Knöpfe."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:prefLabel "Zwiebelknopffibel"@de .

lvr_fund:Gefaess_und_Behaeltnis a skos:Concept ;
    skos:broader lvr_fund:concept_e9dddde8 ;
    skos:definition "Gefäße, Behältnisse, Geschirr und Vorratsbehälter aus Ton, Metall, Glas oder Stein."@de ;
    skos:inScheme lvr_fund:scheme ;
    skos:narrower lvr_fund:gefaess_behaelter ;
    skos:prefLabel "Behältnis"@de .

