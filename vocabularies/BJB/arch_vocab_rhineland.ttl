<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/korb_behaelter> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:definition "Ein Korb ist ein geflochtener Behälter, meist aus biegsamem Holz oder anderen flexiblen Materialien, der zum Transport und Lagern von Lasten oder Materialien verwendet wird."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Korb (Behälter)"@de .

