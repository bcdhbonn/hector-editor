<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/schleuderwaffe> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Waffe_und_Ruestung> ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Schleuderwaffe"@de ;
    skos:scopeNote "Eine Schleuder ist eine Fernwaffe. Die Bauform variiert von Handschleudern bis hin zu Katapulten, die große Geschosse schleudern können."@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/schloss_vorrichtung> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Bau_und_Architekturelement> ;
    skos:definition "Ein Schloss ist eine Vorrichtung, die dem sicheren Verriegeln von Gebäuden, Innenräumen oder Gegenständen dient."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Schloss (Vorrichtung)"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/schluessel_schloss> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Bau_und_Architekturelement> ;
    skos:definition "Ein Schlüssel ist der Bestandteil eines Schlosses, mit dem dieses geöffnet oder geschlossen werden kann."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Schlüssel (Schloss)"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/schlussstein> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:definition "Ein Schlussstein ist ein Gewölbedetail, das im Scheitelpunkt sitzt und häufig durch Form und/oder Verzierung hervorgehoben wird."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Schlussstein"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/schmelzofen> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
