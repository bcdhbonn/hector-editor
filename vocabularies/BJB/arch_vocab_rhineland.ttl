<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_71280cc2> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_8e462332> ;
    skos:definition "Ein Leichenbrandlager ist ein Brandgrab, in dessen Grabgrube Leichenbrand auf einer Stelle konzentriert liegt."@de ;
