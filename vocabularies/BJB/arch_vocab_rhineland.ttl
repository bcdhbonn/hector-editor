<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_06a004c4> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_2000a1d4> ;
    skos:definition "Ein Grubenkomplex ist ein Erdbauwerk, das aus dicht beieinander liegenden Gruben besteht. Diese können sich überschneiden, da sie nacheinander angelegt werden."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Grubenkomplex"@de .

