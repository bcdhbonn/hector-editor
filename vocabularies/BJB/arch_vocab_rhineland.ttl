<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/halskette> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:definition "Eine Halskette ist ein Schmuckstück, das um den Hals getragen wird."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Halskette"@de .

