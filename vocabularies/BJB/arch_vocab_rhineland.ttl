<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_6f67c2db> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_53ac9493> ;
    skos:definition "Ein Atriumhaus ist ein Bauwerk, dessen Räume auf einen Innenhof gerichtet sind."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
