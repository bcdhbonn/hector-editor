<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_11cc4652> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_38795406> ;
    skos:definition "Eine Kreuzwegstation ist ein visuelles Werk, das eine der Stationen des Kreuzweges Jesu umfasst."@de ;
