    skos:prefLabel "Chopping Tool"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/cleaver> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:definition "Ein Cleaver ist ein keilförmiges Steingerät mit einer beilähnlichen oder meißelartigen Schneide. Cleaver können einseitig oder beidseitig flächenretuschiert sein und werden meist aus Abschlägen hergestellt."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Cleaver"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_001a1479> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_8e462332> ;
    skos:definition "Ein Totenbrett ist ein Objekt, das die Form eines Brettes hat, auf dem Tote bis zum Begräbnis aufgebahrt werden und das anschließend mit ins Grab gegeben werden oder zur Erinnerung an den Verstorbenen, teilweise mit Inschriften und Malereien verziert, aufgestellt werden kann und damit auch die Funktion eines Informationsträgers übernimmt."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Totenbrett"@de .

