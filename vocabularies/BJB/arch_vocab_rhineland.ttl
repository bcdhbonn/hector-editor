<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_119f7460> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_30060d07> ;
    skos:definition "Ein Spitzgraben ist ein Befestigungsgraben, der keine Sohle besitzt, sondern dessen Grabenwände stattdessen in spitzem Winkel aufeinandertreffen."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Spitzgraben"@de .

