        "Roman emperor in 251 (death year: 251)"@en,
        "heerser uit Oude Rome (230-251)"@nl ;
    skos:exactMatch <http://d-nb.info/gnd/1224273338>,
        <http://www.wikidata.org/entity/Q46837> ;
