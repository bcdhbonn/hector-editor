    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Bifazielle Spitze"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/blattfoermiger_schaber> a skos:Concept ;
