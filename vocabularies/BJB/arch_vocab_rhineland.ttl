<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/laterne_objekt> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
    skos:editorialNote "Benutzt für Beleuchtungskörper bestehend aus einer Lichtquelle mit Schutzgehäuse; für den Beleuchtungskörper der Straßenbeleuchtung siehe Straßenlampe."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Laterne (Objekt)"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/leichenbrand> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Werkzeug_und_Geraet> ;
