<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/geld> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Muenze_Gewicht_und_Tauschmittel> ;
    skos:definition "Geld ist ein Zahlungsmittel, das von einem Staat in Umlauf gebracht wird und anderen Waren und Dienstleistungen gegenüber als handelbares Tauschmittel dient."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Geld"@de .

<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/gemaelde> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/Bildkunst_Schrift_und_Spiel> ;
    skos:definition "Ein Gemälde ist ein visuelles Werk, bei dem ein Bild mit gelöster Farbe auf einen Bildträger gemalt wird."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:prefLabel "Gemälde"@de .

