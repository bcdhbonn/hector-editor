<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_f0489169> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_f204e7aa> ;
    skos:definition "Ein Becken ist ein Bauwerk, das als künstliche Vertiefung oder Einmuldung mit einer gebauten Umfassung errichtet ist. Becken können unterschiedliche Formen und Größen haben und werden entsprechend ihrem Einsatzzweck gestaltet."@de ;
    skos:inScheme <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/arch_vocab_rhineland> ;
    skos:narrower <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_2ba794ca>,
        <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_e635d4da> ;
    skos:prefLabel "Becken (Bauwerk)"@de ;
    skos:scopeNote "Ein Becken dient in der Regel dazu, Wasser oder andere Flüssigkeiten aufzunehmen."@de .

