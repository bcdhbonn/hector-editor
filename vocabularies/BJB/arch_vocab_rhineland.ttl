<http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_808bb712> a skos:Concept ;
    skos:broader <http://vocabs.bcdh.uni-bonn.de/LVR_Fundansprachen/concept_8e05577f> ;
    skos:definition "Viertel-Jahrhundert von 2200 v. Chr. bis 2176 v. Chr.."@de,
