lvr:befestigungsanlage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Befestigungsanlage ist ein Baukomplex, der zur Verteidigung eines Ortes oder einer Landschaft und zum Schutz gegen Zerstörung errichtet wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:abschnittsbefestigung,
