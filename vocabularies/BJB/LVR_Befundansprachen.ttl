@prefix dct: <http://purl.org/dc/terms/> .
@prefix lvr: <http://vocabs.bcdh.uni-bonn.de/LVR_Befundansprachen/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

lvr:a_horizont a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "A-Horizont"@de .

lvr:abbaukammer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Abbaukammer ist Bestandteil einer Untertageanlage in Form eines kammerartig eingeteilten Abbauraums, der im bergmännischen Abbauverfahren des Kammerbaus entsteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abbaukammer"@de .

lvr:abdruck_vertiefung a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abdruck (Vertiefung)"@de .

lvr:abfallgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "material that has accumulated or has been deposited into a cut feature"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300015132>,
        <http://www.wikidata.org/entity/Q319926> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abfallgrube"@de,
        "fill"@en .

lvr:abortgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Abortgrube ist eine Grube, die eine Kanalisation ersetzt und menschliche Abgangsstoffe auffängt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abortgrube"@de .

lvr:abraumhalde a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Abraumhalde ist eine Halde, die aus dem ausgeräumten, wertlosen Material besteht, das beim Abbau von Bodenschätzen anfällt."@de ;
    skos:editorialNote "Benutzt für die aus dem Abbau von Rohstoffen resultierende Aufschüttung; für die Halde eines Steinkohlenbergwerks siehe Bergehalde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abraumhalde"@de .

lvr:abri a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Abri ist eine Landschaftsform oder ein Landschaftsraum, der als Nische unter Felsüberhängen zu finden ist und natürlichen Schutz für Rast oder Wohnstätten bietet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abri"@de .

lvr:abschnittsbefestigung a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Abschnittsbefestigung ist eine Befestigungsanlage, die eine topographische Engstelle eines ansonsten natürlich unzugänglichen Geländes (Bergsporn, Halbinsel) abriegelt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abschnittsbefestigung"@de .

lvr:absetzbecken a skos:Concept ;
    skos:broader lvr:becken_bauwerk ;
    skos:definition "Ein Absetzbecken ist ein Becken, in dem Abwässer von Feststoffen getrennt werden. Da in dem Becken kaum Strömung herrscht, können die im Wasser enthaltenen Feststoffe zu Boden sinken."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Absetzbecken"@de .

lvr:absturzstelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Absturzstelle ist ein offener Raum, an dem ein Lebewesen oder ein Fahrzeug aus größerer Höhe fallend, verunglückt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Absturzstelle"@de .

lvr:abzugsloch_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abzugsloch (Ofen)"@de .

lvr:aermchen_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ärmchen (Ofen)"@de .

lvr:alenkastell a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Alenkastell ist ein römisches Auxiliarlager, in dem eine berittene Einheit (ala quingenaria oder ala milliaria, Kavallerieeinheiten) stationiert ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Alenkastell"@de .

lvr:altacker_landwirtschaft a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Altacker (Landwirtschaft)"@de ;
    skos:scopeNote "Im Gelände können sich Altäcker als terrassierte Fläche zeigen, die als Grünland genutzt wird oder mit Wald bestanden ist."@de .

lvr:amphitheater a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Amphitheater ist ein Theaterbau, der eine ovale oder kreisförmige Form aufweist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Amphitheater"@de ;
    skos:scopeNote "Die Form des Amphitheaters mit stufenweise ansteigenden Sitzreihen,  hohen Außenmauern oder Eintiefung in die Erde wird in der Gartenkunst für die Gestaltung von Freilichttheatern aufgenommen."@de .

lvr:anlegestelle a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Anlegestelle ist ein offener Raum an Gewässerufern, in dem Wasserfahrzeuge anlegen können."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Anlegestelle"@de .

lvr:aquaeduktbruecke a skos:Concept ;
    skos:broader lvr:aquaedukt ;
    skos:definition "Eine Aquäduktbrücke ist der Bestandteil eines Aquädukts, durch das eine Wasserleitung oder einen natürlichen oder künstlichen Wasserlauf über ein Gelände oder Terraineinschnitte geführt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aquäduktbrücke"@de .

lvr:aquaedukttunnel a skos:Concept ;
    skos:broader lvr:aquaedukt ;
    skos:definition "Ein Aquädukttunnel ist ein Tunnel, in dem ein Aquädukt durch Berge hindurchgeführt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aquädukttunnel"@de .

lvr:arbeitsflaeche_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Arbeitsfläche ist eine Stelle, die in der Archäologie alle Arbeitsbereiche, wie Flächen, Sondagen und Quadranten, umfasst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Arbeitsfläche (Archäologie)"@de .

lvr:arbeitsgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Arbeitsgrube"@de .

lvr:arbeitslager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Arbeitslager ist ein Gefangenenlager, in dem Menschen zur Ausbeutung ihrer Arbeitskraft durch Zwangsarbeit festgehalten werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Arbeitslager"@de .

lvr:aschengrube_ofen a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aschengrube (Ofen)"@de .

lvr:aschenkiste a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Eine Aschenkiste ist ein Behältnis, in dem die Reste einer Brandbestattung aufbewahrt werden."@de ;
    skos:editorialNote "Benutzt für das Behältnis zur Aufbewahrung von Resten einer Brandbestattung; für den Bestandteil eines Ofens siehe Aschkasten."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aschenkiste"@de ;
    skos:scopeNote "Eine Aschenkiste ist ähnlich einem Sarkophag, kann aber deutlich kleiner sein. Sie nimmt die vom Verbrennungsplatz ausgelesenen Reste der Brandbestattung auf. Eine Aschenkiste muss nicht in der Erde bestattet sein."@de .

lvr:atriumhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Atriumhaus ist ein Bauwerk, dessen Räume auf einen Innenhof gerichtet sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Atriumhaus"@de .

lvr:auensediment a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Auensediment ist ein Sediment, das im Auenbereich von Wasserläufen bei Überflutungen abgelagert wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Auensediment"@de .

lvr:aufschuettung_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Aufschüttung ist ein Erdbauwerk in Form einer künstlichen Erhöhung, die durch die Anhäufung von Material entstanden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aufschüttung (Bauwerk)"@de .

lvr:ausbruchgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ausbruchgraben"@de .

lvr:ausbruchgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ausbruchgrube"@de .

lvr:ausbruchsbefund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ausbruchsbefund"@de .

lvr:ausfachung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Ausfachung ist die Füllung eines Gefaches."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ausfachung"@de ;
    skos:scopeNote "Der Verschluss der einzelnen Gefache erfolgt durch Holzbohlen, Staken mit Lehm und Lehmbewurf, Backsteinen oder Bruchsteinen."@de .

lvr:auxiliarlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Auxiliarlager ist ein römisches Militärlager, in dem Hilfstruppen, die Auxiliartruppen, lagern und in dem sich Principia, Kommandantenwohnhaus und Mannschaftsunterkünfte befinden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Auxiliarlager"@de .

lvr:backhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Backhaus ist ein Nebengebäude, in dem sich ein Backofen befindet oder das ein Backofen in Form eines Gebäudes ist."@de ;
    skos:editorialNote "Verwendet für mehr oder weniger freistehende Gebäude, deren primärer Zweck sich durch den darin enthaltenen Backofen definiert. Für die (früher gemauerten) Bereiche in oder an Häusern, nutze Backofen wk002026."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Backhaus"@de .

lvr:backofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Backofen ist ein Ofen, der aus Mauerziegeln, Steinen oder Ton errichtet ist und der Zubereitung von Lebensmitteln dient."@de ;
    skos:editorialNote "Verwendet für die (früher gemauerten) Bereiche in oder an Häusern. Benutzt für den gesamten Ofen. Für Bestandteil eines Herdes siehe Backröhre. Für mehr oder weniger freistehende Gebäude, deren primärer Zweck sich durch den darin enthaltenen Backofen definiert, siehe Backhaus."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Backofen"@de .

lvr:bad_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bad ist ein Bauwerk, in dem Wasser in mitunter mehreren unterschiedlich großen Behältnissen zur Erfrischung, Reinigung oder zu Heilzwecken zur Verfügung steht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bad (Bauwerk)"@de .

lvr:badehaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Badehaus ist ein öffentliches Bad, in dessen Gebäude sich Wannenbäder und andere Waschmöglichkeiten befinden, beziehungsweise das direkt mit einer Badestelle an einem offenen Gewässer verbunden ist."@de ;
    skos:editorialNote "Benutzt für das Gebäude, in dem sich ein öffentliches Wannenbad befindet, beziehungsweise das direkt mit dem Wasser verbunden ist; für Gebäude einer Kuranlage, in denen sich Badevorrichtungen befinden, siehe Kurmittelhaus; für römische Badeanlagen siehe Thermen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Badehaus"@de ;
    skos:scopeNote "Badehäuser übernehmen teilweise auch die Funktion von gesellschaftlichen Treffpunkten."@de .

lvr:balken_bauteil a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Balken ist ein Bauteil, das als Träger horizontal gelagert ist und vertikal wirkende Kräfte aufnimmt und weitergibt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Balken (Bauteil)"@de .

lvr:baptisterium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Baptisterium ist ein Gebäude, das in der Regel als Zentralbau neben der eigentlichen Kirche steht und ausschließlich der Taufe dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baptisterium"@de .

lvr:baracke a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Baracke ist ein Bauwerk, das aus vorgefertigten Teilen schnell und einfach aufgebaut werden kann und nicht als dauerhaftes Gebäude vorgesehen ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baracke"@de .

lvr:barbakane a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Barbakane ist der Bestandteil einer Befestigungsanlage, die in Form eines hofartigen, von Wehrgängen umzogenen, vor einem Tor oder Turm befindlichen Wehrbaus, der zur Verstärkung einer schwachen Stelle dient, auftritt und einem eingedrungenen Angreifer durch seine Vorlagerung keinen Schutz bietet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Barbakane"@de .

lvr:basilika_halle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Basilika ist eine größere Halle, in der in römischer Zeit in größeren Orten Handelsgeschäfte, Versammlungen oder Gerichtsverhandlungen abgehalten wurden."@de ;
    skos:editorialNote "Benutzt für das hallenartige Gebäude ohne kirchliche Nutzung; für das Kirchengebäude siehe Basilika (Kirche)."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Basilika (Halle)"@de ;
    skos:scopeNote "Eine Basilika ist ein lang gestreckter hoher Raum, der meist mehrere Seitenschiffe und an der hinteren Seite einen Abschluss in Form einer Apsis oder einer erhöhten Exedra besitzt."@de .

lvr:basilika_kirche a skos:Concept ;
    skos:broader lvr:kirchengebaeude ;
    skos:definition "Eine Basilika ist ein Kirchengebäude, das im Obergaden oberhalb der Arkaden zu den Seitenschiffen durch Fenster unmittelbar belichtet wird, dessen Langhaus aus mehreren Schiffen besteht und dessen Mittelschiff höher ist als die Seitenschiffe."@de ;
    skos:editorialNote "Benutzt für das Kirchengebäude; für andere hallenartige Gebäude ohne kirchliche Nutzung siehe Basilika (Halle)."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Basilika (Kirche)"@de .

lvr:bastion a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Bastion ist der Bestandteil einer Festung, der vor dem Hauptwall (Kurtine) eines größeren Wehrbaus vorspringt und mit Geschützen bestückt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bastion"@de ;
    skos:scopeNote "Die Bastion tritt an die Stelle der Mauertürme und hatte anfangs einen runden, später einen spitzwinkligen Grundriss."@de .

lvr:batterie_festung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Batterie ist der Bestandteil einer Festung, der der wirksamen und sicheren Aufstellung von Geschützen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Batterie (Festung)"@de .

lvr:baugrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Raum, der unterhalb der Geländeoberfläche ausgehoben zur Gründung einer baulichen Anlage"@de ;
    skos:exactMatch <http://www.wikidata.org/entity/Q811364>,
        <https://d-nb.info/gnd/4004790-8> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baugrube"@de,
        "building pit"@en .

lvr:bauhuette_bauwerk a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Bauhütte ist eine Werkstatt, in der die am Bau beteiligten Handwerker, wie Steinmetze, Maler usw., arbeiten."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bauhütte (Bauwerk)"@de .

lvr:baumsarg a skos:Concept ;
    skos:broader lvr:sarg ;
    skos:definition "Ein Baumsarg ist ein Sarg, der aus einem der Länge nach aufgetrennten und anschließend ausgehöhlten Baumstamm gefertigt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baumsarg"@de .

lvr:baumstandspur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Baumstandspur ist Befund, der den ehemaligen Standort einer Baumwurzel anzeigt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baumstandspur"@de .

lvr:baumwurfgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Baumwurfgrube"@de .

lvr:befund_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Befund ist eine aussagefähige Beobachtung in archäologischen Fundsituationen. Befunde können Hinweise auf menschliche, aber auch auf natürliche Aktivitäten geben, die in Form von mehr oder weniger deutlich unterscheidbaren Verfärbungen, Schichtbildungen und Strukturen erkennbar sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Befund (Archäologie)"@de .

lvr:befund_nicht_interpretierbar a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Befund nicht interpretierbar"@de .

lvr:beigabennische a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:editorialNote "Benutzt in Kombination mit den jeweiligen Grabtyp"@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Beigabennische"@de .

lvr:benefiziarierstation a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Benefiziarierstation ist eine militärische Anlage, in der Benefiziarier, aus ihren Stammeinheiten abkommandierte Unteroffiziere, an den Fernstraßen des Römischen Reiches Polizeifunktionen wahrnehmen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Benefiziarierstation"@de ;
    skos:scopeNote "Die Stationen liegen an Straßenkreuzungen, Flussübergängen und anderen neuralgischen Punkten, sie sind befestigt und weisen nur wenige Gebäude innerhalb der Befestigung auf."@de .

lvr:bergbaugebiet a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bergbaugebiet ist ein offener Raum, in dem die  vorhandenen Bodenschätze abgebaut werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergbaugebiet"@de .

lvr:bergfried a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bergfried ist ein Wehrturm, der als Hauptturm einer Burg im Gegensatz zu einem Wohnturm nur eingeschränkt bewohnbar war."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergfried"@de ;
    skos:scopeNote "Die Übergänge zwischen Bergfried und Wohnturm sind allerdings fließend. Zu berücksichtigen ist auch, dass die Benennung \"Bergfried\" für einen Turm mit vorrangiger Funktion als Wehrturm und vor allem als Statussymbol erst der deutschsprachigen Burgenliteratur des 19. Jahrhunderts entstammt."@de .

lvr:bergwerk a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Bergwerk ist ein Betrieb, der der Gewinnung und Verarbeitung von Steinen und Erden dient."@de ;
    skos:editorialNote "Benutzt für den Rohstoff gewinnenden Betrieb; für das gesamte Gelände eines Bergwerks siehe Bergwerksgelände."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergwerk"@de ;
    skos:scopeNote "Die Rohstoffe können im Tagebau oder im Tiefbau gewonnen werden. Zu einem Bergwerk können mehrere Tagesanlagen und Schachtanlagen gehören."@de .

lvr:bergwerksschacht a skos:Concept ;
    skos:broader lvr:schacht_bauwesen ;
    skos:definition "Ein Bergwerksschacht ist der Bestandteil einer Untertageanlage, der senkrecht, oder seltener auch schräg, Lagerstätten erschließt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergwerksschacht"@de .

lvr:bergwerksstollen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Bergwerksstollen ist ein Stollen, der tunnelförmig, waagerecht oder leicht ansteigend verläuft und von der Erdoberfläche aus die Verbindung zu einer Lagerstätte herstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergwerksstollen"@de .

lvr:berme a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Berme ist ein Erdbauwerk, das in Form eines ebenen oder schwach geneigten Absatzes zwischen dem inneren Rand eines Grabens und dem äußeren Fuß eines Walles oder einer Wehrmauer gestaltet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Berme"@de .

lvr:bestattungsplatz a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Bestattungsplatz ist ein Baukomplex, auf dem Verstorbene beigesetzt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bestattungsplatz"@de .

lvr:bildstock_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bildstock ist ein Bauwerk, das mit einem religiösen Bild versehen ist und im Freien aufgestellt wird. Es ist häufig ein Flurdenkmal."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bildstock (Bauwerk)"@de .

lvr:bioturbation a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bioturbation"@de .

lvr:bleihuette_wirtschaft a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Bleihütte ist ein Hüttenwerk, in dem Blei geschmolzen und weiterverarbeitet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bleihütte (Wirtschaft)"@de .

lvr:bohrloch a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bohrloch"@de .

lvr:bombentrichter a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bombentrichter ist ein Explosionskrater, der durch den Einschlag einer Bombe entstanden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bombentrichter"@de .

lvr:brandgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Brandgrab ist ein Grab, in dem die Überreste von verbrannten Toten bestattet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brandgrab"@de .

lvr:brandgrubengrab a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Ein Brandgrubengrab ist ein Brandgrab, in dessen Grabgrube sich kein Behältnis befindet. Der Leichenbrand wird vermischt mit Scheiterhaufenresten, teilweise auch mit Grabbeigaben, direkt in die Grube gefüllt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brandgrubengrab"@de .

lvr:brandschuettungsgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Brandschüttungsgrab ist ein Urnengrab, in dem sich aufbewahrt in einem Behältnis, der größte Teil des Leichenbrandes in einem Behältnis befindet, über das jedoch weitere Scheiterhaufenrückstände, vermischt mit Leichenbrandresten und teilweise Beigaben, geschüttet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brandschüttungsgrab"@de .

lvr:brauerei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Brauerei ist ein Betrieb, in dem eine oder mehrere Anlagen zum Brauen von Bier untergebracht sind und in dem das Bier abgefüllt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brauerei"@de .

lvr:brennraum_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brennraum (Ofen)"@de .

lvr:brennraumboden a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brennraumboden"@de .

lvr:bruecke_bauwerk a skos:Concept ;
    skos:broader lvr:Infrastruktur_und_Verkehr ;
    skos:definition "Eine Brücke ist ein Bauwerk, das natürliche oder künstliche Hindernisse überspannt und über das ein Verkehrsweg führt."@de ;
    skos:editorialNote "Benutzt für ein Bauwerk, das natürliche oder künstliche Hindernisse überspannt; für ein unterirdisches Bauwerk, dessen lichte Weite weniger als zwei Meter misst, siehe Durchlass (Unterirdisches Bauwerk), für ein unterirdisches Bauwerk, dessen lichte Weite mehr als zwei Meter misst, siehe Unterführung und Tunnel."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brücke (Bauwerk)"@de .

lvr:brunnenfassung a skos:Concept ;
    skos:broader lvr:brunnen ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brunnenfassung"@de .

lvr:brunnenschacht a skos:Concept ;
    skos:broader lvr:schacht_bauwesen ;
    skos:definition "Ein Brunnenschacht ist ein Schacht und der Bestandteil eines Schachtbrunnens, der als Röhre bis auf den Grund des Brunnens führt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brunnenschacht"@de .

lvr:brunnenstube a skos:Concept ;
    skos:broader lvr:brunnen ;
    skos:definition "Eine Brunnenstube ist eine Quellfassung, die das Quellwasser durch Einhausung vor Verschmutzung schützt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brunnenstube"@de ;
    skos:scopeNote "Teile der Brunnenstube können Filter und andere Vorrichtungen sein, die das Wasser reinigen. In der Regel dient eine Brunnenstube nicht der unmittelbaren Entnahme, sondern der weiteren Verteilung des Wassers."@de .

lvr:bunker_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Bunker ist ein Gebäude, das dem Schutz von Zivilpersonen und Militärpersonen sowie gefährdeten Gütern dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bunker (Bauwerk)"@de .

lvr:burg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Burg ist eine Befestigungsanlage, die seit der Frühgeschichte einen in sich geschlossenen, bewohnbaren Wehrbau darstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Burg"@de ;
    skos:scopeNote "Der Begriff Burg ist epochenübergreifend. Auch in der Neuzeit hat die Burg noch häufig eine zumindest rechtliche Bedeutung."@de .

lvr:burgus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Burgus ist eine Befestigungsanlage, die vom 2. Jahrhundert bis zum 4. Jahrhundert n. Chr. zum Schutz von Grenzen, Straßen oder ländlichen Orten angelegt wurde und nur mit einer kleineren Truppeneinheit besetzt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Burgus"@de ;
    skos:scopeNote "Burgi bestehen meist aus einer quadratischen, von Wall und Graben umgebenen Wehranlage, in der Kasernenbauten oder ein Wehrturm stehen konnten. Sie können auch in Verbindung zu einem Landgut stehen und dienten dann der Verteidigung der und durch die Landbevölkerung."@de .

lvr:bustum a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Bustum ist ein Brandgrab, in dem der Leichnam verbrannt und bestattet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bustum"@de ;
    skos:scopeNote "Der Leichnam wurde in einem Scheiterhaufen über der späteren Grabgrube verbrannt, die Brandreste fielen dabei in die Grube. Daher sind die Ränder dieser Gräber durch das Feuer rot verziegelt. Nach der Einäscherung des Leichnams konnten die Reste ausgelesen, in eine Urne gefüllt und getrennt von dem Brandschutt bestattet werden. Zusätzlich konnten unverbrannte Beigaben mitgegeben werden."@de .

lvr:canabae_legionis a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Canabae Legionis ist eine Siedlung, die außerhalb eines römischen Lagers und entlang einer zum Lager führenden Straße angelegt ist, selbst aber nicht-militärischen Charakter aufweist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Canabae legionis"@de ;
    skos:scopeNote "Sie besitzt eine eigene Verwaltung, diente vorwiegend der Versorgung der Militäreinheiten und weist daher gewerbliche Einrichtungen sowie Wohn-, Handwerks- und Wirtschaftsbauten auf."@de .

lvr:cella_memoria a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Cella memoria ist ein Grabbau, der in der Spätantike und dem frühen Mittelalter dem Gedenken von Bestatteten diente."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Cella memoria"@de ;
    skos:scopeNote "Bei einer Cella memoria handelt es sich um ein kleineres, rechteckiges Gebäude ohne kirchliche Einrichtungen. Sie kann einen christlichen wie einen heidnischen Hintergrund haben."@de .

lvr:colonia_siedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Colonia ist eine Siedlung, die in den römischen Provinzen geplant angelegt wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Colonia (Siedlung)"@de ;
    skos:scopeNote "In einer frühen Phase dienten sie der Kontrolle der besetzten Gebiete mit militärischen Mitteln, später entwickelten sich daraus Verwaltungsorte und Versorgungsorte für das Umland."@de .

lvr:contrescarpe a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Contrescarpe ist ein Bestandteil einer Festung, der die Feldseite eines Festungsgrabens bezeichnet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Contrescarpe"@de .

lvr:darre a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Darre ist eine Trockenanlage, die dazu dient, pflanzliche Erzeugnisse durch Trocknen und leichtes Rösten haltbar zu machen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Darre"@de .

lvr:deckungsgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Luftschutzbauwerk"@de ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1182020> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Deckungsgraben"@de,
        "cover ditch"@en .

lvr:deich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Deich ist ein Damm, der zum Schutz vor Überschwemmungen oder zum Schutz tiefer liegender Gebiete entlang von Flüssen und Meeresküsten aufgeschüttet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Deich"@de .

lvr:depot_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Depot ist ein archäologischer Befund, in dem mehrere Gegenstände zu einem Zeitpunkt niedergelegt wurden, im Sinne einer willentlichen Entäußerung."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Depot (Archäologie)"@de .

lvr:dom a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Dom ist ein Kirchengebäude, das zu einem Bischofssitz gehört."@de ;
    skos:editorialNote "Benutzt nur für Bischofskirchen; für andere als \"Dom\" bezeichnete Kirchen siehe Kirchengebäude."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dom"@de ;
    skos:scopeNote "Als Bestandteil des Namens wird Dom umgangssprachlich auch für andere bedeutende Kirchen verwendet."@de .

lvr:donjon a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Donjon"@de ;
    skos:scopeNote "Im Gegensatz zum wehrhaften Bergfried im deutschen Raum ist der Donjon jedoch bewohnt."@de .

lvr:dorf a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Dorf ist eine dauerhafte Siedlung mit mehreren beieinander liegenden Wohnstätten. Das Dorf ist in der Regel überwiegend durch die Wirtschaftsformen Landwirtschaft oder Fischerei geprägt und hat Gebäude mit zentraler Funktion, wie zum Beispiel eine Kirche oder eine Schule."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dorf"@de .

lvr:dorfkern a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dorfkern"@de .

lvr:dormitorium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Dormitorium ist ein Gebäudeteil, der in einem Kloster als Schlafsaal der Klosterinsassen dient oder deren Zellen enthält."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dormitorium"@de .

lvr:dungschleier a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Der Begriff Dungschleier bezeichnet einen Dungauftrag, der als dünne Stalldungschicht auf den Acker gelangt. In der Archäologie werden Oberflächenfunde, die aufgrund ihrer Datierung und Zusammensetzung als von der Landwirtschaft aufgetragene Fundstreuung bestimmt werden, so genannt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dungschleier"@de .

lvr:einfriedung a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Eine Einfriedung ist ein Element, das den Zugang zu dem durch die Einfriedung umschlossenen Bereich nur durch ein Tor, eine Schranke oder ähnliches erlaubt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einfriedung"@de .

lvr:einkammerofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Einkammerofen ist ein Brennofen, in dem sich Feuerung und Brenngut in einer gemeinsamen Kammer oder unter einer Ofenkuppel befinden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einkammerofen"@de ;
    skos:scopeNote "Feuerungsraum und Brennraum können schräg hintereinander angelegt oder durch eine kleine Stufe getrennt sein. Jedoch sind keine zusätzlichen trennenden Elemente (Feuergitter bzw. Ständer) zwischen Feuerung und Brenngut vorhanden."@de .

lvr:einsiedelei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Einsiedelei ist eine Siedlung, in der sich eine einzelne Person oder eine Gruppe zu einem kontemplativen Leben mit besonderer Konzentration auf geistige sowie religiöse Inhalte oder einem Leben im Einklang mit der Natur zurückzieht."@de ;
    skos:editorialNote "Benutzt für den Ort religiös motivierten Rückzugs; für den im Rahmen einer Gartengestaltung und häufig nachgespielten zeitweisen Rückzug gestalteten Ort siehe Eremitage."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einsiedelei"@de .

lvr:einzelfund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Einzelfund ist ein Fund, der in der Regel ohne erkennbaren funktionalen Kontext aufgefunden wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einzelfund"@de .

lvr:einzelhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Einzelhof ist eine Einzelsiedlung, die von einem einzeln gelegenen Bauernhof gebildet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einzelhof"@de .

lvr:eisenbahnstrecke a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Eisenbahnstrecke ist ein Schienenweg für den spurgebundenen Eisenbahnverkehr auf eigenem Bahnkörper."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Eisenbahnstrecke"@de ;
    skos:scopeNote "Zur Eisenbahnstrecke gehören die Bahnhöfe, die freien Strecken zwischen den Bahnhöfen sowie die sonstigen Bahnanlagen (wie Betriebswerke, Brücken, Bahnübergänge). Die Strecken werden nach Haupt- und Nebenstrecken, Kleinbahnen, Werkbahnen und Stadtschnellbahnen unterschieden."@de .

lvr:eisenhuette a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Eisenhüttenwerk ist ein Hüttenwerk, in dem Eisen aus Erz gewonnen wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Eisenhütte"@de .

lvr:eisgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Eisgrube ist eine Grube, in der Lebensmittel und Getränke mit Hilfe von dort eingelagertem Eis gekühlt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Eisgrube"@de .

lvr:eiskeller a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Eiskeller ist ein Keller und ein Raum, in dem früher Eis aufbewahrt wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Eiskeller"@de .

lvr:entwaesserungsgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "offener Graben, der überflüssiges Wasser ableitet"@de,
        "open ditch carrying surplus water"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1345747> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Entwässerungsgraben"@de,
        "drainage ditch"@en .

lvr:erdkeller a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Erdkeller ist ein Keller, der aus einem einfachen Loch im Erdreich besteht, das meist in einen Hang hineingegraben und mit Mauerwerk und Deckenkonstruktion ausgebaut wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Erdkeller"@de .

lvr:erdwerk_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Erdwerk ist eine Befestigungsanlage, die aus einer Grabenanlage mit einem oder mehreren Zugängen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Erdwerk (Archäologie)"@de ;
    skos:scopeNote "Das hinter dem Graben im Inneren der Anlage anzunehmende Annäherungshindernis in Form eines Walles oder einer Palisade kann im archäologischen Befund gelegentlich nachgewiesen oder erschlossen werden."@de .

lvr:erzroestplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Erzröstplatz ist ein offener Raum, auf dem sich Röstherde für die Erze befinden und der häufig Bestandteil eines Verhüttungsplatzes ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Erzröstplatz"@de .

lvr:erzwaesche_vorrichtung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Erzwäsche (Vorrichtung)"@de .

lvr:eskarpe a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Eskarpe ist der Bestandteil einer Festung, der die Innenseite bzw. Festungsseite eines Festungsgrabens markiert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Eskarpe"@de .

lvr:explosionskrater a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Explosionskrater ist ein offener Raum, welcher durch eine trichterförmige Vertiefung der Erdoberfläche gekennzeichnet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Explosionskrater"@de ;
    skos:scopeNote "Die Vertiefung kann dabei durch eine vulkanische Eruption oder durch die Explosion einer Bombe oder eines Geschosses entstanden sein."@de .

lvr:fabrica a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:exactMatch <http://www.wikidata.org/entity/Q18380196> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fabrica"@de,
        "Fabrica"@en .

lvr:fabrik_baukomplex a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ort, an dem Güter industriell hergestellt oder verarbeitet werden oder wurden (auch stillgelegt)"@de,
        "facility where goods are industrially made, or processed"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300006232>,
        <http://www.wikidata.org/entity/Q83405>,
        <https://d-nb.info/gnd/4250288-3> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fabrik"@de,
        "factory"@en ;
    skos:scopeNote "Die Verwaltung des Betriebes erfolgt getrennt von der Produktion."@de .

lvr:fachwerkstaenderbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Fachwerkständerbau ist ein Holzfachwerkbau, dessen Ständer vom Boden bis zum Dach durchlaufen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fachwerkständerbau"@de .

lvr:faekalienrinne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Fäkalienrinne ist ein Bauwerk, das der Entsorgung von Fäkalien dient und die Form einer Furche oder einer Röhre besitzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fäkalienrinne"@de .

lvr:faerberei_wirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Färberei ist ein Betrieb, in dem Textilien gefärbt werden."@de ;
    skos:editorialNote "Benutzt für den Handwerksbetrieb und den Industriebetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Färberei (Wirtschaft)"@de .

lvr:faerbergrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Färbergrube ist eine Grube, in der die Färber ein Farbbad erzeugen, in dem Textilien gefärbt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Färbergrube"@de .

lvr:faschine a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Faschine ist ein Materialverbund aus Reisig und Drähten, der der Sicherung von Böschungen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Faschine"@de ;
    skos:scopeNote "Das Reisig wird mit Hilfe von Draht zu walzenförmigen Bündeln zusammengefügt."@de .

lvr:feldbegrenzung_landwirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feldbegrenzung (Landwirtschaft)"@de .

lvr:feldbrandofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Feldbrandofen ist ein Brennofen, der nicht aufgemauert wird, sondern ausschließlich aus den zu brennenden Rohlingen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feldbrandofen"@de .

lvr:feldstellung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Feldstellung ist eine Feldbefestigung, die von der kämpfenden Truppe zum eigenen Schutz angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feldstellung"@de ;
    skos:scopeNote "Es handelt sich zumeist um ausgehobene Gräben, Deckungslöcher oder Sicherungsbauten (Feldunterstände). Die Anlagen wurden z.T. mit Holz ausgebaut, vor allem die Feldunterstände."@de .

lvr:felsbild a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Felsbild ist ein visuelles Werk, das in einen Felsen geritzt oder auf den Felsen gemalt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Felsbild"@de .

lvr:felsheiligtum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Felsheiligtum ist ein Naturheiligtum, an dem kultische Handlungen in unmittelbarer Verbindung an offenen, natürlichen Felsen, Felsspalten usw. vollzogen werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Felsheiligtum"@de .

lvr:festes_haus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Festes Haus ist ein Gebäude, das einem adligen Besitzer als Wohngebäude dient, aber auch Wehrfunktion hat, Repräsentationszwecke erfüllt und mit relativ starken Mauern versehen ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Festes Haus"@de .

lvr:festung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Festung ist eine Befestigungsanlage, die vorrangig zu militärischen Verteidigungszwecken dauerhaft errichtet wurde und zumeist aus mehreren untergeordneten Wehrbauten besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Festung"@de ;
    skos:scopeNote "Die hauptsächlich vom Ende des 15. Jahrhunderts bis in die erste Hälfte des 20. Jahrhunderts entstandenen Festungen sind in ihrer Form und Ausbildung von der gleichzeitigen Entwicklung der Feuerwaffen abhängig."@de .

lvr:feuerstelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Feuerstelle ist eine Verfärbung, die durch darin liegende Brandreste, wie Holzkohle oder Asche entsteht, und sowohl auf der Oberfläche liegen kann aber auch in einer grubenartigen Vertiefung."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feuerstelle"@de .

lvr:feuerungskanal a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feuerungskanal"@de .

lvr:feuerungsraum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feuerungsraum"@de .

lvr:feuerungstuer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Feuerungstür"@de .

lvr:findling_geologie a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Findling ist ein Gesteinsblock, der durch einen Gletscher über eine größere Entfernung mittransportiert wird und nach dem Abschmelzen des Gletschers zurückbleibt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Findling (Geologie)"@de .

lvr:fischteich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Fischteich ist ein Teich, in dem Fische gehalten und gezüchtet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fischteich"@de .

lvr:flachgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Flachgrab ist ein Grab, das oberflächlich durch keine Erdaufschüttung gekennzeichnet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flachgrab"@de .

lvr:flachsroeste_grube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Flachsröste ist eine Grube, die mit Wasser gefüllt ist und in der Flachs mehrere Wochen fault."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flachsröste (Grube)"@de ;
    skos:scopeNote "Dadurch löst sich die spinnbare Flachsfaser von den holzigen Pflanzenbestandteilen."@de .

lvr:flakstellung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Flakstellung ist eine Geschützstellung, in der Flugabwehrgeschütze (Flugabwehrkanone, Fliegerabwehrkanone - FLAK) aufgestellt und bedient werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flakstellung"@de .

lvr:fliessgewaesser a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Fließgewässer ist ein Oberflächengewässer mit ständig oder zeitweilig fließendem Wasser."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fließgewässer"@de .

lvr:flottenlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Flottenlager ist ein Auxiliarlager, das vom Römischen Reich als Standquartier der Flotte genutzt wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flottenlager"@de .

lvr:fluchtgang a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Fluchtgang ist ein Gang, der als Fluchtmöglichkeit in Notfällen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fluchtgang"@de ;
    skos:scopeNote "Fluchtgänge finden sich in Befestigungsanlagen, in Häusern, Bergwerken, Industrieanlagen usw. Sie können direkt in den anstehenden Boden oder Fels getrieben worden sein oder separat errichtet und anschließend zugedeckt worden sein."@de .

lvr:flughafen a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Flughafen ist ein Baukomplex, der aus Start- und Landebahn sowie den Nebeneinrichtungen zur Personen- und Güterabfertigung, Überwachung des Flugverkehrs und Wartung der Flugzeuge besteht."@de ;
    skos:editorialNote "Benutzt für die großflächige Anlage mit umfangreichem Frachtverkehr, Linienverkehr und Charterverkehr mit Verkehrsflugzeugen; für die flächenmäßig kleinere Anlage für den Flugverkehr mit in der Regel privaten oder Sportflugzeugen siehe Flugplatz; für einen für die Landung eines Flugzeugs, oder  eines Hubschraubers geeigneten Platz siehe Landeplatz; für Militärflughafen siehe Fliegerhorst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flughafen"@de ;
    skos:scopeNote "Er dient zur Abwicklung des regelmäßigen kommerziellen Linien- und Charterverkehrs mit Verkehrsflugzeugen."@de .

lvr:flugzeug a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Flugzeug ist ein Luftfahrzeug mit festen Tragflächen, das schwerer ist als die verdrängte Luftmasse und durch dynamischen Auftrieb fliegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flugzeug"@de .

lvr:flurform a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Flurform ist eine landwirtschaftliche Nutzfläche, deren Parzellen eine bestimmte Form bilden. Diese ändert sich abhängig von der Bewirtschaftung, der Rechtslage oder den Herrschaftsverhältnissen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flurform"@de .

lvr:flusskies a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flusskies"@de .

lvr:forum_offener_raum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Forum ist ein Platz, der in römischer Zeit als zentraler Gerichtsort, Marktort und Versammlungsort fungierte."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Forum (Offener Raum)"@de .

lvr:fossillagerstaette a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fossillagerstätte"@de .

lvr:freilandstation a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Freilandstation ist eine zeitweilige Siedlung, die durch Jäger und Sammler im offenen Gelände gebildet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Freilandstation"@de .

lvr:friedhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Friedhof ist ein Bestattungsplatz, der eingefriedet ist und bei dem der Zugang zu den Gräbern durch Wege oder Straßen gewährleistet ist."@de ;
    skos:editorialNote "Friedhof benutzt für Begräbnisplätze seit dem Mittelalter; für Begräbnisplätze vor dem Mittelalter siehe Gräberfeld; für Begräbnisplätze an Kirchen siehe Kirchhof."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Friedhof"@de ;
    skos:scopeNote "Die Gräber sind oftmals in Reihen oder Feldereinteilungen angelegt."@de .

lvr:frigidarium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Frigidarium ist der Bestandteil von Thermen, in dem kalte Bäder genommen werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Frigidarium"@de .

lvr:fritteofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Fritteofen ist ein Ofen, in dem Glasfritte hergestellt wird, wobei die Beimengungen für die Glasherstellung gepulvert, vermischt und bis zur Schmelze erhitzt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fritteofen"@de .

lvr:fund_objekt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:editorialNote "Benutzt für Funde, die als Quelle im Rahmen einer wissenschaftlichen Untersuchung genutzt werden können."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fund (Objekt)"@de .

lvr:fundament a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Fundament ist ein Bauteil, der als der unterste Teil eines Bauwerks dessen Gewicht unmittelbar auf den Baugrund als Pressung überträgt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundament"@de .

lvr:fundamentgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Fundamentgraben ist ein Graben, der Bestandteil eines Fundamentunterbaus ist und mit flacher Sohle in den Boden eingegraben wird, und in dem das Fundament errichtet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundamentgraben"@de .

lvr:fundkonzentration a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Fundkonzentration ist ein Allgemeinbegriff in der Archäologie, der eine Ansammlung von Funden, die auf einer abgrenzbaren Fläche zusammenliegen und chronologisch einer bestimmbaren Epoche angehören, umfasst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundkonzentration"@de .

lvr:fundplatzindikator a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundplatzindikator"@de .

lvr:furt a skos:Concept ;
    skos:broader lvr:Infrastruktur_und_Verkehr ;
    skos:definition "Eine Furt ist ein Weg, der an einer seichten Stelle das Überqueren eines Flusses oder Baches durch das Fließgewässer ermöglicht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Furt"@de .

lvr:fussboden a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Fußboden ist ein Bauteil, der einen Raum als begehbare Fläche nach unten hin begrenzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fußboden"@de .

lvr:fussbodenheizung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Art von Flächenheizung"@de,
        "system of heating"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1431222>,
        <https://d-nb.info/gnd/4155745-1> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fußbodenheizung"@de,
        "underfloor heating"@en .

lvr:fussbodenmosaik a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:exactMatch <http://www.wikidata.org/entity/Q120714483>,
        <https://d-nb.info/gnd/4155746-3> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fußbodenmosaik"@de,
        "mosaic pavement"@en .

lvr:gaestehaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gästehaus ist ein Beherbergungsbetrieb, der meist zur vorübergehenden Unterbringung von Gästen einer größeren Einrichtung, zum Beispiel einer Hochschule, eines größeren Betriebes oder einer Gebietskörperschaft, genutzt wird."@de ;
    skos:editorialNote "Benutzt für den Beherbungsbetrieb, der institutionell geführt und häufig auch zu repräsentativen Zwecken genutzt wird; für die zumeist privat geführte und im Vergleich zu einem Hotel in seiner Ausstattung bescheidenere Gästeunterkunft siehe Pension."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gästehaus"@de .

lvr:galgenhuegel a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Galgenhügel ist eine Richtstätte, die außerhalb eines bewohnten Ortes auf einem Hügel liegt und an der ein Galgen errichtet worden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Galgenhügel"@de .

lvr:gang_architektur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gang ist ein Erschließungsraum, der zumindest von drei Seiten begrenzt wird, zuweilen auch überdeckt oder unterirdisch verlaufen kann."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gang (Architektur)"@de .

lvr:garage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Garage ist ein Gebäudeteil, in dem Kraftfahrzeuge abgestellt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Garage"@de .

lvr:garten a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Garten ist ein offener Raum, der abgegrenzt, häufig auch eingefriedet ist und in dem Nutzpflanzen oder Zierpflanzen, oft beide, angebaut werden."@de ;
    skos:editorialNote "Benutzt für kleinere und eindeutig abgegrenzte Anlagen, auch für Teile von Anlagen; für größere Anlagen siehe auch Park."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Garten"@de ;
    skos:scopeNote "Mehr oder weniger künstlerisch oder aufwendig gestaltet ist der Garten immer vom Menschen angelegt und der Pflege bedürftig. Die Begriffe Garten und Park werden auch synonym gebraucht."@de .

lvr:gasthof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gasthof ist ein Beherbergungsbetrieb, der neben einer Gaststätte zur Verpflegung der Gäste auch Zimmer zur Unterkunft von Übernachtungsgästen anbietet."@de ;
    skos:editorialNote "Benutzt für den Beherbergungsbetrieb, der neben einer Speisegaststätte auch Übernachtungsunterkünfte anbietet; für den Bewirtungsbetrieb allgemein siehe Gaststätte, für den Bewirtungsbetrieb der vorrangig Speisen anbietet siehe Restaurant."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gasthof"@de .

lvr:gaststaette a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Gaststätte ist ein Bewirtungsbetrieb, in dem man gegen Bezahlung Getränke und Speisen erhalten kann."@de ;
    skos:editorialNote """Benutzt für den Bewirtungsbetrieb ohne Übernachtungsmöglichkeit. Für den Bewirtungsbetrieb, der auch Übernachtungsunterkünfte anbietet, siehe Gasthof. 
Für den Bewirtungsbetrieb, der vorrangig Speisen anbietet, siehe Restaurant."""@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gaststätte"@de ;
    skos:scopeNote "Eine Gaststätte kann ein Gebäude oder Teil eines Gebäudes sein."@de .

lvr:gebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gebäude ist ein Bauwerk, das sich über der Erde erhebt, ein Dach besitzt, einen oder mehrere Räume umschließt, von Menschen betreten werden kann, dem Schutz von Menschen, Tieren oder Sachen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gebäude"@de .

lvr:gefaengnisgebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:editorialNote "Benutzt für das einzelne Gebäude; für die Einrichtung des heutigen Strafvollzugs siehe Justizvollzugsanstalt; für historische Einrichtungen bis 1970 siehe Gefängniskomplex."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gefängnisgebäude"@de .

lvr:gerberei a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Gerberei ist ein Betrieb, der handwerklich oder industriell Tierhäute zu Leder verarbeitet oder Felle zu Pelzen zurichtet."@de ;
    skos:editorialNote "Benutzt für den Handwerksbetrieb und den Industriebetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gerberei"@de .

lvr:gerbergrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Gerbergrube ist eine Grube, die mit einer Gerbflüssigkeit gefüllt ist und in der der Gerbprozess der Tierhäute stattfindet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gerbergrube"@de .

lvr:geschuetzstand a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Geschützstand ist eine militärische Anlage, die Bestandteil einer Geschützstellung ist und auf der ein Geschütz beim Schießen steht, im Weiteren aber auch eine ganze Batterie."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Geschützstand"@de .

lvr:getreidedarre a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Getreidedarre ist eine Darre, die dem Trocknen von Getreide dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Getreidedarre"@de .

lvr:gewoelbe_bauteil a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gewölbe ist ein Bauteil, der als gebogene Fläche einen Raum nach oben abschließt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gewölbe (Bauteil)"@de .

lvr:glacis a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Glacis ist der Bestandteil einer Festung, der als feindwärts flach geneigte Aufschüttung vor dem äußeren Grabenrand einer Festung ein freies Schussfeld ermöglicht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Glacis"@de .

lvr:glashuette a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Glashütte ist ein Betrieb, in dem Glas gewonnen und teilweise weiterverarbeitet wird."@de ;
    skos:editorialNote "Benutzt für einen Betrieb, der vorrangig Glas erzeugt; für einen Betrieb, der Glas weiterverarbeitet siehe Glasfabrik."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Glashütte"@de .

lvr:glasofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Glasofen ist ein Ofen, in dem Glas hergestellt oder bearbeitet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Glasofen"@de .

lvr:glaswerkstatt a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Glaswerkstatt"@de .

lvr:glockengussgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Glockengrube ist eine Gießgrube, in der zunächst die Gussform einer Glocke hergestellt wird, um diese anschließend vor Ort zu gießen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Glockengussgrube"@de .

lvr:grabbau_bauwerk a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Grabbau ist ein Bauwerk, das dem Schutz der eigentlichen Bestattung oder Bestattungen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabbau (Bauwerk)"@de .

lvr:grabeinfriedung a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Grabeinfriedung ist eine Einfriedung, die die Begrenzung einzelner Grabstätten markiert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabeinfriedung"@de .

lvr:grabenanlage a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Der Begriff Grabenanlage bezeichnet Gräben, die in einem bestimmten Verhältnis zueinander angelegt sind."@de ;
    skos:editorialNote "Benutzt für Grabenanlage zusammen mit Befestigungsanlage oder Bewässerungsanlage."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabenanlage"@de ;
    skos:scopeNote "Eine Grabenanlage kann eine Befestigungsanlage oder eine Bewässerungsanlage sein."@de .

lvr:grabgarten a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Grabgarten ist eine Grabeinfriedung, die aus einem quadratischen oder rechteckigen, vereinzelt leicht trapezförmigen Graben besteht, der als obertägig sichtbare Begrenzung eine oder mehrere Grabstellen umfasste."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabgarten"@de ;
    skos:scopeNote "Es können mehrere Grabgärten aneinanderstoßen sowie miteinander verbunden sein. In einer der Seiten kann eine Erdbrücke den Graben unterbrechen. Grabgärten wurden vor allem in der Eisenzeit und der Römischen Kaiserzeit angelegt. Der Begriff wird darüber hinaus auch für Grabeinfriedungen anderer Zeitstellungen benutzt."@de .

lvr:grabgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Grabgrube ist eine Grube, die Bestandteil eines Grabes ist und in der die sterblichen Überreste von Mensch oder Tier niedergelegt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabgrube"@de .

lvr:grabhuegel a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Grabhügel ist eine Aufschüttung, die aus Erde besteht und sich über einer oder mehreren Grablegen befindet."@de ;
    skos:editorialNote "Benutzt für ein Grab mit hügelartiger Aufschüttung, das nach der Merowingerzeit angelegt wurde; für Hügel über Gräbern aus urgeschichtlichen Perioden bis zur Merowingerzeit siehe Hügelgrab."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabhügel"@de .

lvr:grabkammer a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Grabkammer ist ein Grabraum, in dem ein  oder auch mehrere Verstorbene beigesetzt wurden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabkammer"@de .

lvr:grabungsflaeche a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Grabungsfläche ist ein offener Raum, an dem eine archäologische Ausgrabung stattfindet oder bereits stattgefunden hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grabungsfläche"@de .

lvr:graeberfeld a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Gräberfeld ist ein Bestattungsplatz, auf dem sich mehrere Bestattungen befinden, unabhängig von der Grabform oder der Bestattungsart."@de ;
    skos:editorialNote "Gräberfeld benutzt für Begräbnisplätze vor dem Mittelalter; für Begräbnisplätze seit dem Mittelalter siehe Friedhof; für Begräbnisplätze an Kirchen siehe Kirchhof."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gräberfeld"@de .

lvr:graefte a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Gräfte ist ein Wassergraben, der einen Adelssitz, einen Hof oder eine Garten- und Parkanlage umgeben kann."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gräfte"@de .

lvr:grenzpunkt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Grenzpunkt ist ein Vermessungspunkt, der im Verlauf einer Flurstücksgrenze oder Grundstücksgrenze liegt und einen Eck- oder Wendepunkt bildet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grenzpunkt"@de .

lvr:grenzstein a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Grenzstein ist ein Bauwerk, das im Gelände der Kennzeichnung eines eingemessenen Grenzpunktes dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grenzstein"@de .

lvr:grubenhaus a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Ein Grubenhaus ist ein Gebäude, dessen Fußboden in die Erde eingetieft ist und das meistens nur über einen einzigen Raum verfügt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grubenhaus"@de ;
    skos:scopeNote "In germanischer und frühmittelalterlicher Zeit wurde es als Wohnbau und Wirtschaftsbau benutzt und war selten größer als 4 x 4 m."@de .

lvr:grubenkomplex a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Ein Grubenkomplex ist ein Erdbauwerk, das aus dicht beieinander liegenden Gruben besteht. Diese können sich überschneiden, da sie nacheinander angelegt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grubenkomplex"@de .

lvr:gruft a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Gruft ist ein Grabraum, der meist in den Boden eingetieft und gemauert ist und worin sich eine oder auch mehrere Bestattungen befinden können. Sie kann Bestandteil eines Grabmals sein."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gruft"@de .

lvr:grundriss a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Grundriss ist ein Bild eines räumlichen Gebildes in einer zweidimensionalen waagerecht ausgeführten Aufsicht. Meistens bildet der Grundriss die Grundmauern oder das Erdgeschoss eines Gebäudes ab."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grundriss"@de .

lvr:hafen a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Hafen ist ein Baukomplex, der  aus einem künstlich angelegten Wasserbecken und der dazugehörigen Infrastruktur an Land besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hafen"@de ;
    skos:scopeNote "Er dient der Passagierabfertigung und dem Güterumschlag im Schiffsverkehr. Je nach Hauptfunktion unterscheidet man unterschiedliche Hafenarten."@de .

lvr:hafenofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Hafenofen ist ein Schmelzofen, der in Glashütten zum Schmelzen von Glas verwendet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hafenofen"@de .

lvr:halbbastion a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Halbbastion ist der Bestandteil einer Festung, der die Form einer halbierten Bastion hat und lediglich aus einer Face und einer Flanke besteht, während die der Flanke gegenüberliegende Seite in die seitliche Kurtine des jeweiligen Festungswerks übergeht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Halbbastion"@de .

lvr:halde_wirtschaft a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Halde ist ein offener Raum in Form einer Aufschüttung, die aus Material besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Halde (Wirtschaft)"@de .

lvr:hallenhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Hallenhaus ist ein Gebäude, das als bäuerliches Einhaus Wohnen und Wirtschaften unter einem Dach vereint und vor allem in Nordwesteuropa verbreitet ist. Die Erscheinung des Hauses ist bestimmt durch eine hallenartige Raumaufteilung."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hallenhaus"@de .

lvr:hammerwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Hammerwerk ist ein Betrieb, in dem Roheisen, Kupfer und Messing mechanisch bearbeitet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hammerwerk"@de .

lvr:hauptburg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Hauptburg ist der Bestandteil einer Burg, der sich zumeist an zentraler Stelle der Anlage befindet, am stärksten gesichert ist und im Angriffsfalle zuletzt erreicht wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hauptburg"@de .

lvr:hauptgebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Hauptgebäude ist ein Gebäude, das zu einem Baukomplex gehört und für gewöhnlich das größte und wichtigste Gebäude ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hauptgebäude"@de .

lvr:heiligtum_raum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Heiligtum (Raum)"@de .

lvr:herberge a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Herberge ist ein Beherbergungsbetrieb, in dem Reisende kostenpflichtig bewirtschaftet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Herberge"@de .

lvr:herdstelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Herdstelle ist ein offener Raum, der mit Steinen oder anderen Materialien befestigt ist und sich klar von der Umgebung abgrenzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Herdstelle"@de .

lvr:hochofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Hochofen ist ein Schachtofen, der zur Gewinnung von Roheisen aus Eisenerzen unter Zusatz von weiteren Stoffen, mit denen er kontinuierlich beschickt wird, dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hochofen"@de .

lvr:hockergrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Hockergrab ist ein Körpergrab, in dem der Tote in gehockter Stellung, d.h. mit mehr oder minder angezogenen Beinen und Armen auf der Seite liegend oder auch sitzend bestattet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hockergrab"@de .

lvr:hoeckerlinie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Höckerlinie ist eine Panzersperre, die aus einer langgestreckten Aufreihung von höcker- oder zahnförmigen Sperrelementen aus Stahlbeton oder Beton besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Höckerlinie"@de .

lvr:hoehenburg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Höhenburg ist eine Burg, die auf einer natürlichen Anhöhe errichtet wurde und aus dem umgebenden Gelände herausragt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Höhenburg"@de .

lvr:hoehensiedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Höhensiedlung ist eine Siedlung, die auf höher liegendem Gelände errichtet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Höhensiedlung"@de .

lvr:hoehle a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Eine Höhle ist eine Geländeform, die als unterirdischer Hohlraum auftritt und durch Naturvorgänge entstanden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Höhle"@de .

lvr:hoehlenheiligtum a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Höhlenheiligtum ist ein Naturheiligtum, in dessen Umgebung kultische Handlungen, verbunden mit Höhlen, vollzogen werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Höhlenheiligtum"@de .

lvr:hof_landwirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Hof ist ein Baukomplex, der alle zu einem Landwirtschaftsbetrieb gehörigen Bauwerke und die in unmittelbarem Zusammenhang mit den Bauwerken stehenden Flächen umfasst."@de ;
    skos:editorialNote "Benutzt ausschließlich für den Baukomplex; für Baukomplex mit Nutzfläche siehe Landwirtschaftsbetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hof (Landwirtschaft)"@de .

lvr:hohlweg a skos:Concept ;
    skos:broader lvr:weg_verkehr ;
    skos:definition "Ein Hohlweg ist ein Fahrweg, der sich durch jahrhundertelange Nutzung als Viehtrieb und Gehweg sowie durch Befahren mit Fuhrwerken in das umgebende Gelände eingeschnitten hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hohlweg"@de .

lvr:holzwerkstatt a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Holzwerkstatt"@de .

lvr:horreum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Horreum ist ein Lagergebäude, das in römischer Zeit vorwiegend der Aufbewahrung von Getreide und anderen schweren Materialien diente."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Horreum"@de .

lvr:huegelgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Hügelgrab ist ein Grab, das aus einem aufgeschütteten Hügel aus Erde oder Steinen besteht, unter dem oder in dem sich ein Grab oder mehrere Gräber befinden."@de ;
    skos:editorialNote "Benutzt für ein Grab mit hügelartiger Aufschüttung, die in urgeschichtliche Perioden bis zur Merowingerzeit datiert werden; für Hügel über Gräbern späterer Perioden siehe Grabhügel."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hügelgrab"@de .

lvr:hypokaustum a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Hypokaustum ist eine Fußbodenheizung, die für einzelne Räume in römischen Thermen, vornehmen Wohnhäusern, Villen und Palästen verwendet wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hypokaustum"@de .

lvr:immunitaetsbezirk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Immunitätsbezirk ist ein offener Raum, der durch ein besonderes Schutzprivileg von der übrigen Stadt abgegrenzt ist."@de ;
    skos:editorialNote "Benutzt für das durch eine Immunität gekennzeichnete Gelände; für den entsprechenden Rechtsbegriff siehe Immunität."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Immunitätsbezirk"@de ;
    skos:scopeNote "Häufig vorkommende Bezirke sind Domimmunitätsbezirke, Klosterimmunitätsbezirke oder Stiftsimmunitätsbezirke."@de .

lvr:industrieanlage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Industrieanlage ist ein Baukomplex, der sämtliche Gebäude und Einrichtungen einschließlich des Geländes eines Industriebetriebes umfasst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Industrieanlage"@de .

lvr:innenhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Innenhof ist ein Hof, der innerhalb eines Gebäudes liegt oder von einem Gebäudekomplex vollkommen umschlossen wird"@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Innenhof"@de .

lvr:insula_siedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Insula ist ein Siedlungsteil in römischer Zeit, der sich aus einem von Straßen eingeschlossenen Häuserblock zusammensetzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Insula (Siedlung)"@de .

lvr:irdenwareofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Irdenwareofen ist ein Töpferofen, in dem Irdenware bei Temperaturen zwischen 650 °C und 800 °C gebrannt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Irdenwareofen"@de .

lvr:juedischer_friedhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein jüdischer Friedhof ist ein Friedhof einer jüdischen Gemeinde, auf dem die Bestattung ausschließlich gemäß den Gesetzlichkeiten des Judentums erfolgt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Jüdischer Friedhof"@de .

lvr:kaldarium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kaldarium (Caldarium) ist der Bestandteil der Thermen in römischer Zeit, der als Heißbaderaum und Schwitzabteilung genutzt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kaldarium"@de .

lvr:kalkbrennerei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kalkbrennerei ist ein Betrieb, in dem in einem oder mehreren Kalköfen Kalk gebrannt wird."@de ;
    skos:editorialNote "Benutzt für eine vorindustriell betriebene Anlage; für eine industriell betriebene Anlage siehe Kalkwerk."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kalkbrennerei"@de .

lvr:kalkloeschgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Kalklöschgrube ist eine Grube, in der Kalk gelöscht wird, d.h., in der Calciumoxid mit Wasser versetzt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kalklöschgrube"@de .

lvr:kalkofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Kalkofen ist ein Brennofen, in dem Kalkstein zu Kalk gebrannt wird. Hierfür werden verschiedene Ofentypen genutzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kalkofen"@de .

lvr:kalvarienberg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kalvarienberg ist ein visuelles Werk, das plastisch oder bildlich die biblische Kreuzigungsgruppe darstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kalvarienberg"@de ;
    skos:scopeNote "Die Bezeichnung \"Berg\" geht darauf zurück, dass Kalvarienberge meist als letzte Station eines Kreuzweges auf einer Anhöhe liegen."@de .

lvr:kammergrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kammergrab"@de .

lvr:kanal_wasserbau a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Kanal ist ein Bauwerk, das in Form offener, künstlicher Wasserläufe oder unterirdisch geführter Rohrleitungen für Abwässer, Bewässerung oder Entwässerung genutzt wird."@de ;
    skos:editorialNote "Benutzt für künstlichen Wasserlauf für Abwässer, Bewässerung oder Entwässerung; für schiffbaren Kanal siehe Schifffahrtskanal."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kanal (Wasserbau)"@de .

lvr:kanalisation a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Kanalisation ist eine Abwasseranlage, die aus unterirdischen Bauwerken besteht, die der Sammlung und dem Transport von Abwässern, Regenwasser u.ä. dienen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kanalisation"@de .

lvr:kapelle_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kapelle ist ein Sakralbau, der in der Regel klein und einfach ist und keine Pfarrrechte besitzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kapelle (Bauwerk)"@de ;
    skos:scopeNote "Eine Kapelle kann sowohl ein selbständiges Gebäude als auch Teil eines größeren Gebäudes sein."@de .

lvr:kapitelsaal a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kapitelsaal"@de .

lvr:karner a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Karner ist ein Friedhofsgebäude, das der Aufbewahrung von Gebeinen dient und in dem Totenmessen abgehalten werden. Ein Karner ist meist zweigeschossig."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Karner"@de .

lvr:kasematte a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kasematte ist der Bestandteil einer Festung, der einen  gegen Beschuss gesicherten, überwölbten Raum darstellt, der meist durch Erdaufschüttung entsteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kasematte"@de .

lvr:kaserne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kaserne ist ein Militärgebäude, das Bestandteil einer militärischen Anlage ist und der ständigen Unterbringung von Truppen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kaserne"@de .

lvr:kavalier_festung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kavalier ist der Bestandteil einer Festung, der als erhöhte Plattform auf dem Wall oder den Kasematten zur Beobachtung und zum Aufstellen von Kanonen als Erdausschüttung mit Brustwehr dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kavalier (Festung)"@de .

lvr:kein_befund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kein Befund"@de .

lvr:kenotaph a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kenotaph ist ein Grabmal, das für eine Person errichtet wird, die an einem anderen Ort verstorben und begraben ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kenotaph"@de .

lvr:kirchhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kirchhof ist ein Friedhof, der das Kirchengebäude unmittelbar umgibt oder dessen Vorhof bildet."@de ;
    skos:editorialNote "Kirchhof benutzt für Friedhöfe an Kirchen; für Bestattungsplätze seit dem Mittelalter siehe Friedhof; für Bestattungsplätze vor dem Mittelalter siehe Gräberfeld."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kirchhof"@de .

lvr:klausur_kloster a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Klausur ist der Bestandteil eines Klosters, der ausschließlich den Klosterinsassen vorbehalten ist und von Außenstehenden nur ausnahmsweise betreten werden darf."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Klausur (Kloster)"@de .

lvr:kleinkastell a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kleinkastell ist ein römisches Militärlager, das für kleine Einheiten wie Wachkommandos genutzt wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kleinkastell"@de ;
    skos:scopeNote "Es bot Platz für etwa 40 bis 80 Mann Besatzung (Centurie bzw. Halbcenturie)."@de .

lvr:kloake_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kloake (Bauwerk)"@de .

lvr:kloakenrinne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kloakenrinne ist ein Bauwerk, das dem Abfluss von Fäkalien aus einer Kloake dient und die Form einer Furche oder einer Röhre besitzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kloakenrinne"@de .

lvr:kloster_architektur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kloster ist ein Baukomplex, in dem Menschen in Ausübung ihrer Religion zusammenleben."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kloster (Architektur)"@de ;
    skos:scopeNote "Das Kloster besteht in der Regel aus Bauten für die Religionsausübung, Wohngebäuden, Wirtschaftsgebäuden, eventuell weiteren Bauwerken und Freiflächen sowie Nutzflächen wie der Innenhof des Kreuzgangs oder Gärten."@de .

lvr:knochenmuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Knochenmühle ist eine Mühle, in der Tierknochen zermahlen oder gestampft werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Knochenmühle"@de .

lvr:knochensiederei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Knochensiederei ist ein Betrieb, in dem Schlachtknochen aufbereitet werden. Sie werden ausgekocht von Fleisch und Fettresten befreit und dann zur weiteren Verwertung an Knochenmühlen, Seifensiedereien, Leimsiedereien usw. weitergeleitet. Weiterhin besteht die Möglichkeit, das Fett des aufbereiteten Suds an Lichtgießer zu verkaufen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Knochensiederei"@de .

lvr:knochenwerkstatt a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Knochenwerkstatt"@de .

lvr:knueppeldamm a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Knüppeldamm"@de .

lvr:kochgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Kochgrube ist eine Grube, in deren Verfüllung sich Funde befinden, die auf die den Vorgang des Kochens hinweisen, wie z.B. Steine, die eindeutig Erhitzungsspuren aufweisen, aber auch Knochen und Holzkohle."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kochgrube"@de .

lvr:koerpergrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Körpergrab ist ein Grab, in dem der vollständige unverbrannte Körper des Toten beigesetzt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Körpergrab"@de .

lvr:kohlenmeiler a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kohlenmeiler"@de .

lvr:kohortenkastell a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kohortenkastell ist ein Auxiliarlager, in dem eine Kohorte stationiert ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kohortenkastell"@de .

lvr:kolluvium a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "Ein Kolluvium ist ein Landboden, bei dem das Substrat der Bodenbildung durch Wasser oder Wind über kurze Strecken transportiert und dann abgelagert worden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kolluvium"@de .

lvr:konzentrationslager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Konzentrationslager ist ein Gefangenenlager, welches in der Zeit des Nationalsozialismus für die Internierung und zumeist auch Ermordung von Opfern der nationalsozialistischen Unrechtsherrschaft errichtet wurde."@de ;
    skos:editorialNote "Benutzt für das unter der NS-Herrschaft von 1933-1945 eingerichtete und betriebene Lager; für andere Lager siehe Lager (Unterkunft) oder Gefangenenlager."@de ;
    skos:historyNote "Gültig: 1933 bis 1945"@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Konzentrationslager"@de ;
    skos:scopeNote "Die Opfer der Konzentrationslager wurden aufgrund ihrer Rasse, ihres Glaubens, ihrer Weltanschauung, sexuellen Orientierung, körperlichen oder geistigen Behinderungen oder ihrer politischen Gegnerschaft zum Nationalsozialismus verfolgt und inhaftiert. In den Lagern starben die meisten dieser Menschen an den Folgen physischer Misshandlungen, systematischer Aushungerung, Zwangsarbeit, medizinischer Menschenversuche oder wurden - vor allem im Rahmen der deutschen Judenvernichtung (Shoah bzw. Holocaust) - durch Massentötungen in Gaskammern, Erschießungen oder Todesmärsche ermordet."@de .

lvr:krankenhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Krankenhaus ist ein Baukomplex, in dem Kranke für längere Zeit stationär behandelt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Krankenhaus"@de .

lvr:kreisgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Anlage, die sich als kreisförmiger Graben im archäologischen Bodenbefund abzeichnet"@de,
        "circular or semicircular ditch, or cropmark indicating the remains of a ditch"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300312201>,
        <http://www.wikidata.org/entity/Q1490797> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kreisgraben"@de,
        "ring ditch"@en .

lvr:kreuzgang a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kreuzgang ist ein Gebäudeteil eines Sakralbaus, der als Gang den von der Kirche und den Klausurgebäuden gebildeten Hof umgibt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kreuzgang"@de ;
    skos:scopeNote "Der Kreuzgang erschließt die umliegenden Gebäudeteile der Kloster- oder Stiftsanlagen und dient darüber hinaus auch als Aufenthalts- und Unterrichtsort."@de .

lvr:kreuzwegstation a skos:Concept ;
    skos:broader lvr:weg_verkehr ;
    skos:definition "Eine Kreuzwegstation ist ein visuelles Werk, das eine der Stationen des Kreuzweges Jesu umfasst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kreuzwegstation"@de .

lvr:kriegsgefangenenlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kriegsgefangenenlager ist ein Gefangenenlager, in dem während oder unmittelbar nach einem Krieg feindliche Soldaten und Kriegsgefangene festgehalten werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kriegsgefangenenlager"@de .

lvr:kueche_raum a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Küche ist ein Raum, der vorwiegend für die Zubereitung von Speisen genutzt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Küche (Raum)"@de .

lvr:kuehlofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kühlofen"@de .

lvr:kuenette a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Künette ist der Bestandteil einer Festung, der als auf der Sohle eines großen, trockenen Grabens gelegener Abflussgraben zu dessen Entwässerung dient und zugleich ein eigenes Annäherungshindernis darstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Künette"@de .

lvr:kultopfer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kultopfer"@de .

lvr:kurtine a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Kurtine ist der Bestandteil einer Festung, der einen Mauerabschnitt zwischen Türmen oder Bastionen bildet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kurtine"@de .

lvr:landschaft a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "subjektive Wahrnehmung einer Gegend als ästhetische Ganzheit (philosophisch-kulturwissenschaftlicher Landschaftsbegriff) die durch naturwissenschaftlich erfassbare Merkmale von anderen Gebieten abgrenzt ist (geographischer Landschaftsbegriff)"@de,
        "visible features of an area of land"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300008626>,
        <http://www.wikidata.org/entity/Q107425>,
        <https://d-nb.info/gnd/4034343-1> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Landschaft"@de,
        "landscape"@en .

lvr:landwehr_bauwerk a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Landwehr ist eine Grenzbefestigung, die aus einem oder mehreren, mit undurchdringlichem Buschwerk besetzten Wällen und breiten Gräben besteht und die größere und kleinere Landgebiete umschloss."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Landwehr (Bauwerk)"@de .

lvr:langhaus_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Langhaus ist ein Bauwerk, für den ein Grundriss charakteristisch ist, bei dem die Längsachse das Ausmaß der Querachse erheblich übersteigt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Langhaus (Bauwerk)"@de ;
    skos:scopeNote "Aufgrund der Innenausstattung, z.B. mit mehreren Herdstellen, wird davon ausgegangen, dass derartige Gebäude von größeren Personengruppen bewohnt werden."@de .

lvr:langhuegel_grab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Langhügel ist ein Hügelgrab, das langgestreckt rechteckig bis trapezförmig sein kann."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Langhügel (Grab)"@de .

lvr:latrine a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Latrine ist ein Bauwerk in Form einer Grube, das als behelfsmäßiger Abort von mehreren Personen gleichzeitig benutzt werden kann."@de ;
    skos:editorialNote "Benutzt für die Sanitäranlage des Altertums und des Mittelalters."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Latrine"@de .

lvr:laufhorizont a skos:Concept ;
    skos:broader lvr:Geologie_Stratigraphie_und_Naturform ;
    skos:definition "in der Archäologie eine Schicht (Grabungsschicht) von Überresten einer einzelnen Kultur"@de ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1807467> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Laufhorizont"@de,
        "Begehungshorizont"@en .

lvr:layerinterface a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Layerinterface"@de .

lvr:legionslager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Legionslager"@de .

lvr:legionsziegelei a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Legionsziegelei"@de .

lvr:leichenbrandlager a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Leichenbrandlager ist ein Brandgrab, in dessen Grabgrube Leichenbrand auf einer Stelle konzentriert liegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Leichenbrandlager"@de ;
    skos:scopeNote "Zeitweise ist es möglich, das ursprüngliche Vorhandensein von organischen Behältern, in die der Leichenbrand eingefüllt war, nachzuweisen."@de .

lvr:leichenschatten a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Leichenschatten ist eine Verfärbung, die durch das Vergehen eines menschlichen oder tierischen Körpers im Boden entsteht und die dessen Umriss nachzeichnet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Leichenschatten"@de .

lvr:leprosorium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Leprosorium ist ein Siechenhaus und ein Baukomplex, der vom Mittelalter bis in die Mitte des 20. Jahrhunderts in Europa der Aufnahme, Verpflegung und Quarantäne unheilbar Kranker, insbesondere Leprakranker (Lepröse, Leprose), diente."@de ;
    skos:editorialNote "Benutzt für die vom Mittelalter bis in die Mitte des 20. Jahrhunderts in Europa als Pflegeheim genutzte Einrichtung; für die heutige medizinische Einrichtung siehe Krankenhaus."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Leprosorium"@de .

lvr:lichtschacht_architektur a skos:Concept ;
    skos:broader lvr:schacht_bauwesen ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Lichtschacht (Architektur)"@de .

lvr:liegender_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Liegender Ofen"@de .

lvr:limes_grenzbefestigung a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Limes ist die Grenzbefestigung, die in der Römischen Kaiserzeit die militärischen Grenzsicherungssysteme in Europa, Vorderasien und Nordafrika umfasste."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Limes (Grenzbefestigung)"@de .

lvr:lochstein_vermessungswesen a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Lochstein ist ein Grenzstein, der bis ins 19. Jahrhundert die Eigentumsgrenze an einem Bergwerk markiert. Er zeigt an der Oberfläche an, wie weit der unterirdische Abbau gehen darf."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Lochstein (Vermessungswesen)"@de .

lvr:lochtenne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Lochtenne"@de .

lvr:loeschteich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Löschteich ist ein Teich, in dem Löschwasser für den Fall eines Brandes vorgehalten wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Löschteich"@de .

lvr:luenette_festung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:editorialNote "Benutzt für Werke, die weder wie die Demi-lune einer Bastion noch wie das Ravelin einer Kurtine zugeordnet sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Lünette (Festung)"@de .

lvr:luftschutzkeller a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Luftschutzkeller ist ein Keller, der zeitweilig als Schutzraum genutzt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Luftschutzkeller"@de .

lvr:mansio a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Mansio ist eine Herberge, die in römischer Zeit an überregionalen Straßen dem Aufenthalt, dem Übernachten und als Umspannstation diente."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mansio"@de .

lvr:markierung_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Markierung (Archäologie)"@de .

lvr:marktplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Marktplatz ist ein Platz, der innerhalb einer Siedlung liegt und an dem Waren verkauft oder getauscht werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Marktplatz"@de .

lvr:marschlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Marschlager ist ein Militärlager, das nur für einen kurzen Gebrauch während eines Marsches von Militäreinheiten errichtet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Marschlager"@de ;
    skos:scopeNote "Daher weist es zumindest eine äußere Befestigung, aber nur selten eine Innenbebauung aus festen Gebäuden wie Hütten, auf."@de .

lvr:massengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Massengrab ist ein Grab, in dem eine große Anzahl Menschen beigesetzt wird, die u.a. Naturkatastrophen oder Kriegsverbrechen zum Opfer gefallen sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Massengrab"@de .

lvr:materialentnahmegrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Materialentnahmegrube ist eine Grube, für die Entnahme von Lehm, Mergel, Sand oder Kies. Ebenfalls kann sich so ein flächiger Bodenaustausch abzeichnen."@de ;
    skos:editorialNote "Benutzt für kleinräumige Bodenstörungen; für großräumige Entnahmestellen zum Abbau  von Kies, Schotter, Sand oder Kohlen siehe Tagebau."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Materialentnahmegrube"@de .

lvr:materialraub a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Materialraub"@de .

lvr:mauerfundament a skos:Concept ;
    skos:broader lvr:mauer ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mauerfundament"@de .

lvr:megalithgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Megalithgrab ist ein Grab, das häufig Reste von Erdhügeln und Erdanschüttungen aufweist und bei denen meist auffallend große Steinblöcke und Steinplatten verwendet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Megalithgrab"@de .

lvr:mehrfachbestattung_grab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Mehrfachbestattung ist ein Grab, in dem mehrere Bestattungen zum gleichen Zeitpunkt oder auch zeitnah gestaffelt niedergelegt werden."@de ;
    skos:editorialNote "Benutzt für mehrere Bestattungen, die zum gleichen Zeitpunkt oder zeitnah  in einem Grab beigesetzt werden; für mehrere Bestattungen in einer Grabanlage, die nicht alle zu einem Zeitpunkt niedergelegt werden, siehe Kollektivbestattung."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mehrfachbestattung (Grab)"@de .

lvr:meilenstein_entfernungsanzeiger a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Meilenstein (Entfernungsanzeiger)"@de .

lvr:meilerplatz a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Meilerplatz ist ein offener Raum, auf dem in vergangener Zeit ein Kohlenmeiler stand."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Meilerplatz"@de ;
    skos:scopeNote "Meilerplätze zeichnen sich im Gelände durch planierte, horizontal liegende Flächen ab, die durch mit Holzkohlenstaub durchmischtem Erdboden bzw. Holzkohlenresten charakterisiert sind."@de .

lvr:mikwe a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mikwe"@de ;
    skos:scopeNote "Im Mittelalter sind die Mikwen häufig eigenständige monumentale Gebäude. Da für die rituelle Reinigung lebendiges, fließendes Wasser erforderlich ist, reichen die tiefen Schächte mit Treppenanlage, die zu dem eigentlichen Badebecken führen bis zum Grundwasser. In den späteren Perioden gab es auch einfache Mikwen im Keller von Wohnhäusern. Seit Neuzeit befinden sich Mikwen zumeist in Gemeindezentren. Gut erhaltene monumentale Mikwen können in Speyer, Worms, Köln und Friedberg (Hessen) besichtigt werden."@de .

lvr:militaerdepot a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Militärdepot ist ein Depot, das der Lagerung von Kraftstoff, Munition oder Gerät dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Militärdepot"@de .

lvr:militaerlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Militärlager ist eine militärische Anlage, in der Truppen in Kasernen untergebracht werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Militärlager"@de .

lvr:militaerposten_baukomplex a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Militärposten ist ein Baukomplex, der der Sicherung von Grenzen, einer Stellung oder eines Geländes bzw. Verkehrskontrollen dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Militärposten (Baukomplex)"@de .

lvr:mittelstaender_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mittelständer (Ofen)"@de .

lvr:mittelzunge_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mittelzunge (Ofen)"@de .

lvr:motte_architektur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Motte ist eine Burg, die aus einem künstlich aufgeschütteten Burghügel besteht. Dieser kann gegebenenfalls eine natürliche Erhebung einbeziehen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Motte (Architektur)"@de ;
    skos:scopeNote "Motten können durch eine Vorburg sowie umgebende Wassergräben ergänzt werden. Sie wurden meist im Hochmittelalter errichtet und gingen später manchmal in Burgen auf."@de .

lvr:muehle_baukomplex a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Mühle ist ein Baukomplex, der aus dem Mühlengebäude mit den darin befindlichen Vorrichtungen zum Zerkleinern oder Zermahlen von stückigem Material besteht, sowie dem umgebenden Gelände einschließlich der für den Betrieb der Mühle erforderlichen Bauwerke."@de ;
    skos:editorialNote "Benutzt für Mühlen als Gesamtkomplex; für die Zerkleinerungsmaschine siehe Mühle (Maschine)."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mühle (Baukomplex)"@de .

lvr:muehlengraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Mühlengraben ist ein Wassergraben, der künstlich angelegt wurde, um eine Wassermühle zu betreiben."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mühlengraben"@de .

lvr:muehlenteich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Mühlenteich ist ein Stauteich, der an einer Mühle liegt und oftmals aus dem Wasser des Mühlgrabens gespeist wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mühlenteich"@de .

lvr:muenzschatzfund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Münzschatzfund ist ein Depot, das aus Münzen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Münzschatzfund"@de .

lvr:muffelofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Muffelofen ist ein Brennofen, dessen Inhalt nicht in direkten Kontakt mit der Flamme kommt, sondern in einem anderen Raum, gesondert von ihr, brennt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Muffelofen"@de .

lvr:mundloch_bergbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Mundloch ist der Bestandteil einer Untertageanlage, der den  Bergwerksstollen mit der Tagesoberfläche verbindet. Die Öffnung kann durch Mauerwerk eingefasst sein."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mundloch (Bergbau)"@de .

lvr:nachbestattung_grab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Nachbestattung ist ein Grab, das in einer bereits bestehenden Bestattungsanlage (wie einem Grabhügel) nachträglich angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Nachbestattung (Grab)"@de ;
    skos:scopeNote "Eine Nachbestattung ist meist durch außermittige Lage bzw. höhere Position von der Zentralbestattung zu unterscheiden."@de .

lvr:natur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Natur"@de .

lvr:nebenbestattung_grab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Der Begriff Nebenbestattung bezeichnet ein Grab, das mit einem eindeutigen Bezug zu einer Zentralbestattung in einer größeren Grabanlage (z.B. einem Grabhügel) zeitgleich angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Nebenbestattung (Grab)"@de .

lvr:nebengebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Nebengebäude ist ein Gebäude, das Bestandteil eines Baukomplexes und in seiner Funktion von untergeordneter Bedeutung ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Nebengebäude"@de .

lvr:niederungsburg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Niederungsburg"@de ;
    skos:scopeNote "Teil einer Niederungsburg kann ein künstlich aufgeschütteter Hügel sein."@de .

lvr:noch_nicht_ermittelt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Noch nicht ermittelt"@de .

lvr:numeruskastell a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Numeruskastell ist ein Auxiliarlager, in dem ein Numerus stationiert ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Numeruskastell"@de .

lvr:oberflaechenfund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Oberflächenfund"@de .

lvr:oelmuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Ölmühle ist eine Mühle, in der Ölsaat zerquetscht und ausgepresst oder ausgeschlagen wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ölmühle"@de .

lvr:ofen_vorrichtung a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Ofen ist eine Vorrichtung, die sowohl transportabel als auch fest eingebaut sein kann und zur Erzeugung von Wärme dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofen (Vorrichtung)"@de .

lvr:ofenfeuerung a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofenfeuerung"@de .

lvr:ofenkuppel a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofenkuppel"@de ;
    skos:scopeNote "Je nach Ofentyp und Art der Befeuerung besteht die Möglichkeit, dass auch der Feuerungsraum von der Ofenkuppel überdeckt wird. Die Ofenkuppel kann aus verschiedenen Materialien erbaut sein. So gibt es Kuppeln, die ursprünglich aus mit Lehm verstrichenem Flechtwerk oder Töpfen bestanden, daneben aber auch gemauerte Kuppelgewölbe, für deren Errichtung unterschiedliche Materialien, in der Regel Ziegelsteine, Schamottsteine oder aus Töpferton geformte Ziegel benutzt wurden."@de .

lvr:ofenrost a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Ofenrost ist der Bestandteil eines Ofens, der sich am Boden des Feuerungsraumes befindet und auf dem das Brenngut gestapelt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofenrost"@de .

lvr:ofenwandung a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofenwandung"@de .

lvr:ofenzunge a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofenzunge"@de .

lvr:opferfund a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Opferfund"@de .

lvr:opfergrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Opfergrube ist eine Grube, in der Opfer niedergelegt oder dauerhaft deponiert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Opfergrube"@de .

lvr:opferschacht a skos:Concept ;
    skos:broader lvr:schacht_bauwesen ;
    skos:definition "Ein Opferschacht ist ein Schacht, in dem Opfergaben niedergelegt oder dauerhaft deponiert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Opferschacht"@de .

lvr:oppidum_siedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Oppidum ist eine befestigte Siedlung aus keltischer Zeit und wurde zumeist in erhöhter oder schwer zugänglicher Lage angelegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Oppidum (Siedlung)"@de ;
    skos:scopeNote "Es kann sich um eine Zufluchtsstätte, einen ständig bewohnten Ort oder einen Werkplatz handeln. Im Mittelalter wurde unter einem Oppidum eine kleine stadtähnliche Siedlung mit Marktfunktion verstanden, der das Marktrecht bzw. Stadtrecht fehlte."@de .

lvr:palas a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Palas ist ein Gebäude, das das hauptsächliche Wohn- und Repräsentationsgebäude einer Burg präsentiert und vor allem einen großen Saal, im fortgeschrittenen Mittelalter auch mehrere Säle enthält, deren in der Regel zu Gruppen zusammengefasste Fensteröffnungen wesentliche Gestaltungsmerkmale der Fassade sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Palas"@de ;
    skos:scopeNote "In der Literatur wird der Palas häufig auch als Saalbau bezeichnet, vor allem, wenn es sich um das Repräsentationsgebäude einer Pfalz handelt."@de .

lvr:palisade a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Palisade ist eine Einfriedung, die aus nebeneinander eingeschlagenen Pfählen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Palisade"@de .

lvr:palisadengraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Palisadengraben ist ein Befestigungsgraben, der für die Aufnahme einer Palisade angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Palisadengraben"@de ;
    skos:scopeNote "Bodenverfärbungen auf der Grabensohle verdeutlichen, dass Holzpfosten in einer dichten Reihe (auch Doppelreihen oder Mehrfachreihen) in den Graben gesetzt werden."@de .

lvr:palisadenpfosten a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Ein Palisadenpfosten ist ein Pfosten, der meist senkrecht in den Erdboden eingelassen oder eingerammt ist und zusammengeschlossen mit weiteren benachbarten Pfosten Teil einer Palisade ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Palisadenpfosten"@de .

lvr:panzergraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Panzergraben ist ein Befestigungsgraben, der zur Abwehr feindlicher Panzer angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Panzergraben"@de .

lvr:panzersperre a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Panzersperre ist ein Bauwerk, das den Vorstoß von Panzern verhindern soll."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Panzersperre"@de .

lvr:papiermuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Papiermühle ist eine Mühle, in der Lumpen oder Zellstoff für die Papierherstellung zerkleinert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Papiermühle"@de .

lvr:park a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Park ist ein offener Raum, der abgegrenzt, häufig eingefriedet, vom Menschen mehr oder weniger künstlerisch oder aufwendig gestaltet und der Pflege bedürftig ist, aber auch gestalterisch mit der Umgebung verbunden sein kann, beispielsweise durch ein Ha-Ha."@de ;
    skos:editorialNote "Benutzt für größere Anlagen, die wesentlich durch Baumbestand bestimmt sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Park"@de ;
    skos:scopeNote "Gestaltungselemente sind vor allem Gehölze, Rasenflächen und Wiesenflächen, Gewässer und Wegesysteme. Innerhalb eines Parks können sich Gärten befinden, die dem Anbau bestimmter Pflanzen dienen (zum Beispiel Küchengärten). Die Begriffe Garten und Park werden allerdings häufig synonym gebraucht."@de .

lvr:pavillon_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pavillon (Bauwerk)"@de .

lvr:pechhuette a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Pechhütte ist ein Betrieb, in dem das Pech gesiedet wird."@de ;
    skos:editorialNote "Benutzt für den Betrieb und das Gebäude."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pechhütte"@de .

lvr:pechofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Pechofen ist ein Kuppelofen, in dem harzige Stücke Holz von Kiefern und Fichten zu Pech oder Teer eingekocht werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pechofen"@de .

lvr:peristyl a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Peristyl ist ein Gebäudeteil, der einen Hof oder Garten auf allen Seiten in Form eines Säulenganges umringt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Peristyl"@de .

lvr:pfahlgruendung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pfahlgründung ist eine Tiefgründung, bei der Pfähle in den Baugrund gebohrt oder gerammt werden, bis eine ausreichend tragfähige Bodenschicht oder Gesteinsschicht erreicht ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfahlgründung"@de .

lvr:pfahlrost a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Pfahlrost ist eine Tiefgründung, bei der Pfähle oder Pfahlgruppen durch eine Rostplatte zu einer einheitlich tragenden Gründung miteinander verbunden werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfahlrost"@de .

lvr:pfalz_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pfalz ist ein Baukomplex, zu dem neben Wohnbauten und Wirtschaftsgebäuden, die auch abseits liegen können, vor allem Kapelle und Saalbau gehören und der im Mittelalter dem König, einem Herzog, Grafen oder Bischof als Verwaltungs- und Amtssitz diente."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfalz (Bauwerk)"@de ;
    skos:scopeNote "Wenn Pfalzen auch befestigt sind, so steht der Zweck als Wehrbau doch nicht im Vordergrund. Im Gegensatz zu den Königspfalzen, die den König und seinen Hof nur zeitweise beherbergen, dienen die anderen Pfalzen häufig als ständige Sitze."@de .

lvr:pfeifenbaeckerei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pfeifenbäckerei ist ein Betrieb, in dem aus so genanntem Pfeifenton Tabakspfeifen produziert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfeifenbäckerei"@de .

lvr:pfeiler a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Pfeiler ist eine Stütze, die aus Mauerwerk besteht und rechteckigen, quadratischen, polygonalen oder runden Querschnitt hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfeiler"@de .

lvr:pferch a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Pferch ist ein offener Raum, der durch transportable Zäune eingefriedet ist und in dem das Vieh zur Nacht zusammengetrieben werden kann."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pferch"@de .

lvr:pflaster_oberflaechenelement a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pflaster (Oberflächenelement)"@de .

lvr:pflugspur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pflugspur ist eine Spur, die als rillenförmige Verfärbung im Boden erhalten ist und vermutlich durch die Verwendung eines Pflugs entstanden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pflugspur"@de .

lvr:pfosten a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfosten"@de .

lvr:pfostenbau_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostenbau (Bauwerk)"@de .

lvr:pfostengrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Pfostengrube ist eine Grube, die ausgehoben wird um einen Pfosten im Erdboden aufzustellen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostengrube"@de .

lvr:pfostengrubenreihe a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:editorialNote "Benutzt für die im archäologischen Befund nachweisbaren Reihen von Pfostengruben; für die eigentlichen, in einer Reihe stehenden Pfosten siehe Pfostenreihe."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostengrubenreihe"@de .

lvr:pfostenreihe a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:editorialNote "Benutzt für die eigentlichen, in einer Reihe stehenden Pfosten; für die im archäologischen Befund nachweisbaren Reihen von Pfostengruben siehe Pfostengrubenreihe."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostenreihe"@de .

lvr:pfostenspur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pfostenspur ist eine Verfärbung, die in einer Pfostengrube den Standort des vergangenen Pfostens anzeigt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostenspur"@de .

lvr:pfostenstickung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfostenstickung"@de .

lvr:pinge a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Pinge ist eine Abbaustelle, die aufgelassen und teilweise verfüllt ist. Pingen zeichnen sich im Gelände durch zumeist trichterförmige bis schüsselförmige Vertiefungen ab."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pinge"@de .

lvr:pingenfeld a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Pingenfeld ist ein Bergbaugebiet, das mehr oder weniger groß ist, in dem sich eine Anzahl von Pingen befindet und in dem auch weitere Relikte bergbaulicher Tätigkeiten erhalten sein können."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pingenfeld"@de .

lvr:plagge_landwirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Plagge ist eine Sode mit darauf befindlicher Vegetation, welche in der Regel nach einer Nutzung als Einstreu anschließend auf weniger nährstoffreiche Ackerflächen aufgebracht wurde, um die landwirtschaftliche Produktivität zu steigern."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Plagge (Landwirtschaft)"@de .

lvr:planierung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Planierung"@de .

lvr:platz_staedtebau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Platz ist ein offener Raum, der in der Regel durch Bauwerke begrenzt ist und im städtebaulichen Kontext steht."@de ;
    skos:editorialNote "Benutzt für freien Raum, der im städtebaulichen Kontext entstanden ist und in der Regel von Bauwerken begrenzt wird; für Plätze außerhalb des städtebaulichen Kontext siehe Offene Räume."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Platz (Städtebau)"@de .

lvr:pochwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Pochwerk ist eine Mühle, die dem Zerkleinern von Erz dient. Dazu werden Pochstempel mit sogenannten Pochschuhen aus Eisen über eine Welle angehoben und auf die Erzstücke fallen gelassen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pochwerk"@de .

lvr:podiumstempel a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Podiumstempel ist ein Tempel, der auf einem hohen Unterbau ruht und mit einer Freitreppe an der Front ausgestattet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Podiumstempel"@de .

lvr:porta_decumana a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Porta Decumana ist als Tor Bestandteil eines römischen Militärlagers. Es liegt innerhalb der Schmalseite des Lagers im rückwärtigen Teil gegenüber der Hinterfront der Principia."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Porta decumana"@de .

lvr:porta_praetoria a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Porta praetoria ist ein Tor, das in einer Schmalseite des Lagers gegenüber der Front der Principia liegt und den Hauptzugang in ein römisches Militärlager markiert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Porta praetoria"@de .

lvr:porta_principalis_dextra a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Porta principalis dextra ist ein Tor, das in der rechten Breitseite eines römischen Militärlagers liegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Porta principalis dextra"@de .

lvr:porta_principalis_sinistra a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Porta Principalis Sinistra ist das Tor eines römischen Lagers, das in der linken Breitseite des Lagers liegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Porta principalis sinistra"@de .

lvr:portikus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein oder eine Portikus ist ein Gebäudeteil, der als von Säulen oder Pfeilern getragene offene Halle einem Gebäude vorgesetzt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Portikus"@de .

lvr:postamt_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Postamt ist ein Gebäude, in dem in der Zeit von 1871 bis 1994 Einrichtungen zur postalischen Beförderung und Verteilung von schriftlichen Nachrichten, Briefpost und Paketpost untergebracht sind."@de ;
    skos:editorialNote "Benutzt für das Amtsgebäude der Post zwischen 1871 und 1994; für das Postgebäude vor 1871 siehe Poststation und nach 1995 siehe Postagentur."@de ;
    skos:historyNote "Gültig: 1871 bis 1994"@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Postamt (Bauwerk)"@de .

lvr:praefurnium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Das Praefurnium ist der Teil des Hypokaustums, in dem in römischer Zeit das Feuer brannte. Von hier aus wurde die Hitze in die Hypokausten geleitet. Zum Praefurnium gehörte ein Bedienraum."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Praefurnium"@de .

lvr:praetorium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Das Praetorium ist ein Gebäude, das in einem römischen Militärlager liegt und in dem der Kommandeur residiert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Praetorium"@de .

lvr:principia_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Principia (Bauwerk)"@de .

lvr:profil_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Profil ist eine Stelle, die einen senkrechten Schnitt durch die Erdoberfläche grafisch darstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Profil (Archäologie)"@de .

lvr:pulvermuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Pulvermühle ist eine Mühle, in der Salpeter, Schwefel und Holzkohle für die Herstellung von Schwarzpulver zerkleinert und gemischt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pulvermühle"@de .

lvr:punktfundament a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Punktfundament"@de .

lvr:quelle_gewaesser a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Quelle ist ein Gewässer, bei dem Grundwasser auf natürliche Weise austritt, wodurch ein Übergangsbereich zwischen Grundwasser und Fließgewässer ausgebildet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Quelle (Gewässer)"@de .

lvr:quellfassung a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Quellfassung ist ein Bauwerk, das um den Austritt einer Quelle an die Erdoberfläche errichtet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Quellfassung"@de .

lvr:radkasten a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Radkasten ist ein Bestandteil, in dem ein Rad läuft. Er gehört zu Vorrichtungen wie Wassermühlen, Schiffen oder Kraftfahrzeugen."@de ;
    skos:editorialNote "Benutzt immer in Kombination mit der Vorrichtung, zu der er gehört."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Radkasten"@de .

lvr:raeucherofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Räucherofen ist ein Ofen, in dem Fleisch, Fisch oder Geflügel speziell im Rauch zubereitet und haltbar gemacht wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Räucherofen"@de ;
    skos:scopeNote "Er besitzt zwei Kammern: die obere, größere ist für die Räucherware; die untere, kleinere ist für das Feuerholz, das den Rauch entwickelt und dem Fleisch das Aroma verleiht."@de .

lvr:raubgraeberloch a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Raubgräberloch ist eine Grube, die im Zusammenhang mit Raubgrabungen unerlaubt angelegt wird und bei deren Erstellung zumindest Teile von archäologischen Befunden gestört oder zerstört werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Raubgräberloch"@de .

lvr:raum_gebaeudeteil a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Raum (Gebäudeteil)"@de .

lvr:ravelin a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Ravelin ist der Bestandteil einer Festung, der als Verteidigungswerk am äußeren Rand des Hauptgrabens gegenüber der Kurtine liegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ravelin"@de .

lvr:refektorium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Refektorium ist ein Saal, der in einem Kloster als Speisesaal des Konventes dient und sich in der Regel in demjenigen Flügel des Kreuzgangs befindet, der der Kirche gegenüberliegt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Refektorium"@de .

lvr:reihengraeberfeld a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Reihengräberfeld"@de .

lvr:reithalle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Reithalle ist eine Pferdesportanlage in Form einer Halle, die speziell für den Reitsport konzipiert ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Reithalle"@de .

lvr:remise a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Remise ist ein Gebäude, das vorrangig dem Unterstellen von Wagen, Fahrzeugen usw. dient und in der Regel offen und nicht verschließbar ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Remise"@de ;
    skos:scopeNote "Regional werden jedoch auch mit Toren verschließbare Unterstellschuppen und Unterstellhallen als Remise bezeichnet."@de .

lvr:rennofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Rennofen ist ein Schachtofen, dessen Schacht aus einem Lehmmantel besteht, in dem aufgrund der erreichten Temperaturen kein flüssiges Eisen sondern Luppen erzeugt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Rennofen"@de .

lvr:revisionsschacht a skos:Concept ;
    skos:broader lvr:schacht_bauwesen ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Revisionsschacht"@de .

lvr:richtstaette a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Richtstätte ist ein offener Raum, an welchem ein Urteil vollstreckt wird, also ein Verurteilter gerichtet oder hingerichtet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Richtstätte"@de .

lvr:ringofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Ringofen ist ein Kammerofen, in dem kontinuierlich Ziegel, Keramik, Kalk oder Zement gebrannt werden und aus mehreren ringförmig oder oval angeordneten Brennkammern besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ringofen"@de .

lvr:ringwall a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Ein Ringwall ist eine Wallanlage, die eine mehr oder weniger runde Form hat und einen oder mehrere größere offene Räume umschließt, die zur Verteidigung, aus religiösen Gründen, als Versammlungsorte oder als Besiedlung genutzt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ringwall"@de ;
    skos:scopeNote "Der Wallanlage kann ein Graben vorgelagert sein, es können sich ein oder mehrere Tore in der Wallanlage befinden. Eine Innenbebauung kann es je nach Nutzung geben."@de .

lvr:risalit a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Risalit ist ein Gebäudeteil, der in ganzer Höhe des Bauwerks vorspringt, auch höher sein kann und oftmals ein eigenes Dach hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Risalit"@de .

lvr:roemisches_militaerlager a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Römisches Militärlager"@de .

lvr:roesche_bergbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Rösche ist ein Erdbauwerk, in Form eines flachen Grabens oder einer Rinne, das im unteren Bereich eines Stollens liegt und der Wasserableitung dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Rösche (Bergbau)"@de .

lvr:saegemuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Sägemühle ist eine Mühle, in der Baumstämme zu Balken, Brettern, Latten oder Dielen geschnitten werden."@de ;
    skos:editorialNote "Benutzt für den Baukomplex; für den industriell geführten Betrieb siehe Sägewerk."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sägemühle"@de .

lvr:saeule a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Säule ist eine Stütze, die einen kreisförmigen Querschnitt hat, im Gegensatz zum Rundpfeiler in der Regel mit Verjüngung und manchmal auch mit Entasis. Sie lässt sich gewöhnlich in Basis, Schaft und Kapitell gliedern."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Säule"@de .

lvr:sakralbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Sakralbau ist ein Gebäude, das Kultzwecken dient. Zu den Sakralbauten zählen der Kirchenbau, Tempelbau und die Moschee."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sakralbau"@de .

lvr:sammelbecken_bauwerk a skos:Concept ;
    skos:broader lvr:becken_bauwerk ;
    skos:definition "Ein Sammelbecken ist ein Becken, in dem Flüssigkeiten gespeichert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sammelbecken (Bauwerk)"@de .

lvr:sarkophag a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Sarkophag ist ein Sarg, der aus Stein gefertigt ist, mit Reliefs verziert, bemalt oder auch mit Inschriften versehen ist. Vorwiegend dient er der repräsentativen Bestattung höhergestellter Personen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sarkophag"@de .

lvr:schaedelbestattung_grab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Eine Schädelbestattung ist ein Grab, in dem nur der vom Körper getrennte Kopf beigesetzt wird. In einem Grab können sich auch Köpfe mehrerer Individuen befinden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schädelbestattung (Grab)"@de .

lvr:schanze_befestigungsanlage a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Schanze ist eine Feldbefestigung, die aus einem Wall aus aufgeworfener Erde besteht und mit einem Graben ausgestattet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schanze (Befestigungsanlage)"@de .

lvr:scherbenhuegel a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Scherbenhügel ist eine Halde, in der Fehlbrände von Töpfereien oder zu Bruch gegangene keramische Gefäße zur endgültigen Entsorgung abgelagert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Scherbenhügel"@de .

lvr:scherbennest a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Scherbennest"@de .

lvr:scheune a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Scheune ist ein Gebäude, das dem Lagern des Erntegutes dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Scheune"@de .

lvr:schicht_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Schicht ist eine einheitlich strukturierte, räumlich begrenzte, meist horizontal liegende Bodenverfärbung oder Materialkonzentration. Diese Schichten können natürlich entstanden oder künstlich angelegt worden sein."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schicht (Archäologie)"@de .

lvr:schiessstand a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Schießstand ist eine Sportstätte, in der Übungsschießen und Wettkampfschießen durchgeführt werden. Der Begriff wird sowohl für zivile als auch für militärische Anlagen genutzt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schießstand"@de .

lvr:schiff_wasserfahrzeug a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Schiff ist ein größeres Wasserfahrzeug, das auf dem Wasser schwimmt und über einen eigenen Antrieb in Form von Segeln, Motoren oder Riemen verfügt. Es besitzt einen länglichen Rumpf, selten mehrere, der an einem oder beiden Enden schmal oder spitz zuläuft. Im Unterschied zum Boot ist es größer und aufgrund seiner Bauweise in der Regel seetüchtiger."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schiff (Wasserfahrzeug)"@de .

lvr:schifffahrtskanal a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Schifffahrtskanal ist eine Wasserstraße, die künstlich angelegt ist und vor allem für die kommerzielle Schifffahrt genutzt wird."@de ;
    skos:editorialNote "Benutzt für schiffbaren Kanal; für künstlichen Wasserlauf für Abwässer, Bewässerung oder Entwässerung siehe Kanal (Wasserbau)."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schifffahrtskanal"@de .

lvr:schiffswerft a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schiffswerft"@de .

lvr:schlachtfeld a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Schlachtfeld ist ein offener Raum, auf dem sich eine kriegerische Auseinandersetzung, eine Schlacht, ereignet hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlachtfeld"@de .

lvr:schlachtplatz_wirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Schlachtplatz ist ein offener Raum, in dem Tierkörper zerteilt, entbeint, portioniert werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlachtplatz"@de .

lvr:schlackenhalde a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Schlackenhalde ist eine Halde, die aus Reststoffen des Verhüttungsprozesses besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlackenhalde"@de .

lvr:schlagplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlagplatz"@de .

lvr:schleiferei_wirtschaft a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Schleiferei ist ein Betrieb, in dem unbearbeitete Grundstoffe oder vorgefertigtes Halbzeug wie Glas, Stein, Edelsteine und Metalle durch Schleifen endbearbeitet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schleiferei (Wirtschaft)"@de .

lvr:schleuse_wasserbau a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Schleuse ist ein Bauwerk zur Überwindung von Höhenunterschieden in staugeregelten Flüssen und Kanälen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schleuse (Wasserbau)"@de .

lvr:schleusenwehr a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Ein Schleusenwehr ist ein Wehr, das der Regulierung des Wasserstandes an einer Schleuse dient und fest in der Wasserstraße installiert ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schleusenwehr"@de .

lvr:schlitzgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Schlitzgrube ist eine Grube, die in der Archäologie eine schmale, aber zwei bis drei Meter lange und bis zu vier Meter tiefe Grube bezeichnet. Der Querschnitt keilförmig ist. Die Enden sind im Profil gerade oder nur leicht schräg abgerundet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlitzgrube"@de .

lvr:schlitztenne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlitztenne"@de .

lvr:schloss_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Schloss ist ein Baukomplex, der aus einem repräsentativen Gebäude, Nebengebäuden und häufig auch Wirtschaftsgebäuden, Außenanlagen und Freiflächen, Gärten und Gewässern besteht und bei dem je nach Größe und Lage einzelne Teile entfallen können."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schloss (Bauwerk)"@de ;
    skos:scopeNote "Von der Burg unterscheidet sich das Schloss durch den Vorrang des Repräsentativen und die größere Bequemlichkeit der Wohnung. Allerdings sind die Grenzen fließend, so dass es zahlreiche Überschneidungen zwischen Burg und Schloss gibt."@de .

lvr:schmelzofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schmelzofen"@de .

lvr:schmelzplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schmelzplatz"@de .

lvr:schmiede a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Schmiede ist ein Betrieb, in dem schmiedbare Metalle durch Warmverformung und Kaltverformung bearbeitet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schmiede"@de .

lvr:schuerfgrube_bauwesen a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Schürfgrube ist eine Grube, die zur Erkundung des Baugrunds angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schürfgrube (Bauwesen)"@de .

lvr:schuermuendung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schürmündung"@de .

lvr:schuetzengraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "militärische Befestigung"@de,
        "type of earthwork constructed in a military context"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q91764>,
        <https://d-nb.info/gnd/4180074-6> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schützengraben"@de,
        "military trench"@en .

lvr:schuetzenloch a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schützenloch"@de .

lvr:schurf a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Schurf ist eine Grube, die relativ flach ist und  lediglich zur Auffindung von oberflächennahen Lagerstätten angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schurf"@de .

lvr:schwarzerderelikt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwarzerderelikt"@de .

lvr:schwellbalkenkonstruktion a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwellbalkenkonstruktion"@de .

lvr:schwelle_fachwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwelle (Fachwerk)"@de .

lvr:schwellenbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Der Schwellenbau ist ein Gebäude, dessen Wände auf waagrechten Schwellen aufsitzen."@de ;
    skos:editorialNote "Benutzt für das Gebäude; für die Baukonstruktion siehe Schwellbalkenkonstruktion."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwellenbau"@de .

lvr:schwimmbad a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Schwimmbad ist ein Bad oder eine Sportstätte, die aus einem oder mehreren Schwimmbecken, Umkleideräumen, gegebenenfalls Liegewiesen besteht und von einem Bademeister beaufsichtigt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwimmbad"@de .

lvr:siechenhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Siechenhaus ist ein Hospital, das in der Zeit vom 11. bis zum 18. Jahrhundert der Aufnahme und Verpflegung sowie der Quarantäne von unheilbar Kranken (\"Siechen\") diente."@de ;
    skos:editorialNote "Benutzt für die in der Zeit vom 11. bis zum 18. Jahrhundert als Pflegeheim genutzte Einrichtung; für die medizinische Einrichtung seit dem 18. Jahrhundert siehe Krankenhaus."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Siechenhaus"@de .

lvr:siedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Siedlung ist in der gebauten Umwelt eine menschliche Niederlassung, die aus Wohnbauten und Zweckbauten sowie der dazugehörigen Infrastruktur besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Siedlung"@de .

lvr:skelett_koerperbestandteil a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Skelett ist der Bestandteil eines Tiers oder Menschen, der das tragende Gerüst aus festem Gewebe bildet. So handelt es sich dabei etwa bei Wirbeltieren um die Gesamtheit der Knochen oder bei bestimmten Fischen um die der Knorpel."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Skelett (Körperbestandteil)"@de .

lvr:sohlgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Sohlgraben ist ein Graben, der einen flachen Boden (Grabensohle) hat, sodass das Grabenprofil U-förmig ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sohlgraben"@de .

lvr:soldatenfriedhof a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Soldatenfriedhof ist eine Kriegsgräberstätte, auf dem während eines Krieges gefallene Soldaten beigesetzt sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Soldatenfriedhof"@de .

lvr:speicher_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Speicher ist ein Lagergebäude, in dem Güter aufbewahrt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Speicher (Bauwerk)"@de .

lvr:spinnerei a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Spinnerei ist ein Betrieb, in dem aus Fasern Fäden gesponnen werden."@de ;
    skos:editorialNote "Benutzt für den Handwerksbetrieb und den Industriebetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Spinnerei"@de .

lvr:spitzgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Spitzgraben ist ein Befestigungsgraben, der keine Sohle besitzt, sondern dessen Grabenwände stattdessen in spitzem Winkel aufeinandertreffen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Spitzgraben"@de .

lvr:sportplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Sportplatz ist ein Platz, der als große, ebene und freie Fläche angelegt ist, zum Treiben von Sport oder der Austragung von Wettbewerben dient und zu dem meist auch Umkleidemöglichkeiten gehören."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sportplatz"@de .

lvr:stadt_siedlung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Stadt ist eine dauerhafte Siedlung, die mit bestimmten Rechten ausgestattet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stadt (Siedlung)"@de ;
    skos:scopeNote "Kennzeichnend sind ferner eine höhere bauliche Verdichtung und die Ausübung zentralörtlicher Funktionen für ein Umland, etwa in den Bereichen Verwaltung, Wirtschaft, Bildung und Kultur.  Charakteristisch ist die Ansiedlung einer stark arbeitsteiligen Wirtschaft."@de .

lvr:stadtbefestigung a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Stadtbefestigung ist eine Befestigungsanlage, die einer städtischen Siedlung zu deren Sicherung, Befriedung oder Verteidigung dient."@de ;
    skos:editorialNote "Benutzt für Anlagen zur Befestigung einer städtischen Siedlung, die aufgrund ihrer Bauform und ihres Baumaterials nicht als Stadtmauer zu bezeichnen sind; für das als massive Konstruktion aus Stein gemauerte Bauwerk siehe Stadtmauer."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stadtbefestigung"@de .

lvr:stadtgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Stadtgraben ist ein Befestigungsgraben, der um eine Stadt herum führt und diese sichert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stadtgraben"@de .

lvr:stadtkern a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Stadtkern ist ein Ortskern, der im Zentrum einer Stadt liegt und deren stärkste bauliche Verdichtung und die Konzentration städtischer Funktionen aufweist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stadtkern"@de .

lvr:stadtmauer a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Stadtmauer ist eine Umfassungsmauer, die um eine Stadt führt und zu deren Sicherung, Befriedung, Befestigung oder Verteidigung dient."@de ;
    skos:editorialNote "Benutzt für das als massive Konstruktion aus Stein gemauerte Bauwerk; für sich aufgrund ihrer Bauform und ihres Baumaterials davon unterscheidende Anlagen zur Befestigung einer städtischen Siedlung siehe Stadtbefestigung."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stadtmauer"@de ;
    skos:scopeNote "Eine Stadtmauer kann auch um eine Siedlung führen, die im rechtlichen Sinne nicht als Stadt gilt, aber als Freiheit oder gefreiter Ort durch ein entsprechendes Privileg (Befestigungsrecht) das Recht zur Errichtung einer Wehrmauer hat."@de .

lvr:staenderwand_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ständerwand (Ofen)"@de .

lvr:stall a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Stall ist ein Gebäude oder ein Gebäudeteil, in dem Tiere untergebracht werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stall"@de .

lvr:stauanlage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Stauanlage ist ein Baukomplex oder Bauwerk, das den natürlichen Wasserspiegel eines Gewässers durch Verringerung des Wasserabflusses anhebt und zu dem Wehre und Talsperren zählen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stauanlage"@de .

lvr:staudamm a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Staudamm ist ein Damm, der als Bestandteil einer Stauanlage aus aufgeschütteten Baustoffen besteht und das Gebiet abschließt, in dem ein Gewässer aufgestaut wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Staudamm"@de .

lvr:stauteich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Stauteich ist ein Teich, in dem Wasser für eine spätere gewerbliche Nutzung angestaut wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stauteich"@de .

lvr:steg_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Steg ist eine Brücke, die als Übergang über Gewässer dient und im Verhältnis zu einer Brücke kleiner und schmaler ist und nicht für den Autoverkehr geeignet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steg (Bauwerk)"@de .

lvr:stehender_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Stehender Ofen ist ein Brennofen, bei dem Feuerung und Brennraum übereinander angeordnet sind und durch eine horizontale Lochtenne oder Schlitztenne getrennt werden, sodass das Brenngut von unten mit Heizluft bestrichen wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stehender Ofen"@de .

lvr:steinbruch a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Steinbruch ist eine Abbaustelle, an der aus anstehendem Fels nutzbares Gestein gewonnen wird, dessen Abbau meist obertägig erfolgt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinbruch"@de .

lvr:steinkeller a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Steinkeller ist ein Keller, dessen Wände aus Mauerziegeln oder Bruchsteinen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinkeller"@de .

lvr:steinkistengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Steinkistengrab ist ein Grab, bei dem mehrere zumeist unbearbeitete Steinplatten so aufgestellt sind, dass eine Grabkammer entsteht, die anschließend mit Erdboden überdeckt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinkistengrab"@de .

lvr:steinkonzentration a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Steinkonzentration ist ein allgemeiner Begriff der Archäologie, der eine Konzentration von Bruchsteinen bezeichnet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinkonzentration"@de .

lvr:steinkreuz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Steinkreuz ist ein Gedenkkreuz, das aus Stein heraus gearbeitet wird. Steinkreuze sind häufig Flurdenkmale."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinkreuz"@de .

lvr:steinplattengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Steinplattengrab ist ein Plattengrab, dessen Grabgrube mit flachen, aufrecht stehenden Steinplatten ausgekleidet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinplattengrab"@de .

lvr:steinsetzung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Steinsetzung ist ein Bauwerk, das aus Steinen besteht, die in unterschiedlicher Form horizontal zueinander angeordnet sind."@de ;
    skos:editorialNote "Benutzt für archäologische Fundplätze und Befunde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinsetzung"@de .

lvr:steinzeugofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Steinzeugofen ist ein Töpferofen, in dem zumeist Steinzeug gebrannt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinzeugofen"@de .

lvr:sternschanze a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Sternschanze ist eine Schanze, deren geschlossenes Außenwerk auf einer sternförmigen Grundfläche ruht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Sternschanze"@de .

lvr:stickung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Stickung ist der Bestandteil des Fundamentunterbaus, der aus losem, nicht vermörteltem Material (Bruchsteinen, Ziegelbruch und anderen Materialien) besteht und auf der Sohle des Fundamentgrabens liegt."@de ;
    skos:editorialNote "Benutzt für den Fundamentunterbau aus losem, nicht vermörteltem Material; für das entsprechende Bauteil aus Beton oder einer Kiesschicht siehe Sauberkeitsschicht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stickung"@de .

lvr:stiftsgebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Stiftsgebäude ist ein Gebäude, das zu einem kirchlichen Stift gehört."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stiftsgebäude"@de .

lvr:stoerung_archaeologie a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Störung ist ein allgemeiner Begriff der Archäologie, der einen Bodeneingriff bezeichnet, der einen anderen Befund stört, z.B. überschneidet, überdeckt oder durchschneidet und relativchronologisch jünger als der gestörte Befund datiert wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Störung (Archäologie)"@de .

lvr:strassendamm a skos:Concept ;
    skos:broader lvr:strasse ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Straßendamm"@de .

lvr:strassengraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Straßengraben ist ein Entwässerungsgraben, der die Straße begleitet und das von ihr abfließende Oberflächenwasser aufnimmt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Straßengraben"@de .

lvr:strassenposten a skos:Concept ;
    skos:broader lvr:strasse ;
    skos:definition "Ein Straßenposten ist eine militärische Anlage, die unterschiedliche Kontrollmöglichkeiten an Verkehrswegen umfasst."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Straßenposten"@de .

lvr:strassensperre a skos:Concept ;
    skos:broader lvr:strasse ;
    skos:definition "Eine Straßensperre ist ein Bauwerk, das sowohl ortsfest als auch mobil sein kann und auf einem Verkehrsweg zum Stoppen und Kontrollieren des fließenden Verkehrs dient."@de ;
    skos:editorialNote "Benutzt in Kombination mit dem spezifischen Begriff für das versperrende Objekt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Straßensperre"@de .

lvr:streifenflur a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Eine Streifenflur ist eine Flurform, die einen Flurtyp mit lang gestreckten Parzellen charakterisiert."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Streifenflur"@de .

lvr:streifenhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Streifenhaus ist ein Gebäude, das typisch für die römische Zeit ist. Seine Form ist lang gestreckt und die schmale Giebelseite zeigt zur Straße."@de ;
    skos:editorialNote "Benutzt für den römischen Haustyp; für andere Gebäude mit Wohnfunktion siehe Wohnhaus."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Streifenhaus"@de .

lvr:stueckofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Stückofen ist ein Schachtofen, dessen viereckiger Schacht gemauert aber relativ flach ist. Die Belüftung erfolgt durch Blasebälge, die mit Wasserkraft angetrieben werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stückofen"@de ;
    skos:scopeNote "Ein Stückofen ist eine Weiterentwicklung der Rennfeueröfen und einer der Vorläufer der Hochöfen."@de .

lvr:stufenrain a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Stufenrain ist ein Rain, der Bestandteil einer Ackerterrasse ist und die vordere in Pflugrichtung verlaufende Begrenzung parallel zum Hang bildet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stufenrain"@de .

lvr:suspensura a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Suspensura"@de .

lvr:synagoge a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Synagoge ist ein Sakralbau, in dem gläubige Juden den Gottesdienst feiern."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Synagoge"@de ;
    skos:scopeNote "In der Synagoge finden auch Gemeindeversammlungen, Sprachunterricht und Religionsunterricht statt."@de .

lvr:teich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Teich"@de .

lvr:tempel a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Tempel ist ein Sakralbau, der anderen Religionen als der christlichen, jüdischen oder muslimischen als Kultraum oder Kultgebäude dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tempel"@de .

lvr:tepidarium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tepidarium"@de .

lvr:terrassenacker a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Ein Terrassenacker ist eine Ackerfläche, die bevorzugt an Hängen angelegt wird und aus mehreren Ackerterrassen besteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Terrassenacker"@de .

lvr:thermen a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Thermen"@de .

lvr:tierbau a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Tierbau ist eine tierische Architektur, in Form eines unterirdisch durch Tiere angelegten Hohlraumes."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tierbau"@de .

lvr:tiergrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Tiergrab ist ein Grab, in dem ein oder mehrere Tiere bestattet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tiergrab"@de .

lvr:toepferei a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Töpferei ist ein Betrieb, in dem aus Ton Gefäße und Skulpturen geformt und anschließend im Ofen gebrannt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Töpferei"@de .

lvr:toepferofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Töpferofen ist ein Brennofen, in dem aus Ton gefertigte Waren zur Gebrauchsfähigkeit fest gebrannt werden. Dessen Bau, Form und Einrichtungen richten sich nach der Beschaffenheit der zu brennenden Ware und des Brennmaterials."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Töpferofen"@de .

lvr:tonaufbereitungsgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Tonaufbereitungsgrube ist eine Grube, in der der Ton für die weitere Bearbeitung vorbereitet wird. Dazu gehören u.a. die Zugabe von Wasser und Magerungsbestandteilen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tonaufbereitungsgrube"@de .

lvr:tongrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Tagebau zur Gewinnung von Tonmineralen"@de,
        "open-pit mining for the extraction of clay minerals"@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q179316>,
        <https://d-nb.info/gnd/4185677-6> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tonstich"@de,
        "clay pit"@en .

lvr:toranlage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Toranlage ist der Bestandteil einer Befestigungsanlage, der sich um deren Tor gruppiert und auf jeden Fall aus Tor und Torweg besteht, wobei Torbauten, Torzwinger u.a. fallweise hinzutreten können."@de ;
    skos:editorialNote "Benutzt für Baukomplexe bei Befestigungen; für das als Durchgang oder Durchfahrt genutzte funktionelle Architekturelement siehe Tor (Architektur)."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Toranlage"@de .

lvr:totenbrett a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Totenbrett ist ein Objekt, das die Form eines Brettes hat, auf dem Tote bis zum Begräbnis aufgebahrt werden und das anschließend mit ins Grab gegeben werden oder zur Erinnerung an den Verstorbenen, teilweise mit Inschriften und Malereien verziert, aufgestellt werden kann und damit auch die Funktion eines Informationsträgers übernimmt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Totenbrett"@de .

lvr:treppe a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Von Stufen gebildeter Aufgang, der unterschiedlich hoch liegende Ebenen innerhalb und außerhalb von Gebäuden verbindet bzw. an Steigungen im Gelände angelegt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Treppe"@de .

lvr:trockenhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Trockenhaus ist ein Gebäude, das so konstruiert ist, dass Luft reguliert hindurchströmen kann, um so darin eingelagerte Güter zu trocknen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Trockenhaus"@de .

lvr:trockenmauergrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Trockenmauergrab ist ein Grab, dessen Grabgrube durch mörtellose Bruchsteinwände verkleidet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Trockenmauergrab"@de .

lvr:trockenrinne a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Trockenrinne ist in der Geologie ein Geländeeinschnitt, der nur zeitweise bei hohem Niederschlagsaufkommen Wasser führt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Trockenrinne"@de ;
    skos:scopeNote "Typisch sind Trockenrinnen in Gebieten mit sehr durchlässigem Boden, wo das Niederschlagswasser in der Regel schneller versickert als es oberirdisch abfließt."@de .

lvr:truemmerstelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Trümmerstelle ist eine Siedlung, die durch eine Konzentration von römischen Ziegelbruchstücken und Scherben auf der Geländeoberfläche den ehemaligen Standort anzeigt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Trümmerstelle"@de .

lvr:tuerschwelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Türschwelle ist ein Bauteil, das als Bestandteil einiger Türen deren Öffnung nach unten abschließt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Türschwelle"@de .

lvr:turnhalle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Turnhalle ist eine Sporthalle, die für den Turnunterricht oder ähnliche sportliche Betätigungen eingerichtet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Turnhalle"@de .

lvr:uebungslager_militaer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Übungslager (Militär)"@de .

lvr:uferbefestigung_bauwerk a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Eine Uferbefestigung ist ein Bauwerk, das als Maßnahme gegen die Beschädigung oder Zerstörung des Gewässerufers errichtet wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Uferbefestigung (Bauwerk)"@de .

lvr:umgangstempel a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Umgangstempel"@de .

lvr:unterstand_militaer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Unterstand (Militär)"@de .

lvr:urnengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Urnengrab ist ein Brandgrab, in dem sich der Leichenbrand und gegebenenfalls vorhandene Beigaben in einer Urne befinden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Urnengrab"@de .

lvr:ustrine a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Ustrine (Ustrina) ist ein Verbrennungsplatz, der in Verbindung zu einem Brandgräberfeld oder einem sonstigen Bestattungsplatz steht, auf dem die Verstorbenen auf einem Scheiterhaufen verbrannt werden, wobei auch die Beigaben mit verbrannt werden können und der sich in der Regel als Verfärbung im archäologischen Befund abzeichnet."@de ;
    skos:editorialNote "Benutzt für den Verbrennungsplatz."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ustrine"@de ;
    skos:scopeNote "In der Römischen Kaiserzeit ist er auch ein selbstständiger Verbrennungsofen oder ein Krematorium mit getrenntem Verbrennungsraum und Heizraum."@de .

lvr:valetudinarium a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Valetudinarium ist ein Lazarett, das Bestandteil eines römischen Lagers ist, bei dem sich in der Regel eine oder zwei Reihen von Krankenzimmern, die durch Gänge verbunden sind, um einen Innenhof gruppieren und in dem sich separate Behandlungsräume, Verwaltungsräume oder Lager befinden können."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Valetudinarium"@de .

lvr:verfuellung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Verfüllung"@de ;
    skos:scopeNote "Bezeichnet bei der archäologischen Schichtenansprache das Material, mit dem ein Hohlraum intentionell oder natürlich wieder aufgefüllt wurde"@de .

lvr:verhuettungsplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Verhüttungsplatz"@de .

lvr:verschanzung_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Verschanzung ist eine Befestigungsanlage, die aus aufgeschütteten Wällen besteht und Wallrechtecke zur Feindseite hin aufweist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Verschanzung (Bauwerk)"@de ;
    skos:scopeNote "Sie wurden zumeist in Handschachtung angelegt, zur Sicherung der eigenen Position. Sie waren ggf. verstärkt durch Holzeinbauten."@de .

lvr:via_decumana a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Via decumana ist eine Straße, die in einem römischen Militärlager liegt und in dessen rückwärtigen Teil in der zentralen Längsachse die Verbindung von der Principia zur Porta Decumana herstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Via decumana"@de .

lvr:via_praetoria a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Via praetoria ist eine Straße, die in einem römischen Militärlager liegt und in der Längsachse die Verbindung von der Front der Principia zum Haupttor (Porta Praetoria) herstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Via praetoria"@de .

lvr:via_principalis a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Via principalis ist eine Straße, die in einem römischen Militärlager liegt und die, parallel zur Front der Principia verlaufend, die Verbindung der beiden seitlichen Lagertore (Portae Principales) herstellt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Via principalis"@de .

lvr:via_quintana a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Via quintana ist eine Straße, die in einem römischen Militärlager liegt und im rückwärtigen Teil des Lagers parallel zur rückwärtigen Front der Principia verläuft."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Via quintana"@de .

lvr:via_sagularis a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Die Via sagularis ist eine Straße, die in einem römischen Militärlager liegt und im Raum zwischen äußerem Befestigungsring und angrenzender Innenbebauung (Intervallum) rund um alle Baulichkeiten des Lagers führt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Via sagularis"@de .

lvr:vicus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Vicus"@de .

lvr:viehtrift a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Viehtrift ist ein Weg, auf dem Viehherden zu Weideplätzen getrieben werden und die oft seitlich durch Hecken, Zäune oder Trockenmauern begrenzt sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Viehtrift"@de .

lvr:villa a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Villa ist ein Wohnhaus, das als repräsentativer Bau auf dem Lande oder im Randbereich von städtischen Ansiedlungen steht und meist nur einer Familie dient."@de ;
    skos:editorialNote "Benutzt für Villen allgemein; für Villen in römischer Zeit siehe Villa rustica für ländliche Villen und Villa urbana für städtische Villen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Villa"@de ;
    skos:scopeNote "Der Begriff Villa wurde in der Antike für repräsentative Landsitze geprägt. Die dem zugrunde liegende Idee blieb bis in die Gegenwart erhalten. In römischer Zeit wurde begrifflich zwischen ländlichen, vorstädtischen und städtischen Villen unterschieden. In nachrömischer Zeit wurde derartige begriffliche Unterschiede nicht mehr gemacht."@de .

lvr:villa_rustica a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Villa rustica"@de .

lvr:villa_urbana a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:historyNote "Gültig: 50 bis 450"@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Villa urbana"@de .

lvr:vorburg a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Vorburg ist der Bestandteil einer Burg, der der Hauptburg vorgelagert und ebenfalls befestigt ist und auf dem vorrangig Wirtschaftsbauten stehen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Vorburg"@de .

lvr:vorratsgrube a skos:Concept ;
    skos:broader lvr:grube_erdbauwerk ;
    skos:definition "Eine Vorratsgrube ist eine Grube, die angelegt wird um landwirtschaftliche Erzeugnisse einzulagern."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Vorratsgrube"@de .

lvr:vorstadt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Vorstadt"@de .

lvr:wachtturm a skos:Concept ;
    skos:broader lvr:turm_bauwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wachtturm"@de .

lvr:wagengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Wagengrab ist ein Grab, bei dem ein Wagen oder Teile eines Wagens als Beigabe in das Grab gegeben werden. Der Bestattete kann auf oder neben dem Wagen liegen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wagengrab"@de .

lvr:wagenspur_verkehr a skos:Concept ;
    skos:broader lvr:Infrastruktur_und_Verkehr ;
    skos:definition "Die Wagenspur ist eine Spur aus schmalen Vertiefungen, die sich durch häufiges befahren eines Verkehrsweges in dessen Längsrichtung bilden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wagenspur (Verkehr)"@de .

lvr:waldweide a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Eine Waldweide ist eine Weide, die sich im Wald befindet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Waldweide"@de ;
    skos:scopeNote "Durch den Weidegang entsteht ein meist lichter Bestand aus überwiegend Eichen oder Buchen. Die sich auf den Erdboden befindenden Eicheln und Bucheckern diente zusätzlich als Mastfutter. Die Weidewirtschaft wurde nur bis in die Mitte des 20 Jahrhundert betrieben."@de .

lvr:walkmuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Walkmühle ist eine Stampfmühle, in der Gewebe durch Stoßen, Strecken und Pressen verdichtet, veredelt und zu Tuch verarbeitet werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Walkmühle"@de .

lvr:wall a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Wall ist ein Bauwerk, das aus Erde, Steinen oder Ähnlichem besteht und oft eine Schutzfunktion hat."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wall"@de .

lvr:wallanlage a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wallanlage"@de .

lvr:wand_architektur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Wand ist ein Architekturelement, das einen Raum in der Senkrechten in voller Höhe und Breite begrenzt. Besteht die Raumbegrenzung aus Mauern, so meint Wand lediglich die sichtbare Oberfläche."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wand (Architektur)"@de .

lvr:wandgraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Wandgraben ist ein Graben, der die Lage einer Hauswand kennzeichnet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wandgraben"@de ;
    skos:scopeNote "Der Wandgraben kann als archäologischer Befund sowohl ein durchgehender, ungegliederter, schmaler Graben für die Aufnahme eines Schwellbalkens als auch ein schmaler Graben mit vielen kleinen Löchern für die Aufnahme einer Palisadenwand, Bretterwand o.ä. sein."@de .

lvr:waschteich a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:editorialNote "Waschteich benutzt für die Teiche, an denen Wäsche gewaschen wird; für Schlämmteiche, Waschteiche usw. im Bergbau, die dem Absetzen von Schwebstoffen dienen siehe Absetzbecken."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Waschteich"@de .

lvr:wasserburg a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Wasserburg ist eine Burg, die vornehmlich zum Zweck des Schutzes allseitig von Wassergräben oder natürlichem Gewässer umgeben ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wasserburg"@de .

lvr:wassergraben a skos:Concept ;
    skos:broader lvr:graben_erdbauwerk ;
    skos:definition "Ein Wassergraben ist ein Bauwerk in Form eines Grabens, der künstlich angelegt oder den Verlauf eines Fließgewässers aufgreifend ausgebaut ist,  Wasser enthält und unterschiedlichen Zwecken dient, wie z.B. der Bewässerung, Entwässerung oder dem Schutz."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wassergraben"@de .

lvr:wasserkunst a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Eine Wasserkunst ist ein Fördersystem, das dem Anheben und Führen von Wasser dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wasserkunst"@de .

lvr:wasserleitung a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "technisches System zum Transport von Wasser"@de,
        "system of pipes and devices for water supply and transport"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300263308>,
        <http://www.wikidata.org/entity/Q373609>,
        <https://d-nb.info/gnd/4064751-1> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wasserleitung"@de,
        "water pipeline"@en .

lvr:wassermuehle a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "technische Anlage, die mittels einer Wasserkraftmaschine durch Wasserkraft angetrieben wird"@de,
        "structure that uses a water wheel or turbine to drive a mechanical process"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300006270>,
        <http://www.wikidata.org/entity/Q185187>,
        <https://d-nb.info/gnd/4064760-2> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wassermühle"@de,
        "watermill"@en .

lvr:weberei_betrieb a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Weberei ist ein Betrieb, in dem auf Webstühlen oder Webmaschinen Stoffe hergestellt werden."@de ;
    skos:editorialNote "Benutzt für Handwerksbetrieb und Industriebetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Weberei (Betrieb)"@de .

lvr:wehr_stauanlage a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wehr (Stauanlage)"@de .

lvr:wehrturm a skos:Concept ;
    skos:broader lvr:befestigungsanlage ;
    skos:definition "Ein Wehrturm ist ein Gebäude in Form eines Turmes, welcher nicht dem Zweck des ständigen Wohnens, sondern überwiegend der Verteidigung dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wehrturm"@de .

lvr:weiher a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Weiher ist ein Standgewässer, das auf natürliche Weise entstanden und von geringer Tiefe ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Weiher"@de .

lvr:weiler a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Weiler ist eine dauerhafte Siedlung, die aus wenigen (3-15) eng oder locker zueinander stehenden Gehöften besteht und bei der Gebäude mit zentraler Funktion in der Regel fehlen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Weiler"@de ;
    skos:scopeNote "Der Weiler stellt keine eigenständige kommunale Verwaltungseinheit dar, sondern ist einer Gemeinde angehörig."@de .

lvr:werft_betrieb a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Werft (Betrieb)"@de .

lvr:werkplatz a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Werkplatz ist ein offener Raum, der genutzt wird, um aus Rohstoffen einfache Objekte herzustellen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Werkplatz"@de .

lvr:werkstatt a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Werkstatt ist ein Raum, in dem alle Arbeitsmittel vorhanden sind, die zur Herstellung oder Reparatur einer Ware in handwerklicher Tätigkeit erforderlich sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Werkstatt"@de .

lvr:windmuehle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Windmühle ist eine Mühle, an deren turmartigem Gebäude Flügel angebracht sind, die mit Windkraft die im Inneren des Gebäudes liegenden Vorrichtungen antreiben."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Windmühle"@de .

lvr:woelbacker a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Ein Wölbacker ist ein Altacker, der aus mehreren parallelen, in der Mitte bis zu einem Meter erhöhten Ackerbeeten besteht und der meist nur noch als Flurwüstung vorhanden ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wölbacker"@de .

lvr:wohnhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Wohnhaus ist ein Bauwerk, das zu Wohnzwecken erbaut und genutzt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wohnhaus"@de .

lvr:wohnstallhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Wohnstallhaus ist ein Bauernhaus, in dem die Funktionen des Wohnens, der Viehhaltung und Lagerung unter einem Dach vereint sind."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wohnstallhaus"@de .

lvr:wohnturm a skos:Concept ;
    skos:broader lvr:turm_bauwerk ;
    skos:definition "Ein Wohnturm ist ein Turm, der militärisch befestigt und zu einer dauerhaften Nutzung als Wohnung eingerichtet ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wohnturm"@de ;
    skos:scopeNote "Aufgrund seiner massiven Bauweise kann ein Wohnturm Bestandteil einer Motte (wk000875) oder einer Burg sein. Vom Bergfried (wk001308) der Burg unterscheidet den Wohnturm seine Einrichtung für eine dauerhafte Bewohnung."@de .

lvr:wuestung a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Wüstung ist ein offener Raum, der bewirtschaftet oder bewohnt war und durch verschiedene Faktoren wie Krieg, Seuchen oder wirtschaftliche Gründe aufgegeben wurde."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wüstung"@de .

lvr:wurt a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Wurt ist eine Aufschüttung, auf der eine Siedlung errichtet wird und die vor allem in Küstengebieten oder an Flussniederungen angelegt wird und dem Schutz vor Hochwasser oder der Flut dient."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wurt"@de .

lvr:zangentor a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Zangentor ist eine Toranlage, bei der der Wall bzw. die Befestigungsmauer auf beiden Seiten nach innen eingezogen sind, so dass vor dem eigentlichen Tor ein kurzer Hohlweg entsteht."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zangentor"@de .

lvr:zaun a skos:Concept ;
    skos:broader lvr:Landwirtschaft_und_Flurstruktur ;
    skos:definition "Ein Zaun ist eine Einfriedung, die aus Holz oder Metall besteht und offene Räume voneinander abgrenzt oder schützend umgibt."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zaun"@de .

lvr:zentralgrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Zentralgrab ist ein Grab, das sich meist zentral in einer Bestattungsanlage findet und in der Regel das Grab ist, für das die zugehörige Bestattungsanlage angelegt wird."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zentralgrab"@de .

lvr:ziegelei a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Eine Ziegelei ist ein Betrieb, in dem handwerklich oder industriell Ziegel geformt, getrocknet und gebrannt werden."@de ;
    skos:editorialNote "Benutzt für den Handwerksbetrieb und den Industriebetrieb."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ziegelei"@de .

lvr:ziegelkonzentration a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ziegelkonzentration ist ein allgemeiner Fachbegriff der Archäologie, der eine Konzentration von Ziegelbruchstücken bezeichnet."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ziegelkonzentration"@de .

lvr:ziegelofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:definition "Ein Ziegelofen ist ein Ofen, in dem Ziegelsteine gebrannt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ziegelofen"@de .

lvr:ziegelplattengrab a skos:Concept ;
    skos:broader lvr:grab ;
    skos:definition "Ein Ziegelplattengrab ist ein Plattengrab, dessen Boden, Wände oder Abdeckung ganz oder teilweise aus Ziegelplatten bestehen."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ziegelplattengrab"@de ;
    skos:scopeNote "Ziegelplattengräber wurden vorwiegend in der römischen und fränkischen Periode angelegt, verwendet wurden in der Regel römische Ziegel."@de .

lvr:zisterne a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "unterirdischer Wasserbehälter"@de,
        "artificial reservoirs for the storage of water, typically water-tight tanks in a high part of a building or underground"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300052558>,
        <http://www.wikidata.org/entity/Q838858>,
        <https://d-nb.info/gnd/4266710-0> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zisterne"@de,
        "cistern"@en .

lvr:zitadelle a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Zitadelle ist der Bestandteil einer Festung, der selbstständig, in sich geschlossen, meist in beherrschender Lage und von der Stadt durch die Esplanade getrennt ist. Es dient als Kernfestung oder als Kernwerk, oft zugleich als Zeughaus und Kaserne."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zitadelle"@de .

lvr:zollhaus a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Zollhaus ist ein Verwaltungsgebäude, in dem vor der Vereinbarung des Allgemeinen Zollabkommens und Handelsabkommens 1947/51 (General Agreement on Tariffs and Trade, GATT) Einrichtungen zur Durchführung, Abfertigung oder Verwaltung des Zolls untergebracht sind."@de ;
    skos:editorialNote "Benutzt für das Gebäude vor 1947/51 (Abschluss des Allgemeinen Zollabkommens und Handelsabkommens GATT); für Gebäude nach 1947/51 siehe Zollstation."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zollhaus"@de .

lvr:zug_ofen a skos:Concept ;
    skos:broader lvr:Produktion_und_Handwerk ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zug (Ofen)"@de .

lvr:zwinger_architektur a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Zwinger ist ein Bauteil, das als Fläche der Ringmauer vorgelagert und nach außen von einer Zwingermauer begrenzt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zwinger (Architektur)"@de ;
    skos:scopeNote "Auch die Fläche zwischen einem Hauptwall und einem Vorwall wird Zwinger genannt."@de .

lvr:kirchengebaeude a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Kirchengebäude ist ein Sakralbau, in dem der Gottesdienst bzw. die Kultausübung verschiedener christlicher Religionsgemeinschaften abgehalten werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:basilika_kirche ;
    skos:prefLabel "Kirchengebäude"@de .

lvr:mauer a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Eine Mauer ist ein begrenzendes Bauteil oder Bauwerk, das als massive Konstruktion aus anorganischen Materialien wie Naturstein, Backstein, Beton usw. besteht und dessen Dicke deutlich geringer ist als seine horizontale und vertikale Ausdehnung."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:mauerfundament ;
    skos:prefLabel "Mauer"@de .

lvr:quellheiligtum a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund,
        lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Quellheiligtum ist ein Naturheiligtum, das als Kultplatz an Quellen mit niedergelegten Weihefunden und Opferfunden nachgewiesen ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Quellheiligtum"@de ;
    skos:scopeNote "Die lebensspendende, gesundheitsspendende und fruchtbarkeitsspendende Rolle des Wassers sowie der Glaube an den Sitz über- und unterirdischer Kräfte an Quellen bilden den kultisch-religiösen Hintergrund."@de .

lvr:sarg a skos:Concept ;
    skos:broader lvr:Sepulkral_und_Bestattungsbefund ;
    skos:definition "Ein Sarg ist ein Behälter, in den Tote gelegt und beigesetzt werden."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:baumsarg ;
    skos:prefLabel "Sarg"@de ;
    skos:scopeNote "Ein Sarg hat die Form eines langen Kastens. Er wird mit einem Deckel verschlossen und kann aus unterschiedlichen Materialien hergestellt sein."@de .

lvr:aquaedukt a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Brücken- und Kanalbauwerk zum Transport von Frischwasser"@de,
        "structure constructed to convey water"@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300006165>,
        <http://www.wikidata.org/entity/Q474>,
        <https://d-nb.info/gnd/4002509-3> ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:aquaeduktbruecke,
        lvr:aquaedukttunnel ;
    skos:prefLabel "Aquädukt"@de,
        "aqueduct"@en .

lvr:becken_bauwerk a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Becken ist ein Bauwerk, das als künstliche Vertiefung oder Einmuldung mit einer gebauten Umfassung errichtet ist. Becken können unterschiedliche Formen und Größen haben und werden entsprechend ihrem Einsatzzweck gestaltet."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:absetzbecken,
        lvr:sammelbecken_bauwerk ;
    skos:prefLabel "Becken (Bauwerk)"@de ;
    skos:scopeNote "Ein Becken dient in der Regel dazu, Wasser oder andere Flüssigkeiten aufzunehmen."@de .

lvr:brunnen a skos:Concept ;
    skos:broader lvr:Wasserbau_und_Hydrostruktur ;
    skos:definition "Ein Brunnen ist ein Bauwerk und Erdbauwerk, durch das Grundwasser zur Erdoberfläche gefördert wird."@de,
        "Wells sunk to extract water from a zone of saturation."@en ;
    skos:exactMatch <http://vocab.getty.edu/aat/300152327>,
        <http://www.wikidata.org/entity/Q43483>,
        <https://d-nb.info/gnd/4008491-7> ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:brunnenfassung,
        lvr:brunnenstube ;
    skos:prefLabel "Brunnen"@de,
        "water wells"@en .

lvr:turm_bauwerk a skos:Concept ;
    skos:broader lvr:Siedlung_und_Architektur ;
    skos:definition "Ein Turm ist ein hoch aufragendes Bauwerk mit relativ geringem Umfang. Er kann freistehend oder Teil eines größeren Bauwerks sein."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:wachtturm,
        lvr:wohnturm ;
    skos:prefLabel "Turm (Bauwerk)"@de .

lvr:weg_verkehr a skos:Concept ;
    skos:broader lvr:Infrastruktur_und_Verkehr ;
    skos:definition "Ein Weg ist ein Landverkehrsweg, der begehbar oder befahrbar und meistens kaum oder gar nicht befestigt ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:hohlweg,
        lvr:kreuzwegstation ;
    skos:prefLabel "Weg (Verkehr)"@de .

lvr:Grube_und_Vertiefung a skos:Concept ;
    skos:broader lvr:concept_2d56c359 ;
    skos:definition "Eingetiefte Befunde, Gruben, Schächte und Aushebungsmulden."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:graben_erdbauwerk,
        lvr:grube_erdbauwerk,
        lvr:schacht_bauwesen ;
    skos:prefLabel "Grube und Vertiefung"@de .

lvr:strasse a skos:Concept ;
    skos:broader lvr:Infrastruktur_und_Verkehr ;
    skos:definition "Eine Straße ist ein Landverkehrsweg, der in erster Linie für die Nutzung mit Fahrzeugen angelegt ist."@de ;
    skos:editorialNote "Benutzt für die befestigte Fahrbahn sowie zugehörige Bürgersteige, Bankette, Straßengräben und Straßenbäume."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:strassendamm,
        lvr:strassenposten,
        lvr:strassensperre ;
    skos:prefLabel "Straße"@de .

lvr:Infrastruktur_und_Verkehr a skos:Concept ;
    skos:broader lvr:concept_2d56c359 ;
    skos:definition "Verkehrswege, Brücken, Wege und erschließende Bauten."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:bruecke_bauwerk,
        lvr:furt,
        lvr:strasse,
        lvr:wagenspur_verkehr,
        lvr:weg_verkehr ;
    skos:prefLabel "Infrastruktur und Verkehr"@de .

lvr:schacht_bauwesen a skos:Concept ;
