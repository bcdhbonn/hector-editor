lvr:grube_erdbauwerk a skos:Concept ;
    skos:broader lvr:Grube_und_Vertiefung ;
    skos:definition "Eine Grube ist ein künstlich angelegtes Bauwerk, das als Vertiefung in der Erde sichtbar ist."@de ;
    skos:inScheme lvr:scheme ;
    skos:narrower lvr:abfallgrube,
