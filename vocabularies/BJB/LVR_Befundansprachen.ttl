        lvr:wehr_stauanlage,
        lvr:wehrturm ;
    skos:prefLabel "Befestigungsanlage"@de .

lvr:graben_erdbauwerk a skos:Concept ;
    skos:broader lvr:Grube_und_Vertiefung ;
    skos:definition "Ein Graben ist ein Erdbauwerk, das als längere, schmale Vertiefung im Boden ausgeführt ist."@de ;
    skos:inScheme lvr:scheme ;
